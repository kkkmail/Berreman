"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.itemChoosePhotoButton","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.itemRemovePhotoButton","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.itemParameterGrid","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditPanel","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditKnownChoice","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditUnknownChoice","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditValueField","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditLowerField","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditUpperField","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S72-ITEMS-PANEL-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.parameterEditPriorSigmaField","op":"create","path":"Berreman/OpticalConstructor/