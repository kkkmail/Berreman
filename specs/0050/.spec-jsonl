/ExperimentCollectionRoundTripTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SceneSaveLoadTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupSaveLoadTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OpticalConstructor.Ui.Tests.fsproj"], "tests": [{"op": "rename", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitContentFileJsonTests.a scene is stored under its name made filesystem-safe", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitContentFileJsonTests.fs", "class": "OpticalConstructor.Tests.KitContentFileJsonTests", "discovery_gate": "constructor-unit-tests", "successor": "OpticalConstructor.Tests.KitContentFileJsonTests.a setup is stored under its name made filesystem-safe", "obligations": ["S82-SETUP-FILE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitContentFileJsonTests.a setup file round-trips through its canonical text", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitContentFileJsonTests.fs", "obligations": ["S82-SETUP-FILE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitContentFileJsonTests.a setup file of another schema version is UnsupportedSchemaVersionErr", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitContentFileJsonTests.fs", "obligations": ["S82-SETUP-FILE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitContentFileJsonTests.a schema-invalid or malformed setup file is refused before it binds", "path": "Berreman/OpticalConstructor/OpticalCons