ests", "OpticalConstructor.Ui.Tests.SnapToBeamTests", "OpticalConstructor.Ui.Tests.SnapToReflectedTests", "OpticalConstructor.Ui.Tests.SolverHandoffWindowTests", "OpticalConstructor.Ui.Tests.SourceAndDetectorMoveTests", "OpticalConstructor.Ui.Tests.TableAndElementRotationTests", "OpticalConstructor.Ui.Tests.TableRotationTests", "OpticalConstructor.Ui.Tests.TestLauncherTests", "OpticalConstructor.Ui.Tests.WindowLauncherTests", "OpticalConstructor.Ui.Tests.WorkbenchInfoAndCaptureTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs", "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SceneSaveLoadTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OpticalConstructor.Ui.Tests.fsproj"], "tests": [{"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests.a saved scene is a setup file in the kit and loads back onto the table", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SceneSaveLoadTests.fs", "class": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests", "discovery_gate": "ui-tests", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests.saving a scene with a blank name reports a typed status and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SceneSaveLoadTests.fs", "class": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests", "discovery_gate": "ui-tests", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests.loading a scene the kit does not hold reports a typed status and leaves the table alone", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SceneSaveLoadTests.fs", "class": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests", "discovery_gate": "ui-tests", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"op": "create", "suite": "ui-smoke", "id": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests.the scene row renders its name field, Save scene and the saved scenes", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SceneSaveLoadTests.fs", "class": "OpticalConstructor.Ui.Tests.SceneSaveLoadTests", "discovery_gate": "ui-smoke", "obligations": ["S43-SCENE-SAVE-LOAD"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SceneSetName", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SceneSave", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SceneLoad", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.sceneName", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.savedScenes", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.sceneNameField", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S43-SCENE-SAVE-LOAD"]}, {"symbol": "OpticalConstructor.