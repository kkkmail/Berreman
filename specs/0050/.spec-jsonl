-CPL.setup-json","data/optics-mueller/CPL-(LR#0)-CPL.setup-json","data/optics-mueller/CPL-(LR#45)-CPL.setup-json","data/optics-mueller/CPL-(LR#90)-CPL.setup-json","data/optics-mueller/CPL-(QZ#0-LR#0)-CPL.setup-json","data/optics-mueller/CPL-(QZ#45-LR#45)-CPL.setup-json","data/optics-mueller/CPL-(QZ#90-LR#90)-CPL.setup-json","data/optics-mueller/CPL-(LR#-90)-CPL.setup-json","data/optics-mueller/CPL-(QZ#90-LR#-90)-CPL.setup-json","data/optics-mueller/LP-(AIR#0)-LP-2.experiment-json","data/optics-mueller/LP-(AIR#0)-LP-2R.experiment-json","data/optics-mueller/LP-(LR#0)-LP-2.experiment-json","data/optics-mueller/LP-(LR#45)-LP-2.experiment-json","data/optics-mueller/LP-(LR#90)-LP-2.experiment-json","data/optics-mueller/LP-(QZ#0)-LP-2.experiment-json","data/optics-mueller/LP-(QZ#0-LR#0)-LP-2.experiment-json","data/optics-mueller/LP-(QZ#45)-LP-2.experiment-json","data/optics-mueller/LP-(QZ#45-LR#45)-LP-2.experiment-json","data/optics-mueller/LP-(QZ#90)-LP-2.experiment-json","data/optics-mueller/LP-(QZ#90-LR#90)-LP-2.experiment-json","data/optics-mueller/LP-(AIR#0)-CPL-2.experiment-json","data/optics-mueller/LP-(AIR#0)-CPL-2R.experiment-json","data/optics-mueller/LP-(LR#0)-CPL-2.experiment-json","data/optics-mueller/LP-(LR#45)-CPL-2.experiment-json","data/optics-mueller/LP-(LR#90)-CPL-2.experiment-json","data/optics-mueller/LP-(QZ#0)-CPL-2.experiment-json","data/optics-mueller/LP-(QZ#0-LR#0)-CPL-2.experiment-json","data/optics-mueller/LP-(QZ#45)-CPL-2.experiment-json","data/optics-mueller/LP-(QZ#45-LR#45)-CPL-2.experiment-json","data/optics-mueller/LP-(QZ#90)-CPL-2.experiment-json","data/optics-mueller/LP-(QZ#90-LR#90)-CPL-2.experiment-json","data/optics-mueller/CPL-(AIR#0)-LP-2.experiment-json","data/optics-mueller/CPL-(AIR#0)-LP-2R.experiment-json","data/optics-mueller/CPL-(LR#0)-LP-2.experiment-json","data/optics-mueller/CPL-(LR#45)-LP-2.experiment-json","data/optics-mueller/CPL-(LR#90)-LP-2.experiment-json","data/optics-mueller/CPL-(QZ#0)-LP-2.experiment-json","data/optics-mueller/CPL-(QZ#0-LR#0)-LP-2.experiment-json","data/optics-mueller/CPL-(QZ#45)-LP-2.experiment-json","data/optics-mueller/CPL-(QZ#45-LR#45)-LP-2.experiment-json","data/optics-mueller/CPL-(QZ#90)-LP-2.experiment-json","data/optics-mueller/CPL-(QZ#90-LR#90)-LP-2.experiment-json","data/optics-mueller/CPL-(AIR#0)-CPL.experiment-json","data/optics-mueller/CPL-(AIR#0)-CPL-BR.experiment-json","data/optics-mueller/CPL-(LR#0)-CPL.experiment-json","data/optics-mueller/CPL-(LR#90)-CPL.experiment-json","data/optics-mueller/CPL-(QZ#0)-CPL.experiment-json","data/optics-mueller/CPL-(QZ#0-LR#0)-CPL.experiment-json","data/optics-mueller/CPL-(QZ#45)-CPL.experiment-json","data/optics-mueller/CPL-(QZ#90)-CPL.experiment-json","data/optics-mueller/CPL-(QZ#90-LR#90)-CPL.experiment-json","data/optics-mueller/CPL-(AIR#0)-CPL-2.experiment-json","data/optics-mueller/CPL-(LR#45)-CPL-2.experiment-json","data/optics-mueller/CPL-(QZ#45-LR#45)-CPL-2.experiment-json","data/optics-mueller/CPL-(Darkness)-LP-2.experiment-json","data/optics-mueller/CPL-(Darkness)-LP-2R.experiment-json","data/optics-mueller/Darkness.experiment-json","data/optics-mueller/LP-(Darkness)-CPL2.experiment-json","data/optics-mueller/LP-(Darkness)-LP-2.experiment-json","data/optics-mueller/LP-(Darkness)-LP-2R.experiment-json","data/optics-mueller/BullshitCheck.experiment-json","data/optics-mueller/BullshitCheck-2.experiment-json","data/optics-mueller/QZ-LR.study-json","data/optics-mueller/QZ-LR@20260531T120100Z.fitrun-json","data/optics-mueller/QZ-LR@20260531T120200Z.fitrun-json","data/optics-mueller/library"],"tests":[{"op":"create","suite":"kit-acceptance","id":"OpticalConstructor.Ui.Tests.KitAcceptanceTests.the built optics-mueller kit equals the committed kit file by file","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","class":"OpticalConstructor.Ui.Tests.KitAcceptanceTests","discovery_gate":"kit-acceptance","obligations":["S121-COMMITTED-KIT"]}],"contracts":[],"packages":[],"checks":[]},"section":"S12.1 -- AT-1 and the optics-mueller reference kit"}
{"number":429,"anchor":"IMPLEMENT","ac":"AC-S121j","touches":["OpticalConstructor.Ui.Tests"],"depends_on":[428],"how_to":"AT-1 proves the read path on the committed kit (001 §Q 'Open: the test then opens the COMMITTED kit read-only through the real folder `KitProxy`, against an EMPTY library database, and runs its study from there. This proves the read path: the library snapshot, the relative paths and hashes, and the data import. A test never writes into `data/`'; .spec-md §3.12 'A read-only open writes nothing'). Each doc is one to three lines citing spec 0050 S12.1. (1) `OpticalConstructor.Ui.Tests/TestAppScope.fs`: `emptyLibraryAppContext (owner : FolderName) : AppContext`, with a one-line doc citing 001 §Q 'Open', is `AppContext.create` over `testLocations owner` (step 83) whose shipped catalogue folder is a fresh, empty folder under the test output, so the start-up import finds no catalogue, logs its refusal and leaves the SQLite `:memory:` library empty (step 100). (2) The fact `the committed optics-mueller kit opens read-only against an empty library, writes nothing, and its study reproduces the reference reconstruction` in `KitAcceptanceTests`: before anything, the committed folder's relative paths and bytes are recorded. Over `emptyLibraryAppContext (FolderName \"KitAcceptanceTests\")`, a start screen built as step 421 builds one sends `OpenKitReadOnly` of the committed folder (step 177), and the kit is opened read-only through `KitProxy.create`'s `readOnlyView` (step 131); the window model is `TestAppScope.inverseModelOver` of the context and the opened kit. Then: the context's item-model store and live library list no entry, while every one of the nine items resolves its model through the kit's snapshots (`model.tryItemModelChoice`, steps 142, 222, 263); the opened kit holds the 53 experiments, the 42 setups, the 9 items, the study and its two fit runs; every experiment's attachment status is unchanged at its recorded hash (`attachmentStatus`, step 134) and its data loads through the Phone ROI CSV profile (`readMapped`, step 305) to its group's points; `assertReferenceInstruments model.kitItems` holds (step 427). (3) The study runs from there through the study engine itself, because a fit run's write is refused under a read-only kit (steps 185, 413): `StudyFitParam.runFit` (step 391) of `{ study = QZ-LR; stage = ObjectStage; calibrationUse = CalibrationHeldFixed }` under `UnwatchedIterations` (step 380), the parameter being `model.studyForwardContext`, a clock fixed at 2026-05-31T12:03:00Z, the solver and deviates `StudyFitEnvironment.create` composes (step 393) and `model.kitFitRuns`, answers `Ok run` with `LinearStudyEngine`, and `assertReferenceObjects run` holds (step 427). Afterwards the committed folder's relative paths and bytes equal the recorded ones: nothing was written, no lock, stamp, snapshot or cache (.spec-md §3.12). No product code changes. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the read path lands, the committed kit MUST open read-only against an empty library, resolve every item model from its snapshots, load every attachment at its hash, reproduce the published instruments and, through `StudyFitParam.runFit`, the reference matrices and product-check ratio within `MuellerReference.dataMatrixTol`, and leave every file of the committed folder unchanged; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `the committed optics-mueller kit opens read-only against an empty library, writes nothing, and its study reproduces the reference reconstruction`, the count rising by 1; ui-smoke MUST pass; and build, elevation and the twenty-one s41 invariants MUST pass.","required_gates":["build","elevation","kit-acceptance","ui-smoke","ui-tests"],"gate_selection":{"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.StudyViewTests","OpticalConstructor.Ui.Tests.DataStepTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/TestAppScope.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"],"tests":[{"op":"create","suite":"kit-acceptance","id":"OpticalConstructor.Ui.Tests.KitAcceptanceTests.the committed optics-mueller kit opens read-only against an empty library, writes nothing, and its study reproduces the reference reconstruction","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","class":"OpticalConstructor.Ui.Tests.KitAcceptanceTests","discovery_gate":"kit-acceptance","obligations":["S121-AT1-READ-PATH"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.Tests.TestAppScope.emptyLibraryAppContext","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/TestAppScope.fs","obligations":["S121-AT1-READ-PATH"]}],"packages":[],"checks":[]},"section":"S12.1 -- AT-1 and the optics-mueller reference kit"}
{"number":430,"anchor":"IMPLEMENT","ac":"AC-S121k","touches":["OpticalConstructor.Ui.Tests"],"depends_on":[429],"how_to":"AT-1 proves the exchange path (001 §Q 'Send: the built kit is zipped with `SendKit`, unzipped elsewhere and reopened; the reopened kit and the study's residual vector at its start point equal the built ones'; 001 §H). The fact `the optics-mueller kit travels through Send kit and Open kit from zip unchanged, its study's residual at the start point included` in `KitAcceptanceTests`: (1) The kit is built (`buildOpticsMuellerKit`) into a fresh run folder, its window model's `kitShell` holding `KitArchiveProxy.create ()` (step 199) and `KitArchiveJobHost.immediate` (step 200) whose callbacks record `SendKitProgressed` and `SendKitEnded`; `SendKit (FileName <optics-mueller.zip in the run folder, outside the kit>)` (step 201) and the recorded messages passed through the update leave `SendKitEnded (Ok _)` and the zip written, without `.oc/` (step 198). (2) A start screen over the build's app context, built as step 421 builds one with `KitArchiveProxy.create ()` and `KitArchiveJobHost.immediate` recording `OpenKitZipProgressed` and `OpenKitZipEnded`, sends `OpenKitZip { zip = <the zip>; target = <a fresh, empty folder named optics-mueller in the run folder> }` (step 230) and passes the recorded messages through `updateKitStart`, so the target is extracted and opened, and its `showKit` keeps the reopened kit. (3) The target's relative file paths and bytes, `.oc/` left out of both, equal the built folder's: every kit file, `library/**` and `data/**`. (4) The study's residual vector at its start point is the composition steps 377-379 define, over each folder's window model (`TestAppScope.inverseModelOver` of the context and its kit): `prefitWith`, `dataWith` and `residualWith` over `model.studyForwardContext` and `parameterLayoutWith`'s layout at its `startVector`, for the study `QZ-LR`; the reopened kit's vector equals the built kit's element for element, both answering `Ok`. Nothing is written under `data/`; no product code changes.","acceptance":"After the round trip lands, the built kit sent through `SendKit` and reopened through `OpenKitZip` MUST equal the built kit file by file, `.oc/` excluded, and its study's residual vector at the start point MUST equal the built kit's element for element; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `the optics-mueller kit travels through Send kit and Open kit from zip unchanged, its study's residual at the start point included`, the count rising by 1; and build, elevation and the twenty-one s41 invariants MUST pass.","required_gates":["build","elevation","kit-acceptance","ui-smoke","ui-tests"],"gate_selection":{"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.StudyViewTests","OpticalConstructor.Ui.Tests.DataStepTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"],"tests":[{"op":"create","suite":"kit-acceptance","id":"OpticalConstructor.Ui.Tests.KitAcceptanceTests.the optics-mueller kit travels through Send kit and Open kit from zip unchanged, its study's residual at the start point included","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","class":"OpticalConstructor.Ui.Tests.KitAcceptanceTests","discovery_gate":"kit-acceptance","obligations":["S121-AT1-SEND"]}],"contracts":[],"packages":[],"checks":[]},"section":"S12.1 -- AT-1 and the optics-mueller reference kit"}
{"number": 431, "anchor": "IMPLEMENT", "ac": "AC-S122a", "touches": ["BerremanTestSupport", "BerremanTests"], "depends_on": [430], "how_to": "The ground truth's acceptance moves into the shared test support, so AT-2 and `AbsorbingBiaxialNoisyTests` judge a recovery by ONE function and draw ONE seed list (001 §Q AT-2 'Fit: … within the bands `AbsorbingBiaxialNoisyTests` asserts. Those band checks move into one shared function that both tests call'; 001 §Q 'The data and the expected values come from where they already live; nothing is transcribed'; AGENTS.md 'Reuse, never copy': a re-transcribed constant is a defect; .spec-md §3.21 for the locator). Each change is a MOVE (.spec-md §4 'A reuse is a move or a call'): after the step exactly one declaration of each moved name exists, and BerremanTests' numbers are bit-identical (.spec-md §4 'BerremanTests' numbers stay unchanged'). Each doc is one to three lines citing spec 0050 S12.2. (1) `Berreman/BerremanTestSupport/CommittedKits.fs` (steps 330, 344): `CommittedKit` gains its second case `AbsorbingBiaxialNoisyKit`, and `tryFindFolder` answers `KitFolder (FolderName <root>/data/absorbing-biaxial-noisy)` for it by the same upward walk to the folder holding `Berreman/Berreman.slnx` and the same absence rule (`None` while that kit folder does not exist), and `data/optics-mueller` for `OpticsMuellerKit` as today; the type's doc names both kits. It still writes nothing. (2) `ensembleSeeds` (`InverseFitHarness.fs:ensembleSeeds`, the eight fixed seeds the noisy suites share; steps 339, 343) MOVES from `Berreman/BerremanTests/InverseFitHarness.fs` to `Berreman/BerremanTestSupport/BiaxialSample.fs`, last in the module, its body unchanged and its doc cut to its contract in one to three lines. Each consumer names it at its new home, `BerremanTestSupport.BiaxialSample.ensembleSeeds`, at its uses (`MuellerInverseTests.fs:1204`, `:1252`; `BiaxialInverseTests.fs:837`, `:922`) and opens nothing new, so no other name either file reads changes its binding; `AbsorbingBiaxialNoisyTests`' one use moves with its `seeds` (3a). (3) `Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs` (step 346), after `searchBox`, opening `OpticalConstructor.Optimization` where the compiler asks, in this order: (a) `noisySeeds : NoiseSeed list` = `ensembleSeeds |> List.truncate 5`, MOVED from `AbsorbingBiaxialNoisyTests`' `seeds` (`AbsorbingBiaxialNoisyTests.fs:70`), its doc's reason kept in one line (five seeds rather than eight, for runtime). (b) `absorbingReportedQuantities : RecoveredQuantity<AbsorbingTriclinicParameters> list`, MOVED from `AbsorbingBiaxialNoisyTests`' `reportedQuantities` (`:87`) as step 341 leaves it: `RecoveredQuantity.ofAxis` of each of `AbsorbingTriclinicParameters.axes`, then `n2 - n1`, `n3 - n2`, `n3 - n1` and `isotropic absorption`, each `RecoveredQuantity.derived (ParameterName <name>)` of today's expression; its doc keeps, in one line, why the isotropic absorption is reported. (c) `RecoveryBandBreach = { quantity : ParameterName; spread : RelativeError; bandOpt : RelativeError option }` (`RelativeError`, step 341): a reported quantity whose spread its band does not hold, with `member this.describe : string` rendering `<name> <spread> is out of its band <band>`, or `<name> has no band pinned` for `None`. (d) `absorbingBandBreaches (spreadOf : RecoveredQuantity<AbsorbingTriclinicParameters> -> RelativeError) : RecoveryBandBreach list`: for each of `absorbingReportedQuantities` in order, its spread as the caller measures it against its band; the band match MOVES from the ensemble fact (`AbsorbingBiaxialNoisyTests.fs:151-158`) with its numbers and its comment on how they were pinned: `n1`, `n2`, `n3` 1.0e-3; `n2 - n1`, `n3 - n2`, `n3 - n1` 1.5e-3; `e11`, `e22`, `e33`, `e23`, `e13`, `e12` 1.5e-2; `isotropic absorption` 2.0e-3; `g11`, `g22`, `g33`, `g23`, `g13`, `g12` 1.0e1. A quantity whose spread is not strictly below its band is a breach, and so is one with no band (where the fact `failwith`ed, the function answers a breach, so it is total); the answer is empty when every quantity is in band. The noisy ensemble passes each row's `scatter`, and AT-2's one-seed fit each quantity's own relative error (step 436). The file holds no `Assert`: `BerremanTestSupport` references no test framework (step 344). (4) `Berreman/BerremanTests/AbsorbingBiaxialNoisyTests.fs`: `seeds` and `reportedQuantities` are deleted and their uses read `noisySeeds` and `absorbingReportedQuantities`; the band loop (`:146-159`) becomes one `Assert.True` that `absorbingBandBreaches (fun q -> (rowFor table q.name |> expectOk).scatter)` is empty, its message the breaches' `describe`s joined by `; `, then `: ` and the report. Every other assertion, message and number of the fact is unchanged, and its band comparisons are the same strict `<` on the same doubles. No test is added or removed.", "acceptance": "After the move, `BerremanTestSupport.AbsorbingBiaxialSample` MUST declare `noisySeeds`, `absorbingReportedQuantities`, `RecoveryBandBreach` and `absorbingBandBreaches`, `ensembleSeeds` MUST be declared in `BerremanTestSupport.BiaxialSample` alone, `CommittedKit` MUST hold `AbsorbingBiaxialNoisyKit`, and `AbsorbingBiaxialNoisyTests` MUST judge its bands through `absorbingBandBreaches`; unit-tests MUST pass over the selected classes, among them `BerremanTests.AbsorbingBiaxialNoisyTests`, their numbers and count unchanged; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, its count unchanged; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests", "kit-acceptance"], "gate_selection": {"unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.AbsorbingBiaxialNoisyTests", "BerremanTests.BiaxialInverseTests", "BerremanTests.MuellerInverseTests", "BerremanTests.MuellerReconstructionTests"]}, "kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/BerremanTestSupport/CommittedKits.fs", "Berreman/BerremanTestSupport/BiaxialSample.fs", "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "Berreman/BerremanTests/InverseFitHarness.fs", "Berreman/BerremanTests/MuellerInverseTests.fs", "Berreman/BerremanTests/BiaxialInverseTests.fs", "Berreman/BerremanTests/AbsorbingBiaxialNoisyTests.fs"], "tests": [{"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.AbsorbingBiaxialNoisyTests.an ensemble of noisy experiments recovers the absorption far better than the optical activity", "path": "Berreman/BerremanTests/AbsorbingBiaxialNoisyTests.fs", "obligations": ["S122-BANDS-MOVE"]}], "contracts": [{"symbol": "BerremanTestSupport.CommittedKit", "op": "change_shape", "obligations": ["S122-BANDS-MOVE"], "path": "Berreman/BerremanTestSupport/CommittedKits.fs"}, {"symbol": "BerremanTestSupport.CommittedKit.AbsorbingBiaxialNoisyKit", "op": "create", "path": "Berreman/BerremanTestSupport/CommittedKits.fs", "obligations": ["S122-BANDS-MOVE"]}, {"symbol": "BerremanTestSupport.BiaxialSample.ensembleSeeds", "op": "create", "path": "Berreman/BerremanTestSupport/BiaxialSample.fs", "obligations": ["S122-BANDS-MOVE"]}, {"symbol": "BerremanTests.InverseFitHarness.ensembleSeeds", "op": "retire", "obligations": ["S122-BANDS-MOVE"], "preserves_obligations": ["S122-BANDS-MOVE"], "path": "Berreman/BerremanTests/InverseFitHarness.fs"}, {"symbol": "BerremanTestSupport.AbsorbingBiaxialSample.noisySeeds", "op": "create", "path": "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "obligations": ["S122-BANDS-MOVE"]}, {"symbol": "BerremanTestSupport.AbsorbingBiaxialSample.absorbingReportedQuantities", "op": "create", "path": "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "obligations": ["S122-BANDS-MOVE"]}, {"symbol": "BerremanTestSupport.AbsorbingBiaxialSample.RecoveryBandBreach", "op": "create", "path": "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "obligations": ["S122-BANDS-MOVE"]}, {"symbol": "BerremanTestSupport.AbsorbingBiaxialSample.absorbingBandBreaches", "op": "create", "path": "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "obligations": ["S122-BANDS-MOVE"]}], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number":432,"anchor":"IMPLEMENT","ac":"AC-S122b","touches":["OpticalConstructor.Ui.Tests"],"depends_on":[431],"how_to":"AT-2 starts its kit (001 §1b; 001 §Q 'Common rules' 'Build: each test builds its kit ONLY through the semantic messages (§P), against a SQLite `:memory:` library, and writes it through the REAL folder `KitProxy` into a throw-away folder under the test run's output directory'; 001 §Q AT-2 'Kit: a source at `referenceWaveLength`; an ideal polarimeter detector with the `NoiseParam.decentLab` noise model; five sample items — 100 µm plates cut … — all made of ONE material version holding the `absorbing` ground truth'). A crystal material reaches the library through its entry file (step 355), so the build drops the material and its plate sample on the Library window, as a user drops files they were given (001 §H; steps 104, 111). In `OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs` (step 421), each private function documented in one line citing spec 0050 S12.2: (1) Shared with AT-1, so one composition exists (AGENTS.md 'Reuse, never copy'): the test clock and the start screen `buildOpticsMuellerKit` composes inline (step 421 (c), (d)) become `testClockAt (instant : ClockTime)`, answering a `ClockProvider` over a mutable cell and that cell, which only a build sets to move its clock, and `kitStartOver (context : AppContext) (clock : ClockProvider) (kitId : KitId) (author : KitAuthor) (folder : KitFolder)`, the `KitStartModel` and the cell its `showKit` keeps the opened kit in; `buildOpticsMuellerKit` calls them with its own values, and every AT-1 fact keeps its assertions. (2) `buildAbsorbingKit (run : FolderName)`, which later steps extend, answers the built folder, the app context, the window model and the test clock, in this order. (a) The folder is `<System.AppContext.BaseDirectory>/KitAcceptanceTests/<run>/absorbing-biaxial-noisy`, created fresh and empty, its leaf naming the kit (step 145). (b) The context is `TestAppScope.freshAppContext (FolderName \"KitAcceptanceTests\")` (steps 83, 100). (c) The clock is `testClockAt` 2026-06-01T12:00:00Z (UTC), advanced only by the build. (d) The two entry files, written outside the kit under `<System.AppContext.BaseDirectory>/KitAcceptanceTests/<run>/entries/`: each `LibraryEntryContent` (step 25) at the first version under `UserProvenance` (step 24), `sealed` then `fileText` (step 30), written as that text, UTF-8 without a byte-order mark, under its `fileName`. The material: `ofMaterialEntry` of the entry `MaterialId (Guid.Parse \"81e1d115-5d06-4337-80fd-50765a403de7\")`, `EntryName \"Absorbing triclinic crystal\"`, category `CategoryIds.crystal`, the description `The fifteen-parameter absorbing, gyrotropic, triclinic crystal of spec 0044 (AbsorbingBiaxialSample.absorbing).` and the physics `CrystalParameterPhysics (AbsorbingTriclinicCrystal AbsorbingBiaxialSample.absorbing)` (steps 354, 355; `BerremanTestSupport/AbsorbingBiaxialSample.fs:absorbing`), every other field as `MaterialProxyTests` mints its absorbing crystal material (step 355). The sample: `ofSample` of `SampleId (Guid.Parse \"af711361-2854-4b61-ade4-bdb47a184d9f\")`, `EntryName \"Absorbing triclinic plate 100 um\"`, the structure `{ films = []; substrate = Some { materialId = MaterialVersionId.firstOf <the material's id>; thickness = AbsorbingBiaxialSample.plate; orientation = PrimaryAxes }; lower = None }` (`ElementId.fs:SampleStructure`), `ThickPlate`, the description `A 100 um plate of the absorbing triclinic crystal; each observation carries its cut.` and `EmitBoth`. (e) The drop: a Library window model (`initLibraryWindow` in Browse mode, step 111) over the context's stores and import seam, as `LibraryWindowTests`' `stubContext` builds one, whose `openImportDialog` keeps the request it is given; `DropLibraryEntryFiles [ <the material file>; <the sample file> ]` opens it over `ApplyDroppedEntries` of two rows whose default action adds the entry (steps 93, 104); an import dialog model (`initImportDialog`, step 107) over `context.catalogueImports`, that request, an `onApplied` that keeps the `ImportDialogApplied` and a `requestClose` that does nothing takes `ApplyImportChoices`, and the Library window takes `LibraryImportApplied` of what was kept. The material and the sample are then in the SQLite library at version 1. (f) The kit: `kitStartOver context clock (KitId (Guid.Parse \"e15b30f6-b9ff-4a6b-a88d-b5401df2a7ae\")) (KitAuthor \"absorbing-biaxial-noisy bench\") <the folder>` and `CreateKit` of the folder (steps 177, 420). The window model is `TestAppScope.inverseModelOver context <the opened kit>` (step 421), whose `itemIds` is replaced by a test-local `ItemIdProvider` answering, call by call, Laser `9f304813-02a2-4624-b7e3-eea3e75193e7`, Polarimeter T `f7e47d80-d265-481e-b351-6e6bf48785ee`, Polarimeter R `938e1eb1-4b3d-43ea-b4a0-12c1dc5c4191`, OpticAxisCut `f61f5339-1db2-4c6c-a453-a9a9f0c11594`, OtherOpticAxisCut `10409181-5b7a-47b6-82df-525608098a65`, ZCut `1a62e3fd-a168-4c03-a653-1ed3ae71789b`, XCut `d64587f5-a4dd-4d6e-b85d-c6fecdc24f9b`, YCut `5b34e704-1b59-4aa7-9904-f5ccbbb3ef71`. (g) The naming template: `SetNamingTemplateText (ControlCaption \"{obj1}\")` and `SaveNamingTemplate` (step 273), so setups and experiments are named by the plate in Object 1 (steps 271, 286). (h) The eight items, each through `OpenAddItemForm`, `ChooseNewItemModel` of the form's offer, `SetNewItemLabel` and `AddItem` of the form's draft (step 239), every one `FixedMounting`, in this order: `Laser`, the `PresetIds.heNe633` source preset, whose 632.8 nm is `AbsorbingBiaxialSample.waveLength` (`referenceWaveLength`); `Polarimeter T` and `Polarimeter R`, the Mueller polarimeter (`ItemModelIds.muellerPolarimeterModelId`), whose noise axes default to `NoiseParam.decentLab`'s budget (steps 207, 208, 210); and the five plates `OpticAxisCut`, `OtherOpticAxisCut`, `ZCut`, `XCut` and `YCut`, each the form's `StackSampleChoice` of the dropped sample (step 239). No parameter state is set: every parameter stays known at its default. (i) The table: `AssignSlot` (step 263) puts `Laser` in `src`, `OpticAxisCut` in `sample` and `Polarimeter T` in `det` (`TableAndElementRotationView.fs:initInverse`); then `AddElement Detector` adds a detector, `PlaceOnBeam (<that element's id>, BeamLayout.OnReflectedBeamOf (Library.ElementId \"sample\"))` puts it on the plate's reflected ray, and `AssignSlot` puts `Polarimeter R` in it, so the plate is captured in transmission and reflection (`TableAndElementRotationView.fs:availableCaptures`). (3) `absorbingBuild`, a module-level `Lazy` of `buildAbsorbingKit (FolderName \"AT-2\")`, documented in one line: every AT-2 fact but the ensemble (step 437) reads this one build, so the build and the fit it ends with (step 436) run once per test run; xUnit runs one class's facts one at a time, and no fact writes into the built folder or changes the shared model, a fact that sends a message folding it over its own copy. Each AT-2 fact asserts what its part of the build writes, which the later parts keep. (4) The fact `AT-2 builds the absorbing-biaxial-noisy kit's library entries, items and table through the app's messages`: after the build, a second `KitProxy.create` of the built folder reads `.kit-json` holding the id above, the name `absorbing-biaxial-noisy`, the author `absorbing-biaxial-noisy bench`, created and modified at 2026-06-01T12:00:00Z, the template `{obj1}`, no import profile and no send exclusion; `readItems` the eight items with the ids, labels and models above, `FixedMounting`, revision 1 and every parameter `KnownParameter` at its default, the two polarimeters' `rotationUncertainty`, `elementUncertainty` and `throughputUncertainty` equal to `NoiseParam.decentLab.parameterAxes`' defaults and each plate's `substrate.thickness` equal to `AbsorbingBiaxialSample.plate` in metres (step 207); and `library/` holds exactly four snapshots, the material and the sample each byte-identical to its dropped file and the `heNe633` preset and the Mueller polarimeter model each byte-identical to its `Catalogue/Builtin/` file. Each assertion's message names the file and both values. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved. KitAcceptanceTests.fs MUST open OpticalConstructor.Optimization.BenchNoise for NoiseParam and its parameterAxes member; Domain holds only the detector axis descriptors.","acceptance":"After AT-2's first part lands, `KitAcceptanceTests` MUST build the absorbing-biaxial-noisy kit through the Library window's drop, the import dialog, the start screen and the kit window's messages alone: one material and one sample in the SQLite library, the kit file, eight items and a table capturing the plate in T and R, and AT-1 MUST compose its clock and start screen through the same two functions; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `AT-2 builds the absorbing-biaxial-noisy kit's library entries, items and table through the app's messages`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.","required_gates":["build","elevation","kit-acceptance","ui-smoke","ui-tests"],"gate_selection":{"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.StudyViewTests","OpticalConstructor.Ui.Tests.DataStepTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"],"tests":[{"op":"create","suite":"kit-acceptance","id":"OpticalConstructor.Ui.Tests.KitAcceptanceTests.AT-2 builds the absorbing-biaxial-noisy kit's library entries, items and table through the app's messages","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","class":"OpticalConstructor.Ui.Tests.KitAcceptanceTests","discovery_gate":"kit-acceptance","obligations":["S122-AT2-KIT-ITEMS"]}],"contracts":[],"packages":[],"checks":[]},"section":"S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 433, "anchor": "IMPLEMENT", "ac": "AC-S122c", "touches": ["OpticalConstructor.Ui.Tests"], "depends_on": [432], "how_to": "AT-2's setups and experiments come from the grid generator, one experiment per plate whose scan is the plate's part of the 44 configurations (001 §Q AT-2 'one experiment per plate, with a multi-variable scan (incidence × azimuth × T / R) that reproduces exactly `a1 @ a2 @ a3` = 44 configurations. This is the grid generator's job, checked configuration by configuration against `fullConfigurations`'; 001 §J; steps 274, 276, 281, 282, 287, 292). A plate's azimuth is its slot's R1 and its incidence its R2 (steps 371, 375: `elementOrientation` turns R1 to the azimuth and tilts R2 to the incidence). (1) `buildAbsorbingKit` (step 432) continues, through the window's messages alone, in three grids, each over a fresh draft (`ExpNew`) and a fresh grid panel (`OpenSetupGrid`, then `CloseSetupGrid` after its `GenerateSetupGrid` of `model.setupGrid`): (a) `OpticAxisCut`, A1's four azimuths read in T, then A2's incidence × azimuth read in T and R: `ExpChooseElement (Library.ElementId \"sample\")`, `ExpChooseVariable` of R1, the range 0…67.5° over 4 points (`ExpSetRangeMin`, `ExpSetRangeMax`, `ExpSetRangePoints`), `ExpChooseMeasurement` of transmission and `ExpAddScanBlock`; then the sample's R2 over 20…60° in 3 points, `ExpAddScanAxis`, the sample's R1 over 0…90° in 2 points and `ExpChooseMeasurement` of both; the grid toggles `OpticAxisCut` on `sample` (`ToggleSetupGridItem`). (b) `OtherOpticAxisCut`, A1's four azimuths read in T: the sample's R1 over 0…67.5° in 4 points, `ExpChooseMeasurement` of transmission; the grid toggles `OtherOpticAxisCut`. (c) The three principal cuts, A3's incidence × azimuth read in T and R: the sample's R2 over 0…45° in 2 points, `ExpAddScanAxis`, the sample's R1 over 0…90° in 2 points, `ExpChooseMeasurement` of both; the grid toggles `ZCut`, `XCut` and `YCut`, in that order. Each grid records its setups and one experiment of its draft over each (step 276), named by the template: the five setups and the five experiments are `OpticAxisCut`, `OtherOpticAxisCut`, `ZCut`, `XCut` and `YCut`, in that order. The ranges sweep exactly the design's angles (step 287's `sweptValues`: 0, 22.5, 45, 67.5; 20, 40, 60; 0, 90; 0, 45), and a block reading both branches reads T then R innermost, as A2 and A3 do. (2) The test's reading of a scan, a private function documented in one line citing spec 0050 S12.2: `configurationsOf (setups : Setup list) (experiment : Experiment) : MeasurementConfiguration list`, each point of `experiment.scan.points` in order, read on its capture (T; R; T then R for both), as `AbsorbingBiaxialSample.configuration <cut> <incidence> <azimuth> <observable>` (`BerremanTestSupport/AbsorbingBiaxialSample.fs:configuration`, the builder `a1`, `a2` and `a3` use): the incidence the point's R2 setting in degrees, or 0 when the point sets none (the plate at normal incidence), the azimuth its R1 setting, and the cut that of the plate in Object 1 of the experiment's setup by the test's table `OpticAxisCut` to `AbsorbingBiaxialSample.opticAxisCut`, `OtherOpticAxisCut` to `otherOpticAxisCut`, `ZCut` to `ZCut`, `XCut` to `XCut` and `YCut` to `YCut`. (3) The fact `AT-2's grid generator records one experiment per plate whose multi-variable scan reproduces a1 @ a2 @ a3 configuration by configuration`: after the build, a second `KitProxy.create` of the built folder reads exactly the five setups, each holding `Laser` in `src`, its plate in `sample`, `Polarimeter T` in `det` and `Polarimeter R` on the plate's reflected ray, and exactly the five experiments, in that order, each over its setup at revision 1, `ScienceRun` and no session; `OpticAxisCut`'s scan holds two blocks and every other one block; the experiments' `configurationsOf` joined in kit order hold 16, 4, 8, 8 and 8 configurations and equal, configuration by configuration, `(a1 |> List.take 4) @ a2 @ (a1 |> List.skip 4) @ a3`, the 44 of `fullConfigurations` with each plate's together; and the dropped sample's substrate thickness is `AbsorbingBiaxialSample.plate` and the `Laser` preset's wavelength `AbsorbingBiaxialSample.waveLength`, the plate and wavelength `configuration` builds with. A mismatch names the experiment, the configuration's position and both configurations. The step-432 fact keeps its assertions.", "acceptance": "After AT-2's second part lands, the build MUST record through three grids the five setups and one experiment per plate, whose scans read in kit order MUST equal `fullConfigurations` with each plate's configurations together, configuration by configuration; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `AT-2's grid generator records one experiment per plate whose multi-variable scan reproduces a1 @ a2 @ a3 configuration by configuration`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "kit-acceptance", "ui-smoke", "ui-tests"], "gate_selection": {"kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.StudyViewTests", "OpticalConstructor.Ui.Tests.DataStepTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"], "tests": [{"op": "create", "suite": "kit-acceptance", "id": "OpticalConstructor.Ui.Tests.KitAcceptanceTests.AT-2's grid generator records one experiment per plate whose multi-variable scan reproduces a1 @ a2 @ a3 configuration by configuration", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs", "class": "OpticalConstructor.Ui.Tests.KitAcceptanceTests", "discovery_gate": "kit-acceptance", "obligations": ["S122-AT2-SETUPS"]}], "contracts": [], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 434, "anchor": "IMPLEMENT", "ac": "AC-S122d", "touches": ["OpticalConstructor.Ui.Tests"], "depends_on": [433], "how_to": "AT-2's data are the harness's noisy observations, written as kit data files through the observation profile and read back through it (001 §Q AT-2 'Data: for each of the five seeds, the observations come from the EXISTING `noisyObserveAbsoluteWith forward absorbing NoiseParam.decentLab seed fullConfigurations`; they are written as kit data files under `data/absorbing-biaxial-noisy/data/` through the Mueller-matrix import profile, committed with the kit, and read back through the same profile; the test regenerates them from the seeds and requires the committed files byte-identical'; steps 301, 317-320, 340). The observation file is what the bench's instrument writes, so the build writes it into the kit's `data/`, as AT-1's lab files lie there, and the app attaches it in place (step 134). Each private function is documented in one line citing spec 0050 S12.2. (1) `noisyObservationsOf (seed : NoiseSeed) : MuellerObservation list`: `noisyObserveAbsoluteWith (MuellerInverse.createBerremanForward (fun (p : AbsorbingTriclinicParameters) -> p.opticalProperties) BiaxialSample.solverParameters) AbsorbingBiaxialSample.absorbing NoiseParam.decentLab seed AbsorbingBiaxialSample.fullConfigurations` (step 340; the forward `AbsorbingBiaxialNoisyTests` draws with, step 334), an `Error` failing the fact naming the seed and the error. `plateLabelOf (cut : SampleCut) : ItemLabel` is step 433's table read the other way. `observationFileOf (seed : NoiseSeed) : KitFileText` is `KeyedObservation.observationFileText` (step 301) of `noisyObservationsOf seed` in the harness's order, each keyed `DataRowKey` of its plate's label, an `Error` failing the fact. (2) `buildAbsorbingKit` continues: for each seed of `AbsorbingBiaxialSample.noisySeeds` (step 431) in order, the built folder's `data/noisy-observations-seed-<n>.csv`, `n` the seed's value, is written with the text of `observationFileOf seed` exactly (LF, no byte-order mark: the text's own); then, through the window's messages, `SplitByColumn (FileName <seed 1's file, absolute>, ImportProfileName.muellerObservations)` (step 319; the profile splits by `sample`, step 317), whose five groups are each `ExperimentForGroup` of the experiment its key names (step 318 (b)), and `MatchByTemplate` (step 320), which records the file in place and gives each experiment `KeyedDataRows` of its key. The other four files stay in `data/` unattached: the ensemble attaches them in turn (step 437), and the equality of step 438 compares them. (3) The fact `AT-2 writes each seed's noisy observations through the Mueller-matrix observation profile and attaches seed 1's to its plates`: after the build, the built folder's `data/` holds exactly the five files, each byte-identical to `observationFileOf` of its seed regenerated in the fact, and each read back by `parseMuellerObservations` (step 301) to its seed's observations keyed by plate: every configuration equal and every `measured.element i j` equal exactly to `noisyObservationsOf`'s; a second `KitProxy.create` reads each experiment with `dataOpt` the attachment `data/noisy-observations-seed-1.csv` at that file's SHA-256, profile `Mueller-matrix observations`, `KeyedDataRows (DataRowKey <the experiment's name>)` and no exclusion; and the window's `experimentData.readMapped` (step 305) reads each to `ObservationPoints` of its plate's seed-1 observations in file order. The step-432 and step-433 facts keep their assertions.", "acceptance": "After AT-2's third part lands, the build MUST write the five seeds' observation files into the kit's `data/` through `KeyedObservation.observationFileText`, each reading back through the profile to its seed's observations exactly, and attach seed 1's file in place to the five experiments by its `sample` key; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `AT-2 writes each seed's noisy observations through the Mueller-matrix observation profile and attaches seed 1's to its plates`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "kit-acceptance", "ui-smoke", "ui-tests"], "gate_selection": {"kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.StudyViewTests", "OpticalConstructor.Ui.Tests.DataStepTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"], "tests": [{"op": "create", "suite": "kit-acceptance", "id": "OpticalConstructor.Ui.Tests.KitAcceptanceTests.AT-2 writes each seed's noisy observations through the Mueller-matrix observation profile and attaches seed 1's to its plates", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs", "class": "OpticalConstructor.Ui.Tests.KitAcceptanceTests", "discovery_gate": "kit-acceptance", "obligations": ["S122-AT2-DATA"]}], "contracts": [], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 435, "anchor": "IMPLEMENT", "ac": "AC-S122e", "touches": ["OpticalConstructor.Ui.Tests"], "depends_on": [434], "how_to": "AT-2's study and its two identity assertions (001 §Q AT-2 'Study: open the material with all 15 components `Unknown` (`MaterialScope` across the five plates); start = `perturbedStart`, box = `searchBox`'; 'Assertions, cheap to expensive: 1. Data identity: the observations the study loads equal the harness's, exactly. 2. Model identity: the generated parameter axes equal `AbsorbingTriclinicParameters.axes`, and the study's residual vector at `perturbedStart` equals the harness's `throughputResidualFor` vector (≤ 1e-12 relative)'; steps 361, 362, 379, 387, 409). The box is the harness's: the nonlinear engine's scaled unit is a parameter's bounds' span over twice `studySearchBox.halfWidth` (step 387), so bounds of ± `searchBox.halfWidth` times the harness's scale make its unit the harness's scale. Each private function is documented in one line citing spec 0050 S12.2. (1) `buildAbsorbingKit` continues: `StudyCommand (CreateStudy (StudyName \"AbsorbingTriclinic\", <the five experiments in kit order>))`, `StudyCommand (OpenMaterial (AbsorbingTriclinic, MaterialVersionId.firstOf <the material's id>))` (steps 366, 410), then, for each generated axis `a` of the opened copy's `crystal.parameterAxes` (step 361) and the axis `r` at its position in `AbsorbingTriclinicParameters.axes`, `StudyCommand (SetOpenedMaterialParameter (AbsorbingTriclinic, <that version>, { name = a.name; state = UnknownParameter { start = s; bounds = { lower = s − h; upper = s + h }; priorOpt = None } }))` (step 409), `s` being `a.parameterValueOf (AbsorbingTriclinicCrystal AbsorbingBiaxialSample.perturbedStart)` and `h` `AbsorbingBiaxialSample.searchBox.halfWidth` times `r.read` of `(AbsorbingBiaxialSample.absorbingScalingAround AbsorbingBiaxialSample.perturbedStart).scale`, each in the parameter's own unit. No scope is set: a material component's scope is `MaterialScope` (step 362). No fit runs yet. (2) Shared with AT-1, so one composition exists: the study residual at its start point that step 430's fact composes inline becomes `studyResidualAtStart (model : TableAndElementRotationModel) (study : StudyName) : Result<ResidualVector, StudyForwardError>`, `prefitWith`, `dataWith` and `residualWith` over `model.studyForwardContext` and `parameterLayoutWith`'s layout at its `startVector` (steps 372, 377-379), which step 430's fact now calls with its assertions kept; and its first half, `studyDataOf (model : TableAndElementRotationModel) (study : StudyName) : Result<StudyData, StudyForwardError>`, the `prefitWith` and `dataWith` it calls. (3) `byPlate (observations : MuellerObservation list) : MuellerObservation list`: the observations of each plate together, plate by plate in kit order and each plate's in their own order, which is the order the study reads seed 1's file in. (4) The fact `AT-2's study opens the material across the five plates, loads the harness's observations exactly, and its residual at perturbedStart is the harness's`: after the build, a second `KitProxy.create` reads `AbsorbingTriclinic.study-json` holding the five experiments, one opened material at version 1 whose fifteen components are `UnknownParameter` as set, no link and no session, and the window's study answers `scopeOf` `MaterialScope` for each component. Model identity, the axes: the opened copy's generated axes have the fifteen names and field cases of `AbsorbingTriclinicParameters.axes` in its order, and at each position the generated read of `AbsorbingTriclinicCrystal perturbedStart` equals the record axis's read of `perturbedStart` exactly. Data identity: `studyDataOf`'s runs, in study order, hold only `ObservationRow`s, whose observations equal `byPlate (noisyObservationsOf (List.head noisySeeds))` (step 434) in number and order, every configuration equal and every `measured.element i j` equal exactly. Model identity, the residual: `studyResidualAtStart` answers a vector of 704 entries (16 per observation), entry k within 1e-12 · max(1, |h_k|) of entry `h_k` of `MuellerFitting.throughputResidualFor <step 434's forward> (byPlate <those observations>) (absorbingScalingAround perturbedStart)` at the zero scaled vector: step 379's layout, every run's element entries and then every row's throughput, is that harness vector's. Each mismatch names the position and both values. The earlier facts keep their assertions.", "acceptance": "After AT-2's study lands, the build MUST create the study over the five experiments, open the material and free its fifteen components from `perturbedStart` within the harness's box, the generated axes MUST equal `AbsorbingTriclinicParameters.axes`, the observations the study loads MUST equal the harness's exactly, and its residual at the start point MUST equal `throughputResidualFor`'s within 1e-12 relative, AT-1's Send fact composing its residual through the same function; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `AT-2's study opens the material across the five plates, loads the harness's observations exactly, and its residual at perturbedStart is the harness's`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "kit-acceptance", "ui-smoke", "ui-tests"], "gate_selection": {"kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.StudyViewTests", "OpticalConstructor.Ui.Tests.DataStepTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"], "tests": [{"op": "create", "suite": "kit-acceptance", "id": "OpticalConstructor.Ui.Tests.KitAcceptanceTests.AT-2's study opens the material across the five plates, loads the harness's observations exactly, and its residual at perturbedStart is the harness's", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs", "class": "OpticalConstructor.Ui.Tests.KitAcceptanceTests", "discovery_gate": "kit-acceptance", "obligations": ["S122-AT2-STUDY"]}], "contracts": [], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 436, "anchor": "IMPLEMENT", "ac": "AC-S122f", "touches": ["OpticalConstructor.Ui.Tests"], "depends_on": [435], "how_to": "AT-2's study runs through the study engine, and one seed's recovery is judged by the noisy suite's own bands (001 §Q AT-2 '3. Fit: one seed through the study engine recovers the 15 constants and the derived quantities (birefringences, isotropic absorption) within the bands `AbsorbingBiaxialNoisyTests` asserts'; 001 §1 'the study and its fit runs'; steps 386, 387, 391, 393, 407, 431). Each private function is documented in one line citing spec 0050 S12.2. (1) Shared with AT-1, so one composition exists (AGENTS.md 'Reuse, never copy'): the fit hosting step 427 (2) composes inline (the shell's `StudyFitJobHost.posting` whose `post` runs its job at once, recording `StudyFit (StudyFitProgressed _)` and `StudyFit (StudyFitEnded _)`, the wait on a `ManualResetEventSlim`, never a sleep, then the recorded messages passed through the update in order) becomes `runStudyFitThroughShell (model : TableAndElementRotationModel) (request : StudyFitRequest) (deadline : TimeSpan) : TableAndElementRotationModel`, which AT-1's build calls with its sixty seconds and AT-2's with 1800 seconds (one fifteen-parameter fit takes about three minutes, 001 §1b); a fit that does not end by its deadline fails the fact naming the request. Every AT-1 fact keeps its assertions. (2) `buildAbsorbingKit` ends: the test clock moves to 2026-06-01T12:01:00Z, then `runStudyFitThroughShell` of `{ study = AbsorbingTriclinic; stage = JointStage; calibrationUse = CalibrationHeldFixed }` writes `AbsorbingTriclinic@20260601T120100Z.fitrun-json`: the study's unknowns are a material's, so `engineWith` chooses the nonlinear engine (step 386), one start (`settings.starts`, 1, step 382) at the components' starts within their bounds (step 387), its deviates `UniformDeviateProvider.fromSeed (NoiseSeed 1)` (step 393). (3) `assertAbsorbingRecovery (study : Study) (run : FitRun) : unit`: the recovered crystal is the `p` of `study.promotedMaterialWith run (MaterialVersionId.firstOf <the material's id>) <the material entry of step 432>` (step 407), which answers that entry with the physics `CrystalParameterPhysics (AbsorbingTriclinicCrystal p)`, any other answer failing the fact naming it; then `absorbingBandBreaches (fun q -> RelativeError.between (q.valueIn p) (q.valueIn AbsorbingBiaxialSample.absorbing))` (step 431; the relative error `statisticsFor` measures a bias by, step 341) is empty, the message naming every breach's `describe` and the run's chi-squared. Step 439 calls it too. (4) The fact `AT-2's study engine recovers one seed's fifteen constants and derived quantities within the bands AbsorbingBiaxialNoisyTests asserts`: after the build (`absorbingBuild`, step 432), `readFitRuns AbsorbingTriclinic` (step 384) holds exactly that one run: `JointStage` with `CalibrationHeldFixed`, `NonlinearStudyEngine`, one member that converged, and fifteen entries, the opened material's components in the axes' order, each starting at `perturbedStart`'s value; and `assertAbsorbingRecovery` of the stored study and that run holds. The earlier facts keep their assertions.", "acceptance": "After AT-2's fit lands, the build MUST end by running the study through the shell's fit host into one nonlinear fit run, and the crystal it recovers MUST hold every reported quantity within the noisy suite's bands through `absorbingBandBreaches`, AT-1 hosting its fits through the same function; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `AT-2's study engine recovers one seed's fifteen constants and derived quantities within the bands AbsorbingBiaxialNoisyTests asserts`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "kit-acceptance", "ui-smoke", "ui-tests"], "gate_selection": {"kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.StudyViewTests", "OpticalConstructor.Ui.Tests.DataStepTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"], "tests": [{"op": "create", "suite": "kit-acceptance", "id": "OpticalConstructor.Ui.Tests.KitAcceptanceTests.AT-2's study engine recovers one seed's fifteen constants and derived quantities within the bands AbsorbingBiaxialNoisyTests asserts", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs", "class": "OpticalConstructor.Ui.Tests.KitAcceptanceTests", "discovery_gate": "kit-acceptance", "obligations": ["S122-AT2-FIT"]}], "contracts": [], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 437, "anchor": "IMPLEMENT", "ac": "AC-S122g", "touches": ["OpticalConstructor.Ui.Tests"], "depends_on": [436], "how_to": "AT-2's full ensemble, on demand (001 §Q AT-2 '4. Full five-seed ensemble (same statistics through the reused `statisticsFor`): marked xUnit v3 `Explicit`, so it runs on demand only. It costs the existing test's ~16 minutes'; `.gates/OpticalConstructor/kit-acceptance.gates`: 'AT-2's five-seed ensemble is xUnit v3 Explicit, so skips are allowed'). The five seeds are five measurements of the same plates, so the kit keeps one experiment per plate and re-attaches each seed's file to them in turn, through the same messages that attached seed 1's (step 434). The fact `AT-2's five-seed ensemble through the study engine keeps every reported quantity's scatter within the noisy suite's bands`, carrying `[<Fact(Explicit = true)>]` and the kit-acceptance trait, documented in one line citing spec 0050 S12.2: (1) `buildAbsorbingKit (FolderName \"AT-2-ensemble\")`, its own build and not `absorbingBuild`, because it re-attaches data; the build ends with seed 1's fit run (step 436). (2) For each later seed of `noisySeeds`, the k-th of them (k = 2 to 5), in order: the test clock moves to 2026-06-01T12:0k:00Z; `SplitByColumn (FileName <its file, absolute>, ImportProfileName.muellerObservations)` and `MatchByTemplate` give each experiment that file's rows of its key (steps 318 (b), 320: a matched group's experiment takes the keyed attachment); and `runStudyFitThroughShell` of step 436's request writes `AbsorbingTriclinic@20260601T120k00Z.fitrun-json`. (3) The five runs' recovered crystals, each read through `promotedMaterialWith` as `assertAbsorbingRecovery` reads one, in seed order, give `table = absorbingReportedQuantities |> List.map (statisticsFor AbsorbingBiaxialSample.absorbing <the five crystals>)` (steps 341, 431). Every row's scatter is above zero (the noise reached the fit, the check the noisy suite makes first), and `absorbingBandBreaches (fun q -> <the scatter of rowFor table q.name>)` is empty, an `Error` of `rowFor` failing the fact. The noisy suite's bias and ordering statements stay in `AbsorbingBiaxialNoisyTests`, the one place they are asserted. The kit-acceptance gate discovers the fact and skips it; it runs on demand through xUnit v3's explicit option.", "acceptance": "After the ensemble lands, `KitAcceptanceTests` MUST hold an xUnit v3 `Explicit` fact that re-attaches seeds 2 to 5 through the split messages, fits each through the shell, and keeps every reported quantity's scatter above zero and within the bands through `statisticsFor` and `absorbingBandBreaches`; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, discovering `AT-2's five-seed ensemble through the study engine keeps every reported quantity's scatter within the noisy suite's bands` without running it, its count unchanged; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "kit-acceptance", "ui-smoke", "ui-tests"], "gate_selection": {"kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.StudyViewTests", "OpticalConstructor.Ui.Tests.DataStepTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"], "tests": [{"op": "create", "suite": "kit-acceptance", "id": "OpticalConstructor.Ui.Tests.KitAcceptanceTests.AT-2's five-seed ensemble through the study engine keeps every reported quantity's scatter within the noisy suite's bands", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs", "class": "OpticalConstructor.Ui.Tests.KitAcceptanceTests", "discovery_gate": "kit-acceptance", "obligations": ["S122-AT2-ENSEMBLE"]}], "contracts": [], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number":438,"anchor":"IMPLEMENT","ac":"AC-S122h","touches":["OpticalConstructor.Ui.Tests"],"depends_on":[437],"how_to":"The reference kit is committed as AT-2's build writes it, once, and never by hand (001 §Q 'Section 12 creates them by running the build below once, through the app's own folder `KitProxy`, and commits the result. They are never hand-written'; 001 §S12 'create the committed kits … `data/absorbing-biaxial-noisy/` (with AT-2's five generated observation files)'; 001 §1). (1) Shared with AT-1: the file-by-file comparison step 428's fact makes inline (the two folders' relative paths, `.oc/` left out of both, then each file's bytes, a difference naming the built folder's absolute path, the first differing relative path and why: missing, extra or different bytes) becomes the private `assertSameKitFiles (built : KitFolder) (other : KitFolder) : unit`, documented in one line citing spec 0050 S12.2, which step 428's and step 430's facts call, their assertions kept. (2) The fact `the built absorbing-biaxial-noisy kit equals the committed kit file by file` in `KitAcceptanceTests`: over `absorbingBuild` (step 432), `CommittedKit.AbsorbingBiaxialNoisyKit.tryFindFolder` (step 431) answers the committed folder, `None` failing the fact naming the built folder; then `assertSameKitFiles` of the built folder and it: every kit file at the root, every file under `library/` and every file under `data/`, the five observation files included, so the committed observations are what the seeds regenerate (001 §Q AT-2). It reads the committed kit and writes nothing there (.spec-md §4 'Tests' data'). (3) The committed kit, created by this step once: run the fact (`kit-acceptance`, filtered to it); it fails, because `data/absorbing-biaxial-noisy/` does not exist, and names its built folder; copy every file of that folder except those under `.oc/` into `data/absorbing-biaxial-noisy/`, keeping their relative paths and bytes; run the fact again, and it passes. The files are the kit file, the eight `<label>.item-json`, the five `<plate>.setup-json`, the five `<plate>.experiment-json`, `AbsorbingTriclinic.study-json`, `AbsorbingTriclinic@20260601T120100Z.fitrun-json`, the five `data/noisy-observations-seed-<n>.csv`, and `library/`'s four snapshots, each `library/<id>@v1.<kind>-json`: the material `81e1d115-5d06-4337-80fd-50765a403de7`, the sample `af711361-2854-4b61-ade4-bdb47a184d9f`, and the `heNe633` preset and the Mueller polarimeter model under the GUIDs the built-in catalogue froze (steps 20, 209). All are LF text, which `.gitattributes`' `* text=auto eol=lf` keeps byte-identical; `git check-ignore` matches none of them, and `/data/*/.oc/` stays ignored (.spec-md §10.6). (4) `AGENTS.md`, the gotcha step 428 adds ('The reference kits are AT-1's and AT-2's output, never hand-edited'): its sentence on the optics-mueller kit gains, in no more than one line, that `data/absorbing-biaxial-noisy/` is exactly what the AT-2 build writes, its five observation files included, and that a change to what the build writes re-runs `the built absorbing-biaxial-noisy kit equals the committed kit file by file` and re-commits the files it names in the same step. The bullet stays within four lines, and nothing else in the file changes.","acceptance":"After the kit is committed, `data/absorbing-biaxial-noisy/` MUST hold exactly the kit files, library snapshots and five observation files AT-2's build writes, `the built absorbing-biaxial-noisy kit equals the committed kit file by file` MUST pass, and AGENTS.md's reference-kit gotcha MUST name the AT-2 kit; AT-1's equality and Send facts MUST compare through `assertSameKitFiles`; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `the built absorbing-biaxial-noisy kit equals the committed kit file by file`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.","required_gates":["build","elevation","kit-acceptance","ui-smoke","ui-tests"],"gate_selection":{"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.StudyViewTests","OpticalConstructor.Ui.Tests.DataStepTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","AGENTS.md","data/absorbing-biaxial-noisy/.kit-json","data/absorbing-biaxial-noisy/Laser.item-json","data/absorbing-biaxial-noisy/Polarimeter T.item-json","data/absorbing-biaxial-noisy/Polarimeter R.item-json","data/absorbing-biaxial-noisy/OpticAxisCut.item-json","data/absorbing-biaxial-noisy/OtherOpticAxisCut.item-json","data/absorbing-biaxial-noisy/ZCut.item-json","data/absorbing-biaxial-noisy/XCut.item-json","data/absorbing-biaxial-noisy/YCut.item-json","data/absorbing-biaxial-noisy/OpticAxisCut.setup-json","data/absorbing-biaxial-noisy/OtherOpticAxisCut.setup-json","data/absorbing-biaxial-noisy/ZCut.setup-json","data/absorbing-biaxial-noisy/XCut.setup-json","data/absorbing-biaxial-noisy/YCut.setup-json","data/absorbing-biaxial-noisy/OpticAxisCut.experiment-json","data/absorbing-biaxial-noisy/OtherOpticAxisCut.experiment-json","data/absorbing-biaxial-noisy/ZCut.experiment-json","data/absorbing-biaxial-noisy/XCut.experiment-json","data/absorbing-biaxial-noisy/YCut.experiment-json","data/absorbing-biaxial-noisy/AbsorbingTriclinic.study-json","data/absorbing-biaxial-noisy/AbsorbingTriclinic@20260601T120100Z.fitrun-json","data/absorbing-biaxial-noisy/data/noisy-observations-seed-1.csv","data/absorbing-biaxial-noisy/data/noisy-observations-seed-2.csv","data/absorbing-biaxial-noisy/data/noisy-observations-seed-3.csv","data/absorbing-biaxial-noisy/data/noisy-observations-seed-4.csv","data/absorbing-biaxial-noisy/data/noisy-observations-seed-5.csv","data/absorbing-biaxial-noisy/library"],"tests":[{"op":"create","suite":"kit-acceptance","id":"OpticalConstructor.Ui.Tests.KitAcceptanceTests.the built absorbing-biaxial-noisy kit equals the committed kit file by file","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","class":"OpticalConstructor.Ui.Tests.KitAcceptanceTests","discovery_gate":"kit-acceptance","obligations":["S122-COMMITTED-KIT"]}],"contracts":[],"packages":[],"checks":[]},"section":"S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number":439,"anchor":"IMPLEMENT","ac":"AC-S122i","touches":["OpticalConstructor.Ui.Tests"],"depends_on":[438],"how_to":"AT-2 proves the read path on the committed kit (001 §Q 'Open: the test then opens the COMMITTED kit read-only through the real folder `KitProxy`, against an EMPTY library database, and runs its study from there. This proves the read path: the library snapshot, the relative paths and hashes, and the data import. A test never writes into `data/`'; 001 §Q AT-2 'the test regenerates them from the seeds and requires the committed files byte-identical'; the S12.2 brief 'a read-only open of the committed kit against an empty library runs 1-3'; .spec-md §3.12 'A read-only open writes nothing'). Each private function is documented in one line citing spec 0050 S12.2. (1) Shared with AT-1: the read-only open step 429's fact composes inline (the committed folder's relative paths and bytes recorded first; `TestAppScope.emptyLibraryAppContext (FolderName \"KitAcceptanceTests\")`; a start screen sending `OpenKitReadOnly` of the committed folder; the window model `TestAppScope.inverseModelOver` of the context and the opened kit) becomes `openCommittedReadOnly (kit : CommittedKit)`, answering the context, the window model and the recording, and the closing check becomes `assertCommittedUnchanged (kit : CommittedKit) (recorded : <the recording>) : unit`, the folder's relative paths and bytes equal to the recorded ones; step 429's fact calls both with its assertions kept. (2) The fact `the committed absorbing-biaxial-noisy kit opens read-only against an empty library, writes nothing, and reproduces AT-2's data, model and fit`: (a) Over `openCommittedReadOnly AbsorbingBiaxialNoisyKit`, each committed `data/noisy-observations-seed-<n>.csv` is byte-identical to `observationFileOf` of its seed regenerated now (step 434). (b) The library snapshot: the context's material, sample, source and item-model stores list no entry, while each of the eight items resolves its model through the kit's snapshots (`model.tryItemModelChoice`, steps 142, 222, 263), each plate's to the dropped sample, whose material version resolves from the kit's snapshot of the material. (c) The kit: the 8 items, the 5 setups, the 5 experiments, the study and its one fit run; every experiment's attachment status is unchanged at its recorded hash (`attachmentStatus`, step 134). (d) Data identity and model identity as step 435 asserts them, over this window model (`studyDataOf`, `studyResidualAtStart`, `byPlate (noisyObservationsOf (List.head noisySeeds))`). (e) The fit, through the study engine itself, because a read-only kit refuses the fit run's write (steps 185, 393): `StudyFitParam.runFit` (step 391) of `{ study = AbsorbingTriclinic; stage = JointStage; calibrationUse = CalibrationHeldFixed }` under `UnwatchedIterations` (step 380), the parameter being `model.studyForwardContext`, a clock fixed at 2026-06-01T12:02:00Z, the solver and deviates `StudyFitEnvironment.create` composes (step 393) and `model.kitFitRuns`, answers `Ok run` of `NonlinearStudyEngine`, and `assertAbsorbingRecovery` of the window's study and that run holds (step 436). (f) Afterwards `assertCommittedUnchanged`: nothing was written, no lock, stamp, snapshot or cache (.spec-md §3.12). No product code changes. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After AT-2's read path lands, the committed kit MUST open read-only against an empty library, its observation files MUST be what the seeds regenerate byte for byte, every item MUST resolve through the kit's snapshots, every attachment MUST load at its hash, the study MUST reproduce data identity, model identity and, through `StudyFitParam.runFit`, a recovery within the bands, and the committed folder MUST be left unchanged, AT-1's read path composing through the same two functions; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `the committed absorbing-biaxial-noisy kit opens read-only against an empty library, writes nothing, and reproduces AT-2's data, model and fit`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.","required_gates":["build","elevation","kit-acceptance","ui-smoke","ui-tests"],"gate_selection":{"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.StudyViewTests","OpticalConstructor.Ui.Tests.DataStepTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"],"tests":[{"op":"create","suite":"kit-acceptance","id":"OpticalConstructor.Ui.Tests.KitAcceptanceTests.the committed absorbing-biaxial-noisy kit opens read-only against an empty library, writes nothing, and reproduces AT-2's data, model and fit","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","class":"OpticalConstructor.Ui.Tests.KitAcceptanceTests","discovery_gate":"kit-acceptance","obligations":["S122-AT2-READ-PATH"]}],"contracts":[],"packages":[],"checks":[]},"section":"S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 440, "anchor": "IMPLEMENT", "ac": "AC-S122j", "touches": ["OpticalConstructor.Ui.Tests"], "depends_on": [439], "how_to": "AT-2 proves the exchange path as AT-1 does (001 §Q 'Send: the built kit is zipped with `SendKit`, unzipped elsewhere and reopened; the reopened kit and the study's residual vector at its start point equal the built ones'; 001 §H; step 430). Each private function is documented in one line citing spec 0050 S12.2. (1) Shared with AT-1: the round trip step 430's fact composes inline (the window model's `kitShell` holding `KitArchiveProxy.create ()` and `KitArchiveJobHost.immediate` recording `SendKitProgressed` and `SendKitEnded`; `SendKit` of a zip named after the kit in the run folder, outside the kit; a start screen over the build's context sending `OpenKitZip` into a fresh, empty folder of the kit's name, its recorded messages passed through `updateKitStart`; the reopened window model `TestAppScope.inverseModelOver` of the context and the reopened kit) becomes `sendAndReopen (context : AppContext) (model : TableAndElementRotationModel) (run : FolderName)`, answering the reopened folder and its window model, and step 430's fact calls it with its assertions kept. (2) The fact `the absorbing-biaxial-noisy kit travels through Send kit and Open kit from zip unchanged, its study's residual at the start point included`: over `absorbingBuild` (step 432), whose model `sendAndReopen` folds over its own copy, under the run folder `AT-2-send`: `SendKitEnded (Ok _)` and a zip holding no `.oc/` (step 198); `assertSameKitFiles` (step 438) of the built folder and the reopened one: every kit file, `library/**` and `data/**`, the five observation files included; and `studyResidualAtStart` (step 435) of `AbsorbingTriclinic` over the reopened window model equals the built one's element for element, both answering `Ok`. Nothing is written under `data/`; no product code changes.", "acceptance": "After AT-2's round trip lands, the built kit sent through `SendKit` and reopened through `OpenKitZip` MUST equal the built kit file by file, `.oc/` excluded, and its study's residual vector at the start point MUST equal the built kit's element for element, AT-1's round trip composing through the same function; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, including `the absorbing-biaxial-noisy kit travels through Send kit and Open kit from zip unchanged, its study's residual at the start point included`, the count rising by 1; and build, elevation and the twenty-one s42 invariants MUST pass.", "required_gates": ["build", "elevation", "kit-acceptance", "ui-smoke", "ui-tests"], "gate_selection": {"kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.StudyViewTests", "OpticalConstructor.Ui.Tests.DataStepTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs"], "tests": [{"op": "create", "suite": "kit-acceptance", "id": "OpticalConstructor.Ui.Tests.KitAcceptanceTests.the absorbing-biaxial-noisy kit travels through Send kit and Open kit from zip unchanged, its study's residual at the start point included", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs", "class": "OpticalConstructor.Ui.Tests.KitAcceptanceTests", "discovery_gate": "kit-acceptance", "obligations": ["S122-AT2-SEND"]}], "contracts": [], "packages": [], "checks": []}, "section": "S12.2 -- AT-2 and the absorbing-biaxial-noisy reference kit"}
{"number": 441, "anchor": "IMPLEMENT", "ac": "AC-S131a", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [440], "how_to": "A pulled version says which bytes of its record it was built from, so that updating a source can mint a version only where the record changed (001 §D 'Updating a source mints a NEW version when the record changed and never mutates one'; the S13.1 brief 'mints a NEW version only where a record's hash changed'; 001 §B 'Identity is GUID + version + hash'). The hash rides in the provenance, so the entry file, the database payload and a kit's snapshot of a pulled version all carry it (001 §C 'Hybrid shape'), and the library database's model and its schema stamp stay as they are (`LibraryDatabaseStore.fs`, step 62: `LibrarySchemaVersion.current` stays 1). Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Domain/LibraryEntryFiles.fs`: `SourcePullInfo` (step 24) gains `recordHash : ContentHash` directly after `record`: the SHA-256 of the record's text as the source's snapshot held it when this version was pulled, computed by `ContentHash.ofBytes` (step 123). Its field doc is one line. No other provenance case, member or field changes; `attributionOpt` (step 113), `protection` and `categoryOrigin` (step 24) read no hash. (2) `OpticalConstructor.Storage/schema/library-common.schema.json` (steps 30, 91, 405): the pulled-from-source provenance shape gains the required key `recordHash`, referencing the content-hash definition the file already holds (`^[0-9a-f]{64}$`, step 30), so a pulled provenance without it fails the schema. The entry schemas keep version 1, because no entry file holding a pulled provenance has been released (.spec-md §7; step 405's precedent). (3) Every construction of a `SourcePullInfo` sets the field, and no assertion changes: `OpticalConstructor.Tests/BuiltinCatalogue.fs`' `licensedMaterialContent` (step 113) sets `recordHash = ContentHash.ofBytes (Encoding.UTF8.GetBytes \"test/<name>\")`, the hash of its record id's text; the literals of `LibraryEntryFilesTests.fs` and `EntryFileJsonTests.fs` (steps 24, 30, 91, 113, 405) each set `ContentHash.ofBytes` of a test-local text. (4) Tests. `EntryFileJsonTests` gains `a pulled provenance keeps its record's hash through an entry file, and a file without it is refused`: a material under `SourcePullProvenance` whose `recordHash` is `ContentHash.ofBytes` of the UTF-8 bytes of `abc` (`ContentHash \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"`, step 123) round-trips content → `sealed` → `fileText` → `parseEntry` (step 30), its decoded provenance holding that hash; the same file text with the `recordHash` key removed answers `SchemaValidationErr`. `every provenance round-trips through an entry file` and `a pulled entry and its forks carry its licence's attribution, and every other provenance none` keep their assertions.", "acceptance": "After the record hash lands, `SourcePullInfo` MUST carry `recordHash : ContentHash` and `library-common.schema.json` MUST require it for a pulled provenance, with no change to the library database's model or schema stamp; constructor-unit-tests MUST pass, including `a pulled provenance keeps its record's hash through an entry file, and a file without it is refused` and the unchanged `every provenance round-trips through an entry file` and `a pulled entry and its forks carry its licence's attribution, and every other provenance none`, the count rising by 1; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/LibraryEntryFiles.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/schema/library-common.schema.json", "Berreman/OpticalConstructor/OpticalConstructor.Tests/BuiltinCatalogue.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/LibraryEntryFilesTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/EntryFileJsonTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.EntryFileJsonTests.a pulled provenance keeps its record's hash through an entry file, and a file without it is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/EntryFileJsonTests.fs", "class": "OpticalConstructor.Tests.EntryFileJsonTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RECORD-HASH"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.LibraryEntryFiles.SourcePullInfo.recordHash", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/LibraryEntryFiles.fs", "obligations": ["S131-RECORD-HASH"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 442, "anchor": "IMPLEMENT", "ac": "AC-S131b", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [441], "how_to": "The library holds a pulled-source record row beside every pulled version, and the import seam answers the versions a source's records minted, which an update re-fetches (001 §C 'What it holds: … pulled-source records (§D)'; 001 §D 'A pulled record becomes a user material version in the database, with provenance'; the S13.1 brief 'a pulled-source record row (S2.1)'). The row is derived from the version's provenance, as its facet rows are derived from its envelope (step 64), so every path that stores a version keeps it: a pull, a kit snapshot's import of a version pulled elsewhere, and the re-import of an exported one. A fork (`ForkProvenance`, step 91) belongs to the user and has no row. The database model is unchanged: step 60's `LibraryPulledSourceRow` already holds the columns. Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Domain/CatalogueImport.fs`, before `CatalogueImportProxy`: `PulledRecord = { version : LibraryVersionRef; pull : SourcePullInfo }` (`LibraryVersionRef`, step 137): one held version and the record it was pulled from. `CatalogueImportProxy` gains `pulledRecordsOf : MaterialSourceName -> Result<PulledRecord list, CatalogueImportError>`, with a one-line doc: every held version, whatever its lifecycle, whose provenance is `SourcePullProvenance` of that source, in ordinal order of the record's text, then of the entry's GUID text, then ascending by version. The in-memory double (`createInMemory`, step 95) answers it from its map's envelopes, and `CatalogueImportProxyTests`' `recordingProxy` (step 94) answers `Ok []`. (2) `OpticalConstructor.Storage/LibraryDatabaseStore.fs`, beside `facetRows` (step 64) and carrying step 62's `StorageBoundary` mark: `member this.pulledSourceRows : LibraryPulledSourceRow list` on `LibraryEntryEnvelope` answers, for a content under `SourcePullProvenance info`, one row with `EntryId` and `Version` from the content and `Source`, `RecordPath`, `SourceVersion`, `Licence` and `Citation` from the texts of `info`'s `source`, `record`, `sourceVersion`, `licence` and `citation` (step 60's columns), and none for any other provenance. `stageVersion` (step 67) makes the version's pulled-source rows exactly its envelope's `pulledSourceRows`, as it does its facet and sample-material rows; `stageRemoval`'s cascade already removes them (step 60). (3) `OpticalConstructor.Storage/CatalogueImportStore.fs`: `createInDatabase` (step 95) answers `pulledRecordsOf source` in one `database.run`: the `PulledSources` rows whose `Source` is the source's text (step 60's `Source`, `RecordPath` index), each version read through `tryStoredVersion` (step 67) and answered with its envelope's `SourcePullInfo`, in the order of (1); a row whose version is missing or whose provenance is not a pull is `LibraryRowInvalidErr` naming the entry and the version, and every `StorageError` is `ImportStoreUnavailableErr` with its `describe`, as its other fields answer (step 95). No cache, query option or other field is added. (4) Tests. `CatalogueImportContract` (step 95) gains `the pulled records of a source are its held pulled versions, by record, entry and version`, so it runs over `CatalogueImportInMemoryTests` and `CatalogueImportSqliteTests`: after `importFrom (CatalogueProxy.createBuiltIn ())`, `BuiltinCatalogue.putSealedEntries` (step 113) puts, each built with `LibraryEntryContent.ofMaterialEntry` of the catalogue's Silicon under a test-local GUID: entry A at version 1 and at version 2, both pulled from `MaterialSourceName \"Test source\"` record `b/x.yml`; entry B at version 1 pulled from `Test source` record `a/y.yml`; entry C at version 1 pulled from `Other source`; a fork of A's version 1 under its own GUID; and a user material. `pulledRecordsOf (MaterialSourceName \"Test source\")` answers exactly B v1, A v1 and A v2, in that order, each with the `SourcePullInfo` it was put with, its `recordHash` included; `Other source` answers C v1 alone; and `Unknown source` answers `[]`. `LibraryDatabaseTests` gains `a pulled version's pulled-source row is stored beside its version row, and no other version has one`: over `BuiltinCatalogue.freshLibraryDatabase ()` (step 67), `stageVersion` of a pulled envelope and of a user envelope, saved in one `run`, leaves exactly one `PulledSources` row, whose seven columns are the pulled envelope's; `stageRemoval` of that entry then leaves none.", "acceptance": "After the rows land, every stored version under `SourcePullProvenance` MUST have its pulled-source row and no other version one, and `CatalogueImportProxy.pulledRecordsOf` MUST answer a source's pulled versions with their provenance over both stores; constructor-unit-tests MUST pass, including `the pulled records of a source are its held pulled versions, by record, entry and version` over `CatalogueImportInMemoryTests` and `CatalogueImportSqliteTests` and `a pulled version's pulled-source row is stored beside its version row, and no other version has one`, the count rising by 3; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/LibraryDatabaseStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/CatalogueImportStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportProxyTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/LibraryDatabaseTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportInMemoryTests.the pulled records of a source are its held pulled versions, by record, entry and version", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportInMemoryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLED-ROWS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportSqliteTests.the pulled records of a source are its held pulled versions, by record, entry and version", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLED-ROWS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.LibraryDatabaseTests.a pulled version's pulled-source row is stored beside its version row, and no other version has one", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/LibraryDatabaseTests.fs", "class": "OpticalConstructor.Tests.LibraryDatabaseTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLED-ROWS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.CatalogueImport.PulledRecord", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "obligations": ["S131-PULLED-ROWS"]}, {"symbol": "OpticalConstructor.Domain.CatalogueImport.CatalogueImportProxy.pulledRecordsOf", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "obligations": ["S131-PULLED-ROWS"]}, {"symbol": "OpticalConstructor.Storage.LibraryDatabaseStore.LibraryEntryEnvelope.pulledSourceRows", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/LibraryDatabaseStore.fs", "obligations": ["S131-PULLED-ROWS"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 443, "anchor": "ADD_CONTRACT", "ac": "AC-S131c", "id": "SVC_BigBoy_0002", "name": "MaterialSourceProxy", "kind": "proxy", "language": "fsharp", "declaring_project": "OpticalConstructor.Domain", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [442], "actions": ["ADD_TEST OpticalConstructor.Tests.MaterialSourceProxyTests"], "how_to": "The online-source seam in Domain: its record, its in-memory double and its facts (001 §D '`MaterialSourceProxy` (search, fetch) with adapters'; 001 §P '`MaterialSourceProxy` (online sources)', 'every proxy has an in-memory stub of the same shape'; the S13.1 brief: search, fetch and update the snapshot, per adapter; .spec-md §5 `MaterialSourceProxy`; §10.2: per-file progress with Cancel). One proxy is one adapter: this section's refractiveindex.info (step 447) and S13.2's PTB and Henke sources are each a `MaterialSourceProxy`. The proxy does IO only; what a pull writes is step 444's. New `OpticalConstructor.Domain/MaterialSources.fs`, `module MaterialSources` in `namespace OpticalConstructor.Domain`, compiled directly before `CatalogueImport.fs` (step 37), because the import context carries the sources (step 444): one `<Compile>` line in `OpticalConstructor.Domain.fsproj` and no comment. It opens `MaterialLibrary`, `LibraryEntryFiles` and `System.Threading`. Its module doc and each declaration's doc are one to three lines citing spec 0050 S13.1. In order: (1) `MaterialSourceError`, an `*Error` union whose every case is `of reason : string`: `SourceSnapshotMissingErr` (the source holds no snapshot yet), `SourceRecordMissingErr` (the snapshot does not list the record), `SourceRecordUnreadableErr` (the record's page does not parse), `SourceSnapshotIoErr` (the snapshot folder could not be read or written), `SourceDownloadErr` (the source's archive could not be downloaded), `SourceArchiveInvalidErr` (the downloaded archive is not the source's database) and `UnsupportedSnapshotSchemaErr` (a snapshot stamp of another schema version), with `member this.describe : string` rendering each in step 39's form: `the source holds no snapshot: <reason>`, `the snapshot does not list the record: <reason>`, `the record could not be read: <reason>`, `the snapshot could not be read or written: <reason>`, `the source's archive could not be downloaded: <reason>`, `the archive is not the source's database: <reason>` and `the snapshot stamp has another schema version: <reason>`. (2) `MaterialSourceHit = { record : MaterialSourceRecordId; name : EntryName }` (step 24's `MaterialSourceRecordId`): one record a search finds and the name a pulled material takes. (3) `MaterialSourceQuery of string` with `.value` and `member this.filter (hits : MaterialSourceHit list) : MaterialSourceHit list`, the one search rule every adapter applies: the query's text is split on white space into words; a hit is kept when each word occurs, ignoring case (`StringComparison.OrdinalIgnoreCase`), in its name's text or in its record's text; an empty or blank query keeps every hit; kept hits keep their order. (4) `SourceMaterialRecord = { pull : SourcePullInfo; material : MaterialEntry }`: a fetched record, its pull provenance (step 24, with step 441's `recordHash`) and the material its page parses into, named by its hit, under an id the pull replaces (step 444). (5) `SourceSnapshotFileCount of int` with `.value`; `SourceSnapshotProgress = { filesDone : SourceSnapshotFileCount; filesTotal : SourceSnapshotFileCount }`, told after each file a snapshot update writes; `[<ReferenceEquality>] SourceSnapshotObserver = { reportSnapshotProgress : SourceSnapshotProgress -> unit; cancellation : CancellationToken }`, asked before each file whether the update is cancelled, the rule of `JobRunner.fs:runLoop` and of `KitArchiveObserver` (step 197), with `static member unobserved : SourceSnapshotObserver` telling nobody and never cancelled (`CancellationToken.None`); `SourceSnapshotInfo = { version : MaterialSourceVersion; files : SourceSnapshotFileCount }`; and `SourceSnapshotOutcome` = `SourceSnapshotUpdated of SourceSnapshotInfo` | `SourceSnapshotCancelled` (the update stopped before its next file and left the held snapshot as it was). (6) `[<ReferenceEquality>] MaterialSourceProxy = { sourceName : MaterialSourceName; snapshotVersion : unit -> Result<MaterialSourceVersion option, MaterialSourceError>; searchRecords : MaterialSourceQuery -> Result<MaterialSourceHit list, MaterialSourceError>; fetchRecord : MaterialSourceRecordId -> Result<SourceMaterialRecord, MaterialSourceError>; updateSnapshot : SourceSnapshotObserver -> Result<SourceSnapshotOutcome, MaterialSourceError> }`, the functional-proxy convention (AGENTS.md), each field with a one-line doc: `sourceName` is the source the adapter reads (data, not IO); `snapshotVersion` the held snapshot's version, `None` before the first update; `searchRecords` the held snapshot's catalog through the query's `filter`, `SourceSnapshotMissingErr` without a snapshot; `fetchRecord` one listed record, parsed, under the held snapshot's version, `SourceSnapshotMissingErr` without a snapshot and `SourceRecordMissingErr` for a record its catalog does not list; `updateSnapshot` replaces the held snapshot by the source's current one, reporting and reading the cancellation per file, and a cancelled or failed update keeps the held snapshot. (7) The double. `InMemorySourceRecord = { hit : MaterialSourceHit; recordHash : ContentHash; citation : EntryCitation; material : MaterialEntry }` is one record as a test publishes it. `InMemoryMaterialSource` is a sealed class whose state (the held snapshot's version and records, and the published ones the next update installs) is private and mutated only inside its members and the proxy's closures, as `InMemoryArchiveDisk` keeps its own (step 197): `static member create (name : MaterialSourceName) (licence : EntryLicence) : InMemoryMaterialSource` holds no snapshot and publishes none; `member this.publish (version : MaterialSourceVersion) (records : InMemorySourceRecord list) : unit` sets what the next update installs. `type MaterialSourceProxy with static member createInMemory (source : InMemoryMaterialSource) : MaterialSourceProxy` answers the five fields of (6) over it: `searchRecords` filters the held records' hits; `fetchRecord` answers `{ pull = { source; record; recordHash; sourceVersion = <the held version>; licence; citation }; material = { <the record's material> with name = <its hit's name> } }`; `updateSnapshot` with nothing published is `SourceDownloadErr` naming the source, and otherwise, before each published record, reads the cancellation (cancelled, it answers `SourceSnapshotCancelled` with the held snapshot unchanged) and after each reports progress; once every record is counted the published snapshot becomes the held one, and the answer is `SourceSnapshotUpdated` of its version and record count. No caching, retry, option or other field is added (.spec-md §8). Tests: new `OpticalConstructor.Tests/MaterialSourceProxyTests.fs`, `module MaterialSourceProxyTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment. Its double is `InMemoryMaterialSource.create (MaterialSourceName \"Test source\") (EntryLicence \"CC0-1.0\")`; its records are the catalogue's Silicon and Langasite (`BuiltinCatalogue.catalogueData ()`, decoded through `toMaterialEntry`), published as `Si (Silicon), Aspnes` at `main/Si/nk/Aspnes.yml` and `La3Ga5SiO14 (Langasite), Test` at `other/La3Ga5SiO14/nk/Test.yml`, with test-local hashes and citations. `a source holds no snapshot until its first update`: `snapshotVersion` answers `Ok None`, and `searchRecords` and `fetchRecord` answer `SourceSnapshotMissingErr`. `an update installs the published snapshot, reporting each record once`: after `publish` of version `2026-11-01`, `updateSnapshot` under an observer recording each progress answers `SourceSnapshotUpdated { version = MaterialSourceVersion \"2026-11-01\"; files = SourceSnapshotFileCount 2 }`, the progress reading 1 and 2 of 2, and `snapshotVersion` answers that version. `a search keeps the hits whose name or record holds every word, ignoring case`: `silicon`, `SI ASPNES` and `nk` keep, in catalog order, the hits that hold them; `aspnes langasite` keeps none; and a blank query keeps both. `a fetched record carries its pull provenance and its material under its hit's name`: `fetchRecord` of the Silicon record answers its `SourcePullInfo` (the source, the record, its hash, the held version, the licence and its citation) and Silicon's material named `Si (Silicon), Aspnes`; an unlisted record answers `SourceRecordMissingErr`. `an update cancelled before its next record keeps the held snapshot`: with `2026-11-01` held and `2026-11-04` published, a token whose source is cancelled on the first progress makes `updateSnapshot` answer `SourceSnapshotCancelled`, and `snapshotVersion` still answers `2026-11-01`. `an update with nothing published is SourceDownloadErr`: a fresh double's `updateSnapshot` answers `SourceDownloadErr`. `every material-source error renders its condition and its payload`: each case over a distinct test-local reason renders a distinct text holding it.", "acceptance": "After the seam lands, `MaterialSources.fs` MUST declare `MaterialSourceProxy` with exactly `sourceName`, `snapshotVersion`, `searchRecords`, `fetchRecord` and `updateSnapshot`, its in-memory double `MaterialSourceProxy.createInMemory` and the one search rule `MaterialSourceQuery.filter`; constructor-unit-tests MUST pass, including `a source holds no snapshot until its first update`, `an update installs the published snapshot, reporting each record once`, `a search keeps the hits whose name or record holds every word, ignoring case`, `a fetched record carries its pull provenance and its material under its hit's name`, `an update cancelled before its next record keeps the held snapshot`, `an update with nothing published is SourceDownloadErr` and `every material-source error renders its condition and its payload` under `MaterialSourceProxyTests`, the count rising by 7; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.a source holds no snapshot until its first update", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.an update installs the published snapshot, reporting each record once", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.a search keeps the hits whose name or record holds every word, ignoring case", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.a fetched record carries its pull provenance and its material under its hit's name", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.an update cancelled before its next record keeps the held snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.an update with nothing published is SourceDownloadErr", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceProxyTests.every material-source error renders its condition and its payload", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceProxyTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCE-SEAM"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceError", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceHit", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceQuery", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.SourceMaterialRecord", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.SourceSnapshotFileCount", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.SourceSnapshotProgress", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.SourceSnapshotObserver", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.SourceSnapshotInfo", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.SourceSnapshotOutcome", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceProxy", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.InMemorySourceRecord", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.InMemoryMaterialSource", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "obligations": ["S131-SOURCE-SEAM"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 444, "anchor": "IMPLEMENT", "ac": "AC-S131d", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [443], "actions": ["ADD_TEST OpticalConstructor.Tests.MaterialSourcePullTests"], "how_to": "A pulled record becomes a user material version, and updating a source re-fetches the pulled records and mints a new version only where a record changed (001 §D 'A pulled record becomes a user material version in the database, with provenance: source, record path, snapshot date or commit, licence, citation'; 'Updating a source mints a NEW version when the record changed and never mutates one'; 001 §C 'Versions are immutable'; the S13.1 brief). It REUSES the import seam's write (`CatalogueImportContext.sealEntry` and `CatalogueImportProxy.putEntryVersion`, step 94), the one path that stores a whole entry version under its own provenance and hash, as Promote to library does (step 408), and step 442's `pulledRecordsOf`, so no library verb is added. The sources live on the import context, the library-exchange seam every library window already carries (steps 101, 109, 116), so no new context is threaded. Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Domain/CatalogueImport.fs`: `CatalogueImportContext` (steps 94, 98, 104, 116, 117) gains `materialSources : MaterialSourceProxy list` (step 443), with a one-line doc: the online material sources the library pulls from, `[]` where none is composed. `OpticalConstructor.Storage/CatalogueImportStore.fs`' `create` (step 94), its signature unchanged, sets `[]`; the composition root sets the app's sources by record update (step 449), as it sets `exportFolderOpt` (step 118). (2) New `OpticalConstructor.Domain/MaterialSourcePulls.fs`, `module MaterialSourcePulls` in `namespace OpticalConstructor.Domain`, compiled directly after `CatalogueImport.fs` and before `KitLibrary.fs` (step 139): one `<Compile>` line and no comment. It opens `MaterialLibrary`, `LibraryEntryFiles`, `MaterialSources` and `CatalogueImport`. In order: (a) `MaterialSourcePullError`, an `*Error` union: `PullSourceErr of error : MaterialSourceError`, `PullImportErr of error : CatalogueImportError` and `PullEntryErr of error : LibraryEntryError`, with `member this.describe : string` rendering `the source refused: <the error's describe>`, `the library refused the pulled version: <the error's describe>` and `the pulled material could not be built: <the error's describe>`. (b) `SourcePullChange` = `PullAddedEntry` (a new user material at version 1) | `PullMintedVersion` (the record changed: its entry's next version) | `PullFoundUnchanged` (the record's hash equals its entry's newest pulled version's; nothing written) | `PullRecordAbsent` (the snapshot no longer lists the record; nothing written), each case documented, and `SourcePullResult = { record : MaterialSourceRecordId; name : EntryName; version : LibraryVersionRef; change : SourcePullChange }`, its version the one added, minted, or left as it was. (c) `SourceRefreshInfo = { snapshot : SourceSnapshotInfo; pulls : SourcePullResult list }` and `SourceRefresh` = `SourceRefreshed of SourceRefreshInfo` | `SourceRefreshCancelled`. (d) On `type CatalogueImportContext with`: `member this.pullRecord (source : MaterialSourceProxy) (record : MaterialSourceRecordId) : Result<SourcePullResult list, MaterialSourcePullError>` reads `this.proxy.pulledRecordsOf source.sourceName` (an error is `PullImportErr`) and keeps the rows of `record`. With none, it fetches the record (`source.fetchRecord`, an error `PullSourceErr`), builds `LibraryEntryContent.ofMaterialEntry VersionNumber.first (SourcePullProvenance fetched.pull) fetched.material` (step 25) under `id = this.newEntryId ()`, as a fork takes a minted id (step 94), seals it through `this.sealEntry`, puts it through `this.proxy.putEntryVersion` with `MoveLatestVersion` (either error `PullImportErr`), and answers one `PullAddedEntry` at version 1: a user entry, because `SourcePullProvenance` is `UserManaged` (step 24). With rows, each entry they name is refreshed as (e) refreshes it, in (e)'s order, and the answer lists their results; when every entry they name is retired (e), it answers `PullImportErr (ImportRejectedErr <the record and the retired entry's GUID>)` and writes nothing, because a retired material is marked active in the Materials window, never revived by a pull. (e) `member this.refreshPulls (source : MaterialSourceProxy) : Result<SourcePullResult list, MaterialSourcePullError>` reads `pulledRecordsOf source.sourceName` and takes each entry's newest pulled row (the highest version among its rows), in ordinal order of the row's record text, then of the entry's GUID text, leaving out an entry whose held latest is `InactiveEntry` (`this.proxy.tryHeldEntry`, step 94, an error `PullImportErr`), so an update never revives a material the user retired. For each it calls `source.fetchRecord` of the row's record: `SourceRecordMissingErr` answers `PullRecordAbsent` at the row's version and writes nothing, and any other error is `PullSourceErr`. A fetched `pull.recordHash` equal to the row's answers `PullFoundUnchanged` at the row's version and writes nothing. Otherwise it reads the entry's latest envelope (`this.proxy.tryLatestEnvelope`, step 116; `None` is `PullImportErr (ImportRejectedErr <the entry's GUID>)`), decodes it (`toMaterialEntry`, step 25, an error `PullEntryErr`), keeps its id, name, category and description and takes the fetched material's `physics`, builds `ofMaterialEntry <the latest's version>.next (SourcePullProvenance fetched.pull)` of it, seals it and puts it with `MoveLatestVersion`, and answers `PullMintedVersion` at that version: every held version stays as it was (001 §C), a user's later edit included, and the record's new physics becomes the latest. The first error stops it, and the writes before it stay (step 40's rule). (f) `member this.updateSourceSnapshot (source : MaterialSourceProxy) (observer : SourceSnapshotObserver) : Result<SourceRefresh, MaterialSourcePullError>`: `source.updateSnapshot observer` (an error `PullSourceErr`); `SourceSnapshotCancelled` answers `SourceRefreshCancelled` and refreshes nothing; `SourceSnapshotUpdated info` answers `SourceRefreshed { snapshot = info; pulls = <refreshPulls source> }`. It is the job Update snapshot runs (step 450). No retry, merge, cache or option is added: a pull or an update never mutates a version (.spec-md §8). Tests: new `OpticalConstructor.Tests/MaterialSourcePullTests.fs`, `module MaterialSourcePullTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, over `CatalogueImportContext.create (CatalogueImportProxy.createInMemory ()).proxy` after its `importFrom (CatalogueProxy.createBuiltIn ())`, its `newEntryId` replaced by record update with a fixed test-local GUID, and step 443's double publishing the Silicon record (`main/Si/nk/Aspnes.yml`, named `Si (Silicon), Aspnes`) at `2026-11-01` under the hash of the UTF-8 bytes of `abc`, installed by one `updateSnapshot`. `a pulled record becomes a user material at version 1 under its pull provenance`: `pullRecord` answers one `PullAddedEntry` at version 1 of the fixed GUID, named `Si (Silicon), Aspnes`; `tryLatestEnvelope` of it holds `SourcePullProvenance` of the fetched pull, `UserManaged`; and `pulledRecordsOf` answers that one version. `pulling a held record again writes nothing while it is unchanged`: a second `pullRecord` answers `PullFoundUnchanged` at version 1, and the entry holds one version. `an update that leaves a record unchanged mints no version`: with `2026-11-04` published holding the same record and hash, `updateSourceSnapshot` answers `SourceRefreshed` whose snapshot is `2026-11-04` and whose one pull is `PullFoundUnchanged` at version 1, and the entry holds one version. `an update whose record changed mints version 2 and keeps version 1`: with `2026-11-04` published holding that record under the hash of `abd` and Langasite's physics, `updateSourceSnapshot` answers `PullMintedVersion` at version 2; version 2 holds Langasite's physics under Silicon's entry id and its name, with the new pull (that hash, `2026-11-04`); and `tryHeldEnvelope` of version 1 answers the envelope it answered before. `a record the snapshot no longer lists leaves its entry as it is`: with `2026-11-04` published without the record, the update answers `PullRecordAbsent` at version 1 and writes nothing. `a cancelled update refreshes nothing`: an update whose token is cancelled on its first progress answers `SourceRefreshCancelled`, and the entry holds one version. `a retired pulled material is never refreshed, and pulling its record again is refused`: after the pull, `this.proxy.retireEntry` of the entry (step 94) and `2026-11-04` published holding a changed record, `updateSourceSnapshot` answers `SourceRefreshed` with no pull, the entry holding one version, retired; and `pullRecord` of the record answers `PullImportErr (ImportRejectedErr _)` naming the record, and writes nothing. `every pull error renders its condition and its payload`: each case over a wrapped test-local error renders a distinct text holding the wrapped error's `describe`.", "acceptance": "After the pulls land, `CatalogueImportContext` MUST carry `materialSources`, `pullRecord` MUST add a pulled record as a user material at version 1 under its pull provenance, and `refreshPulls` and `updateSourceSnapshot` MUST mint the next version only where a record's hash changed, never for a retired material, and write nothing otherwise; constructor-unit-tests MUST pass, including `a pulled record becomes a user material at version 1 under its pull provenance`, `pulling a held record again writes nothing while it is unchanged`, `an update that leaves a record unchanged mints no version`, `an update whose record changed mints version 2 and keeps version 1`, `a record the snapshot no longer lists leaves its entry as it is`, `a cancelled update refreshes nothing`, `a retired pulled material is never refreshed, and pulling its record again is refused` and `every pull error renders its condition and its payload`, the count rising by 8; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/CatalogueImportStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSourcePulls.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.a pulled record becomes a user material at version 1 under its pull provenance", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.pulling a held record again writes nothing while it is unchanged", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.an update that leaves a record unchanged mints no version", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.an update whose record changed mints version 2 and keeps version 1", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.a record the snapshot no longer lists leaves its entry as it is", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.a cancelled update refreshes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.a retired pulled material is never refreshed, and pulling its record again is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullTests.every pull error renders its condition and its payload", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.CatalogueImport.CatalogueImportContext.materialSources", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "obligations": ["S131-PULLS"]}, {"symbol": "OpticalConstructor.Domain.MaterialSourcePulls.MaterialSourcePullError", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSourcePulls.fs", "obligations": ["S131-PULLS"]}, {"symbol": "OpticalConstructor.Domain.MaterialSourcePulls.SourcePullChange", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSourcePulls.fs", "obligations": ["S131-PULLS"]}, {"symbol": "OpticalConstructor.Domain.MaterialSourcePulls.SourcePullResult", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSourcePulls.fs", "obligations": ["S131-PULLS"]}, {"symbol": "OpticalConstructor.Domain.MaterialSourcePulls.SourceRefreshInfo", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSourcePulls.fs", "obligations": ["S131-PULLS"]}, {"symbol": "OpticalConstructor.Domain.MaterialSourcePulls.SourceRefresh", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSourcePulls.fs", "obligations": ["S131-PULLS"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 445, "anchor": "IMPLEMENT", "ac": "AC-S131e", "touches": ["OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [444], "how_to": "refractiveindex.info's two file kinds are read by one module (AGENTS.md 'Reuse, never copy': a second parser for one format is a defect): the importer already reads a record page (`OpticalConstructor.Storage/MaterialImport.fs:RefractiveIndexInfoText.importMaterial`, tabulated `nk` and formula 1-7 pages, a tabulated page through step 2's `TabulatedNK` table), and it gains the database's catalog and a page's references (001 §D 'The existing YAML importer (`MaterialImport`) is REUSED as the record parser'; the S13.1 brief: search runs over the snapshot's catalog). The layout is the database's (`polyanskiy/refractiveindex.info-database`, branch `main`): `database/catalog-nk.yml` is a YAML list of `SHELF` items, each with a `name` and a `content` list of `DIVIDER` and `BOOK` items; a `BOOK` has a `name` and a `content` list of `DIVIDER` and `PAGE` items; a `PAGE` has a `name` and a `data` path relative to `database/data/` (for example `main/Ag/nk/Johnson.yml`). A page opens with `REFERENCES:` and `COMMENTS:` before its `DATA:` list. No YAML package is added; the reading stays line-based, as the page reading is. Each doc is one to three lines citing spec 0050 S13.1. In `MaterialImport.fs`, which now also opens `OpticalConstructor.Domain.LibraryEntryFiles` and `OpticalConstructor.Domain.MaterialSources`: (1) `ImportError` gains `member this.describe : string`: `MalformedYamlErr r` renders `the page is malformed: <r>`, `MalformedCsvErr r` `the CSV is malformed: <r>`, `NoDataErr r` `the file holds no data: <r>` and `UnsupportedFormulaErr (n, r)` `formula <n> is not supported: <r>`, so an import error renders through its own member (ELEV002). (2) `RefractiveIndexInfoCatalogText of string` with `.value`, the text of a database's `catalog-nk.yml`. `type RefractiveIndexInfoCatalogText with member this.hits : Result<MaterialSourceHit list, ImportError>` (step 443's `MaterialSourceHit`) reads it line by line, skipping a line whose trimmed text starts with `#`: `- SHELF:`, `- BOOK:` and `- PAGE:` open a shelf, a book (its page closed) and a page, keyed by the text after the colon; `name:` names the item opened last; `data:` gives the open page its record; `- DIVIDER:`, `content:` and any other key are skipped. A value has its surrounding white space and one pair of enclosing `\"` or `'` removed. Each page with a `data:` is one hit, in catalog order: `record = MaterialSourceRecordId <the data text>` and `name = EntryName \"<book name>, <page name>\"`, an item without `name:` taking its key. A catalog listing no page is `NoDataErr`, and every .NET call that throws is caught and answered `MalformedYamlErr`. (3) `type RefractiveIndexInfoText with member this.referencesOpt : EntryCitation option` reads the page's `REFERENCES:` line: a value other than `|` is the citation, unquoted as in (2); `|` takes the following lines indented deeper than the key, each trimmed, the non-empty ones joined by one space; a page without the key, or with an empty value, answers `None`. No HTML or Markdown is stripped. `importMaterial` is unchanged: its tabulated and formula readings are where a pulled record's physics comes from. (4) Fixture: new `OpticalConstructor.Tests/fixtures/catalog-nk.yml`, a `Content` item copied `PreserveNewest` beside `fixtures/Si.yml`'s with no comment, holding the database's three header comment lines (`# this file is part of refractiveindex.info database`, `# refractiveindex.info database is in the public domain`, `# copyright and related rights waived via CC0 1.0`), a top-level `DIVIDER`, and two shelves: `main` named `MAIN - simple inorganic materials`, holding a `DIVIDER` and the book `Si` named `Si (Silicon)` whose page `Test` is named `Test 2026: n,k 0.25–0.70 µm` with `data: main/Si/nk/Test.yml`; and `glass` named `GLASS - optical glass`, holding the book `BK7` named `BK7 (test)` whose page `Test` is named `Test 2026: n 0.3–2.5 µm` with `data: glass/test/BK7/nk/Test.yml`. Every name is double-quoted. (5) Tests, in `MaterialImportTests`: `the refractiveindex.info catalog lists each page as a hit named by its book and page`: `(RefractiveIndexInfoCatalogText <fixtures/catalog-nk.yml>).hits` answers exactly `main/Si/nk/Test.yml` named `Si (Silicon), Test 2026: n,k 0.25–0.70 µm` and `glass/test/BK7/nk/Test.yml` named `BK7 (test), Test 2026: n 0.3–2.5 µm`, in that order; a test-local catalog whose page has no `name:` names it by its key; and a catalog of header comments alone answers `NoDataErr`. `a page's references are its citation, a block's lines joined`: `fixtures/Si.yml` answers its quoted `REFERENCES` text unquoted; a test-local page whose `REFERENCES: |` block spans three indented lines answers them joined by single spaces; and a page without the key answers `None`. `every import error renders its condition and its payload`: each case over a distinct test-local reason, `UnsupportedFormulaErr` of formula 8, renders a distinct text holding it.", "acceptance": "After the readers land, `MaterialImport` MUST read a refractiveindex.info catalog into `MaterialSourceHit`s and a page's references into a citation, and `ImportError` MUST render through `describe`; constructor-unit-tests MUST pass, including `the refractiveindex.info catalog lists each page as a hit named by its book and page`, `a page's references are its citation, a block's lines joined` and `every import error renders its condition and its payload`, the count rising by 3; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/fixtures/catalog-nk.yml", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.the refractiveindex.info catalog lists each page as a hit named by its book and page", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-PARSER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a page's references are its citation, a block's lines joined", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-PARSER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.every import error renders its condition and its payload", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-PARSER"]}], "contracts": [{"symbol": "OpticalConstructor.Storage.MaterialImport.RefractiveIndexInfoCatalogText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S131-RII-PARSER"]}, {"symbol": "OpticalConstructor.Storage.MaterialImport.ImportError.describe", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S131-RII-PARSER"]}, {"symbol": "OpticalConstructor.Storage.MaterialImport.RefractiveIndexInfoText.referencesOpt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S131-RII-PARSER"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 446, "anchor": "IMPLEMENT", "ac": "AC-S131f", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Ui", "OpticalConstructor.App", "OpticalConstructor.Tests", "OpticalConstructor.Ui.Tests"], "depends_on": [445], "how_to": "The online sources' offline snapshots get a location of their own, read like every other (001 §G 'Every path is overridable in appsettings.json; a Launcher Data locations panel shows them'; the S13.1 brief: the offline snapshot lives under a DataLocations sources folder; .spec-md §3.9 'No test touches the user's data'; .spec-md §8: no configuration knob other than the 001 §G locations). A snapshot is slow data that every kit shares, so its default sits beside the library database under `%LOCALAPPDATA%` (001 §G), never in Documents. Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Domain/WorkbenchSettings.fs`: `DataLocations` (step 81) gains, last, `materialSourcesFolder : FolderName`, with a one-line doc: the folder holding each online source's offline snapshot. `defaultsUnder` answers it as `FolderName \"%LOCALAPPDATA%/Softellect/Berreman/OpticalConstructor/Sources\"`, written there alone. `DataLocationKind` (step 192) gains, last, `MaterialSourcesLocation`, documented in one line naming its field, and `all` lists it last, so the kinds still follow the record's fields. (2) `OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs` (step 193): `caption` answers `Online source snapshots` and `uiKey` `MaterialSources` for it; and `OpticalConstructor.Ui/DataLocationsView.fs`' `DataLocations.rows` (step 193) answers the kind's row as it answers every other folder's, showing and opening `materialSourcesFolder`, so the Data locations window lists the folder with Open folder and nothing else in the view changes. (3) `OpticalConstructor.App/AppConfig.fs` (step 82): module `ConfigKey` gains `materialSourcesFolder` = `\"MaterialSourcesFolder\"` with a one-line doc naming its field; `readDataLocations` reads it through `readSetting` exactly as it reads the other folders, its default written back when missing or refused; and `resolveLocations` expands it and roots it at `install` as it does the others. (4) The test run: `OpticalConstructor.Ui.Tests/appsettings.json` (step 82) gains `MaterialSourcesFolder` = `TestRun/Sources` in `appSettings`, and `TestAppScope.testLocations` (step 83) holds `Sources` under the owner's folder, which `fileLocations` (step 88) moves with the rest, so no test reaches `%LOCALAPPDATA%`. Every other construction of a `DataLocations` record sets the field: `DataLocationsTests` (step 193) sets a `Sources` folder under its test folder. (5) Tests, their assertions widened to the new location and nothing else changed: `WorkbenchSettingsTests`' `DataLocations.defaultsUnder holds the 001 §G locations as configured text` also requires the sources default above, and `every location is a data location kind, in the order of its field` requires the eight kinds, `MaterialSourcesLocation` last. `DataLocationsTests`' `the rows list every location in order, the library by its file` requires eight rows, the last showing and opening the sources folder. `AppConfigTests`' `readDataLocations writes every missing location back as its default and answers it expanded` also requires the `MaterialSourcesFolder` default written back verbatim and answered expanded, and `the test run's appsettings.json keeps the library in memory and every folder under the test output` requires six folders under the test output, the sources folder among them.", "acceptance": "After the location lands, `DataLocations` MUST hold `materialSourcesFolder`, defaulting beside the library database and read from `MaterialSourcesFolder` in `appsettings.json`, and the Data locations window MUST list it with Open folder; constructor-unit-tests MUST pass, including the widened `DataLocations.defaultsUnder holds the 001 §G locations as configured text`, `every location is a data location kind, in the order of its field` and `the rows list every location in order, the library by its file`, the count unchanged; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, including the widened `readDataLocations writes every missing location back as its default and answers it expanded` and `the test run's appsettings.json keeps the library in memory and every folder under the test output`, the count unchanged; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.AppConfigTests", "OpticalConstructor.Ui.Tests.AppContextTests", "OpticalConstructor.Ui.Tests.DataLocationsWindowTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/WorkbenchSettings.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/DataLocationsView.fs", "Berreman/OpticalConstructor/OpticalConstructor.App/AppConfig.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/appsettings.json", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/TestAppScope.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/WorkbenchSettingsTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/DataLocationsTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppConfigTests.fs"], "tests": [{"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.WorkbenchSettingsTests.DataLocations.defaultsUnder holds the 001 §G locations as configured text", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/WorkbenchSettingsTests.fs", "obligations": ["S131-SOURCES-LOCATION"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.WorkbenchSettingsTests.every location is a data location kind, in the order of its field", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/WorkbenchSettingsTests.fs", "obligations": ["S131-SOURCES-LOCATION"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.DataLocationsTests.the rows list every location in order, the library by its file", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/DataLocationsTests.fs", "obligations": ["S131-SOURCES-LOCATION"]}, {"op": "change_expectation", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.AppConfigTests.readDataLocations writes every missing location back as its default and answers it expanded", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppConfigTests.fs", "obligations": ["S131-SOURCES-LOCATION"]}, {"op": "change_expectation", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.AppConfigTests.the test run's appsettings.json keeps the library in memory and every folder under the test output", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppConfigTests.fs", "obligations": ["S131-SOURCES-LOCATION"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.WorkbenchSettings.DataLocations.materialSourcesFolder", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/WorkbenchSettings.fs", "obligations": ["S131-SOURCES-LOCATION"]}, {"symbol": "OpticalConstructor.Domain.WorkbenchSettings.DataLocationKind.MaterialSourcesLocation", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/WorkbenchSettings.fs", "obligations": ["S131-SOURCES-LOCATION"]}, {"symbol": "OpticalConstructor.App.ConfigKey.materialSourcesFolder", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.App/AppConfig.fs", "obligations": ["S131-SOURCES-LOCATION"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 447, "anchor": "IMPLEMENT_CONTRACT", "ac": "AC-S131g", "id": "SVC_BigBoy_0002", "name": "MaterialSourceProxy", "kind": "proxy", "language": "fsharp", "declaring_project": "OpticalConstructor.Domain", "touches": ["OpticalConstructor.Storage", "OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [446], "actions": ["ADD_TEST OpticalConstructor.Tests.MaterialSourceStoreTests"], "how_to": "The refractiveindex.info adapter over an offline snapshot of its GitHub database (001 §D '1. refractiveindex.info (CC0): an offline snapshot of the GitHub database plus \"Update snapshot\". The existing YAML importer (`MaterialImport`) is REUSED as the record parser'; the S13.1 brief: HTTP goes through one marked seam and no test calls it, and tests use fixture snapshots under the test output; .spec-md §4 'Errors and IO', 'Stored formats', 'Every kit and catalogue write is atomic'). The snapshot is the archive's `database/catalog-nk.yml` and `database/data/**`, held under `<materialSourcesFolder>/refractiveindex.info/` beside its stamp `.snapshot-json` (001 §A: a file that exists once per folder is named by its extension alone). The archive is read through S6's archive seam, the app's one zip reader (`KitArchiveProxy.create ()`, step 199: `listZipEntries` reads every name through `KitTreeEntry.tryOfZipEntryName`, so no entry escapes, and `extractKitZip` reports and reads the cancellation per file and removes what it wrote), so no second extractor is written. Each doc is one to three lines citing spec 0050 S13.1. (1) The stamp's schema: new `OpticalConstructor.Storage/schema/material-source-snapshot.schema.json`, draft 2020-12 with `$id` `https://berreman/schema/material-source-snapshot.json`, in the shape of `schema/kit-history.schema.json` (step 167): `schemaVersion` a positive integer, checked unconditionally; only under `if` it is 1 (`then`), exactly the keys `schemaVersion`, `source` and `sourceVersion`, both non-empty strings. It is a `Content` item copied `PreserveNewest` beside `schema/kit-history.schema.json`'s in `OpticalConstructor.Storage.fsproj`, with no comment. `SchemaValidation.fs` gains `validateSourceSnapshot (element : JsonElement) : Result<unit, StorageError>` over `validateWith` (step 29), its schema loaded once behind a `lazy`, as `validateKitHistory` is. (2) New `OpticalConstructor.Storage/MaterialSourceStore.fs`, `module MaterialSourceStore` in `namespace OpticalConstructor.Storage`, compiled directly after `KitArchiveStore.fs` (step 199): one `<Compile>` line and no comment. It opens `System.IO`, `System.Net.Http`, `System.Threading`, `OpticalConstructor.Domain.Kit`, `OpticalConstructor.Domain.KitArchive`, `OpticalConstructor.Domain.LibraryEntryFiles`, `OpticalConstructor.Domain.MaterialSources` and `MaterialImport`. In order: (a) `SourceSnapshotStamp = { schemaVersion : FileSchemaVersion; source : MaterialSourceName; sourceVersion : MaterialSourceVersion }` with `static member currentSchemaVersion : FileSchemaVersion` (1), `extension : FileExtension` (`.snapshot-json`, the one place that text is written) and `fileName : FileName` (`(FileStem.ofText \"\").withExtension SourceSnapshotStamp.extension`), the shape of `KitFile` (step 122). `SourceSnapshotText of string` with `.value` is the stamp file's text, as `KitHistoryText` is the history file's (step 167): `member this.fileText : Result<SourceSnapshotText, StorageError>` on the stamp is `nodeOf this` rendered by `canonicalFileText` (steps 27, 124), and `member this.parseStamp : Result<SourceSnapshotStamp, StorageError>` on the text is `parseVersionedText validateSourceSnapshot SourceSnapshotStamp.extension SourceSnapshotStamp.currentSchemaVersion this.value` (step 124): no up-converter and no fallback reader. (b) `SourceArchiveUrl of string` with `.value`, and `[<ReferenceEquality>] SourceArchiveDownloader = { downloadArchive : SourceArchiveUrl -> FileName -> CancellationToken -> Result<unit, MaterialSourceError> }`, which writes the archive at the URL into the file. `static member http : SourceArchiveDownloader` is the ONE HTTP seam of the online sources and carries `[<ElevationBoundary(nameof IoBoundary, \"the one HTTP seam of the online material sources (001 §D): a GET streamed into a file; every exception is SourceDownloadErr\")>]`: an `HttpClient` made and disposed per call sends a GET with `HttpCompletionOption.ResponseHeadersRead` and the token, requires a success status, and copies the body into a `FileStream` in `FileMode.Create`; every exception is `SourceDownloadErr` naming the URL and the message. No test calls it: tests pass a downloader that copies a zip they wrote. (c) `type MaterialSourceProxy with static member createRefractiveIndexInfo (sources : FolderName) (downloader : SourceArchiveDownloader) (clock : ClockProvider) : MaterialSourceProxy`, unique on its receiver beside `createInMemory` (ELEV019). Building it touches nothing. `sourceName` is `MaterialSourceName \"refractiveindex.info\"`, the snapshot folder `<sources>/refractiveindex.info`, the licence `EntryLicence \"CC0-1.0\"` (the database's README: CC0 1.0 Universal) and the archive `SourceArchiveUrl \"https://github.com/polyanskiy/refractiveindex.info-database/archive/refs/heads/main.zip\"`, each written there alone. Every file is read as bytes and decoded as UTF-8 with a leading byte-order mark dropped, as a kit's files are (step 126). `snapshotVersion ()`: no stamp file answers `Ok None`; otherwise the parsed stamp's `sourceVersion`, an `UnsupportedSchemaVersionErr` being `UnsupportedSnapshotSchemaErr` and any other `StorageError` `SourceSnapshotIoErr`, each with its `describe`. `searchRecords query`: without a stamp `SourceSnapshotMissingErr`; otherwise `query.filter` (step 443) of `RefractiveIndexInfoCatalogText.hits` (step 445) over `database/catalog-nk.yml`, an import error being `SourceSnapshotIoErr` with its `describe`. `fetchRecord record`: without a stamp `SourceSnapshotMissingErr`; a record the catalog's hits do not list, or whose text `KitRelativePath.tryCreate` (step 123) refuses, `SourceRecordMissingErr` naming it; otherwise the bytes of `database/data/<record>` give `recordHash = ContentHash.ofBytes <the bytes>` (step 123) and their text `importMaterial` (an error being `SourceRecordUnreadableErr` naming the record and the error's `describe`), and the answer is `{ pull = { source; record; recordHash; sourceVersion = <the stamp's>; licence; citation }; material = { <the import> with name = <the hit's name> } }`, the citation being `EntryCitation \"refractiveindex.info, <record>\"` followed, when `referencesOpt` (step 445) answers one, by `: ` and its text. `updateSnapshot observer`, in this order, every name below lying beside the snapshot folder in `sources`: any `refractiveindex.info.zip.tmp`, `refractiveindex.info.tmp` or `refractiveindex.info.old` an interrupted run left is deleted; the archive is downloaded into `refractiveindex.info.zip.tmp` with `observer.cancellation`; a cancelled token then answers `SourceSnapshotCancelled`, whatever the download answered, and a download error is answered as it is. `KitArchiveProxy.create ()`'s `listZipEntries` of the zip (a `KitArchiveError` being `SourceArchiveInvalidErr` with its `describe`) gives the entries; the archive's one top-level folder `<top>` MUST hold the file `<top>/database/catalog-nk.yml`, else `SourceArchiveInvalidErr`; the entries kept are that file and every file and folder under `<top>/database/data/`. `extractKitZip { zip = <the zip>; entries = <those>; target = KitFolder (FolderName <refractiveindex.info.tmp>) }` runs under a `KitArchiveObserver` that tells `observer.reportSnapshotProgress` each `KitArchiveProgress` as a `SourceSnapshotProgress` of the same counts and whose cancellation is `observer.cancellation`: `KitArchiveCancelled` answers `SourceSnapshotCancelled`. On `KitArchiveFinished n` the stamp `{ schemaVersion = currentSchemaVersion; source = sourceName; sourceVersion = MaterialSourceVersion <clock.now ()'s UTC date as yyyy-MM-dd, invariant culture> }` is written into `refractiveindex.info.tmp/<top>` through `FileName.writeBytesAtomically` (step 126); a held snapshot folder is moved to `refractiveindex.info.old`, `refractiveindex.info.tmp/<top>` is moved to the snapshot folder, and the `.old` folder, the `.tmp` folder and the zip are deleted, so the snapshot is replaced whole; the answer is `SourceSnapshotUpdated { version; files = SourceSnapshotFileCount n }`. Every exception, and every error after the download, deletes what this run made, moves `.old` back when it was moved, and keeps the held snapshot; an exception is `SourceSnapshotIoErr` naming the folder and the message. A declaration whose signature carries a bare primitive for this IO is marked on itself with `[<ElevationBoundary(nameof IoBoundary, …)>]`, as step 199's are. No package is added (`System.Net.Http` ships with .NET), and no retry, cache, mirror, second URL or setting is added (.spec-md §8). (3) The `MaterialSourceProxy` doc (step 443) names `createRefractiveIndexInfo` beside the in-memory double in one line. Tests: new `OpticalConstructor.Tests/MaterialSourceFixture.fs`, `module MaterialSourceFixture`, and `OpticalConstructor.Tests/MaterialSourceStoreTests.fs`, `module MaterialSourceStoreTests` in `namespace OpticalConstructor.Tests`, appended in that order at the end of the compile list with no comment. The fixture, each member with a one-line doc: `siPage ()` and `glassPage ()` are the texts of `fixtures/Si.yml` and `fixtures/formula2.yml`; `changedSiPage ()` is `siPage ()` with `0.700 3.785 0.013` replaced by `0.700 3.790 0.013`; `freshSources (owner : string) : FolderName` is a new GUID-named folder under `Path.Combine(AppContext.BaseDirectory, owner)`, never under `%TEMP%`; `writeSnapshot (snapshot : string) (si : string) : unit` writes, under `snapshot`, `fixtures/catalog-nk.yml` (step 445) as `database/catalog-nk.yml`, `si` as `database/data/main/Si/nk/Test.yml`, `glassPage ()` as `database/data/glass/test/BK7/nk/Test.yml` and the stamp of `2026-11-01` through `SourceSnapshotStamp.fileText`; `writeArchive (zip : string) (si : string) : unit` writes, through `ZipArchive`, a GitHub-style archive whose one top folder `refractiveindex.info-database-main/` holds `README.md`, `database/tools/x.py`, the folder entries of `database/data/` and below, and the three files `writeSnapshot` writes but the stamp; `copyingDownloader (zip : string) (asked : ResizeArray<SourceArchiveUrl>) : SourceArchiveDownloader` records each URL and copies `zip` into the target file; and `fixedClock (instant : DateTime) : ClockProvider` answers that UTC instant. Facts, each over a fresh sources folder whose snapshot is `<it>/refractiveindex.info`: `a refractiveindex.info source without a snapshot answers no version and refuses search and fetch`: `snapshotVersion` is `Ok None`, and `searchRecords` and `fetchRecord` are `SourceSnapshotMissingErr`. `a snapshot's catalog is searched with the shared rule`: over `writeSnapshot` of `siPage ()`, `snapshotVersion` is `2026-11-01`, `silicon` finds `main/Si/nk/Test.yml` alone, and a blank query finds both pages in catalog order. `a fetched page is MaterialImport's material under its hit's name, with the page's hash, the stamp's version, CC0 and its citation`: the Si record's `material.physics` equals that of `(RefractiveIndexInfoText (siPage ())).importMaterial`, its name is `Si (Silicon), Test 2026: n,k 0.25–0.70 µm`, its `recordHash` is `ContentHash.ofBytes` of the page file's bytes, and its pull holds `refractiveindex.info`, `2026-11-01`, `CC0-1.0` and the citation `refractiveindex.info, main/Si/nk/Test.yml: <the page's REFERENCES text>`; the glass record's physics equals `formula2.yml`'s import; and a record the catalog does not list, and `../x.yml`, answer `SourceRecordMissingErr`. `an update downloads the archive and replaces the snapshot with its catalog and data, file by file`: over a held snapshot, `updateSnapshot` with `copyingDownloader` of `writeArchive` of `changedSiPage ()` and `fixedClock` of 2026-11-04 answers `SourceSnapshotUpdated` of `2026-11-04` and three files, its progress reading 1 to 3 of 3; the one URL asked is the database's archive; the snapshot holds exactly `.snapshot-json`, `database/catalog-nk.yml` and the two pages, with no `README.md` or `tools`; the Si page's hash is the changed page's; and `sources` holds nothing else, no `.tmp`, `.old` or zip. `an update cancelled before its next file keeps the held snapshot`: a token whose source is cancelled on the first progress answers `SourceSnapshotCancelled`; the snapshot still holds `2026-11-01` and its files byte for byte, and `sources` holds nothing else. `an archive without the database catalog is refused and the held snapshot kept`: an archive holding `README.md` alone answers `SourceArchiveInvalidErr`, and the snapshot is unchanged. `a failed download keeps the held snapshot`: a downloader answering `SourceDownloadErr \"offline\"` answers it, and the snapshot is unchanged. `a snapshot stamp of another schema version is refused`: a stamp whose `schemaVersion` is 2 makes `snapshotVersion` answer `UnsupportedSnapshotSchemaErr`.", "acceptance": "After the adapter lands, a test MUST instantiate the real `MaterialSourceProxy.createRefractiveIndexInfo` over a fixture snapshot under the test output, its fetch MUST parse a page through `MaterialImport` under the page's hash, the stamp's version, CC0 and its citation, and its update MUST replace the snapshot whole through the archive seam or keep it; constructor-unit-tests MUST pass, including `a refractiveindex.info source without a snapshot answers no version and refuses search and fetch`, `a snapshot's catalog is searched with the shared rule`, `a fetched page is MaterialImport's material under its hit's name, with the page's hash, the stamp's version, CC0 and its citation`, `an update downloads the archive and replaces the snapshot with its catalog and data, file by file`, `an update cancelled before its next file keeps the held snapshot`, `an archive without the database catalog is refused and the held snapshot kept`, `a failed download keeps the held snapshot` and `a snapshot stamp of another schema version is refused`, the count rising by 8; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Storage/schema/material-source-snapshot.schema.json", "Berreman/OpticalConstructor/OpticalConstructor.Storage/SchemaValidation.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/OpticalConstructor.Storage.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceFixture.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a refractiveindex.info source without a snapshot answers no version and refuses search and fetch", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a snapshot's catalog is searched with the shared rule", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a fetched page is MaterialImport's material under its hit's name, with the page's hash, the stamp's version, CC0 and its citation", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.an update downloads the archive and replaces the snapshot with its catalog and data, file by file", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.an update cancelled before its next file keeps the held snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.an archive without the database catalog is refused and the held snapshot kept", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a failed download keeps the held snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a snapshot stamp of another schema version is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-RII-ADAPTER"]}], "contracts": [{"symbol": "OpticalConstructor.Storage.MaterialSourceStore.SourceSnapshotStamp", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S131-RII-ADAPTER"]}, {"symbol": "OpticalConstructor.Storage.MaterialSourceStore.SourceSnapshotText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S131-RII-ADAPTER"]}, {"symbol": "OpticalConstructor.Storage.MaterialSourceStore.SourceArchiveUrl", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S131-RII-ADAPTER"]}, {"symbol": "OpticalConstructor.Storage.MaterialSourceStore.SourceArchiveDownloader", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S131-RII-ADAPTER"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceProxy.createRefractiveIndexInfo", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S131-RII-ADAPTER"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 448, "anchor": "IMPLEMENT", "ac": "AC-S131h", "touches": ["OpticalConstructor.Tests"], "depends_on": [447], "actions": ["ADD_TEST OpticalConstructor.Tests.MaterialSourcePullSqliteTests"], "how_to": "The pull and the update proved end to end over the real adapter and the real library database: a fixture snapshot under the test output and SQLite `:memory:` (the S13.1 brief 'Tests over a fixture snapshot: search; a pull gives version 1 with provenance; an unchanged update makes no new version; a changed record gives version 2'; .spec-md §9 'Each library proxy's suite runs against BOTH the in-memory store and SQLite :memory:'; .spec-md §3.9). Tests only; no product file changes. New `OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs`, `module MaterialSourcePullSqliteTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, its module doc one to three lines citing spec 0050 S13.1. Each fact opens `BuiltinCatalogue.freshLibraryDatabase ()` (step 67), disposed at its end, composes its import context as `CatalogueImportContext.create (CatalogueImportProxy.createInDatabase <the database>)` (step 95) and its material store as `MaterialProxy.createInDatabase <the database>` (step 69), and builds the adapter as `MaterialSourceProxy.createRefractiveIndexInfo` (step 447) over `MaterialSourceFixture.freshSources \"MaterialSourcePullSqliteTests\"`, whose snapshot `writeSnapshot` writes with `siPage ()`, a `copyingDownloader` of an archive `writeArchive` writes beside it, and `fixedClock` of 2026-11-04; nothing reaches the network. `a pulled refractiveindex.info page is a user material at version 1 with its provenance and its pulled-source row`: `searchRecords (MaterialSourceQuery \"silicon\")` finds `main/Si/nk/Test.yml`; `pullRecord` of it (step 444) answers one `PullAddedEntry` at version 1; the material store's `tryGetMaterial` of its id resolves a material named `Si (Silicon), Test 2026: n,k 0.25–0.70 µm` whose physics is the page's import; the import seam's `tryLatestEnvelope` holds `SourcePullProvenance` with the record, `2026-11-01`, `CC0-1.0`, the citation and the page file's hash, its protection `UserManaged`; the database's `PulledSources` table (read through `run`) holds exactly one row, of that entry at version 1 with those texts; and `attributionLinesOf` of the entry (step 114) answers `Si (Silicon), Test 2026: n,k 0.25–0.70 µm: Licence CC0-1.0`. `an update whose page is unchanged mints no version`: after that pull, `updateSourceSnapshot` (step 444) with the archive of `siPage ()` answers `SourceRefreshed` whose snapshot is `2026-11-04` and whose one pull is `PullFoundUnchanged` at version 1; `resolveVersion` of version 2 answers `None`; and `PulledSources` still holds one row. `an update whose page changed mints version 2 and keeps version 1`: after that pull, the update with the archive of `changedSiPage ()` answers `PullMintedVersion` at version 2; version 2 resolves with the changed page's import as its physics (n 3.790 at 0.70 µm) under the same name, its provenance `2026-11-04` and the changed page's hash; version 1 resolves as before, through `resolveVersion`; the material's latest is version 2; and `PulledSources` holds two rows, versions 1 and 2. `pulling the same page twice writes it once`: a second `pullRecord` answers `PullFoundUnchanged` at version 1, and the entry holds one version.", "acceptance": "After the end-to-end facts land, a pulled refractiveindex.info page MUST be a user material at version 1 in the SQLite library with its pull provenance and its pulled-source row, an update of an unchanged page MUST mint nothing and an update of a changed page MUST mint version 2 and keep version 1; constructor-unit-tests MUST pass, including `a pulled refractiveindex.info page is a user material at version 1 with its provenance and its pulled-source row`, `an update whose page is unchanged mints no version`, `an update whose page changed mints version 2 and keeps version 1` and `pulling the same page twice writes it once`, the count rising by 4; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.a pulled refractiveindex.info page is a user material at version 1 with its provenance and its pulled-source row", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS-SQLITE"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.an update whose page is unchanged mints no version", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS-SQLITE"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.an update whose page changed mints version 2 and keeps version 1", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS-SQLITE"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.pulling the same page twice writes it once", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-PULLS-SQLITE"]}], "contracts": [], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 449, "anchor": "IMPLEMENT", "ac": "AC-S131i", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Ui.Tests"], "depends_on": [448], "how_to": "The app offers refractiveindex.info over its configured sources folder (.spec-md §0.1: `AppContext.create` composes the library proxies over the configured locations; .spec-md §3.9; the S13.1 brief). Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Ui/AppContext.fs`: the `compose` that `create` and `recreateLibrary` share (steps 89, 100, 118) builds `catalogueImports` with, beside `exportFolderOpt` and in the same record update, `materialSources = [ MaterialSourceProxy.createRefractiveIndexInfo locations.materialSourcesFolder SourceArchiveDownloader.http ClockProvider.system ]` (steps 446, 447; `ClockProvider.system`, `KitOpening.fs`, step 150). Every other composition (`DefaultStores`, `initWith`, the tests' import contexts) keeps the `[]` of `CatalogueImportContext.create` (step 444). Composing it reads and writes nothing: no folder is created and nothing is downloaded until Update snapshot runs. The record's doc names the sources in no more words. (2) Tests: `AppContextTests` gains `the app scope offers refractiveindex.info over its configured sources folder, holding no snapshot`: `TestAppScope.freshAppContext (FolderName \"AppContextTests\")`'s `catalogueImports.materialSources` is one source named `refractiveindex.info`, whose `snapshotVersion ()` answers `Ok None`, and nothing exists under the sources folder of `TestAppScope.testLocations (FolderName \"AppContextTests\")` (step 446). No test runs this source's `updateSnapshot`, so no test reaches the network (.spec-md §8).", "acceptance": "After the composition, `AppContext.create` MUST compose the refractiveindex.info source over `locations.materialSourcesFolder` with the HTTP seam and every other composition MUST offer none; constructor-unit-tests MUST pass; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, including `the app scope offers refractiveindex.info over its configured sources folder, holding no snapshot`, the count rising by 1; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.AppContextTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/AppContext.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppContextTests.fs"], "tests": [{"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.AppContextTests.the app scope offers refractiveindex.info over its configured sources folder, holding no snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppContextTests.fs", "class": "OpticalConstructor.Ui.Tests.AppContextTests", "discovery_gate": "ui-tests", "obligations": ["S131-APP-SOURCES"]}], "contracts": [], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 450, "anchor": "IMPLEMENT", "ac": "AC-S131j", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Controls", "OpticalConstructor.Tests"], "depends_on": [449], "actions": ["ADD_TEST OpticalConstructor.Tests.MaterialSourcesModelTests"], "how_to": "The Online sources surface as a pure Elmish update over the import context, Update snapshot running off the UI thread with per-file progress and Cancel (001 §O; 001 §P: every user step is a semantic message; .spec-md §10.1 to §10.5: one click with Cancel, per-file progress, the completion message updates the model; the S13.1 brief: an 'Online sources…' search and fetch UI). It hosts the update as step 200 hosts an archive job and step 393 a fit, over `JobRunner.fs:startBackground`, `:updateJob` and `:JobModel`. New `OpticalConstructor.Ui/MaterialSourcesView.fs`, `module OpticalConstructor.Ui.MaterialSourcesView`, compiled directly after `MaterialsWindowView.fs`: one `<Compile>` line in `OpticalConstructor.Ui.fsproj` and no comment. Its module doc and each declaration's doc are one to three lines citing spec 0050 S13.1. In order: (1) The host. `[<ReferenceEquality>] SourceSnapshotJobHandle = { cancelSourceSnapshot : unit -> unit }` and `[<ReferenceEquality>] SourceSnapshotJobHost = { startSourceSnapshot : (SourceSnapshotObserver -> Result<SourceRefresh, MaterialSourcePullError>) -> SourceSnapshotJobHandle }` with `static member posting (post : (unit -> unit) -> unit) (progressed : JobProgress -> unit) (ended : Result<SourceRefresh, MaterialSourcePullError> -> unit) : SourceSnapshotJobHost`, `onUiThread (progressed) (ended)`, `immediate (progressed) (ended)` and `inert`, each built as `KitArchiveJobHost`'s member of that name is (step 200): a `CancellationTokenSource` and a `Stopwatch` per job; each `SourceSnapshotProgress` told as `{ completed = JobStepCount filesDone.value; total = Some (JobStepCount filesTotal.value); elapsed = JobElapsed <the stopwatch's elapsed> }` (`JobRunner.fs:JobProgress`); a raise (`Error (JobRunExn e)`) ending as `Error (PullSourceErr (SourceSnapshotIoErr e.Message))`. (2) `[<ReferenceEquality>] MaterialSourcesContext = { imports : CatalogueImportContext; jobs : SourceSnapshotJobHost; pullsApplied : ControlCaption -> unit }`: the import seam the sources ride (step 444), the update's host, and the callback telling the window that opened it what the library gained, as `ImportDialogWindow` tells the Materials window (step 110). (3) `MaterialSourcesModel = { context : MaterialSourcesContext; shownSourceOpt : MaterialSourceName option; snapshotOpt : MaterialSourceVersion option; queryDraft : MaterialSourceQuery; hits : MaterialSourceHit list; job : JobModel<SourceSnapshotFileCount>; handleOpt : SourceSnapshotJobHandle option; status : ControlCaption option; error : MaterialSourcePullError option }`, each field documented, with `member this.shownSource : MaterialSourceProxy option`, the context's source of that name. (4) `MaterialSourcesMsg`, each case documented: `ShowMaterialSource of MaterialSourceName` | `SetSourceQueryDraft of MaterialSourceQuery` | `SearchMaterialSource of MaterialSourceQuery` | `PullSourceRecord of MaterialSourceRecordId` | `UpdateSourceSnapshot` | `CancelSourceSnapshot` | `SourceSnapshotProgressed of JobProgress` | `SourceSnapshotEnded of Result<SourceRefresh, MaterialSourcePullError>`. (5) `initMaterialSources (context : MaterialSourcesContext) : MaterialSourcesModel` shows the first of `imports.materialSources` (`None` when there is none), reads its `snapshotVersion ()` (an error held as `PullSourceErr`), and holds an empty query, no hit, the job `initModel` (`JobRunner.fs:185`), no handle and no status. (6) `updateMaterialSources (msg : MaterialSourcesMsg) (m : MaterialSourcesModel) : MaterialSourcesModel`: `ShowMaterialSource name` shows that source, reading its snapshot version and clearing hits, status and error (an unknown name changes nothing); `SetSourceQueryDraft q` sets the draft; `SearchMaterialSource q` answers the shown source's `searchRecords q` as `hits` and clears the error, or holds `PullSourceErr` with no hit; `PullSourceRecord r` is `imports.pullRecord <the shown source> r` (step 444): `Ok results` sets `status` to their captions joined by a space, clears the error and calls `context.pullsApplied` with that status, and `Error e` holds `e`; `UpdateSourceSnapshot` while the job runs changes nothing, and otherwise starts `imports.updateSourceSnapshot <the shown source>` through `context.jobs.startSourceSnapshot`, passes the job through `updateJob StartRequested`, holds the handle and clears status and error; `CancelSourceSnapshot` calls the handle's `cancelSourceSnapshot` while the job runs; `SourceSnapshotProgressed p` is `updateJob (ProgressReported p)`; `SourceSnapshotEnded (Ok (SourceRefreshed info))` is `updateJob (RunCompleted info.snapshot.files)` with no handle, `snapshotOpt = Some info.snapshot.version` and `status` the refresh's caption, and then calls `context.pullsApplied` of it, so the Materials window re-renders with any new version and no reload (.spec-md §10.4); `SourceSnapshotEnded (Ok SourceRefreshCancelled)` is `updateJob RunCancelled` with no handle and the status `The snapshot update was cancelled; the held snapshot is unchanged.`; and `SourceSnapshotEnded (Error e)` returns the job to `Idle` with no handle and holds `e`. No queue, retry or second job is added: one update at a time. (7) `OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs`, each a one-line doc: `MaterialSourcePullError.caption` (its `describe`); `SourcePullResult.caption`: `Pulled <name> as version 1.`, `<name>: the record changed; pulled as version <n>.`, `<name> is unchanged at version <n>.` or `<name>: the snapshot no longer lists <record>; left at version <n>.`; `SourceRefreshInfo.caption`: `Snapshot <version> holds <files> files.` followed by each pull's caption, joined by spaces; and `ConstructorUiId.materialSourceChoice (name : MaterialSourceName)` (`MaterialSourceChoice_<name>`), `materialSourceHitRow (record : MaterialSourceRecordId)` (`MaterialSourceHit_<record>`) and `materialSourcePullButton (record : MaterialSourceRecordId)` (`MaterialSourcePull_<record>`). `OpticalConstructor.Controls/UiIds.fs`, a new group after the Materials window's under `// --- The Online sources window (MaterialSourcesView, MaterialSourcesWindow). ---`, each with a one-line doc and the PascalCase of its name as its text: `materialSourceSnapshotText`, `materialSourceUpdateButton`, `materialSourceUpdateProgressBar`, `materialSourceUpdateProgressText`, `materialSourceUpdateCancelButton`, `materialSourceQueryBox`, `materialSourceSearchButton`, `materialSourceHitList` and `materialSourcesStatusText`. (8) `materialSourcesView (m : MaterialSourcesModel) (dispatch : MaterialSourcesMsg -> unit) : IView`, a pure projection: a `ScrollViewer` over a `MinWidthPanel` of minimum width 520, both scroll bars `Auto`, as `dataLocationsView` scrolls (step 193), over a vertical `StackPanel`. With no source it holds only `No online material source is configured.` in a `TextBlock` carrying `materialSourcesStatusText`. Otherwise it holds, in order: a row of one `MaterialsWindowView.verbButton` per source (`materialSourceChoice`, the shown one on `positiveBackground`, sending `ShowMaterialSource`); a `DockPanel` whose right side is `Update snapshot` (`materialSourceUpdateButton`, disabled while the job runs, sending `UpdateSourceSnapshot`) and whose fill is a wrapping `TextBlock` carrying `materialSourceSnapshotText`: `Snapshot <version>`, or `No snapshot yet; Update snapshot downloads the database.`; while the job runs, a progress row of a `ProgressBar` carrying `materialSourceUpdateProgressBar` (minimum 0, maximum 1, the progress's fraction, indeterminate before the first file), the job's `progressText` (or `Downloading…` before the first file) in a `TextBlock` carrying `materialSourceUpdateProgressText`, and `Cancel` (`materialSourceUpdateCancelButton`, a `MaterialsWindowView.actionButton` on `negativeBackground`, sending `CancelSourceSnapshot`); a `DockPanel` whose right side is `Search` (`materialSourceSearchButton`, sending `SearchMaterialSource m.queryDraft`) and whose fill is a `TextBox` carrying `materialSourceQueryBox` with the draft's text, sending `SetSourceQueryDraft` on each change and `SearchMaterialSource` on Enter; a vertical `StackPanel` carrying `materialSourceHitList` with one `DockPanel` per hit carrying `materialSourceHitRow`, its right side `Pull` (`materialSourcePullButton`, sending `PullSourceRecord`) and its fill the semi-bold name over the record's text; and, when either is set, a wrapping `TextBlock` carrying `materialSourcesStatusText` with the error's caption in `MaterialsWindowView.messageColor`, or else the status. Every id is the control's `Name` and `AutomationId`. Tests: new `OpticalConstructor.Tests/MaterialSourcesModelTests.fs`, `module MaterialSourcesModelTests`, appended at the end of the compile list with no comment, over an import context built as step 444's tests build theirs, its `materialSources` set by record update to step 443's double holding the Silicon record at `2026-11-01`, a `pullsApplied` recording its captions, and `SourceSnapshotJobHost.immediate` whose `progressed` and `ended` the fact feeds back through `updateMaterialSources` in order, or a test-local host recording its job and the cancels of its handle. `the surface opens on the first source and its held snapshot`: `shownSourceOpt` names `Test source`, `snapshotOpt` is `2026-11-01` and there is no hit; over an import context with no source, `shownSourceOpt` is `None`. `SearchMaterialSource lists the hits the shown source finds`: `silicon` lists the Silicon hit; a double holding no snapshot holds `PullSourceErr (SourceSnapshotMissingErr _)` and no hit. `PullSourceRecord pulls the record and tells the opener what the library gained`: `PullSourceRecord` of the Silicon record sets the status `Pulled Si (Silicon), Aspnes as version 1.`, recorded once by `pullsApplied`, and the import seam holds the material. `UpdateSourceSnapshot runs the update with per-file progress, then refreshes the pulls and tells the opener`: after that pull, with `2026-11-04` published holding the record under another hash, `UpdateSourceSnapshot` over `immediate` reports 1 of 1 files, completes with `snapshotOpt` `2026-11-04`, and its status, recorded by `pullsApplied`, names version 2; over the recording host, a second `UpdateSourceSnapshot` while the first job is recorded starts none. `a cancelled update keeps the held snapshot and says so`: over the recording host, `CancelSourceSnapshot` records one cancel, and `SourceSnapshotEnded (Ok SourceRefreshCancelled)` leaves `snapshotOpt` `2026-11-01`, the cancelled status and the job not running. `a failed update tells why`: `SourceSnapshotEnded (Error (PullSourceErr (SourceDownloadErr \"offline\")))` holds that error with the job not running.", "acceptance": "After the surface lands, `updateMaterialSources` MUST search, pull through `pullRecord` and run Update snapshot through the injected `SourceSnapshotJobHost` with per-file progress and Cancel, one update at a time, telling the opener every caption a pull or an update produces; constructor-unit-tests MUST pass, including `the surface opens on the first source and its held snapshot`, `SearchMaterialSource lists the hits the shown source finds`, `PullSourceRecord pulls the record and tells the opener what the library gained`, `UpdateSourceSnapshot runs the update with per-file progress, then refreshes the pulls and tells the opener`, `a cancelled update keeps the held snapshot and says so` and `a failed update tells why`, the count rising by 6; ui-smoke MUST pass; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.MaterialsWindowTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/OpticalConstructor.Ui.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs", "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcesModelTests.the surface opens on the first source and its held snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcesModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCES-VIEW"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcesModelTests.SearchMaterialSource lists the hits the shown source finds", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcesModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCES-VIEW"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcesModelTests.PullSourceRecord pulls the record and tells the opener what the library gained", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcesModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCES-VIEW"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcesModelTests.UpdateSourceSnapshot runs the update with per-file progress, then refreshes the pulls and tells the opener", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcesModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCES-VIEW"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcesModelTests.a cancelled update keeps the held snapshot and says so", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcesModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCES-VIEW"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcesModelTests.a failed update tells why", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcesModelTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcesModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S131-SOURCES-VIEW"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.MaterialSourcesView.SourceSnapshotJobHandle", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.SourceSnapshotJobHost", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.MaterialSourcesContext", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.MaterialSourcesModel", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.MaterialSourcesMsg", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.initMaterialSources", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.updateMaterialSources", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}, {"symbol": "OpticalConstructor.Ui.MaterialSourcesView.materialSourcesView", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesView.fs", "obligations": ["S131-SOURCES-VIEW"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 451, "anchor": "IMPLEMENT", "ac": "AC-S131k", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Controls", "OpticalConstructor.Ui.Tests"], "depends_on": [450], "actions": ["ADD_TEST OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests"], "how_to": "The Online sources window: single-instance, fitted to its screen and reachable at small sizes (.spec-md §4 'UI': every new window calls `WindowFit.keepOnScreen` and joins `ScrollExtentTests`; §10.1; the S13.1 brief: ids, keepOnScreen, ScrollExtentTests). Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Controls/UiIds.fs`, the Online sources group (step 450): `materialSourcesWindow` (`\"MaterialSourcesWindow\"`) with a one-line doc. (2) `OpticalConstructor.Ui/WindowLauncher.fs`: `WindowKey` (`WindowLauncher.fs:34`) gains `MaterialSourcesWindowKey`, documented in one line: the single-instance Online sources window. (3) New `OpticalConstructor.Ui/MaterialSourcesWindow.fs` in `namespace OpticalConstructor.Ui`, compiled directly after `MaterialSourcesView.fs` (step 450) and before `MaterialsWindow.fs`: one `<Compile>` line and no comment. `type MaterialSourcesWindow(imports : CatalogueImportContext, pullsApplied : ControlCaption -> unit)` inherits `HostWindow`, is titled `Online sources`, carries `materialSourcesWindow` as its `Name` and `AutomationId`, opens at 720 × 640 and calls `WindowFit.keepOnScreen` (`OpticalConstructor.Controls/WindowLayout.fs`). It captures the Elmish dispatch from its init command as `MaterialsWindow` does (`MaterialsWindow.fs:35`) and runs `Program.mkProgram` over `initMaterialSources`, `updateMaterialSources` and `materialSourcesView` with the context `{ imports = imports; jobs = SourceSnapshotJobHost.onUiThread (SourceSnapshotProgressed >> dispatch) (SourceSnapshotEnded >> dispatch); pullsApplied = pullsApplied }` (step 450). Its `Closed` hook dispatches `CancelSourceSnapshot`, so a closed window leaves no update running. (4) `OpticalConstructor.Ui.Tests/WireUiFinalCompositionTests.fs`: `rootWindowFactory` (`WireUiFinalCompositionTests.fs:44`), exhaustive over `WindowKey`, answers `MaterialSourcesWindowKey` with `MaterialSourcesWindow(ctx.catalogueImports, ignore)`, as step 190 gave it `KitWindowKey`; its facts keep their names, keys and assertions, the window being rendered by its own ui-smoke fact below. (5) Tests. `OpticalConstructor.Ui.Tests/ScrollExtentTests.fs` gains `the Online sources window leaves everything reachable`: `assertReachable \"OnlineSources\"` (`ScrollExtentTests.fs:89`) over a `MaterialSourcesWindow` whose import context, `CatalogueImportContext.create (CatalogueImportProxy.createInMemory ()).proxy` with `materialSources` set by record update, offers step 443's double holding a snapshot, and whose `pullsApplied` ignores its caption. New `OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs`, `module MaterialSourcesWindowTests`, appended at the end of the compile list with no comment: its windows are built over that import context, the double holding the Silicon record (`main/Si/nk/Aspnes.yml`, `Si (Silicon), Aspnes`) at `2026-11-01`, and a recording `pullsApplied`, shown headless at 800 × 600 as `DataLocationsWindowTests` shows its window (step 193). Without a trait: `the Online sources UiIds are the stable intent-named ids`: the texts of `materialSourcesWindow` and of step 450's nine fixed ids, and `materialSourceChoice` of `Test source`, `materialSourceHitRow` and `materialSourcePullButton` of `main/Si/nk/Aspnes.yml`. `the Online sources window is titled, carries its id and lists its source with its snapshot`: the window is titled `Online sources` and carries `materialSourcesWindow` as its `Name` and `AutomationId`; `materialSourceChoice` of `Test source` exists; and `materialSourceSnapshotText` reads `Snapshot 2026-11-01`. `a window with no source says so and offers nothing`: over `CatalogueImportContext.create`'s `[]`, `materialSourcesStatusText` reads `No online material source is configured.` and no `materialSourceUpdateButton` or `materialSourceQueryBox` exists. With trait `ui-smoke`, pressing a box at its centre as `LibraryWindowTests.fs:clickOn` does: `pressing Search then Pull pulls the record and tells the opener`: with `materialSourceQueryBox`'s text set to `silicon`, pressing `materialSourceSearchButton` shows `materialSourceHitRow` of the Silicon record, and pressing its `materialSourcePullButton` records `Pulled Si (Silicon), Aspnes as version 1.` through `pullsApplied` and shows it in `materialSourcesStatusText`. `the Online sources window opens once through the registry`: two `openOrActivate MaterialSourcesWindowKey` through `WindowLauncher.create` over a factory building the window answer one live window, as step 194's Data locations fact does. No fact presses Update snapshot over a real downloader.", "acceptance": "After the window lands, `MaterialSourcesWindow` MUST be titled `Online sources`, carry its id, keep on screen, open single-instance under `MaterialSourcesWindowKey` and cancel a running update when it closes; constructor-unit-tests MUST pass; ui-smoke MUST pass, including `pressing Search then Pull pulls the record and tells the opener` and `the Online sources window opens once through the registry`, the count rising by 2; ui-tests MUST pass over the selected classes, including `the Online sources window leaves everything reachable`, `the Online sources UiIds are the stable intent-named ids`, `the Online sources window is titled, carries its id and lists its source with its snapshot` and `a window with no source says so and offers nothing`, the count rising by 4; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests", "OpticalConstructor.Ui.Tests.ScrollExtentTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/WindowLauncher.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesWindow.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/OpticalConstructor.Ui.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/WireUiFinalCompositionTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OpticalConstructor.Ui.Tests.fsproj"], "tests": [{"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.ScrollExtentTests.the Online sources window leaves everything reachable", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs", "class": "OpticalConstructor.Ui.Tests.ScrollExtentTests", "discovery_gate": "ui-tests", "obligations": ["S131-SOURCES-WINDOW"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests.the Online sources UiIds are the stable intent-named ids", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests", "discovery_gate": "ui-tests", "obligations": ["S131-SOURCES-WINDOW"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests.the Online sources window is titled, carries its id and lists its source with its snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests", "discovery_gate": "ui-tests", "obligations": ["S131-SOURCES-WINDOW"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests.a window with no source says so and offers nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests", "discovery_gate": "ui-tests", "obligations": ["S131-SOURCES-WINDOW"]}, {"op": "create", "suite": "ui-smoke", "id": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests.pressing Search then Pull pulls the record and tells the opener", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests", "discovery_gate": "ui-smoke", "obligations": ["S131-SOURCES-WINDOW"]}, {"op": "create", "suite": "ui-smoke", "id": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests.the Online sources window opens once through the registry", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialSourcesWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialSourcesWindowTests", "discovery_gate": "ui-smoke", "obligations": ["S131-SOURCES-WINDOW"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.MaterialSourcesWindow", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialSourcesWindow.fs", "obligations": ["S131-SOURCES-WINDOW"]}, {"symbol": "OpticalConstructor.Ui.WindowLauncher.WindowKey.MaterialSourcesWindowKey", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/WindowLauncher.fs", "obligations": ["S131-SOURCES-WINDOW"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.materialSourcesWindow", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S131-SOURCES-WINDOW"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 452, "anchor": "WIRE_UI", "ac": "AC-S131l", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Controls", "OpticalConstructor.Ui.Tests"], "depends_on": [451], "how_to": "The Materials window opens Online sources, and what a pull adds shows in it at once (001 §O; the S13.1 brief 'Materials window: an Online sources... search and fetch UI'; .spec-md §10.1 discoverability, §10.4 completion refresh; 001 §P: the button and the test send the same message). Each doc is one to three lines citing spec 0050 S13.1. (1) `OpticalConstructor.Ui/MaterialsWindowView.fs`: (a) `MaterialsWindowContext` (`MaterialsWindowView.fs:154`, steps 109, 110) gains `openOnlineSources : unit -> unit`, documented in one line: opens the single-instance Online sources window over the context's import seam (the composition root bakes it; tests record). (b) `MaterialsWindowMsg` gains `OpenOnlineSources`, documented in one line. (c) `updateMaterialsWindow`: `OpenOnlineSources` calls `context.openOnlineSources ()` and answers the model unchanged. (d) The verbs row (`MaterialsWindowView.fs:verbsRow`), in Browse mode and after step 119's export verbs: while `context.catalogueImports.materialSources` (step 444) is not empty, `verbButton ConstructorUiId.materialsOnlineSourcesButton (ControlCaption \"Online sources…\") (fun () -> dispatch OpenOnlineSources)`. Select mode never shows it, because a pick session imports nothing. (2) `OpticalConstructor.Ui/MaterialsWindow.fs`: the context's `openOnlineSources` is `openBrowse WindowLauncher.MaterialSourcesWindowKey (fun () -> MaterialSourcesWindow(catalogueImports, fun summary -> dispatch (MaterialsWindowView.MaterialsImportApplied summary)) :> Window)` (steps 110, 451), so a pull's or an update's caption becomes the window's import status and its next render re-queries the store, listing the pulled material and its new versions with no reload. The class doc names Online sources in no more words. (3) `OpticalConstructor.Controls/UiIds.fs`, the Materials window group (`UiIds.fs:525`): `materialsOnlineSourcesButton` (`\"MaterialsOnlineSourcesButton\"`) under a one-line comment citing spec 0050 S13.1. (4) Tests, in `MaterialsWindowTests`: `stubContext` (steps 110, 119) passes a recording `openOnlineSources`. `the Online sources UiId of the Materials window is the stable intent-named id`. `Online sources… is offered in Browse mode while the import seam carries a source`: over an import context whose `materialSources` holds step 443's double, the Browse view shows `materialsOnlineSourcesButton`, and `OpenOnlineSources` records one open and answers the model unchanged; over `[]`, and in Select mode, the button is absent. `a pull's caption is the Materials window's status and the pulled material is listed`: after the double's Silicon record is pulled through the context's import seam (`pullRecord`, step 444), `MaterialsImportApplied` of its caption sets `importStatus` to it, and `filteredEntries` lists the pulled material. With trait `ui-smoke`: `acceptance: Online sources… opens one Online sources window over the app's refractiveindex.info source`: over `AppContext.create (TestAppScope.fileLocations (FolderName \"MaterialsWindowTests\")) WorkbenchSettings.defaults` (steps 88, 446), a `MaterialsWindow` built as the launcher builds it (`ctx.materials`, `ctx.categories`, `ctx.catalogueImports`) is shown headless; pressing `materialsOnlineSourcesButton` opens exactly one `MaterialSourcesWindow`, observed through `Window.WindowOpenedEvent` as `LauncherTests.clickAndObserve` observes, whose `materialSourceChoice` names `refractiveindex.info` and whose `materialSourceSnapshotText` reads `No snapshot yet; Update snapshot downloads the database.`; pressing it again opens no second window. Nothing presses Update snapshot, so nothing is downloaded.", "acceptance": "After the button is wired, the Materials window MUST offer `Online sources…` in Browse mode while its import seam carries a source, `OpenOnlineSources` MUST open the single-instance Online sources window, and a pull's caption MUST become its import status; constructor-unit-tests MUST pass; ui-smoke MUST pass, including `acceptance: Online sources… opens one Online sources window over the app's refractiveindex.info source`, the count rising by 1; ui-tests MUST pass over the selected classes, including `the Online sources UiId of the Materials window is the stable intent-named id`, `Online sources… is offered in Browse mode while the import seam carries a source` and `a pull's caption is the Materials window's status and the pulled material is listed`, the count rising by 3; and build, elevation and the twenty-one s43 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.MaterialsWindowTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindowView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindow.fs", "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs"], "tests": [{"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.the Online sources UiId of the Materials window is the stable intent-named id", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-tests", "obligations": ["S131-MATERIALS-WIRE"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.Online sources… is offered in Browse mode while the import seam carries a source", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-tests", "obligations": ["S131-MATERIALS-WIRE"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.a pull's caption is the Materials window's status and the pulled material is listed", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-tests", "obligations": ["S131-MATERIALS-WIRE"]}, {"op": "create", "suite": "ui-smoke", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.acceptance: Online sources… opens one Online sources window over the app's refractiveindex.info source", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-smoke", "obligations": ["S131-MATERIALS-WIRE"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.MaterialsWindowView.MaterialsWindowContext.openOnlineSources", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindowView.fs", "obligations": ["S131-MATERIALS-WIRE"]}, {"symbol": "OpticalConstructor.Ui.MaterialsWindowView.MaterialsWindowMsg.OpenOnlineSources", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindowView.fs", "obligations": ["S131-MATERIALS-WIRE"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.materialsOnlineSourcesButton", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S131-MATERIALS-WIRE"]}], "packages": [], "checks": []}, "section": "S13.1 -- MaterialSourceProxy and refractiveindex.info"}
{"number": 453, "anchor": "IMPLEMENT", "ac": "AC-S132a", "touches": ["Berreman", "OpticalConstructor.Storage", "BerremanTests", "OpticalConstructor.Tests"], "depends_on": [452], "how_to": "S1.1's tabulated case carries optional per-sample one-sigma uncertainties of n and k as data, serialised with the table, so that a material pulled with them keeps them in its entry file, the database payload and a kit's snapshot (001 §D 'PTB OCDB (CC BY 4.0): EUV / VUV n, k with uncertainties', 'Uncertainties travel with the material (PTB's σ) and become priors in studies and inputs to the Planner'; the S13.2 brief 'S1.1's tabulated case gains optional per-sample sigma-n / sigma-k arrays (data, serialised)'). Each doc is one to three lines citing spec 0050 S13.2. (1) `Berreman/Berreman/Dispersion.fs`, beside `TabulatedNkTable` (step 2): (a) `TabulatedNkUncertainty`, a record marked `[<Softellect.Sys.NumericCarrier(\"per-sample one-sigma uncertainties of a tabulated n,k table, read beside its columns\")>]` with `sigmaN : float array` and `sigmaK : float array`, one value per sample of its table in the table's order. (b) `TabulatedTableError` (step 2) gains `InvalidUncertaintyErr of reason : string`, naming the first offending column and index. (c) `TabulatedNkTable` gains, last, `uncertaintyOpt : TabulatedNkUncertainty option`, with a one-line doc: the source's one-sigma uncertainty of each sample, `None` where the source gives none. `tryCreate` keeps its signature and sets `None`, so every table built today keeps its value. (d) `member this.withUncertainty (sigmaN : float array) (sigmaK : float array) : Result<TabulatedNkTable, TabulatedTableError>` answers the table holding them: two columns whose lengths are not the table's are `SampleCountMismatchErr` naming the lengths, and a NaN, infinite or negative value is `InvalidUncertaintyErr`; it neither sorts nor copies the columns' order. `complexIndex` (step 2) reads no uncertainty, so no number of any table moves. (2) Every complete match on `TabulatedTableError` that FS0025 reports maps the new case as it maps the other three: `OpticalConstructor.Storage/MaterialImport.fs`' tabulated import (step 2) answers it as `NoDataErr` carrying its reason. The material entry schema is unchanged, because the physics inside a payload is bound by the serializer (step 30), and no committed file changes, because no built-in or committed kit entry is tabulated: the built-in dispersive axes are published laws (step 8; `OpticalConstructor.Domain/MaterialLibrary.fs:455`, `:476-477`). No interpolation of the uncertainty, option or other member is added: a reader takes a sample's σ from the columns. (3) Tests. `Berreman/BerremanTests/EpsWithDispValueTests.fs` gains `A tabulated table takes per-sample uncertainties of its own length and refuses any other`: over the hand-written table of step 2's facts (400, 500 and 700 nm), `withUncertainty [| 0.01; 0.02; 0.03 |] [| 0.0; 0.001; 0.002 |]` answers the table holding exactly those columns with `complexIndex` unchanged at each sample (through `BerremanTests.MatrixComparison`'s helpers); columns of two values answer `SampleCountMismatchErr`; a negative, a NaN and an infinite value answer `InvalidUncertaintyErr`; and `tryCreate` answers `uncertaintyOpt = None`. `OpticalConstructor.Tests/EntryFileJsonTests.fs` gains `a tabulated material keeps its per-sample uncertainties through an entry file`: a user material whose complexity is one isotropic dispersive segment over that table with those uncertainties round-trips content → `sealed` → `fileText` → `parseEntry` (step 30), its decoded table equal to the original, uncertainties included; and the same material without uncertainties round-trips with `uncertaintyOpt = None`.", "acceptance": "After the uncertainties land, `TabulatedNkTable` MUST carry `uncertaintyOpt : TabulatedNkUncertainty option`, built only through `withUncertainty`, with every table's numbers unchanged and an entry file keeping the arrays; unit-tests MUST pass over the selected class `BerremanTests.EpsWithDispValueTests`, including `A tabulated table takes per-sample uncertainties of its own length and refuses any other`, the count rising by 1; constructor-unit-tests MUST pass, including `a tabulated material keeps its per-sample uncertainties through an entry file`, the count rising by 1; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests", "constructor-unit-tests", "ui-smoke", "ui-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.EpsWithDispValueTests"]}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.MaterialEditorWindowTests", "OpticalConstructor.Ui.Tests.NkDispersionChartTests"]}, "kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/Berreman/Dispersion.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "Berreman/BerremanTests/EpsWithDispValueTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/EntryFileJsonTests.fs"], "tests": [{"op": "create", "suite": "unit-tests", "id": "BerremanTests.EpsWithDispValueTests.A tabulated table takes per-sample uncertainties of its own length and refuses any other", "path": "Berreman/BerremanTests/EpsWithDispValueTests.fs", "class": "BerremanTests.EpsWithDispValueTests", "discovery_gate": "unit-tests", "obligations": ["S132-TABLE-SIGMA"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.EntryFileJsonTests.a tabulated material keeps its per-sample uncertainties through an entry file", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/EntryFileJsonTests.fs", "class": "OpticalConstructor.Tests.EntryFileJsonTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-TABLE-SIGMA"]}], "contracts": [{"symbol": "Berreman.Dispersion.TabulatedNkUncertainty", "op": "create", "path": "Berreman/Berreman/Dispersion.fs", "obligations": ["S132-TABLE-SIGMA"]}, {"symbol": "Berreman.Dispersion.TabulatedNkTable.uncertaintyOpt", "op": "create", "path": "Berreman/Berreman/Dispersion.fs", "obligations": ["S132-TABLE-SIGMA"]}, {"symbol": "Berreman.Dispersion.TabulatedNkTable.withUncertainty", "op": "create", "path": "Berreman/Berreman/Dispersion.fs", "obligations": ["S132-TABLE-SIGMA"]}, {"symbol": "Berreman.Dispersion.TabulatedTableError.InvalidUncertaintyErr", "op": "create", "path": "Berreman/Berreman/Dispersion.fs", "obligations": ["S132-TABLE-SIGMA"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 454, "anchor": "IMPLEMENT", "ac": "AC-S132b", "touches": ["OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [453], "how_to": "PTB's optical-constants records are read by the module that reads every other optical-constants file, so the adapter of step 455 parses nothing itself (001 §D 'PTB OCDB (CC BY 4.0): EUV / VUV n, k with uncertainties'; AGENTS.md 'Reuse, never copy'). The format is the one PTB publishes (`github.com/PTB-SR/ocdb`, branch `master`, `ocdb/db/data/<name>.txt`, verified 2026-11-04): `#` comment lines, among them `# n = (1-delta) - (i*beta)` and `# The values are provided with their 3-sigma uncertainty bounds. HB: Higher Bound. LB: Lower Bound.`, then the column header `#lambda/nm\\t1-delta\\tbeta\\t1-delta_LB\\t1-delta_HB\\tbeta_LB\\tbeta_HB`, then tab-separated rows, the wavelength in nm. The bounds are absolute values at the stated sigma level, not offsets. Each doc is one to three lines citing spec 0050 S13.2. In `OpticalConstructor.Storage/MaterialImport.fs`: (1) `ImportError` gains `MalformedSourceFileErr of reason : string`, and its `describe` (step 445) renders `the source file is malformed: <reason>`. (2) The entry assembly of the tabulated import (`entryFromTabulated`, step 2: one isotropic dispersive segment over the table's `sampleRange` whose axis is `TabulatedNK table`, no magnetic or active part, a minted `MaterialId`) MOVES into `type TabulatedNkTable with member this.isotropicEntry (name : EntryName) (category : CategoryId) (description : EntryDescription) : MaterialEntry`, which `entryFromTabulated` calls, so the refractiveindex.info and CSV imports keep every field and number and one assembly serves every tabulated source. (3) `PtbOcdbText of string` with `.value`, the text of one PTB record. `type PtbOcdbText with`: (a) `member this.headlineOpt : EntryCitation option`, the text of the first comment line with its `#` and surrounding white space removed, `None` for a text without one; (b) `member this.importMaterial : Result<MaterialEntry, ImportError>`, reading the lines (`\\r\\n` as `\\n`): the column header is the comment whose text after `#` starts with `lambda/nm`, its columns split on tabs and spaces; the sigma level is the integer before `-sigma` in a comment (ordinal, ignoring case), as `3` in `3-sigma`; every other non-empty line is a row of numbers split on tabs and spaces and read with the invariant culture. The columns `lambda/nm`, `1-delta` and `beta` MUST be present; the four bound columns `1-delta_LB`, `1-delta_HB`, `beta_LB` and `beta_HB` are all present or all absent. n is `1-delta`, k is `beta` (PTB writes n = (1 − δ) − iβ with β ≥ 0, the engine n + ik with k ≥ 0), and each wavelength goes through `toMeters Nanometer` (the one Units seam, `OpticalConstructor.Domain/Units.fs:75`). With bounds, σn = (n_HB − n_LB) / (2 × level) and σk = (k_HB − k_LB) / (2 × level): half the bound interval, divided by its sigma level. The rows are sorted by wavelength, their uncertainties with them, as `entryFromTabulated` sorts its rows (step 2); the table is `TabulatedNkTable.tryCreate` then, with bounds, `withUncertainty` (step 453), each `TabulatedTableError` answering `MalformedSourceFileErr` carrying its reason. The answer is `table.isotropicEntry (EntryName \"Imported (PTB OCDB)\") CategoryIds.semiconductor (EntryDescription \"Imported tabulated n,k (PTB OCDB).\")`, the category the tabulated refractiveindex.info import files (`MaterialImport.fs:502`), so the adapter names it (step 455). A missing required column, a partial set of bound columns, bounds without a sigma level, and a row whose value count is not the header's or that does not read are `MalformedSourceFileErr` naming the column, the level or the 1-based line; a text without a row is `NoDataErr`; every .NET call that throws is caught and answered `MalformedSourceFileErr`. No unit heuristic, second format or option is added. (4) Fixture: new `OpticalConstructor.Tests/fixtures/ptb-Co.txt`, a `Content` item copied `PreserveNewest` beside `fixtures/sample-nk.csv`'s with no comment: the seven header lines of PTB's `Co.txt` exactly (`# Optical constants for Co created by PTB`, `# Reconstructed from reflection measurements in the wavelength range 8 - 25 nm`, `# 40 nm Co thin film in a multilayer on Si (C/ Co/ Ru/ Si) (measured 4/2022)`, `# n = (1-delta) - (i*beta)`, the 3-sigma line, the column header and `# ------------------------`) and three of its rows, tab-separated: `8.0 0.96788 0.02267 0.96772 0.96804 0.02253 0.0228`, `11.2 0.95225 0.05349 0.95194 0.95256 0.05327 0.05371` and `25.0 0.92771 0.10418 0.92583 0.92962 0.10319 0.10517`; CC BY 4.0 data credited by its own first line. (5) Tests, in `MaterialImportTests`: `a PTB OCDB record reads n as 1 - delta and k as beta, its 3-sigma bounds as one-sigma uncertainties`: `(PtbOcdbText <fixtures/ptb-Co.txt>).importMaterial` answers one isotropic dispersive segment whose `TabulatedNK` table holds 8.0, 11.2 and 25.0 nm in metres, n 0.96788, 0.95225 and 0.92771, k 0.02267, 0.05349 and 0.10418, and σn and σk the fact computes from the row's bounds as (HB − LB) / 6 (within 1e-15); and `headlineOpt` is `Optical constants for Co created by PTB`. `a PTB OCDB record without bounds has no uncertainty, and a malformed record is refused`: a test-local text of the header without bound columns and two rows answers `uncertaintyOpt = None`; texts without the `beta` column, with `beta_LB` alone, with bounds but no sigma line, and with a row of six values each answer `MalformedSourceFileErr`; and a header without a row answers `NoDataErr`. `every import error renders its condition and its payload` (step 445) also renders `MalformedSourceFileErr`.", "acceptance": "After the reader lands, `PtbOcdbText.importMaterial` MUST read a PTB OCDB record into one isotropic tabulated segment whose n is 1 − δ, k is β and per-sample uncertainty is the bound interval over twice its sigma level, and every tabulated import MUST assemble its entry through `TabulatedNkTable.isotropicEntry` with its fields unchanged; constructor-unit-tests MUST pass, including `a PTB OCDB record reads n as 1 - delta and k as beta, its 3-sigma bounds as one-sigma uncertainties`, `a PTB OCDB record without bounds has no uncertainty, and a malformed record is refused` and the widened `every import error renders its condition and its payload`, the count rising by 2; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/fixtures/ptb-Co.txt", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a PTB OCDB record reads n as 1 - delta and k as beta, its 3-sigma bounds as one-sigma uncertainties", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PTB-READER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a PTB OCDB record without bounds has no uncertainty, and a malformed record is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PTB-READER"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.every import error renders its condition and its payload", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "obligations": ["S132-PTB-READER"]}], "contracts": [{"symbol": "OpticalConstructor.Storage.MaterialImport.PtbOcdbText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S132-PTB-READER"]}, {"symbol": "OpticalConstructor.Storage.MaterialImport.ImportError.MalformedSourceFileErr", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S132-PTB-READER"]}, {"symbol": "OpticalConstructor.Storage.MaterialImport.TabulatedNkTable.isotropicEntry", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S132-PTB-READER"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 455, "anchor": "IMPLEMENT", "ac": "AC-S132c", "touches": ["OpticalConstructor.Storage", "OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [454], "how_to": "The PTB OCDB adapter is a second `MaterialSourceProxy` over an offline snapshot of PTB's repository, kept and updated by the body the refractiveindex.info adapter already runs (001 §D '2. PTB OCDB (CC BY 4.0)'; the S13.1 mapper's note: PTB and Henke are further `MaterialSourceProxy` creates; AGENTS.md 'Reuse, never copy': the shared body moves, it is not copied). Verified 2026-11-04: `github.com/PTB-SR/ocdb`, default branch `master`, the records at `ocdb/db/data/<name>.txt` (`Co.txt`, `Ru.txt`, `Ru_2019.txt`, `TiN.txt` …, no index file) and `ocdb/db/COPYING`, which says the data files in `data` are licensed under CC BY 4.0. Each doc is one to three lines citing spec 0050 S13.2. In `OpticalConstructor.Storage/MaterialSourceStore.fs` (step 447): (1) The snapshot body MOVES out of `createRefractiveIndexInfo` into private shapes that it and every later adapter call, its behaviour and S13.1's eight facts unchanged: `SourceSnapshotLayout = { source : MaterialSourceName; folder : FolderName }`, the snapshot folder whose siblings `<folder>.zip.tmp`, `<folder>.tmp` and `<folder>.old` an update uses; `SourceArchiveEntryChoice` = `KeepArchiveEntry` | `DropArchiveEntry`; `SourceArchiveSpec = { url : SourceArchiveUrl; requiredFile : KitRelativePath; keep : KitRelativePath -> SourceArchiveEntryChoice }`, paths relative to the archive's one top folder. On the layout: `member this.snapshotVersion` (step 447's stamp read), `member this.heldVersion : Result<MaterialSourceVersion, MaterialSourceError>` (`SourceSnapshotMissingErr` without a stamp), `member this.installFrom (staged : FolderName) (clock : ClockProvider) (files : SourceSnapshotFileCount)` (the stamp written into the staged folder, the held folder moved to `.old`, the staged one moved in, the leftovers deleted, an error moving `.old` back) and `member this.updateFromArchive (spec : SourceArchiveSpec) (downloader : SourceArchiveDownloader) (clock : ClockProvider) (observer : SourceSnapshotObserver)` (step 447's download, `listZipEntries`, top-folder check, `extractKitZip` and cancellation, keeping the file entries `spec.keep` keeps and requiring `spec.requiredFile`, else `SourceArchiveInvalidErr`). `createRefractiveIndexInfo` builds its layout and spec (`database/catalog-nk.yml` required; that file and everything under `database/data/` kept) and calls them. Each private declaration whose signature carries a bare primitive for this IO keeps step 447's `ElevationBoundary` mark. (2) `type MaterialSourceProxy with static member createPtbOcdb (sources : FolderName) (downloader : SourceArchiveDownloader) (clock : ClockProvider) : MaterialSourceProxy`, unique on its receiver (ELEV019). Building it touches nothing. `sourceName` is `MaterialSourceName \"PTB OCDB\"`, the folder `<sources>/ptb-ocdb`, the licence `EntryLicence \"CC-BY-4.0\"` and the archive `SourceArchiveUrl \"https://github.com/PTB-SR/ocdb/archive/refs/heads/master.zip\"`, each written there alone; its spec requires `ocdb/db/COPYING` and keeps that file and every file directly in `ocdb/db/data/` whose name ends in `.txt` (ordinal, ignoring case). `snapshotVersion` and `updateSnapshot` are the layout's. `searchRecords query`: `heldVersion`, then `query.filter` (step 443) of one hit per `.txt` file of the snapshot's `ocdb/db/data/`, in ordinal order of file name: `record = MaterialSourceRecordId <the file name>` and `name = EntryName \"<its stem> (PTB OCDB)\"`; an IO exception is `SourceSnapshotIoErr`. `fetchRecord record`: `heldVersion`; a record the search does not list (a separator in it included) is `SourceRecordMissingErr` naming it; otherwise the file's bytes give `recordHash = ContentHash.ofBytes <the bytes>` (step 123) and their UTF-8 text, a leading byte-order mark dropped, is `PtbOcdbText` (step 454), whose `importMaterial` error is `SourceRecordUnreadableErr` naming the record with the error's `describe`. The answer is `{ pull = { source; record; recordHash; sourceVersion = <the stamp's>; licence; citation }; material = { <the import> with name = <the hit's name> } }`, the citation `EntryCitation \"PTB Optical Constants Database (OCDB), ocdb/db/data/<record>\"` followed, when `headlineOpt` answers one, by `: ` and its text, so S3.3's CC-BY rule shows it (step 113). No retry, cache, mirror, second URL or setting is added (.spec-md §8). (3) `OpticalConstructor.Domain/MaterialSources.fs`: the `MaterialSourceProxy` doc (step 443) names `createPtbOcdb` beside the other creates in no more words. Tests, in `OpticalConstructor.Tests/MaterialSourceFixture.fs` (step 447), each with a one-line doc: `ptbRecord ()` is the text of `fixtures/ptb-Co.txt`; `changedPtbRecord ()` is it with `0.96804` replaced by `0.96810`; `writePtbSnapshot (snapshot : string) (record : string) : unit` writes `ocdb/db/COPYING` (a test-local licence line), `record` as `ocdb/db/data/Co.txt`, a three-column record (step 454's header lines without the bound columns or the 3-sigma line, and two rows) as `ocdb/db/data/Ru_2019.txt` and the stamp of `2026-11-01`; `writePtbArchive (zip : string) (record : string) : unit` writes a GitHub-style archive whose one top folder `ocdb-master/` holds `README.rst`, `ocdb/db/literature.bib`, `ocdb/db/metadata/elements/Co.yaml` and the three files `writePtbSnapshot` writes but the stamp. In `MaterialSourceStoreTests`, each over a fresh sources folder: `a PTB OCDB source without a snapshot answers no version and refuses search and fetch`: `snapshotVersion` is `Ok None`, and `searchRecords` and `fetchRecord` are `SourceSnapshotMissingErr`. `a PTB OCDB snapshot lists its data records, and a fetched record is the reader's material with CC BY 4.0 and its citation`: over `writePtbSnapshot` of `ptbRecord ()`, a blank query lists `Co.txt` named `Co (PTB OCDB)` then `Ru_2019.txt`, and `co` lists `Co.txt` alone; the fetched `Co.txt` holds the physics of `(PtbOcdbText (ptbRecord ())).importMaterial`, uncertainties included, under its hit's name, the file's hash, `2026-11-01`, `CC-BY-4.0` and the citation `PTB Optical Constants Database (OCDB), ocdb/db/data/Co.txt: Optical constants for Co created by PTB`; `Ru_2019.txt` holds no uncertainty; and `../Co.txt` and `Ta.txt` answer `SourceRecordMissingErr`. `a PTB OCDB update keeps the data records and the licence file of the repository archive`: `updateSnapshot` with `copyingDownloader` of `writePtbArchive` of `changedPtbRecord ()` and `fixedClock` of 2026-11-04 answers `SourceSnapshotUpdated` of `2026-11-04` and three files, its progress reading 1 to 3 of 3; the one URL asked is the archive's; the snapshot holds exactly `.snapshot-json`, `ocdb/db/COPYING` and the two records, with no `README.rst`, `literature.bib` or metadata; and the sources folder holds nothing else. `a PTB OCDB archive without its licence file is refused and the held snapshot kept`: an archive without `ocdb/db/COPYING` answers `SourceArchiveInvalidErr`, and the held snapshot keeps its files byte for byte. `an update downloads the archive and replaces the snapshot with its catalog and data, file by file` and S13.1's other refractiveindex.info facts keep their assertions.", "acceptance": "After the adapter lands, a test MUST instantiate the real `MaterialSourceProxy.createPtbOcdb` over a fixture snapshot under the test output, its fetch MUST parse a record through `PtbOcdbText` with its uncertainties under the file's hash, the stamp's version, CC-BY-4.0 and PTB's citation, and its update MUST run the snapshot body it shares with refractiveindex.info; constructor-unit-tests MUST pass, including `a PTB OCDB source without a snapshot answers no version and refuses search and fetch`, `a PTB OCDB snapshot lists its data records, and a fetched record is the reader's material with CC BY 4.0 and its citation`, `a PTB OCDB update keeps the data records and the licence file of the repository archive`, `a PTB OCDB archive without its licence file is refused and the held snapshot kept` and the unchanged `an update downloads the archive and replaces the snapshot with its catalog and data, file by file`, the count rising by 4; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceFixture.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a PTB OCDB source without a snapshot answers no version and refuses search and fetch", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PTB-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a PTB OCDB snapshot lists its data records, and a fetched record is the reader's material with CC BY 4.0 and its citation", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PTB-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a PTB OCDB update keeps the data records and the licence file of the repository archive", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PTB-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a PTB OCDB archive without its licence file is refused and the held snapshot kept", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PTB-ADAPTER"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceProxy.createPtbOcdb", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S132-PTB-ADAPTER"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 456, "anchor": "IMPLEMENT", "ac": "AC-S132d", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [455], "actions": ["ADD_TEST OpticalConstructor.Tests.HenkeCompoundsTests"], "how_to": "The Henke compound calculator's physics as pure Domain data and functions: a chemical formula and a density, with each element's CXRO atomic scattering factors f1 and f2, give n and k over the EUV and X-ray range as S1.1's tabulated table (001 §D '3. A Henke-based compound calculator (CXRO f₁, f₂ + formula + density) for EUV and X-ray'; the S13.2 brief). CXRO's relation (henke.lbl.gov/optical_constants/intro.html, verified 2026-11-04) is n = 1 − r₀ λ² Σ_q N_q (f1_q + i f2_q) / 2π, N_q atoms of element q per unit volume, which in the engine's n + ik with k ≥ 0 is n = 1 − δ and k = β, δ = r₀ λ² Σ_q N_q f1_q / 2π and β = r₀ λ² Σ_q N_q f2_q / 2π. New `OpticalConstructor.Domain/HenkeCompounds.fs`, `module HenkeCompounds` in `namespace OpticalConstructor.Domain`, compiled directly before `MaterialSources.fs` (step 443): one `<Compile>` line in `OpticalConstructor.Domain.fsproj` and no comment. It opens `Berreman.Dispersion`, `Units` and `LibraryEntryFiles`. Its module doc and each declaration's doc are one to three lines citing spec 0050 S13.2; every case name has two words. In order: (1) `HenkeCompoundError`, an `*Error` union whose every case is `of reason : string`: `InvalidFormulaErr`, `UnknownElementErr`, `InvalidDensityErr`, `InvalidCompoundQueryErr`, `MissingScatteringFactorsErr`, `InvalidScatteringFactorsErr`, `NoCommonEnergyErr` and `CompoundTableErr`, with `member this.describe : string` rendering `the formula is not valid: <reason>`, `the formula names no known element: <reason>`, `the density is not valid: <reason>`, `the query names no compound: <reason>`, `an element's scattering factors are missing: <reason>`, `the scattering factors are not valid: <reason>`, `the elements share no energy: <reason>` and `the compound's table could not be built: <reason>`. (2) `AtomicNumber of int`, `ElementSymbol of string` and `AtomicWeight of float` (g/mol), each with `.value`; `ChemicalElement = { atomicNumber : AtomicNumber; symbol : ElementSymbol; atomicWeight : AtomicWeight }` with `static member all : ChemicalElement list`, the 92 elements CXRO tabulates, hydrogen (Z = 1) to uranium (Z = 92) in order, each written there once with the IUPAC (CIAAW 2021) standard atomic weight abridged to five significant figures, and for Tc, Pm, Po, At, Rn, Fr, Ra and Ac, which have none, the mass number periodic tables give in brackets (98, 145, 209, 210, 222, 223, 226, 227); and `static member tryOfSymbol (symbol : string) : ChemicalElement option`, case-sensitive (`Co` is cobalt, `CO` no symbol). This table of physical constants is not a library entry, so it is code (.spec-md §3.3 concerns library seeds). (3) `AtomCount of float` with `.value`; `FormulaCount = { element : ChemicalElement; count : AtomCount }`; `ChemicalFormula = { counts : FormulaCount list }` with `static member tryParse (text : string) : Result<ChemicalFormula, HenkeCompoundError>`: the whole text MUST be one or more groups of an element symbol (an upper-case letter, and a following lower-case letter when there is one) and an optional count (digits, optionally a `.` and digits; absent is 1), so `SiO2`, `Si3N4`, `MoSi2` and `Si0.5Ge0.5` read; a repeated element adds its counts at its first position (`CH3COOH` is C 2, H 4, O 2); a symbol the table lacks is `UnknownElementErr` naming it; an empty text, a zero count, a parenthesis, a space or any other character is `InvalidFormulaErr` naming the first unread character; `member this.text : string`, each symbol followed by its count when it is not 1 (`G6`, invariant culture), in order; and `member this.molarMass : AtomicWeight`, Σ count × weight. (4) `CompoundDensity of float` (g/cm³) with `.value` and `static member tryCreate (value : float) : Result<CompoundDensity, HenkeCompoundError>` refusing a NaN, infinite, zero or negative value with `InvalidDensityErr`. (5) `CompoundSpec = { formula : ChemicalFormula; density : CompoundDensity }` with `member this.recordId : MaterialSourceRecordId` (`<formula text>@<density, G6>`), `member this.entryName : EntryName` (`<formula text>, ρ = <density, G6> g/cm³ (CXRO Henke)`), `static member tryOfRecord (record : MaterialSourceRecordId) : Result<CompoundSpec, HenkeCompoundError>`, its inverse, and `static member tryOfQuery (query : MaterialSourceQuery) : Result<CompoundSpec, HenkeCompoundError>` (step 443): the query's text split on white space MUST be two words, a formula and a density read with the invariant culture, else `InvalidCompoundQueryErr` whose reason ends `write a chemical formula and a density in g/cm³, for example SiO2 2.2`. (6) `AtomicScatteringFactors`, a record marked `[<Softellect.Sys.NumericCarrier(\"one element's tabulated f1, f2 over photon energy, read whole for each compound sample\")>]` with `energies : float array` (eV, non-decreasing), `f1 : float array` and `f2 : float array`, and `static member tryCreate (energies : float array) (f1 : float array) (f2 : float array) : Result<AtomicScatteringFactors, HenkeCompoundError>` refusing an empty table, unequal columns and a decreasing energy with `InvalidScatteringFactorsErr`, without sorting. (7) `type CompoundSpec with member this.indexTableWith (factors : Map<ElementSymbol, AtomicScatteringFactors>) : Result<TabulatedNkTable, HenkeCompoundError>`: an element of the formula without factors is `MissingScatteringFactorsErr` naming it; the common range is from the largest first energy to the smallest last energy of the formula's elements, `NoCommonEnergyErr` when it is empty; the grid is every element's energies inside it, ascending, each once; at a grid energy E an element's f1 and f2 are its own row's at its own energies and otherwise linear in E between its bracketing rows; the number density of element q is N_q = count_q × ρ × 10⁶ × N_A / M (per m³: ρ in g/cm³, M the formula's `molarMass`), λ is `toMeters ElectronVolt (UnitMagnitude E)` (`OpticalConstructor.Domain/Units.fs:75`, so no photon-energy constant is re-transcribed), and n = 1 − δ, k = β as above, with r₀ = 2.8179403262e-15 m (CODATA 2018) and N_A = 6.02214076e23 mol⁻¹ (exact), each a private value written there alone. The rows are ordered by ascending λ (descending energy) and built through `TabulatedNkTable.tryCreate` (step 2), a refusal being `CompoundTableErr`; the table carries no uncertainty, because CXRO gives none. No parenthesised formula, isotope, other energy grid, cache or option is added. Tests: new `OpticalConstructor.Tests/HenkeCompoundsTests.fs`, `module HenkeCompoundsTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment. `the element table holds the 92 elements from hydrogen to uranium with their standard atomic weights`: 92 elements, atomic numbers 1 to 92 in order, unique symbols, `H` 1.0080, `O` 15.999, `Si` 28.085, `Mo` 95.95, `Tc` 98 and `U` 238.03, and `tryOfSymbol \"CO\"` `None`. `a chemical formula reads element symbols and counts, merging repeats, and refuses anything else`: `SiO2` is Si 1, O 2 with the text `SiO2`; `Si3N4`, `MoSi2` and `Si0.5Ge0.5` read their counts; `CO` is C 1, O 1 and `Co` cobalt; `CH3COOH` is `C2H4O2`; and `\"\"`, `Ca(OH)2`, `SiO2 ` (a trailing space), `si` and `O0` answer `InvalidFormulaErr`, `Xx2` `UnknownElementErr`. `a compound query and record name a formula and a density, and anything else is refused`: the query `SiO2 2.2` is SiO2 at 2.2, whose `recordId` is `SiO2@2.2` and `entryName` `SiO2, ρ = 2.2 g/cm³ (CXRO Henke)`, and `tryOfRecord` of that record answers it back; `SiO2`, `SiO2 -1`, `SiO2 abc` and `SiO2 2.2 x` answer `InvalidCompoundQueryErr` or `InvalidDensityErr`. `a compound's index is one minus delta plus i beta over its elements' common energies`: test-local factor tables for Si (100, 200 and 300 eV; f1 10, 12, 13; f2 2, 1, 0.5) and O (150, 250 and 400 eV; f1 6, 7, 7.5; f2 3, 2, 1) give, for SiO2 at 2.2 g/cm³, a table over the energies 300, 250, 200 and 150 eV in that order of ascending λ, each n and k equal within 1e-12 relative to the fact's own evaluation of the formulas above at that energy (O's f1 6.5 at 200 eV, Si's 11.5 at 150 eV), and no uncertainty. `a compound lacking one element's factors, or a common energy, is refused`: SiO2 with Si's table alone answers `MissingScatteringFactorsErr` naming O; Si's table with an O table over 400 to 500 eV answers `NoCommonEnergyErr`; and `tryCreate` refuses an empty, an unequal and a decreasing table. `every Henke compound error renders its condition and its payload`: each case over a distinct test-local reason renders a distinct text holding it.", "acceptance": "After the physics lands, `HenkeCompounds` MUST hold the 92 elements with their atomic weights, parse a formula, a density, a query and a record, and compute a compound's `TabulatedNkTable` as n = 1 − δ, k = β over its elements' common energies; constructor-unit-tests MUST pass, including `the element table holds the 92 elements from hydrogen to uranium with their standard atomic weights`, `a chemical formula reads element symbols and counts, merging repeats, and refuses anything else`, `a compound query and record name a formula and a density, and anything else is refused`, `a compound's index is one minus delta plus i beta over its elements' common energies`, `a compound lacking one element's factors, or a common energy, is refused` and `every Henke compound error renders its condition and its payload` under `HenkeCompoundsTests`, the count rising by 6; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.HenkeCompoundsTests.the element table holds the 92 elements from hydrogen to uranium with their standard atomic weights", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "class": "OpticalConstructor.Tests.HenkeCompoundsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-PHYSICS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.HenkeCompoundsTests.a chemical formula reads element symbols and counts, merging repeats, and refuses anything else", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "class": "OpticalConstructor.Tests.HenkeCompoundsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-PHYSICS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.HenkeCompoundsTests.a compound query and record name a formula and a density, and anything else is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "class": "OpticalConstructor.Tests.HenkeCompoundsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-PHYSICS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.HenkeCompoundsTests.a compound's index is one minus delta plus i beta over its elements' common energies", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "class": "OpticalConstructor.Tests.HenkeCompoundsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-PHYSICS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.HenkeCompoundsTests.a compound lacking one element's factors, or a common energy, is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "class": "OpticalConstructor.Tests.HenkeCompoundsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-PHYSICS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.HenkeCompoundsTests.every Henke compound error renders its condition and its payload", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/HenkeCompoundsTests.fs", "class": "OpticalConstructor.Tests.HenkeCompoundsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-PHYSICS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.HenkeCompounds.HenkeCompoundError", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}, {"symbol": "OpticalConstructor.Domain.HenkeCompounds.ChemicalElement", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}, {"symbol": "OpticalConstructor.Domain.HenkeCompounds.ChemicalFormula", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}, {"symbol": "OpticalConstructor.Domain.HenkeCompounds.CompoundDensity", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}, {"symbol": "OpticalConstructor.Domain.HenkeCompounds.CompoundSpec", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}, {"symbol": "OpticalConstructor.Domain.HenkeCompounds.AtomicScatteringFactors", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}, {"symbol": "OpticalConstructor.Domain.HenkeCompounds.CompoundSpec.indexTableWith", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/HenkeCompounds.fs", "obligations": ["S132-HENKE-PHYSICS"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 457, "anchor": "IMPLEMENT", "ac": "AC-S132e", "touches": ["OpticalConstructor.Storage", "OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [456], "how_to": "The Henke compound calculator is a third `MaterialSourceProxy`: its snapshot is CXRO's per-element factor files, fetched once and kept in the sources folder, and a record is a compound it computes (the S13.2 brief 'CXRO atomic scattering factors f1, f2 per element are fetched once through the proxy and kept in the snapshot folder'; 'With a chemical formula and a density they give n, k ... as a tabulated user material with provenance (CXRO, citation)'). Verified 2026-11-04 (henke.lbl.gov/optical_constants/asf.html and `sf/si.nff`): one tab-delimited file per element, H to U, at `https://henke.lbl.gov/optical_constants/sf/<symbol in lower case>.nff`; its first line is `E(eV)\\tf1\\tf2`; each row an energy and f1, f2, plain or with an exponent (`0.186679E-02`); below about 29 eV f1 is the sentinel `-9999.`. CXRO states no licence and cites B. L. Henke, E. M. Gullikson and J. C. Davis, Atomic Data and Nuclear Data Tables 54, 181-342 (1993). Each doc is one to three lines citing spec 0050 S13.2. (1) `OpticalConstructor.Storage/MaterialImport.fs`: `HenkeScatteringText of string` with `.value`, one `.nff` file's text, and `type HenkeScatteringText with member this.factors : Result<AtomicScatteringFactors, ImportError>` (step 456): the first non-empty line MUST start with `E(eV)`; every further non-empty line is three numbers split on tabs and spaces, read with the invariant culture; a row whose f1 is -9999 is left out (CXRO's mark of no f1); the columns go through `AtomicScatteringFactors.tryCreate`, whose refusal, a header that is not CXRO's and a row that does not read are `MalformedSourceFileErr` (step 454) naming the 1-based line; no row left is `NoDataErr`; every .NET call that throws is caught and answered `MalformedSourceFileErr`. (2) `OpticalConstructor.Storage/MaterialSourceStore.fs`: `type MaterialSourceProxy with static member createHenkeCompounds (sources : FolderName) (downloader : SourceArchiveDownloader) (clock : ClockProvider) : MaterialSourceProxy`, unique on its receiver. Building it touches nothing. `sourceName` is `MaterialSourceName \"CXRO Henke\"`, the layout's folder (step 455) `<sources>/cxro-henke`, the licence `EntryLicence \"LicenseRef-CXRO\"` (SPDX's form for a licence it does not list) and the base `https://henke.lbl.gov/optical_constants/sf/`, each written there alone; an element's file is `<symbol in lower case>.nff`. `snapshotVersion` is the layout's. `updateSnapshot observer`: leftovers of an interrupted run are deleted and `<folder>.tmp` is created; then for each of `ChemicalElement.all` in order, the cancellation read first (cancelled: the staged folder deleted, `SourceSnapshotCancelled`), `downloader.downloadArchive` (step 447's one HTTP seam, unchanged) of `SourceArchiveUrl <base><file>` into `<folder>.tmp/<file>` with the token: a cancelled token then answers `SourceSnapshotCancelled`, a download error is answered as it is, and a file whose text `HenkeScatteringText.factors` refuses is `SourceArchiveInvalidErr` naming the element and the error's `describe`, each deleting the staged folder; after each file `reportSnapshotProgress { filesDone = <i>; filesTotal = SourceSnapshotFileCount 92 }`. Once every file is fetched, the layout's `installFrom` with 92 files answers `SourceSnapshotUpdated`; every exception deletes what the run made and keeps the held snapshot (`SourceSnapshotIoErr`). `searchRecords query`: `heldVersion`; `CompoundSpec.tryOfQuery query` (step 456), whose error is `SourceRecordUnreadableErr` carrying its `describe`; an element of the formula without its file in the snapshot is `SourceRecordMissingErr` naming the symbol; otherwise the one hit `{ record = spec.recordId; name = spec.entryName }`: the compound the query writes, because this source has no catalog to filter. `fetchRecord record`: `heldVersion`; `CompoundSpec.tryOfRecord` (an error `SourceRecordMissingErr` naming the record); each element's file read as bytes (missing: `SourceRecordMissingErr`) and through `HenkeScatteringText.factors` (an error `SourceRecordUnreadableErr`); `indexTableWith` (an error `SourceRecordUnreadableErr` carrying its `describe`); and the answer `{ pull = { source; record; recordHash; sourceVersion = <the stamp's>; licence; citation }; material = table.isotropicEntry spec.entryName CategoryIds.semiconductor (EntryDescription \"Computed from CXRO atomic scattering factors (Henke, Gullikson and Davis 1993) for <formula text> at <density> g/cm³.\") }` (step 454), where `recordHash` is `ContentHash.ofBytes` of the record's UTF-8 text followed by each formula element's file bytes in formula order, so an update that changes an element's factors changes the hash (step 444's rule), and the citation is `EntryCitation \"B.L. Henke, E.M. Gullikson and J.C. Davis, Atomic Data and Nuclear Data Tables 54, 181-342 (1993); CXRO atomic scattering factors (henke.lbl.gov/optical_constants): <formula text> at <density> g/cm³\"`. No archive download, retry, cache or setting is added. (3) `OpticalConstructor.Domain/MaterialSources.fs`: the `MaterialSourceProxy` doc names `createHenkeCompounds`, and `searchRecords`' field doc (step 443) adds, in one line, that a source without a catalog answers the record its query names. (4) Fixtures: new `OpticalConstructor.Tests/fixtures/si.nff` and `fixtures/o.nff`, `Content` items copied `PreserveNewest` beside `fixtures/ptb-Co.txt`'s with no comment, in CXRO's format with test-local values (not CXRO data): `si.nff` holds the header, `10.0000\\t-9999.\\t3.94844`, then 100, 200 and 300 eV with f1 10, 12, 13 and f2 2, 1 and `0.500000E+00`; `o.nff` the header, a sentinel row and 150, 250 and 400 eV with f1 6, 7, 7.5 and f2 3, 2, 1, step 456's tables. `MaterialSourceFixture` (step 447) gains, each with a one-line doc: `henkeFile (symbol : string) : byte[]`, the fixture's bytes for `si` and `o` and, for every other element, a test-local header and two rows; `writeHenkeSnapshot (snapshot : string) : unit`, `si.nff`, `o.nff` and the stamp of `2026-11-01`; and `servingDownloader (serve : SourceArchiveUrl -> byte[] option) (asked : ResizeArray<SourceArchiveUrl>) : SourceArchiveDownloader`, which records each URL and writes the served bytes into the target file, answering `SourceDownloadErr \"404\"` for `None`. Tests: `MaterialImportTests` gains `a CXRO scattering-factor file reads its energies and factors, leaving out the rows without f1`: `fixtures/si.nff` reads 100, 200 and 300 eV with their factors, the sentinel row left out and the exponent read; a text whose first line is `Energy` and one with a row `200 x 1` answer `MalformedSourceFileErr`; a header alone answers `NoDataErr`. `MaterialSourceStoreTests` gains, each over a fresh sources folder: `a Henke compound source without a snapshot answers no version and refuses search and fetch`; `a Henke update downloads every element's factors once, file by file, and installs them`: over a held snapshot, `updateSnapshot` with `servingDownloader` of `henkeFile` and `fixedClock` of 2026-11-04 asks 92 URLs, the first `https://henke.lbl.gov/optical_constants/sf/h.nff` and the last `.../sf/u.nff`, in atomic-number order, reports 1 to 92 of 92, answers `SourceSnapshotUpdated` of `2026-11-04` and 92 files, and leaves the snapshot holding exactly the 92 `.nff` files and `.snapshot-json` and the sources folder nothing else; `a Henke update cancelled before its next element, or failing on one, keeps the held snapshot`: a token cancelled on the first progress answers `SourceSnapshotCancelled`, and a downloader serving `None` for `fe` answers `SourceDownloadErr`, each leaving the held snapshot byte for byte and nothing beside it; `a Henke search names the compound its query writes, and refuses a query that names none`: over `writeHenkeSnapshot`, `SiO2 2.2` finds one hit `SiO2@2.2` named `SiO2, ρ = 2.2 g/cm³ (CXRO Henke)`, `SiO2` answers `SourceRecordUnreadableErr` and `Fe2O3 5.2` `SourceRecordMissingErr` naming `Fe`; `a fetched Henke compound is the index its elements' factors give, under CXRO's provenance`: the fetched `SiO2@2.2` holds the table `indexTableWith` gives over the two fixture files read through `factors`, under that name, the hash of `SiO2@2.2`'s bytes followed by `si.nff`'s and `o.nff`'s, `2026-11-04`, `LicenseRef-CXRO` and the citation above.", "acceptance": "After the adapter lands, a test MUST instantiate the real `MaterialSourceProxy.createHenkeCompounds` over a fixture snapshot under the test output, its update MUST fetch the 92 element files once, file by file, through the one HTTP seam's shape, its search MUST name the compound its query writes, and its fetch MUST compute the compound's table through `indexTableWith` under CXRO's provenance; constructor-unit-tests MUST pass, including `a CXRO scattering-factor file reads its energies and factors, leaving out the rows without f1`, `a Henke compound source without a snapshot answers no version and refuses search and fetch`, `a Henke update downloads every element's factors once, file by file, and installs them`, `a Henke update cancelled before its next element, or failing on one, keeps the held snapshot`, `a Henke search names the compound its query writes, and refuses a query that names none` and `a fetched Henke compound is the index its elements' factors give, under CXRO's provenance`, the count rising by 6; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/MaterialSources.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/fixtures/si.nff", "Berreman/OpticalConstructor/OpticalConstructor.Tests/fixtures/o.nff", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceFixture.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a CXRO scattering-factor file reads its energies and factors, leaving out the rows without f1", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a Henke compound source without a snapshot answers no version and refuses search and fetch", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a Henke update downloads every element's factors once, file by file, and installs them", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a Henke update cancelled before its next element, or failing on one, keeps the held snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a Henke search names the compound its query writes, and refuses a query that names none", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-ADAPTER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourceStoreTests.a fetched Henke compound is the index its elements' factors give, under CXRO's provenance", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourceStoreTests.fs", "class": "OpticalConstructor.Tests.MaterialSourceStoreTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-HENKE-ADAPTER"]}], "contracts": [{"symbol": "OpticalConstructor.Storage.MaterialImport.HenkeScatteringText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S132-HENKE-ADAPTER"]}, {"symbol": "OpticalConstructor.Domain.MaterialSources.MaterialSourceProxy.createHenkeCompounds", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialSourceStore.fs", "obligations": ["S132-HENKE-ADAPTER"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 458, "anchor": "IMPLEMENT", "ac": "AC-S132f", "touches": ["OpticalConstructor.Tests"], "depends_on": [457], "how_to": "The PTB and Henke pulls proved end to end over their real adapters and the real library database: fixture snapshots under the test output and SQLite `:memory:` (the S13.2 brief 'Tests over fixtures: a PTB record with sigma; two element .nff files and a formula'; 'The attribution shows (S3.3, CC-BY)'; .spec-md §9 'Each library proxy's suite runs against BOTH the in-memory store and SQLite :memory:'; .spec-md §3.9). Tests only; no product file changes, because step 444's `pullRecord`, `refreshPulls` and `updateSourceSnapshot` serve every adapter. `OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs` (step 448) gains three facts, each composing its import context and material store over `BuiltinCatalogue.freshLibraryDatabase ()` as the class's facts do, the adapter over `MaterialSourceFixture.freshSources \"MaterialSourcePullSqliteTests\"` (steps 447, 455, 457); nothing reaches the network. `a pulled PTB OCDB record keeps its uncertainties in the library and credits PTB`: over `MaterialSourceProxy.createPtbOcdb` whose snapshot `writePtbSnapshot` writes with `ptbRecord ()`, `pullRecord` of `Co.txt` answers one `PullAddedEntry` at version 1; the material store's `resolveVersion` of version 1 answers a material named `Co (PTB OCDB)` whose one tabulated segment's table equals the fixture's import, `uncertaintyOpt` included (the database's canonical payload keeps the arrays, steps 69, 453); `PulledSources` holds one row of that entry with the source `PTB OCDB`; and `attributionLinesOf` of the entry (step 114) answers exactly `Co (PTB OCDB): Licence CC-BY-4.0 — cite: PTB Optical Constants Database (OCDB), ocdb/db/data/Co.txt: Optical constants for Co created by PTB`. `an update whose PTB OCDB bounds changed mints version 2 and keeps version 1`: after that pull, `updateSourceSnapshot` with `copyingDownloader` of an archive `writePtbArchive` writes with `changedPtbRecord ()` and `fixedClock` of 2026-11-04 answers `PullMintedVersion` at version 2, whose first sample's σn is the changed bounds' (0.96810 − 0.96772) / 6, and version 1 resolves with its own uncertainties, as before. `a pulled Henke compound is a user material at version 1 under CXRO's provenance, its licence named`: over `MaterialSourceProxy.createHenkeCompounds` whose snapshot `writeHenkeSnapshot` writes, `searchRecords (MaterialSourceQuery \"SiO2 2.2\")` finds `SiO2@2.2`; `pullRecord` of it answers `PullAddedEntry` at version 1; `tryLatestEnvelope` holds `SourcePullProvenance` with the source `CXRO Henke`, the record, `2026-11-01`, `LicenseRef-CXRO`, the citation of step 457 and the record's hash, its protection `UserManaged`; the resolved material's table equals the fixture factors' `indexTableWith`; and `attributionLinesOf` answers `SiO2, ρ = 2.2 g/cm³ (CXRO Henke): Licence LicenseRef-CXRO`, no citation, because only a CC-BY licence cites (step 113).", "acceptance": "After the end-to-end facts land, a pulled PTB OCDB record MUST be a user material in the SQLite library holding its uncertainties and crediting PTB under CC-BY-4.0, an update of changed bounds MUST mint version 2 and keep version 1, and a pulled Henke compound MUST be a user material at version 1 under CXRO's provenance; constructor-unit-tests MUST pass, including `a pulled PTB OCDB record keeps its uncertainties in the library and credits PTB`, `an update whose PTB OCDB bounds changed mints version 2 and keeps version 1` and `a pulled Henke compound is a user material at version 1 under CXRO's provenance, its licence named`, the count rising by 3; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.a pulled PTB OCDB record keeps its uncertainties in the library and credits PTB", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PULLS-SQLITE"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.an update whose PTB OCDB bounds changed mints version 2 and keeps version 1", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PULLS-SQLITE"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests.a pulled Henke compound is a user material at version 1 under CXRO's provenance, its licence named", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialSourcePullSqliteTests.fs", "class": "OpticalConstructor.Tests.MaterialSourcePullSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-PULLS-SQLITE"]}], "contracts": [], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 459, "anchor": "IMPLEMENT", "ac": "AC-S132g", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Ui.Tests"], "depends_on": [458], "how_to": "The app offers the three online sources over its configured sources folder, so the Online sources window lists PTB OCDB and CXRO Henke beside refractiveindex.info with no change to the window (.spec-md §0.1: `AppContext.create` composes the library proxies over the configured locations; .spec-md §3.9; the S13.1 mapper's note: PTB OCDB and the Henke calculator are appended to the composition's `materialSources`). Each doc is one to three lines citing spec 0050 S13.2. (1) `OpticalConstructor.Ui/AppContext.fs`: the `compose` that `create` and `recreateLibrary` share (step 449) sets `materialSources = [ MaterialSourceProxy.createRefractiveIndexInfo …; MaterialSourceProxy.createPtbOcdb locations.materialSourcesFolder SourceArchiveDownloader.http ClockProvider.system; MaterialSourceProxy.createHenkeCompounds locations.materialSourcesFolder SourceArchiveDownloader.http ClockProvider.system ]` (steps 455, 457), in that order. Composing them reads and writes nothing. Every other composition keeps `[]`. `initMaterialSources` shows the first source (step 450), so the window opens on refractiveindex.info as before, and its choice row lists the three. (2) Tests: `AppContextTests`' `the app scope offers refractiveindex.info over its configured sources folder, holding no snapshot` (step 449) widens its assertion, keeping its name: `catalogueImports.materialSources` names `refractiveindex.info`, `PTB OCDB` and `CXRO Henke` in that order, each `snapshotVersion ()` answers `Ok None`, and nothing exists under the sources folder of `TestAppScope.testLocations (FolderName \"AppContextTests\")`. No test runs these sources' `updateSnapshot`, so no test reaches the network (.spec-md §8); S13.1's `MaterialsWindowTests` acceptance (step 452), which reads the shown source's choice and snapshot text, keeps its assertions.", "acceptance": "After the composition, `AppContext.create` MUST offer refractiveindex.info, PTB OCDB and CXRO Henke over `locations.materialSourcesFolder` with the HTTP seam, in that order, and every other composition none; constructor-unit-tests MUST pass; ui-smoke MUST pass; ui-tests MUST pass over the selected class, including the widened `the app scope offers refractiveindex.info over its configured sources folder, holding no snapshot`, the count unchanged; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.AppContextTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/AppContext.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppContextTests.fs"], "tests": [{"op": "change_expectation", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.AppContextTests.the app scope offers refractiveindex.info over its configured sources folder, holding no snapshot", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/AppContextTests.fs", "obligations": ["S132-APP-SOURCES"]}], "contracts": [], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number":460,"anchor":"IMPLEMENT","ac":"AC-S132h","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests","OpticalConstructor.Ui.Tests"],"depends_on":[459],"how_to":"A study opens a tabulated material as it opens a crystal, and a component freed from a table that carries uncertainties takes its source σ as its prior (001 §D 'Uncertainties travel with the material (PTB's σ) and become priors in studies and inputs to the Planner'; 001 §I 'a study OPENS a material version, which creates a study-local working copy ... with Unknown components'; 001 §N 'a material complexity or item model publishes its ParameterAxis list'; the S13.2 brief 'A study that opens such a material (S11.1) takes sigma as its components' prior'). Step 361 opened crystal-parameter versions only ('A complexity tree publishes no parameter axis in this spec'); a single tabulated isotropic segment now publishes its rows, and every other complexity is still refused. The copy keeps ONE list (`Study.materials`), so every reader of a study's opened materials and their `parameters` reads a table's components with no change: `libraryReferences` (step 359), `withMaterialParameterState` and `openedMaterialsIn` (step 361), `unknownsWith` (step 362), `parameterLayoutWith` (step 372), `SetOpenedMaterialParameter` (step 409), `EditStudyParameter` (step 411), the unknowns table (step 414), the fit run's parameters (step 383) and the promotion subjects (step 407); the S11.3 residual adds a row for each prior (step 387), so the source σ weighs a fit with no engine change. Each doc is one to three lines citing spec 0050 S13.2. (1) `OpticalConstructor.Domain/ItemModels.fs`: `ParameterName` (steps 205, 244) gains, beside step 244's position members, `static member tableRowIndex (row : int) : ParameterName` (`row<i>.n`) and `static member tableRowExtinction (row : int) : ParameterName` (`row<i>.k`), 1-based. (2) `OpticalConstructor.Domain/Studies.fs`, directly before `OpenedMaterial` (step 358): `OpenedMaterialPhysics` = `OpenedCrystalPhysics of CrystalParameters` | `OpenedTablePhysics of TabulatedNkTable`, the working copy's physics, stored in the serializer's case form as `CrystalParameters` is (step 359), with: `member this.componentNames : ParameterName list` (a crystal's `parameterAxes` names in order, step 361; a table's `tableRowIndex i` then `tableRowExtinction i` for each row in order); `member this.componentValue (name : ParameterName) : ParameterValue option` (the generated axis's `parameterValueOf`, or the row's n or k); `member this.withComponent (name : ParameterName) (value : ParameterValue) : OpenedMaterialPhysics` (written through the axis's `writeValue`, or the table with that row's n or k replaced in new columns; an unknown name answers `this`); `member this.componentSigmaOpt (name : ParameterName) : ParameterSigma option` (a table row's σn or σk when `uncertaintyOpt` holds a positive one, step 453; otherwise `None`); `member this.withoutSourceUncertainty : OpenedMaterialPhysics` (a table with `uncertaintyOpt = None`, a crystal unchanged); `member this.crystalOpt : CrystalParameters option`; and `member this.materialPhysics : MaterialPhysics` (`CrystalParameterPhysics c`, step 355, or `ComplexityPhysics` of one isotropic dispersive segment over `t.sampleRange` whose axis is `TabulatedNK t`, with no magnetic or active part, the shape every tabulated import builds, step 454). (3) `OpenedMaterial` holds `physics : OpenedMaterialPhysics` in place of `crystal : CrystalParameters`. `openFrom` (step 361): a `CrystalParameterPhysics crystal` opens as `OpenedCrystalPhysics crystal` with the parameters it has today; a `ComplexityPhysics` whose `eps` is `EpsWithDispValue (IsotropicDispersive [ s ])` with `s.dispersion = TabulatedNK t` and no magnetic or active part opens as `OpenedTablePhysics t` whose parameters are, per `componentNames` in order, `KnownParameter` of `componentValue`; any other complexity is `MaterialWithoutParametersErr` as today. `withParameterState` keeps its rules and, for a component whose `componentSigmaOpt` is `Some σ`, stores an `UnknownParameter d` whose `d.priorOpt` is `None` as `UnknownParameter { d with priorOpt = Some { centre = <the opened physics' componentValue>; sigma = σ } }`: the opened version's value at its source's σ; an explicit prior is kept and a known or calibrated state is unchanged. `currentCrystal` becomes `member this.currentPhysics : OpenedMaterialPhysics`, the physics with each component written through `withComponent` at its parameter's current number, in order. (4) `OpticalConstructor.Domain/StudyForward.fs`: `ExperimentAssignment` (step 373) holds `physics : Map<MaterialVersionId, OpenedMaterialPhysics>` in place of `crystals`; `crystalOf` becomes `member this.physicsOf (material : OpenedMaterial) : OpenedMaterialPhysics` (its entry or the copy's `currentPhysics`); `materialProxyOver` answers the store's entry with `physics = (physicsOf <the copy>).materialPhysics`, so a stack sample made of an opened table is solved with the study's working table at every wavelength; `assignmentFor` (b) writes each entry through `withComponent` and (c) reads a material leader through `componentValue`. `observedCrystalOpt` (step 375) is the one copy's `physicsOf … .crystalOpt`, so an observation of a table plate answers `ObservationPlateErr`, as an object of no opened crystal does. (5) `OpticalConstructor.Domain/StudyPublishing.fs`: `promotedMaterialWith` (step 407) answers `{ entry with physics = <the copy with its fitted components>.currentPhysics.withoutSourceUncertainty.materialPhysics }`: a fitted table's uncertainty is its fit run's (S11.4), not its source's. (6) Stored files. The study file keeps schema version 1: `study.schema.json` leaves the inner shapes to the serializer (step 359) and no study file has been released (.spec-md §7). The committed `data/absorbing-biaxial-noisy/AbsorbingTriclinic.study-json` (step 438) is rewritten to the bytes the kit writes for its study, its one opened material's `crystal` key becoming `physics` holding `OpenedCrystalPhysics` of the same crystal and nothing else changing, so AT-2's file-by-file comparison (step 438) holds; `data/optics-mueller/QZ-LR.study-json` opens no material (steps 421-430) and keeps its bytes. (7) Tests. Every `OpenedMaterial` record expression writes `physics = OpenedCrystalPhysics <its crystal>` and every read of a copy's `crystal` reads its `physics`, every assertion and number unchanged: `KitStudyFileTests` and `KitContentFileJsonTests` (step 359), `StudyMaterialTests` (step 361, whose `the generated axes of an opened absorbing triclinic material equal AbsorbingTriclinicParameters.axes` reads `c.parameterAxes` of the copy's `OpenedCrystalPhysics c`), `StudyTests` (step 362), `StudyMessageTests` (steps 366, 409), `StudyForwardTests` (steps 373, 375: `physicsOf` in place of `crystalOf`), `StudyPublishingTests` (step 407), `StudyWindowModelTests` (step 410), `StudyViewTests` (step 414) and `KitAcceptanceTests`' `buildAbsorbingKit` (step 435: the generated axes of the copy's crystal). `a material whose physics is a complexity tree, or one opened twice, is refused` keeps its constant isotropic complexity refused. New facts over a test-local user material whose one isotropic tabulated segment holds 400, 500 and 700 nm, n 1.5, 1.6, 1.9 and k 0, 0.1, 0.3, with σn 0.01, 0.02, 0.03 and σk 0, 0.001, 0.002 (step 453). `StudyMaterialTests`: `a tabulated material opens with one known component per row's n and k`: it opens as `OpenedTablePhysics` of its table with `row1.n`, `row1.k`, `row2.n` … `row3.k` known at those values; a two-segment tabulated complexity answers `MaterialWithoutParametersErr`. `a freed component of an uncertain table takes its source sigma as its prior, and an explicit prior is kept`: freeing `row2.n` from 1.6 within [1.5, 1.7] with no prior stores the prior centre 1.6, σ 0.02; freeing `row1.k` (σ 0) stores none; a prior given explicitly is kept; and the same material without uncertainties frees `row2.n` with none. `an opened table's current physics is its table with each row at its parameter's current value`: with `row2.n` unknown from 1.65 and `row3.k` known at 0.35, `currentPhysics` is the table with n2 1.65 and k3 0.35 and every other value and the uncertainties its own. `StudyForwardTests`: `a stack sample made of an opened table resolves to the study's working table`: over step 373's fixture with a sample whose substrate is the opened table version, `row2.n` freed and the vector holding 1.65 for it, the assignment's `materialProxyOver` resolves that version to `ComplexityPhysics` of the table with n2 1.65, whose ε at 500 nm is (1.65 + 0.1i)² within 1e-12, and another version unchanged; with a link whose follower is `row3.n` and leader `row2.n` (step 364), `row3.n` is 1.65. `StudyPublishingTests`: `a promoted table is its opened version's entry holding the fitted rows without the source's uncertainty`: a test-local fit run fitting `row2.n` to 1.62 promotes the entry with that row's n 1.62, every other row the opened version's and `uncertaintyOpt = None`. The Planner (S14) reads the same copies and tables; nothing else is added here.","acceptance":"After the tables open, `OpenedMaterial` MUST hold `physics : OpenedMaterialPhysics`, a single tabulated isotropic segment MUST open with one known component per row's n and k, a freed component of an uncertain table MUST take its source σ as its prior, the forward model MUST solve a stack of an opened table with the working table, and every crystal path MUST keep its numbers; constructor-unit-tests MUST pass, including `a tabulated material opens with one known component per row's n and k`, `a freed component of an uncertain table takes its source sigma as its prior, and an explicit prior is kept`, `an opened table's current physics is its table with each row at its parameter's current value`, `a stack sample made of an opened table resolves to the study's working table`, `a promoted table is its opened version's entry holding the fitted rows without the source's uncertainty` and the unchanged `the generated axes of an opened absorbing triclinic material equal AbsorbingTriclinicParameters.axes` and `a material whose physics is a complexity tree, or one opened twice, is refused`, the count rising by 5; ui-smoke MUST pass; ui-tests MUST pass over the selected class, the count unchanged; kit-acceptance MUST pass over the selected class with AT-2's committed study file equal to the built one; and build, elevation and the twenty-one s44 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests","kit-acceptance"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.StudyViewTests"]},"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/ItemModels.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/Studies.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/StudyForward.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/StudyPublishing.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyMaterialTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyForwardTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyPublishingTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/KitStudyFileTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/KitContentFileJsonTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyWindowModelTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyMessageTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/StudyViewTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitAcceptanceTests.fs","data/absorbing-biaxial-noisy/AbsorbingTriclinic.study-json"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.StudyMaterialTests.a tabulated material opens with one known component per row's n and k","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyMaterialTests.fs","class":"OpticalConstructor.Tests.StudyMaterialTests","discovery_gate":"constructor-unit-tests","obligations":["S132-STUDY-TABLES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.StudyMaterialTests.a freed component of an uncertain table takes its source sigma as its prior, and an explicit prior is kept","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyMaterialTests.fs","class":"OpticalConstructor.Tests.StudyMaterialTests","discovery_gate":"constructor-unit-tests","obligations":["S132-STUDY-TABLES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.StudyMaterialTests.an opened table's current physics is its table with each row at its parameter's current value","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyMaterialTests.fs","class":"OpticalConstructor.Tests.StudyMaterialTests","discovery_gate":"constructor-unit-tests","obligations":["S132-STUDY-TABLES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.StudyForwardTests.a stack sample made of an opened table resolves to the study's working table","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyForwardTests.fs","class":"OpticalConstructor.Tests.StudyForwardTests","discovery_gate":"constructor-unit-tests","obligations":["S132-STUDY-TABLES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.StudyPublishingTests.a promoted table is its opened version's entry holding the fitted rows without the source's uncertainty","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyPublishingTests.fs","class":"OpticalConstructor.Tests.StudyPublishingTests","discovery_gate":"constructor-unit-tests","obligations":["S132-STUDY-TABLES"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.Studies.OpenedMaterialPhysics","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Studies.fs","obligations":["S132-STUDY-TABLES"]},{"symbol":"OpticalConstructor.Domain.Studies.OpenedMaterial.physics","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Studies.fs","obligations":["S132-STUDY-TABLES"]},{"symbol":"OpticalConstructor.Domain.Studies.OpenedMaterial.currentPhysics","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Studies.fs","obligations":["S132-STUDY-TABLES"]},{"symbol":"OpticalConstructor.Domain.StudyForward.ExperimentAssignment.physicsOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/StudyForward.fs","obligations":["S132-STUDY-TABLES"]},{"symbol":"OpticalConstructor.Domain.ItemModels.ParameterName.tableRowIndex","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/ItemModels.fs","obligations":["S132-STUDY-TABLES"]},{"symbol":"OpticalConstructor.Domain.ItemModels.ParameterName.tableRowExtinction","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/ItemModels.fs","obligations":["S132-STUDY-TABLES"]}],"packages":[],"checks":[]},"section":"S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 461, "anchor": "IMPLEMENT", "ac": "AC-S132i", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [460], "how_to": "A material imported from a user's glass catalogue says which file, and which bytes of it, it came from (the S13.2 brief 'A user-supplied .agf file becomes user materials ... with imported-from-file provenance'; 001 §B 'provenance — built-in / user / imported-from-kit / pulled-from-source'; step 405's precedent: add a provenance case where none fits). None fits: `UserProvenance` carries nothing and `SourcePullProvenance` names an online source, its licence and its snapshot (`LibraryEntryFiles.fs`, steps 24, 91, 405, 441). Each doc is one to three lines citing spec 0050 S13.2. (1) `OpticalConstructor.Domain/LibraryEntryFiles.fs`: `EntryProvenance` gains a seventh case, `FileImportProvenance of EntryFileImportInfo`, declared together with `and EntryFileImportInfo = { file : FileName; fileHash : ContentHash }`: the imported file's leaf name (`FileName.leafName`) and the SHA-256 of its bytes (`ContentHash.ofBytes`, step 123). An imported entry belongs to the user: `protection` answers `UserManaged`, `categoryOrigin` `UserCategory`, and `attributionOpt` (step 113) `None`, because a user's file carries no licence the app knows. (2) `OpticalConstructor.Storage/LibraryDatabaseStore.fs` (steps 63, 91, 405): `kindValue` answers 7 for a file import and `catalogueIdOpt` `None`. (3) `OpticalConstructor.Storage/schema/library-common.schema.json` (steps 30, 91, 405, 441): the provenance definition gains a seventh shape, exactly what the serializer writes for `FileImportProvenance`: `file` a non-empty string and `fileHash` the content-hash definition the file holds. The entry schemas keep version 1, because no entry file has been released (.spec-md §7). Any other complete match on `EntryProvenance` that FS0025 reports answers a file import as it answers `UserProvenance`. No other case, member, converter or schema changes; the glass import builds the case (step 463). (4) Tests. `LibraryEntryFilesTests`' `a built-in provenance is protected and every other provenance is user-managed` also covers a `FileImportProvenance` of `FileName \"test-glasses.agf\"` and the hash of the UTF-8 bytes of `abc`: `UserManaged` and `UserCategory`; its `a pulled entry and its forks carry its licence's attribution, and every other provenance none` (step 113) answers `None` for it. `EntryFileJsonTests`' `every provenance round-trips through an entry file` gains a material under that provenance; it round-trips through its entry file, and its decoder answers the material.", "acceptance": "After the provenance lands, `EntryProvenance` MUST hold `FileImportProvenance of EntryFileImportInfo` (the file's leaf name and its bytes' hash), user-managed with no attribution, stored with provenance kind 7 and no catalogue, and written and read back in an entry file under `library-common.schema.json`; constructor-unit-tests MUST pass, including the widened `a built-in provenance is protected and every other provenance is user-managed`, `a pulled entry and its forks carry its licence's attribution, and every other provenance none` and `every provenance round-trips through an entry file`, the count unchanged; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/LibraryEntryFiles.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/LibraryDatabaseStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/schema/library-common.schema.json", "Berreman/OpticalConstructor/OpticalConstructor.Tests/LibraryEntryFilesTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/EntryFileJsonTests.fs"], "tests": [{"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.LibraryEntryFilesTests.a built-in provenance is protected and every other provenance is user-managed", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/LibraryEntryFilesTests.fs", "obligations": ["S132-FILE-PROVENANCE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.LibraryEntryFilesTests.a pulled entry and its forks carry its licence's attribution, and every other provenance none", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/LibraryEntryFilesTests.fs", "obligations": ["S132-FILE-PROVENANCE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.EntryFileJsonTests.every provenance round-trips through an entry file", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/EntryFileJsonTests.fs", "obligations": ["S132-FILE-PROVENANCE"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.LibraryEntryFiles.EntryProvenance.FileImportProvenance", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/LibraryEntryFiles.fs", "obligations": ["S132-FILE-PROVENANCE"]}, {"symbol": "OpticalConstructor.Domain.LibraryEntryFiles.EntryFileImportInfo", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/LibraryEntryFiles.fs", "obligations": ["S132-FILE-PROVENANCE"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 462, "anchor": "IMPLEMENT", "ac": "AC-S132j", "touches": ["OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [461], "how_to": "A user-supplied Zemax glass catalogue (`.agf`, as Schott, Ohara, Hoya and CDGM publish theirs) is read into user materials, each glass's dispersion formula rewritten as the refractiveindex.info formula of the same equation and lowered by MaterialImport's existing lowering, so no second formula engine exists (001 §D 'User-supplied glass catalogues (Schott / Ohara / Hoya / CDGM AGF): import only, never bundle'; the S13.2 brief 'Their formula coefficients are lowered through MaterialImport's existing formula lowering'; .spec-md §3.19; AGENTS.md 'Reuse, never copy'). Nothing is bundled: the reader reads a text the user gives. The AGF equations, λ in µm and C1 … Cn the `CD` coefficients in order, as OpticSim.jl evaluates them (`src/GlassCat/utilities.jl`, verified 2026-11-04): 1 Schott n² = C1 + C2λ² + C3λ⁻² + C4λ⁻⁴ + C5λ⁻⁶ + C6λ⁻⁸; 2 Sellmeier 1 n² = 1 + C1λ²/(λ²−C2) + C3λ²/(λ²−C4) + C5λ²/(λ²−C6); 3 Herzberger n = C1 + C2L + C3L² + C4λ² + C5λ⁴ + C6λ⁶, L = 1/(λ²−0.028); 4 Sellmeier 2 n² = 1 + C1 + C2λ²/(λ²−C3²) + C4λ²/(λ²−C5²); 5 Conrady n = C1 + C2/λ + C3/λ^3.5; 6 Sellmeier 3, formula 2 with a fourth term C7λ²/(λ²−C8); 7 Handbook of Optics 1 n² = C1 + C2/(λ²−C3) − C4λ²; 8 Handbook of Optics 2 n² = C1 + C2λ²/(λ²−C3) − C4λ²; 9 Sellmeier 4 n² = C1 + C2λ²/(λ²−C3) + C4λ²/(λ²−C5); 10 Extended n² = formula 1 + C7λ⁻¹⁰ + C8λ⁻¹²; 11 Sellmeier 5, formula 2 over five terms C1 … C10; 12 Extended 2 n² = formula 1 + C7λ⁴ + C8λ⁶; 13 Extended 3 n² = C1 + C2λ² + C3λ⁴ + C4λ⁻² + C5λ⁻⁴ + C6λ⁻⁶ + C7λ⁻⁸ + C8λ⁻¹⁰ + C9λ⁻¹². Each doc is one to three lines citing spec 0050 S13.2. In `OpticalConstructor.Storage/MaterialImport.fs`: (1) `AgfFormulaNumber of int` with `.value` and `member this.family : string` (`Schott`, `Sellmeier 1`, `Herzberger`, `Sellmeier 2`, `Conrady`, `Sellmeier 3`, `Handbook of Optics 1`, `Handbook of Optics 2`, `Sellmeier 4`, `Extended`, `Sellmeier 5`, `Extended 2`, `Extended 3`, or `AGF formula <n>`). `type AgfFormulaNumber with member this.riiFormOf (c : float array) : Result<RiiFormulaNumber * float array, ImportError>` rewrites a glass's coefficients (absent ones zero) as the refractiveindex.info page of the same equation (`RiiFormulaNumber`, `MaterialImport.fs:30`): 1 is formula 3 `[C1; C2; 2; C3; −2; C4; −4; C5; −6; C6; −8]`; 2, 6 and 11 are formula 2 `[0; C1; C2; …]` over three, four and five pairs; 3 is formula 7 `[C1 … C6]`; 4 is formula 1 `[C1; C2; C3; C4; C5]` (formula 1 squares its resonances); 5 is formula 5 `[C1; C2; −1; C3; −3.5]`; 7 is formula 4 `[C1; C2; 0; C3; 1; 0; 0; 0; 0; −C4; 2]` and 8 formula 4 `[C1; C2; 2; C3; 1; 0; 0; 0; 0; −C4; 2]`; 9 is formula 2 `[C1 − 1; C2; C3; C4; C5]`; 10, 12 and 13 are formula 3 over their powers in order; any other number is `MalformedSourceFileErr` naming it. Each pair is the equation term for term, so no number is approximated. (2) `GlassCatalogueText of string` with `.value`; `static member ofBytes (bytes : byte[]) : GlassCatalogueText` decodes a UTF-16 little-endian (`FF FE`) or big-endian (`FE FF`) byte-order mark as that encoding, a UTF-8 mark as UTF-8, and otherwise UTF-16 little-endian when one of the first two bytes is zero and UTF-8 when none is, as Zemax writes its catalogues in either. `type GlassCatalogueText with member this.importGlasses : Result<MaterialEntry list, ImportError>`: lines (`\\r\\n` as `\\n`) whose first token is `NM` open a glass: its second token is the name and its third the formula number, read as an integer or as a real with no fraction (`2.0`); `CD` gives its coefficients and `LD` its range (two numbers, µm, through `toWaveLength Micrometer`, as the page range is, `MaterialImport.fs:142`; a glass without `LD` takes the zero nominal interval as a page without a range does); a line starting with `!` and every other keyword (`CC`, `GC`, `ED`, `TD`, `OD`, `IT` …) are read past. Each glass is `riiFormOf`, then `lowerFormulaAxis` (`MaterialImport.fs:438`, unchanged), then the formula import's entry assembly (`entryOfAxis`, `MaterialImport.fs:455`, which files it under `CategoryIds.glass`) named by the glass and described `Imported <family> glass (AGF formula <n>).`, in file order. A glass that does not lower (Conrady's λ^3.5, which the lowering refuses as no finite term sum, `MaterialImport.fs:294`) or does not read makes the whole text `MalformedSourceFileErr` naming every such glass with its reason, one per line, so nothing imports silently in part; a text without a glass is `NoDataErr`; every .NET call that throws is caught and answered `MalformedSourceFileErr`. No transmission, thermal or price data, no partial import and no option is added. (3) Fixture: new `OpticalConstructor.Tests/fixtures/test-glasses.agf`, a `Content` item copied `PreserveNewest` beside `fixtures/ptb-Co.txt`'s with no comment, ASCII, test-local values (not a vendor's): a `CC` line, then `TEST-S1` (formula 2, `CD 1.04 0.006 0.23 0.02 1.01 103.6 0 0 0 0`, `LD 0.3 2.5`, with `GC`, `ED`, `TD`, `OD` and `IT` lines), `TEST-SCHOTT` (formula `1.0`, six coefficients, `LD 0.36 1.5`) and `TEST-HERZ` (formula 3, six coefficients, no `LD`). (4) Tests, in `MaterialImportTests`: `a glass catalogue's glasses lower through MaterialImport's formulas to the AGF equations`: the fixture's three glasses, in order and named so, each match at 0.4, 0.5876 and 1.0 µm, within 1e-12, n² (or n) of its AGF equation the fact evaluates from the fixture's coefficients; and test-local glasses of formulas 4, 7, 8, 9, 10, 11, 12 and 13 do so at 0.5876 µm. `a glass catalogue reads in UTF-8 or UTF-16 and takes each glass's wavelength range`: `TEST-S1`'s interval is 0.3 to 2.5 µm and `TEST-HERZ`'s the zero nominal one; the fixture's text encoded UTF-16 little-endian with and without its mark, and UTF-8 with its mark, reads the same three glasses. `a glass catalogue with a glass no formula lowers, or with no glass, is refused`: a test-local text holding a Conrady glass and a formula-14 glass beside `TEST-S1` answers `MalformedSourceFileErr` naming both; a `CC` line alone answers `NoDataErr`.", "acceptance": "After the reader lands, `GlassCatalogueText.importGlasses` MUST read an AGF catalogue in UTF-8 or UTF-16 into one user glass per `NM` block, each formula rewritten as the refractiveindex.info formula of the same equation and lowered by `lowerFormulaAxis`, refusing the whole text when a glass does not lower; constructor-unit-tests MUST pass, including `a glass catalogue's glasses lower through MaterialImport's formulas to the AGF equations`, `a glass catalogue reads in UTF-8 or UTF-16 and takes each glass's wavelength range` and `a glass catalogue with a glass no formula lowers, or with no glass, is refused`, the count rising by 3; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/fixtures/test-glasses.agf", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a glass catalogue's glasses lower through MaterialImport's formulas to the AGF equations", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-READER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a glass catalogue reads in UTF-8 or UTF-16 and takes each glass's wavelength range", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-READER"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.MaterialImportTests.a glass catalogue with a glass no formula lowers, or with no glass, is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/MaterialImportTests.fs", "class": "OpticalConstructor.Tests.MaterialImportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-READER"]}], "contracts": [{"symbol": "OpticalConstructor.Storage.MaterialImport.AgfFormulaNumber", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S132-AGF-READER"]}, {"symbol": "OpticalConstructor.Storage.MaterialImport.GlassCatalogueText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Storage/MaterialImport.fs", "obligations": ["S132-AGF-READER"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 463, "anchor": "IMPLEMENT", "ac": "AC-S132k", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [462], "how_to": "A glass catalogue is imported through the one import path every library file takes: its glasses are decided against the library row by row and nothing applies until the import dialog's Apply (001 §D 'import only'; 001 §B 'one table for catalogues, kit snapshots and single dropped files', 'nothing is overwritten silently'; .spec-md §3.7: a dropped file always opens the dialog; .spec-md §10.3: identify → confirm). It REUSES `decideDroppedFiles` (step 104), `DroppedFileOrigin` (step 102) and the import dialog's apply (steps 107, 108), so no second write path exists. Each doc is one to three lines citing spec 0050 S13.2. (1) `OpticalConstructor.Domain/CatalogueImport.fs`, before `CatalogueImportContext`: `GlassCatalogueRead = { file : FileName; fileHash : ContentHash; glasses : MaterialEntry list }`, one read glass catalogue. `CatalogueImportContext` (steps 94, 104, 444) gains `readGlassCatalogue : FileName -> Result<GlassCatalogueRead, CatalogueImportError>`, documented as reading one glass catalogue. `OpticalConstructor.Storage/CatalogueImportStore.fs`' `create` (step 94), its signature unchanged, fills it: the file's bytes (`File.ReadAllBytes` at this IO edge, an exception being `DroppedFileRefusedErr` naming the file and the message), `fileHash = ContentHash.ofBytes <the bytes>` (step 123), `file = <the file>.leafName` and `glasses` from `(GlassCatalogueText.ofBytes <the bytes>).importGlasses` (step 462), an `ImportError` being `DroppedFileRefusedErr` naming the file with the error's `describe` (step 445); a declaration whose signature carries a bare primitive for this IO is marked `[<ElevationBoundary(nameof IoBoundary, …)>]`. (2) `decideDroppedFiles` (step 104) step (a): a file whose extension is `.agf` (ordinal, ignoring case) is a glass catalogue. It is read through `readGlassCatalogue`, a refusal joining the refused files with its reason, as an entry file's does; each of its glasses becomes, in the file's order, the envelope `this.sealEntry` (step 94) of `LibraryEntryContent.ofMaterialEntry VersionNumber.first (FileImportProvenance { file = read.file; fileHash = read.fileHash }) glass` (steps 25, 461) under `id = this.newEntryId ()`, as a pull takes a minted id (step 444), a seal error refusing the file. Every other file is read as today. Steps (b) to (d) then run over every envelope in drop order, each glass decided under `DroppedFileOrigin <the file's leaf name>`, so a new glass is `EntryIdNotHeld` (added by default) and a glass named like a held material is `NameCollision` (side by side, `<name> — from <file>`, step 102). Nothing is written. The doc of `decideDroppedFiles` names glass catalogues in one line. No dedupe across drops, merge, retry or option is added: a second drop mints new ids and collides by name, and the user chooses (.spec-md §8). (3) Tests: new `[<Fact>]` members of `CatalogueImportContract` (step 95), so each runs over `CatalogueImportInMemoryTests` and `CatalogueImportSqliteTests`, after `importFrom (CatalogueProxy.createBuiltIn ())` through the class's context with its real readers and `newEntryId` minting a fixed sequence of test-local GUIDs, the file being `fixtures/test-glasses.agf` (step 462) copied into a fresh GUID folder under `Path.Combine(AppContext.BaseDirectory, \"CatalogueImportTests\")`. `a dropped glass catalogue is decided as one new user material per glass, writing nothing`: dropping it answers three `EntryIdNotHeld` rows under `DroppedFileOrigin (FileName \"test-glasses.agf\")`, named `TEST-S1`, `TEST-SCHOTT` and `TEST-HERZ`, each content in `CategoryIds.glass` under `FileImportProvenance` of that leaf name and the hash of the file's bytes, and `tryHeldEntry` of each id answers `None`. `an applied glass catalogue adds its glasses, and dropping it again collides by name`: `apply` of the rows' `byDefault` choices (step 94) holds the three, latest at version 1, `UserManaged`; dropping the file again answers three `NameCollision` rows whose `rowName` is `TEST-S1 — from test-glasses.agf` and so on. `a glass catalogue that does not read is refused, naming the file and its reason`: a `.agf` file holding a Conrady glass answers `DroppedFileRefusedErr` whose reason names the file and the glass, and a missing `.agf` one naming the file; dropped beside a user material's entry file, the refusal names the bad file alone.", "acceptance": "After the import seam lands, `CatalogueImportContext.decideDroppedFiles` MUST decide each glass of a dropped `.agf` file as an entry under `DroppedFileOrigin` and `FileImportProvenance`, writing nothing until the import dialog applies it; constructor-unit-tests MUST pass, including `a dropped glass catalogue is decided as one new user material per glass, writing nothing`, `an applied glass catalogue adds its glasses, and dropping it again collides by name` and `a glass catalogue that does not read is refused, naming the file and its reason` over `CatalogueImportInMemoryTests` and `CatalogueImportSqliteTests`, the count rising by 6; kit-acceptance MUST pass over OpticalConstructor.Ui.Tests.KitAcceptanceTests with AT-1 and AT-2 expectations and tolerances unchanged; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"suite": "kit-acceptance", "mode": "selected", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/CatalogueImportStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportInMemoryTests.a dropped glass catalogue is decided as one new user material per glass, writing nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportInMemoryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-IMPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportSqliteTests.a dropped glass catalogue is decided as one new user material per glass, writing nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-IMPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportInMemoryTests.an applied glass catalogue adds its glasses, and dropping it again collides by name", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportInMemoryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-IMPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportSqliteTests.an applied glass catalogue adds its glasses, and dropping it again collides by name", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-IMPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportInMemoryTests.a glass catalogue that does not read is refused, naming the file and its reason", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportInMemoryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-IMPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.CatalogueImportSqliteTests.a glass catalogue that does not read is refused, naming the file and its reason", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/CatalogueImportInMemoryTests.fs", "class": "OpticalConstructor.Tests.CatalogueImportSqliteTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S132-AGF-IMPORT"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.CatalogueImport.GlassCatalogueRead", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "obligations": ["S132-AGF-IMPORT"]}, {"symbol": "OpticalConstructor.Domain.CatalogueImport.CatalogueImportContext.readGlassCatalogue", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/CatalogueImport.fs", "obligations": ["S132-AGF-IMPORT"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 464, "anchor": "WIRE_UI", "ac": "AC-S132l", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Controls", "OpticalConstructor.Ui.Tests"], "depends_on": [463], "how_to": "The Materials window imports a glass catalogue the user picks, and one dropped on it, through the import dialog (001 §D; 001 §O; .spec-md §10.1 discoverability: the import dialog opens on a dropped entry file, and the window offers the verb; §10.3 identify → confirm; §10.4: the dialog's completion message re-renders the window; 001 §P: the button and the test send the same message). A dropped `.agf` file already decides through `DropMaterialEntryFiles` (step 110) and `decideDroppedFiles` (step 463); this step adds the verb and its message. Each doc is one to three lines citing spec 0050 S13.2. (1) `OpticalConstructor.Ui/MaterialsWindowView.fs`: (a) the public `pickGlassCatalogueFile (owner : Window) (onPicked : FileName -> unit) : unit` is the open dialog, an IO edge in `pickEntryExportFile`'s shape (step 119): `owner.StorageProvider.OpenFilePickerAsync` with `Title = \"Import glass catalogue\"`, `AllowMultiple = false` and one `FilePickerFileType` `Zemax glass catalogue` whose pattern is `*.agf`; a confirmed file's `Path.LocalPath` is passed as a `FileName`, posted on the UI thread, and a host without a provider changes nothing. (b) `MaterialsWindowMsg` gains `ImportGlassCatalogue of FileName`, documented in one line. (c) `updateMaterialsWindow`: `ImportGlassCatalogue file` answers what `DropMaterialEntryFiles [ file ]` answers (step 110), both arms calling one private helper over the file list: `Ok decisions` opens the import dialog over them (`context.openImportDialog`) and clears the import status and error; `Error e` sets `importError`. (d) The verbs row (`MaterialsWindowView.fs:verbsRow`), in Browse mode, after step 452's `Online sources…`: `verbButtonOn ConstructorUiId.materialsImportGlassCatalogueButton (ControlCaption \"Import glass catalogue…\")`, resolving the owner window from the press as `materialsExportButton` does (step 119), calls `pickGlassCatalogueFile owner (fun file -> dispatch (ImportGlassCatalogue file))`. Select mode never shows it. (2) `OpticalConstructor.Ui/MaterialsWindow.fs`: `member _.ImportGlassCatalogue (file : FileName) : unit` dispatches `ImportGlassCatalogue file`, the semantic seam the verb and the tests share, as `DropEntryFiles` is the drop's (step 110); the class doc names it in no more words. (3) `OpticalConstructor.Controls/UiIds.fs`, the Materials window group (`UiIds.fs:525`): `materialsImportGlassCatalogueButton` (`\"MaterialsImportGlassCatalogueButton\"`) under a one-line comment citing spec 0050 S13.2. (4) Tests, in `MaterialsWindowTests`, each AGF file written by the fact into a fresh GUID folder under `Path.Combine(AppContext.BaseDirectory, \"MaterialsWindowTests\")`: a test-local two-glass text, `LAB-A` (formula 2) and `LAB-B` (formula 1), ASCII. `the glass-catalogue UiId of the Materials window is the stable intent-named id`: the id's text. `ImportGlassCatalogue decides the catalogue's glasses and opens the import dialog, applying nothing`: over `stubContext` (steps 110, 119, 452) with its recording `openImportDialog`, `ImportGlassCatalogue` of the file records one dialog holding two `EntryIdNotHeld` rows named `LAB-A` and `LAB-B` under `FileImportProvenance`, the context's import seam holding neither; `ImportGlassCatalogue` of a missing file sets `importError` to `DroppedFileRefusedErr` and records no dialog. `Import glass catalogue… is offered in Browse mode only`: the Browse view shows `materialsImportGlassCatalogueButton` and a Select-mode view does not. With trait `ui-smoke`: `acceptance: a glass catalogue imported in the Materials window adds its glasses to the app library`: over `AppContext.create (TestAppScope.fileLocations (FolderName \"MaterialsWindowTests\")) WorkbenchSettings.defaults` (step 88), a `MaterialsWindow` built as the launcher builds it is shown headless; `window.ImportGlassCatalogue` of the file opens exactly one `ImportDialogWindow`, observed through `Window.WindowOpenedEvent` as `LauncherTests.clickAndObserve` observes; pressing its `importApplyButton` closes it, `ctx.materials.tryGetMaterial` resolves both glasses in the Glass category, and `materialsImportStatusText` shows the summary.", "acceptance": "After the verb is wired, the Materials window MUST offer `Import glass catalogue…` in Browse mode, and `ImportGlassCatalogue` MUST open the import dialog over the catalogue's glasses as a drop of the file does; constructor-unit-tests MUST pass; ui-smoke MUST pass, including `acceptance: a glass catalogue imported in the Materials window adds its glasses to the app library`, the count rising by 1; ui-tests MUST pass over the selected class, including `the glass-catalogue UiId of the Materials window is the stable intent-named id`, `ImportGlassCatalogue decides the catalogue's glasses and opens the import dialog, applying nothing` and `Import glass catalogue… is offered in Browse mode only`, the count rising by 3; and build, elevation and the twenty-one s44 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.MaterialsWindowTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindowView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindow.fs", "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs"], "tests": [{"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.the glass-catalogue UiId of the Materials window is the stable intent-named id", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-tests", "obligations": ["S132-AGF-WIRE"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.ImportGlassCatalogue decides the catalogue's glasses and opens the import dialog, applying nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-tests", "obligations": ["S132-AGF-WIRE"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.Import glass catalogue… is offered in Browse mode only", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-tests", "obligations": ["S132-AGF-WIRE"]}, {"op": "create", "suite": "ui-smoke", "id": "OpticalConstructor.Ui.Tests.MaterialsWindowTests.acceptance: a glass catalogue imported in the Materials window adds its glasses to the app library", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.MaterialsWindowTests", "discovery_gate": "ui-smoke", "obligations": ["S132-AGF-WIRE"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.MaterialsWindowView.MaterialsWindowMsg.ImportGlassCatalogue", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindowView.fs", "obligations": ["S132-AGF-WIRE"]}, {"symbol": "OpticalConstructor.Ui.MaterialsWindowView.pickGlassCatalogueFile", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/MaterialsWindowView.fs", "obligations": ["S132-AGF-WIRE"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.materialsImportGlassCatalogueButton", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S132-AGF-WIRE"]}], "packages": [], "checks": []}, "section": "S13.2 -- PTB OCDB, the Henke compound calculator and glass catalogues"}
{"number": 465, "anchor": "IMPLEMENT", "ac": "AC-S141a", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [464], "actions": ["ADD_TEST OpticalConstructor.Tests.PlannerSymmetryTests"], "how_to": "The point-group table of the Planner's layer 1, as pure Domain data (001 §M 'Layer 1, structural (exact, tabulated): the point group fixes the tensor components: isotropic 1, uniaxial 2, biaxial 3 + orientation; optical activity in 18 of the 21 non-centrosymmetric classes'; the S14.1 brief; specs/0046/.manual/018 §3 and its source 'Gyrotropic point groups (18 of 21)'). The optical class REUSES `Anisotropy` (`MaterialComplexityEditor.fs:Anisotropy`: `Isotropic | Uniaxial | Biaxial`, how many independent principal axes the eps carries), and a crystal record's class REUSES `CrystalParameters.anisotropy` (`LibraryFacets.fs`, step 355); no second class type is declared. Each doc is one to three lines citing spec 0050 S14.1; every case name has two words; no `bool` appears. (1) New `Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs`, `module PlannerSymmetry` in `namespace OpticalConstructor.Domain`, appended at the end of `OpticalConstructor.Domain.fsproj`'s compile list (one `<Compile Include=\"PlannerSymmetry.fs\" />` line, no comment), because it reads `CrystalPhysics` (step 353), `LibraryFacets`, `MaterialComplexityEditor`, `MuellerInverse` and `Studies` (step 361). Module doc: the Measurement Planner's layer-1 tables, what a crystal's symmetry allows and what a look at a plate of it can see (spec 0050 S14.1). (2) `ComponentCount of int` with `.value`, a count of independent components or angles. (3) `type Anisotropy with member this.independentIndexCount : ComponentCount`: 1 for `Isotropic`, 2 for `Uniaxial`, 3 for `Biaxial`. (4) `Centrosymmetry` = `CentrosymmetricClass | NonCentrosymmetricClass` and `Gyrotropy` = `GyrotropicClass | NonGyrotropicClass` (whether the class's symmetry allows natural optical activity). Both are derived and never stored, so they carry no wire tag. (5) `PointGroup`, the 32 crystallographic point groups, one case each, named by its crystal class (Hermann-Mauguin symbol in brackets): `TriclinicPedial` (1), `TriclinicPinacoidal` (-1), `MonoclinicSphenoidal` (2), `MonoclinicDomatic` (m), `MonoclinicPrismatic` (2/m), `OrthorhombicDisphenoidal` (222), `OrthorhombicPyramidal` (mm2), `OrthorhombicDipyramidal` (mmm), `TetragonalPyramidal` (4), `TetragonalDisphenoidal` (-4), `TetragonalDipyramidal` (4/m), `TetragonalTrapezohedral` (422), `DitetragonalPyramidal` (4mm), `TetragonalScalenohedral` (-42m), `DitetragonalDipyramidal` (4/mmm), `TrigonalPyramidal` (3), `TrigonalRhombohedral` (-3), `TrigonalTrapezohedral` (32), `DitrigonalPyramidal` (3m), `DitrigonalScalenohedral` (-3m), `HexagonalPyramidal` (6), `TrigonalDipyramidal` (-6), `HexagonalDipyramidal` (6/m), `HexagonalTrapezohedral` (622), `DihexagonalPyramidal` (6mm), `DitrigonalDipyramidal` (-6m2), `DihexagonalDipyramidal` (6/mmm), `CubicTetartoidal` (23), `CubicDiploidal` (m-3), `CubicGyroidal` (432), `CubicHextetrahedral` (-43m) and `CubicHexoctahedral` (m-3m). Members, each a complete match with no wildcard arm: `this.symbol : string`, the bracketed symbol, a bar written as a leading minus; `this.anisotropy : Anisotropy`, the five cubic classes `Isotropic`, the nineteen tetragonal, trigonal and hexagonal ones `Uniaxial`, the eight orthorhombic, monoclinic and triclinic ones `Biaxial`; `this.centrosymmetry : Centrosymmetry`, `CentrosymmetricClass` for exactly the eleven Laue classes -1, 2/m, mmm, 4/m, 4/mmm, -3, -3m, 6/m, 6/mmm, m-3 and m-3m; `this.gyrotropy : Gyrotropy`, `GyrotropicClass` for exactly the eighteen 1, 2, m, 222, mm2, 4, -4, 422, 4mm, -42m, 3, 32, 3m, 6, 622, 6mm, 23 and 432, so the three non-centrosymmetric classes -6, -6m2 and -43m and every centrosymmetric class are `NonGyrotropicClass`; `this.orientationAngleCount : ComponentCount`, how many angles fix the principal axes that the lattice does not, 3 for the two triclinic classes, 1 for the three monoclinic ones and 0 for the rest; and `static member all : PointGroup list`, the 32 in the order listed. (6) `CrystalSymmetry = { anisotropy : Anisotropy; pointGroups : PointGroup list }`, what a crystal record's tensor form allows, with `member this.independentIndexCount : ComponentCount` (its anisotropy's) and `member this.orientationAngleCount : ComponentCount` (the largest of its point groups', 0 for none). (7) `type CrystalParameters with member this.symmetry : CrystalSymmetry`: `anisotropy` is `this.anisotropy` (step 355); `pointGroups` is, for `UniaxialCrystal`, the six classes whose gyration tensor is diag(g11, g11, g33), `TrigonalPyramidal`, `TrigonalTrapezohedral`, `TetragonalPyramidal`, `TetragonalTrapezohedral`, `HexagonalPyramidal` and `HexagonalTrapezohedral` (the record's own doc 'classes 3/32/4/422/6/622', `MuellerInverse.fs:178`, moved with the record to `CrystalPhysics.fs` by step 353), and for `TriclinicCrystal` and `AbsorbingTriclinicCrystal` the one class `TriclinicPedial` (class 1, their docs). No wire tag, store, conversion or other member is added: nothing stores a point group, and the Planner's prior reads a kit's crystal through its record (step 471). Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs`, `module PlannerSymmetryTests` in `namespace OpticalConstructor.Tests`, appended at the end of `OpticalConstructor.Tests.fsproj`'s compile list with no comment. `the 32 point groups split into 11 centrosymmetric and 21 non-centrosymmetric classes, 18 of them gyrotropic`: `PointGroup.all` holds 32 distinct symbols; the centrosymmetric ones are exactly the eleven above; the other 21 hold exactly 18 gyrotropic classes, and the three that are not are -6, -6m2 and -43m; no centrosymmetric class is gyrotropic. `a point group fixes how many independent principal indices and orientation angles a crystal has`: the isotropic classes are exactly 23, m-3, 432, -43m and m-3m, each with one independent index; the nineteen uniaxial classes have two and the eight biaxial ones three; the orientation angle count is 3 for 1 and -1, 1 for 2, m and 2/m, and 0 for the other 27. `a crystal record states its anisotropy and the point groups whose tensor form it holds`: over test-local records written as literals (a uniaxial crystal n_o 1.544, n_e 1.553, g11 3.0e-5, g33 -1.0e-5, step 355's probe; a triclinic one with distinct indices; an absorbing one with fifteen distinct values), the uniaxial crystal's symmetry is `Uniaxial` over the symbols 3, 32, 4, 422, 6 and 622, each gyrotropic, with two independent indices and no orientation angle; the triclinic and the absorbing crystal's is `Biaxial` over 1, with three indices and three orientation angles.", "acceptance": "After the table lands, `PlannerSymmetry.PointGroup` MUST hold the 32 classes with 11 centrosymmetric, 18 gyrotropic (all non-centrosymmetric) and the 1 / 2 / 3 independent indices of isotropic / uniaxial / biaxial classes, and `CrystalParameters.symmetry` MUST state each record's anisotropy and point groups; constructor-unit-tests MUST pass, including `the 32 point groups split into 11 centrosymmetric and 21 non-centrosymmetric classes, 18 of them gyrotropic`, `a point group fixes how many independent principal indices and orientation angles a crystal has` and `a crystal record states its anisotropy and the point groups whose tensor form it holds`, the count rising by 3; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerSymmetryTests.the 32 point groups split into 11 centrosymmetric and 21 non-centrosymmetric classes, 18 of them gyrotropic", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "class": "OpticalConstructor.Tests.PlannerSymmetryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-POINT-GROUPS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerSymmetryTests.a point group fixes how many independent principal indices and orientation angles a crystal has", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "class": "OpticalConstructor.Tests.PlannerSymmetryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-POINT-GROUPS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerSymmetryTests.a crystal record states its anisotropy and the point groups whose tensor form it holds", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "class": "OpticalConstructor.Tests.PlannerSymmetryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-POINT-GROUPS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.PlannerSymmetry.ComponentCount", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.Anisotropy.independentIndexCount", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.Centrosymmetry", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.Gyrotropy", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.PointGroup", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalSymmetry", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalParameters.symmetry", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-POINT-GROUPS"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 466, "anchor": "IMPLEMENT", "ac": "AC-S141b", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [465], "how_to": "What each parameter of a crystal record is as a tensor component, and which principal axis a plate puts on its normal, so a look can be judged by the transverse rule (001 §M layer 1 'what each cut sees'; the S14.1 brief 'REUSE MuellerInverse.internalAngle, gyrationProjection and orientForCut'; `MuellerInverse.fs:62`'s module header: a wave only ever sees the tensor components transverse to its own propagation direction). The cut geometry REUSES `orientForCut` (`MuellerInverse.fs:orientForCut`), and a layer's orientation the rotation the system builder applies (`Propagation.fs:ResolvedLayer.getLayer`, `layer.rotate this.orientation.toRotation`, i.e. `OpticalProperties.rotate`, `MaterialProperties.fs:187`), so the Planner restates no rotation. In `PlannerSymmetry.fs`, after step 465's declarations, each doc one to three lines citing spec 0050 S14.1: (1) `CrystalAxis` = `FirstCrystalAxis | SecondCrystalAxis | ThirdCrystalAxis`, a principal axis of the frame the crystal records are written in (`CrystalPhysics.fs`, step 353). `static member marker : OpticalProperties`: the engine properties of a probe crystal, `TriclinicParameters` with `index1 = RefractionIndex 1.0`, `index2 = RefractionIndex 2.0`, `index3 = RefractionIndex 3.0` and every gyration component `RhoValue 0.0`, through its `opticalProperties` (steps 333, 353), so its permittivity is diag(1, 4, 9) and each axis is recognised by its own value wherever a rotation carries it. `static member normalOf (oriented : OpticalProperties) : CrystalAxis option`: the axis whose marker value (1, 4 or 9) equals the real part of `oriented.eps.[2, 2]` (`Eps.Item`, `MaterialProperties.fs:66`) within 1e-9 while the magnitudes of `oriented.eps.[0, 2]` and `oriented.eps.[1, 2]` are below 1e-9, i.e. the principal axis lying along the lab z-axis, the plate normal along which the system stratifies (`MuellerInverse.fs:orientForCut`'s doc); `None` when no principal axis lies along it. The tolerance is one private value of the module: a rotation by 90 degrees leaves round-off near 1e-16 on the entries it zeroes. (2) `CrystalAxisPair = { firstAxis : CrystalAxis; secondAxis : CrystalAxis }`, a record because a tuple repeating a type is ELEV011. (3) `TensorComponent` = `PrincipalIndexComponent of CrystalAxis list` (a principal index on the axes it occupies: n_o on the 1- and 2-axes of a uniaxial crystal) | `GyrationDiagonalComponent of CrystalAxis list` | `GyrationOffDiagonalComponent of CrystalAxisPair` | `AbsorptionDiagonalComponent of CrystalAxis` (a diagonal component of the absorbing record's ε″) | `AbsorptionOffDiagonalComponent of CrystalAxisPair`, with `member this.axes : CrystalAxis list` (a pair's two axes in order). (4) `CrystalComponent = { name : ParameterName; component : TensorComponent }`, one parameter of a crystal record and the component it is. (5) `type CrystalParameters with member this.components : CrystalComponent list`: the names of `this.parameterAxes` (`Studies.fs`, step 361) in their order, each paired positionally (`List.map2`) with its case's component list, so no parameter name is written a second time (AGENTS.md 'Reuse, never copy'). `UniaxialCrystal`: n_o `PrincipalIndexComponent [ FirstCrystalAxis; SecondCrystalAxis ]`, n_e `PrincipalIndexComponent [ ThirdCrystalAxis ]`, g11 `GyrationDiagonalComponent [ FirstCrystalAxis; SecondCrystalAxis ]`, g33 `GyrationDiagonalComponent [ ThirdCrystalAxis ]`. `TriclinicCrystal`: n1, n2 and n3 the index on the 1-, 2- and 3-axis; g11, g22 and g33 the gyration diagonal on each; g23, g13 and g12 the off-diagonals on (2, 3), (1, 3) and (1, 2). `AbsorbingTriclinicCrystal`: the three indices; e11, e22 and e33 `AbsorptionDiagonalComponent` on each axis; e23, e13 and e12 `AbsorptionOffDiagonalComponent` on (2, 3), (1, 3) and (1, 2); then the six gyration components as the triclinic record has them (`MuellerInverse.fs:AbsorbingTriclinicParameters`' axes order). (6) `type SampleCut with member this.normalAxisOpt : CrystalAxis option` (`MuellerInverse.fs:SampleCut`): `CrystalAxis.normalOf (orientForCut this (SampleAzimuth.degree 0.0<Berreman.Constants.deg>) CrystalAxis.marker)`, so `ZCut` answers the 3-axis, `XCut` the 1-axis and `YCut` the 2-axis (the transverse planes `BiaxialInverseTests.fs:135-140` lists), and a `TiltedCut` off 0 and 90 degrees none; the azimuth turns a plate about its normal and never changes the axis on it. (7) `type CrystalOrientation with member this.normalAxisOpt : CrystalAxis option` (`ElementId.fs:CrystalOrientation`): `CrystalAxis.normalOf (CrystalAxis.marker.rotate this.toRotation)` (`ElementId.fs:115`); `PrimaryAxes` is the identity rotation, so a plate of a crystal in its own frame is a z-cut, as `orientForCut ZCut` is. No other member is added. Tests, in `PlannerSymmetryTests` (step 465), over its test-local records: `every crystal record names its parameters' tensor components in its axis order`: each crystal's `components` names equal its `parameterAxes` names in order; the uniaxial components are the four above; the triclinic g23, g13 and g12 are `GyrationOffDiagonalComponent` of the pairs (2, 3), (1, 3) and (1, 2); the absorbing crystal has fifteen components whose seventh to ninth are `AbsorptionOffDiagonalComponent`s and whose last three are `GyrationOffDiagonalComponent`s. `each principal cut puts on the normal the axis orientForCut carries there, and a tilted cut puts none`: `ZCut`, `XCut` and `YCut` answer `ThirdCrystalAxis`, `FirstCrystalAxis` and `SecondCrystalAxis`; `TiltedCut (Angle.degree 30.0<Berreman.Constants.deg>)` answers `None`; and the real part of `CrystalAxis.marker.eps.[i, i]` is 1, 4 and 9 for i = 0, 1, 2. `a plate's crystal orientation puts its axis on the normal as the system builder rotates it`: `PrimaryAxes` answers `ThirdCrystalAxis`; an `EulerRotation` under `ZmYpXp` with phi = psi = 0 and theta = 90 degrees (the rotation `Rotation.rotateY` builds, `Geometry.fs:584`, which `orientForCut XCut` applies) answers `FirstCrystalAxis`; and one with theta = 30 degrees answers `None`.", "acceptance": "After the components and the cut geometry land, `CrystalParameters.components` MUST name every record parameter's tensor component in its axes' order, and `SampleCut.normalAxisOpt` and `CrystalOrientation.normalAxisOpt` MUST answer the principal axis that `orientForCut` and the layer rotation carry onto the plate normal; constructor-unit-tests MUST pass, including `every crystal record names its parameters' tensor components in its axis order`, `each principal cut puts on the normal the axis orientForCut carries there, and a tilted cut puts none` and `a plate's crystal orientation puts its axis on the normal as the system builder rotates it`, the count rising by 3; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerSymmetryTests.every crystal record names its parameters' tensor components in its axis order", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "class": "OpticalConstructor.Tests.PlannerSymmetryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerSymmetryTests.each principal cut puts on the normal the axis orientForCut carries there, and a tilted cut puts none", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "class": "OpticalConstructor.Tests.PlannerSymmetryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerSymmetryTests.a plate's crystal orientation puts its axis on the normal as the system builder rotates it", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerSymmetryTests.fs", "class": "OpticalConstructor.Tests.PlannerSymmetryTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-COMPONENTS-AND-CUTS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalAxis", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalAxisPair", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.TensorComponent", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalComponent", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalParameters.components", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.SampleCut.normalAxisOpt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}, {"symbol": "OpticalConstructor.Domain.PlannerSymmetry.CrystalOrientation.normalAxisOpt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/PlannerSymmetry.fs", "obligations": ["S141-COMPONENTS-AND-CUTS"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 467, "anchor": "IMPLEMENT", "ac": "AC-S141c", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [466], "actions": ["ADD_TEST OpticalConstructor.Tests.PlannerReportTests"], "how_to": "A look at a plate, and what one look sees of each tensor component, by the layer-1 rules (001 §M 'what each cut sees: a c-cut at normal incidence sees n_o only (and g33); n_e needs oblique incidence or an a-cut', 'activity along birefringent directions needs full-Mueller or HAUP-class measurements', 'intensity-only detectors lose phase'; the S14.1 brief). The rules speak the parameterization the study engine fits, the engine's bi-anisotropic rho, along whose propagation direction the TRANSVERSE gyration acts and g33 does not (`MuellerInverse.fs:62` module header), because the Planner reports on the study engine's unknowns and `MuellerInverseTests` asserts `C1 is completely blind to g33`; 001's '(and g33)' is the crystallographic reading. So the crystallographic projection `gyrationProjection`, which that header and its own doc (`MuellerInverse.fs:gyrationProjection`) say is deliberately not used to predict this engine, is not called; the Snell cap reuses `internalAngle` (step 468) and the cut geometry `orientForCut` (step 466). Every rule is first order: what a look's normalized reading depends on linearly. (1) New `Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs`, `module MeasurementPlanner` in `namespace OpticalConstructor.Domain`, appended at the end of the Domain compile list after `PlannerSymmetry.fs` (one `<Compile>` line, no comment). Module doc: the Measurement Planner's inputs from a kit and its structural recoverability report (spec 0050 S14.1). Each doc below is one to three lines citing spec 0050 S14.1; every case name has two words; no `bool` appears. (2) `DetectorReach` = `FullMuellerReach` (a full Mueller matrix: a polarimeter, or the HAUP class, an intensity detector between a polarizer and an analyzer) | `EllipsometricReach` (Psi and Delta, the ratio of the diagonal Jones elements) | `IntensityOnlyReach` (S0 alone, its level scaled by the detector's gain, 001 §I). (3) `LookTilt` = `NormalIncidenceLook | ObliqueIncidenceLook` and `AxisAspect` = `TransverseAxis | LongitudinalAxis`. (4) `PlannerLook = { normalAxisOpt : CrystalAxis option; incidence : IncidenceAngle; observable : Observable; reach : DetectorReach }`, one measurement a kit or a design makes of a plate: the principal axis on its normal (step 466), the external incidence, T or R (`MuellerInverse.fs:Observable`) and what its detector records. `member this.tilt : LookTilt` is `NormalIncidenceLook` when `this.incidence.value` equals `IncidenceAngle.normal.value` (`Fields.fs:29`) and `ObliqueIncidenceLook` otherwise. `member this.aspectOf (axis : CrystalAxis) : AxisAspect` is `LongitudinalAxis` when the look is at normal incidence and `normalAxisOpt` is `Some axis`, and `TransverseAxis` otherwise: off normal incidence the refracted wave runs at a non-zero internal angle to the normal, so no principal axis lies along it. (5) `type MeasurementConfiguration with member this.plannerLookWith (reach : DetectorReach) : PlannerLook` (`MuellerInverse.fs:MeasurementConfiguration`): `{ normalAxisOpt = this.cut.normalAxisOpt; incidence = this.incidenceAngle; observable = this.observable; reach = reach }`, so a spec 0044 design is read as looks with nothing transcribed. (6) `LookSight` = `SeenInLook | AlongPropagationInLook | NormalIncidenceInLook | NoRetardanceInLook | ReachMissesInLook`. (7) On `PlannerLook`, `member this.sightOf (crystal : CrystalParameters) (component : TensorComponent) : LookSight`, where an axis is transverse when `aspectOf` answers `TransverseAxis`: (a) `PrincipalIndexComponent axes`: `AlongPropagationInLook` when no axis of `axes` is transverse; otherwise `SeenInLook` for an oblique look (the Fresnel amplitudes and the internal angle move with the index, specs/0044/.manual/004 §3.2); otherwise, at normal incidence, `SeenInLook` when the reach is not `IntensityOnlyReach` and the transverse axes are occupied by two or more distinct `PrincipalIndexComponent`s of `crystal.components` (linear retardance, whose phase carries the indices), and `NoRetardanceInLook` otherwise: a uniaxial plate along its optic axis is a pure rotator whose normalized matrix carries no index at first order (`MuellerInverseTests`' `C1 alone cannot determine three of the four constants`), and an intensity-only reading records no retardance while the gain takes its level. (b) `GyrationDiagonalComponent axes`: `AlongPropagationInLook` when no axis is transverse; `SeenInLook` under `FullMuellerReach`; `ReachMissesInLook` otherwise (optical activity rotates the polarization, which Psi and Delta and an intensity without an analyzer do not record at first order, and along a birefringent direction it is buried under the retardance, 001 §M). (c) `GyrationOffDiagonalComponent _`: `NormalIncidenceInLook` for a normal-incidence look at a plate with a principal axis on its normal (the engine's rho couples the off-diagonal components through the wave's longitudinal field, which exists only off normal incidence: `BiaxialInverseTests.fs:42-48` and `the cuts buy the gyration DIAGONAL and only the tilt buys its OFF-DIAGONAL`); otherwise `SeenInLook` under `FullMuellerReach` and `ReachMissesInLook` under another reach. (d) `AbsorptionDiagonalComponent axis`: `SeenInLook` when the axis is transverse, else `AlongPropagationInLook`. (e) `AbsorptionOffDiagonalComponent pair`: `SeenInLook` when both axes are transverse, else `AlongPropagationInLook` (a component coupling the propagation axis reaches the transverse response only at second order). A plate with no principal axis on its normal has every axis transverse, so the Planner never calls a component unseen through it; layer 2 (S14.2) measures such a plate. No other type or member is added. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs`, `module PlannerReportTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, over test-local records written as literals (step 465's uniaxial, triclinic and absorbing probes) and looks written as records, an oblique look being at `IncidenceAngle.create (Angle.degree 30.0<Berreman.Constants.deg>)`. `a look sees a component only through an axis transverse to its propagation`: at a z-cut at normal incidence, transmitted, `FullMuellerReach`, the uniaxial n_e and g33 are `AlongPropagationInLook` and g11 `SeenInLook`; at the same plate oblique, n_e and g33 are `SeenInLook`; at an x-cut at normal incidence g33 is `SeenInLook`; `aspectOf` answers `LongitudinalAxis` for the 3-axis and `TransverseAxis` for the 1-axis at the normal z-cut, `TransverseAxis` for every axis oblique and at normal incidence on a plate whose `normalAxisOpt` is `None`. `an index needs linear retardance at normal incidence, or an oblique look`: the uniaxial n_o is `NoRetardanceInLook` at the normal z-cut, transmitted and reflected, and `SeenInLook` with n_e at the normal x-cut; the triclinic n1 and n2 are `SeenInLook` and n3 `AlongPropagationInLook` at the normal z-cut; under `IntensityOnlyReach` the uniaxial n_o is `NoRetardanceInLook` at the normal x-cut and `SeenInLook` at the oblique z-cut. `gyration needs a full Mueller reach, and an off-diagonal component an oblique look`: at the normal z-cut under `FullMuellerReach` the triclinic g12 is `NormalIncidenceInLook` and g11 `SeenInLook`; oblique, g12 and g13 are `SeenInLook`; under `EllipsometricReach` the uniaxial g33 at the normal x-cut and g11 at the normal z-cut are `ReachMissesInLook`; under `IntensityOnlyReach` the oblique triclinic g12 is `ReachMissesInLook`; and at normal incidence on a plate whose `normalAxisOpt` is `None` g12 is `SeenInLook` under `FullMuellerReach`. `an absorption component is seen through its transverse axes`: at the normal z-cut the absorbing e11 and e12 are `SeenInLook` and e33 and e13 `AlongPropagationInLook`; oblique, e33 and e13 are `SeenInLook`. `a measurement configuration is a look at its cut's normal axis, incidence and observable`: the configuration `{ cut = XCut; thickness = Thickness.mkm 20.0<Berreman.Constants.mkm>; incidenceAngle = IncidenceAngle.create (Angle.degree 30.0<Berreman.Constants.deg>); azimuth = SampleAzimuth.degree 45.0<Berreman.Constants.deg>; observable = ReflectedMueller; waveLength = WaveLength.nm 632.8<Berreman.Constants.nm> }}`'s `plannerLookWith EllipsometricReach` is the look of `FirstCrystalAxis`, that incidence, `ReflectedMueller` and `EllipsometricReach`, its tilt `ObliqueIncidenceLook`; the same configuration with `ZCut` at 0 degrees is a `NormalIncidenceLook` of `ThirdCrystalAxis`.", "acceptance": "After the looks land, `PlannerLook.sightOf` MUST judge each component by the transverse, retardance, full-Mueller and off-normal rules, and `MeasurementConfiguration.plannerLookWith` MUST read a design's configuration as a look; constructor-unit-tests MUST pass, including `a look sees a component only through an axis transverse to its propagation`, `an index needs linear retardance at normal incidence, or an oblique look`, `gyration needs a full Mueller reach, and an off-diagonal component an oblique look`, `an absorption component is seen through its transverse axes` and `a measurement configuration is a look at its cut's normal axis, incidence and observable`, the count rising by 5; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.a look sees a component only through an axis transverse to its propagation", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-LOOK-SIGHT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.an index needs linear retardance at normal incidence, or an oblique look", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-LOOK-SIGHT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.gyration needs a full Mueller reach, and an off-diagonal component an oblique look", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-LOOK-SIGHT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.an absorption component is seen through its transverse axes", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-LOOK-SIGHT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.a measurement configuration is a look at its cut's normal axis, incidence and observable", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-LOOK-SIGHT"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MeasurementPlanner.DetectorReach", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-LOOK-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.LookTilt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-LOOK-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.AxisAspect", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-LOOK-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerLook", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-LOOK-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.MeasurementConfiguration.plannerLookWith", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-LOOK-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.LookSight", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-LOOK-SIGHT"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 468, "anchor": "IMPLEMENT", "ac": "AC-S141d", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [467], "how_to": "What a set of looks can recover of one target, and how far a tilt carries the wave off a plate's normal (001 §M 'It answers outright \"this kit can never recover X\"'; 'Snell caps the internal angle at arcsin(1/n_o) ≈ 40.4° for quartz, so more than one cut is required'; the S14.1 brief 'Snell caps the internal angle (REUSE MuellerInverse.internalAngle …)'). In `MeasurementPlanner.fs`, after step 467's declarations, each doc one to three lines citing spec 0050 S14.1: (1) `UnseenReason` = `NoLookReason` (there is no look: the kit holds no plate of the material, or no detector) | `AlongEveryPropagationReason` | `NormalIncidenceOnlyReason` | `NoRetardanceReason` | `FullMuellerNeededReason`, with `member this.text : string`, in that order: `no look of the kit measures a plate of it`, `every look propagates along its axes`, `it is seen only off normal incidence`, `no look carries its linear retardance or an oblique change of the Fresnel amplitudes` and `it needs a full Mueller polarimeter, or a polarizer and an analyzer around the plate`. It is derived, never stored, so it carries no wire tag. (2) `TargetSight` = `ReachableTarget | UnreachableTarget of UnseenReason`. (3) `type CrystalParameters with member this.targetSightOf (looks : PlannerLook list) (component : TensorComponent) : TargetSight`: `UnreachableTarget NoLookReason` for no look; `ReachableTarget` when some look's `sightOf this component` (step 467) is `SeenInLook`; otherwise `UnreachableTarget` of the first that applies, the reason naming what the looks lack closest to seeing it: `FullMuellerNeededReason` when some look answers `ReachMissesInLook`, `NoRetardanceReason` when some answers `NoRetardanceInLook`, `NormalIncidenceOnlyReason` when some answers `NormalIncidenceInLook`, and `AlongEveryPropagationReason` otherwise. (4) `member this.snellCap : Angle` on `CrystalParameters`: `internalAngle n IncidenceAngle.maxValue` (`MuellerInverse.fs:internalAngle`; `Fields.fs:30`, the steepest incidence the engine takes, 89 degrees) for n the smallest of the crystal's principal indices (the record's `RefractionIndex` itself, n_o or n_e, index1 to index3): the largest internal angle any tilt of a plate of it reaches, so a tilt never carries the wave further than this off the plate normal. No other member is added. Tests, in `PlannerReportTests` (step 467), over its probes and looks: `a target is reachable when any look sees it, and unreachable when there is no look`: the uniaxial n_e over a normal z-cut look and a normal x-cut look, both transmitted under `FullMuellerReach`, is `ReachableTarget`, and every uniaxial component over no look is `UnreachableTarget NoLookReason`. `an unreachable target takes the reason of the look that came closest to seeing it`: over the normal z-cut look alone the uniaxial n_o is `NoRetardanceReason` and g33 `AlongEveryPropagationReason`; adding a normal x-cut look under `EllipsometricReach` makes g33 `FullMuellerNeededReason`; the triclinic g12 over the three principal cuts at normal incidence under `FullMuellerReach` is `NormalIncidenceOnlyReason`; and each reason's `text` is its sentence above. `the Snell cap is the internal angle of the smallest principal index at the steepest incidence`: the uniaxial probe's `snellCap` equals `internalAngle (RefractionIndex 1.544) IncidenceAngle.maxValue` exactly, and the triclinic probe's equals `internalAngle` of its smallest index at `IncidenceAngle.maxValue` exactly.", "acceptance": "After the target sight lands, `CrystalParameters.targetSightOf` MUST answer a target reachable when one look sees it and otherwise the reason of the closest look, and `CrystalParameters.snellCap` MUST be `internalAngle` of the smallest principal index at `IncidenceAngle.maxValue`; constructor-unit-tests MUST pass, including `a target is reachable when any look sees it, and unreachable when there is no look`, `an unreachable target takes the reason of the look that came closest to seeing it` and `the Snell cap is the internal angle of the smallest principal index at the steepest incidence`, the count rising by 3; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.a target is reachable when any look sees it, and unreachable when there is no look", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-TARGET-SIGHT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.an unreachable target takes the reason of the look that came closest to seeing it", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-TARGET-SIGHT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.the Snell cap is the internal angle of the smallest principal index at the steepest incidence", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-TARGET-SIGHT"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MeasurementPlanner.UnseenReason", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-TARGET-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.TargetSight", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-TARGET-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.CrystalParameters.targetSightOf", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-TARGET-SIGHT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.CrystalParameters.snellCap", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-TARGET-SIGHT"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 469, "anchor": "IMPLEMENT", "ac": "AC-S141e", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [468], "how_to": "The structural recoverability report: 'this kit can never recover X' and 'you need an off-axis cut', each with its remedy (001 §M 'It answers outright \"this kit can never recover X\" and \"you need an off-axis cut\"', 'Output: a recoverability report'; the S14.1 brief 'It outputs … findings'; specs/0044/.manual/004 §3.2 'Tilting alone is not sufficient'). In `MeasurementPlanner.fs`, after step 468's declarations, each doc one to three lines citing spec 0050 S14.1. (1) `type SampleCut with member this.plateText : string`: `z-cut plate`, `x-cut plate`, `y-cut plate`, and for `TiltedCut a` `<a in degrees>° tilted-cut plate`. (2) `PlannerRemedy` = `AddPlateRemedy of SampleCut` | `ObliqueIncidenceRemedy of cap : Angle` | `FullMuellerRemedy`, with `member this.text : string`: `add one <plateText>`, `tilt a plate (its internal angle reaches at most <cap in degrees>°)` and `use a full Mueller polarimeter, or a polarizer and an analyzer around the plate`. (3) `TargetFinding = { target : CrystalComponent; reason : UnseenReason; remedies : PlannerRemedy list }`. (4) `OffAxisCutNeed = { targets : CrystalComponent list; capAngle : Angle; cuts : SampleCut list }`. (5) `PlannerFinding` = `UnrecoverableTargetFinding of TargetFinding | OffAxisCutFinding of OffAxisCutNeed`, with `member this.text : string`: `This kit can never recover <name>: <reason text>.` and `You need an off-axis cut: <the targets' names joined by \", \"> lie along the normal of every plate, and a tilt carries the wave at most <capAngle in degrees>° off it; add <\"one \" + each cut's plateText, joined by \" or \">.`. Every angle in a text is in degrees with one decimal, formatted under `CultureInfo.InvariantCulture`. (6) `RecoverabilityReport = { symmetry : CrystalSymmetry; reachable : CrystalComponent list; findings : PlannerFinding list }`, with `member this.unrecoverable : CrystalComponent list` (the targets of its `UnrecoverableTargetFinding`s, in order) and `member this.offAxisCutOpt : OffAxisCutNeed option`. (7) `PlannerError`, an `*Error` union whose every case is `of reason : string`, with `UnknownPlannerTargetErr` and `member this.describe : string` rendering it `the crystal has no such parameter: <reason>`. (8) `type CrystalParameters with member this.structuralReport (targets : ParameterName list) (looks : PlannerLook list) : Result<RecoverabilityReport, PlannerError>`. (a) The first target name that no component of `this.components` (step 466) has answers `UnknownPlannerTargetErr` naming it and the crystal's names. (b) Each target component, in target order, goes by `targetSightOf looks` (step 468) into `reachable` or into an `UnrecoverableTargetFinding` of its reason and remedies. (c) The candidate plates are the crystal's distinct principal cuts, `[ ZCut; XCut ]` when `this.symmetry.anisotropy` is `Uniaxial` (a y-cut looks at a uniaxial crystal as an x-cut does, `MuellerInverse.fs:SampleCut`'s doc) and `[ ZCut; XCut; YCut ]` otherwise; a candidate SEES the component when the normal-incidence look `{ normalAxisOpt = cut.normalAxisOpt; incidence = IncidenceAngle.normal; observable = TransmittedMueller; reach = FullMuellerReach }` answers `SeenInLook`, and is MISSING when no look has its `normalAxisOpt`. Remedies by reason: `NoLookReason`, `AddPlateRemedy` of every candidate that sees the component, then `FullMuellerRemedy`; `AlongEveryPropagationReason` and `NoRetardanceReason`, `AddPlateRemedy` of every missing candidate that sees it, then `ObliqueIncidenceRemedy this.snellCap`; `NormalIncidenceOnlyReason`, `[ ObliqueIncidenceRemedy this.snellCap ]` alone, because more plates do not substitute for a tilt (`BiaxialInverseTests.fs:42-48`); `FullMuellerNeededReason`, `[ FullMuellerRemedy ]`. (d) When the looks are not empty and every look's `normalAxisOpt` is the same `Some a`, the targets whose component's `axes` is exactly `[ a ]`, in target order, give, if there are any, one `OffAxisCutFinding { targets; capAngle = this.snellCap; cuts = the candidates whose normalAxisOpt is not Some a }` after the target findings: every plate puts those components on its normal, so only a tilt reaches them, at most `snellCap` off it. (e) `symmetry` is `this.symmetry` (step 465). The report adds no caching and reads nothing beyond its arguments. Tests, in `PlannerReportTests`, over its probes: `each unrecoverable target names the missing plates and the tilt or the reach that would recover it`: over the normal z-cut look alone (transmitted, `FullMuellerReach`) the uniaxial report's `reachable` is [g11] and its target findings are n_o `NoRetardanceReason`, n_e and g33 `AlongEveryPropagationReason`, each with `[ AddPlateRemedy XCut; ObliqueIncidenceRemedy <the probe's snellCap> ]`; over a normal x-cut look under `EllipsometricReach` g11 and g33 are `FullMuellerNeededReason` with `[ FullMuellerRemedy ]`; the triclinic g12 over the three principal cuts at normal incidence has `[ ObliqueIncidenceRemedy <its snellCap> ]` alone; over no look the uniaxial g11 has `[ AddPlateRemedy ZCut; AddPlateRemedy XCut; FullMuellerRemedy ]`. `plates that all put the same axis on their normal call for an off-axis cut`: the uniaxial report over the normal z-cut look has `offAxisCutOpt = Some { targets = [ n_e; g33 ]; capAngle = <its snellCap>; cuts = [ XCut ] }` as its last finding; over that look and the same z-cut oblique it has no target finding and the same off-axis finding; over that look and a normal x-cut look it has no finding at all; the triclinic report over the normal z-cut look has the off-axis targets [ n3; g33 ] and cuts [ XCut; YCut ]. `a target the crystal does not have refuses the report, naming it`: the target name `n2` over the uniaxial probe answers `UnknownPlannerTargetErr` whose reason names `n2`, and its `describe` starts `the crystal has no such parameter: `. `the findings read as sentences naming the parameter, the reason and the remedy`: over the normal z-cut look the uniaxial report's findings read `This kit can never recover n_e: every look propagates along its axes.` and `You need an off-axis cut: n_e, g33 lie along the normal of every plate, and a tilt carries the wave at most 40.4° off it; add one x-cut plate.`, and its n_o remedies read `add one x-cut plate` and `tilt a plate (its internal angle reaches at most 40.4°)`.", "acceptance": "After the report lands, `CrystalParameters.structuralReport` MUST answer the reachable targets, an unrecoverable-target finding with its reason and remedies for every other target, and an off-axis-cut finding when every plate puts a target's only axis on its normal, refusing an unknown target with `UnknownPlannerTargetErr`; constructor-unit-tests MUST pass, including `each unrecoverable target names the missing plates and the tilt or the reach that would recover it`, `plates that all put the same axis on their normal call for an off-axis cut`, `a target the crystal does not have refuses the report, naming it` and `the findings read as sentences naming the parameter, the reason and the remedy`, the count rising by 4; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.each unrecoverable target names the missing plates and the tilt or the reach that would recover it", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.plates that all put the same axis on their normal call for an off-axis cut", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.a target the crystal does not have refuses the report, naming it", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerReportTests.the findings read as sentences naming the parameter, the reason and the remedy", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerReportTests.fs", "class": "OpticalConstructor.Tests.PlannerReportTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S141-STRUCTURAL-REPORT"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MeasurementPlanner.SampleCut.plateText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerRemedy", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.TargetFinding", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.OffAxisCutNeed", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerFinding", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.RecoverabilityReport", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerError", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.CrystalParameters.structuralReport", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S141-STRUCTURAL-REPORT"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number":470,"anchor":"IMPLEMENT","ac":"AC-S141f","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[469],"actions":["ADD_TEST OpticalConstructor.Tests.PlannerInputsTests"],"how_to":"The lab profile is the kit's items; nothing is typed in (001 §M 'Its inputs are the kit; there is no separate \"lab profile\" to type in: lab profile = the kit's items: sources and lambda ranges, polarizers, compensators, compounds, detectors, angle ranges, and each detector's noise model'; the S14.1 brief, the noise model being the detector parameter axes defined in step 206, with the bench implementation promoted to Optimization in step 339). An item's model is read as the study's forward model reads it, through a `choiceOf : Item -> ItemModelChoice option` (`StudyForwardContext.choiceOf`, step 372; the window's `tryItemModelChoice`, step 263), so no second resolution is written. In `MeasurementPlanner.fs`, after step 469's declarations, each doc one to three lines citing spec 0050 S14.1; every case name has two words; no `bool` appears. (1) `PlannerError` (step 469) gains `UnresolvedPlannerItemErr`, rendered `the item's model is not in the library: <reason>`. (2) `PlannerSource = { item : ItemId; label : ItemLabel; waveLength : WaveLength; tunableLimitsOpt : WaveLengthInterval option }` (the preset's line and limits, `ElementId.fs:SourcePreset`, `tunableLimitsOpt`). (3) `OpticRole` = `PolarizerOptic | CompensatorOptic | CompoundOptic` and `PlannerOptic = { item : ItemId; label : ItemLabel; role : OpticRole }`. (4) `DetectorRecording` = `RecordsIntensity | RecordsMuellerMatrix | RecordsPsiDelta` and `PlannerDetector = { item : ItemId; label : ItemLabel; recording : DetectorRecording; noise : ParameterValues }`. The three unions are derived, never stored, so they carry no wire tag. (5) `LabProfile = { sources : PlannerSource list; optics : PlannerOptic list; detectors : PlannerDetector list }`. `static member ofItems (items : Item list) (choiceOf : Item -> ItemModelChoice option) : Result<LabProfile, PlannerError>` reads the items in order (step 216's `ItemModelChoice`, step 208's forms): an item whose `choiceOf` is `None` answers `UnresolvedPlannerItemErr` naming its label, and nothing is answered in part; `SourcePresetChoice (sourceModel, p)` is a source; `PolarizerPresetChoice (polarizerModel, p)` is an optic, `PolarizerOptic` for a `ComputedIdeal` behavior and `CompoundOptic` for a `ConstantMueller` one (`ElementId.fs:PolarizerBehavior`); a `LibraryModelChoice v` reads `v.entry.model`: `OpticalElementModel (RealPolarizerModel _)` is a `PolarizerOptic`, `RetarderPlateModel _` a `CompensatorOptic`, `CompoundModel components` a `CompoundOptic` when a component at any depth is a `RealPolarizerModel` and a `CompensatorOptic` otherwise, `BlackBoxMuellerModel _` and `EmptySlotModel` are neither (an object and the calibration reference), and `IntensityDetectorModel n`, `MuellerPolarimeterModel n` and `EllipsometerModel n` are detectors recording `RecordsIntensity`, `RecordsMuellerMatrix` and `RecordsPsiDelta` with noise ParameterValues.ofParameters of that detector item, checked against n; a missing or invalid noise value MUST answer UnresolvedPlannerItemErr naming the item and the rejected axis; a `StackSampleChoice` is no part of the profile (the plates are read in step 471). `member this.reachOf (detector : PlannerDetector) : DetectorReach`: `FullMuellerReach` for `RecordsMuellerMatrix`, `EllipsometricReach` for `RecordsPsiDelta`, and for `RecordsIntensity` `FullMuellerReach` when the profile holds two or more polarizing optics (`PolarizerOptic` or `CompoundOptic`), a polarizer and an analyzer around the plate (the HAUP class, 001 §M), and `IntensityOnlyReach` otherwise. `member this.reaches : DetectorReach list`: each reach some detector's `reachOf` answers, once, in the order `FullMuellerReach`, `EllipsometricReach`, `IntensityOnlyReach`. No other member is added. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs`, `module PlannerInputsTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment. Its items are made by `ItemDraft.toItem` (step 216) with `FixedMounting`, over the Built-in catalogue as `BuiltinCatalogue` reads it (steps 207, 210): `Laser` (`SourcePresetChoice` of `PresetIds.heNe633`), `LP1` and `LP2` (`PolarizerPresetChoice` of `PresetIds.polarizerLp`), `CPL1` (`ItemModelIds.circularPolarizerModelId`), `RET` (`ItemModelIds.retarderPlateModelId`), `Phone` (`ItemModelIds.intensityDetectorModelId`), `Polarimeter` (`ItemModelIds.muellerPolarimeterModelId`), `Ellipsometer` (`ItemModelIds.ellipsometerModelId`) and `GL` (`StackSampleChoice` of `SampleIds.glassPlate1mmId` at version 1), and a test-local `choiceOf` answers each item's draft model. `the lab profile reads the kit's sources, optics and detectors from their models`: over all nine, `sources` is [Laser] at the preset's `waveLength` with no limits; `optics` is LP1 and LP2 `PolarizerOptic`, CPL1 `CompoundOptic` and RET `CompensatorOptic`, in item order; `detectors` is Phone `RecordsIntensity`, Polarimeter `RecordsMuellerMatrix` and Ellipsometer `RecordsPsiDelta`, each with the noise ParameterValues derived from that item's parameter states; GL is in none. `an intensity detector reaches a full Mueller matrix only between a polarizer and an analyzer`: in a profile of Phone, LP1 and CPL1, `reachOf` Phone is `FullMuellerReach`; of Phone and LP1, or of Phone, LP1 and RET, `IntensityOnlyReach`; Polarimeter's is `FullMuellerReach` and Ellipsometer's `EllipsometricReach` in any profile; and the `reaches` of a profile of Phone, LP1 and Ellipsometer are [EllipsometricReach; IntensityOnlyReach]. `an item whose model the library does not resolve refuses the lab profile, naming it`: a `choiceOf` answering `None` for LP2 makes `ofItems` answer `UnresolvedPlannerItemErr` naming `LP2`, its `describe` starting `the item's model is not in the library: `. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved. The first fact MUST additionally change one detector's rotationUncertainty parameter and verify that its lab-profile noise reads that value rather than the library default. MeasurementPlanner.fs MUST open OpticalConstructor.Domain.ItemEvaluation for ParameterValues; the Domain lab-profile code MUST NOT open or reference Optimization.","acceptance":"After the lab profile lands, `LabProfile.ofItems` MUST read every kit item's model into sources, optics and detectors (with their noise models) or refuse an unresolved item, and `reachOf` MUST give an intensity detector a full Mueller reach only beside two polarizing optics; constructor-unit-tests MUST pass, including `the lab profile reads the kit's sources, optics and detectors from their models`, `an intensity detector reaches a full Mueller matrix only between a polarizer and an analyzer` and `an item whose model the library does not resolve refuses the lab profile, naming it`, the count rising by 3; and build, elevation and the twenty-one s45 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.the lab profile reads the kit's sources, optics and detectors from their models","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-LAB-PROFILE"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.an intensity detector reaches a full Mueller matrix only between a polarizer and an analyzer","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-LAB-PROFILE"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.an item whose model the library does not resolve refuses the lab profile, naming it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-LAB-PROFILE"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError.UnresolvedPlannerItemErr","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerSource","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.OpticRole","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerOptic","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.DetectorRecording","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerDetector","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.LabProfile","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-LAB-PROFILE"]}],"packages":[],"checks":[]},"section":"S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number":471,"anchor":"IMPLEMENT","ac":"AC-S141g","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[470],"how_to":"The Planner's four inputs, read from the kit and one of its studies (001 §M 'Its inputs are the kit': 'sample inventory = the kit's sample items: cuts, thicknesses, substrates'; 'prior = Known / Calibrated parameters, material class or point group, dispersion choices, source uncertainties (PTB sigma)'; 'targets = the study's chosen unknowns'; the S14.1 brief). They REUSE the study's own readers: the opened working copy (`Studies.fs:OpenedMaterial`, step 460: `physics : OpenedMaterialPhysics` with `crystalOpt` and `currentPhysics`), the study's unknowns (`Study.unknownsWith`, step 362, over `StudyContext.itemsUsedBy`, step 366) and the lab profile (step 470). In `MeasurementPlanner.fs`, after step 470's declarations, each doc one to three lines citing spec 0050 S14.1. (1) `PlannerError` gains `UnopenedPlannerMaterialErr` (`the study opens no such material version: <reason>`) and `NonCrystalPlannerMaterialErr` (`the opened material is not a crystal: <reason>`). (2) `PlannerPlate = { item : ItemId; label : ItemLabel; sample : SampleVersionId; thickness : Thickness; substrate : SubstrateKind; emission : Emission; normalAxisOpt : CrystalAxis option }`, a free-standing plate of the material, the shape the spec 0044 forward models (`MuellerInverse.fs:createBerremanForward`, 'a free-standing crystal plate in air'): its thickness, its substrate kind and emission (`ElementId.fs:Sample`, `supportedEmission`) and the principal axis its layer's crystal orientation puts on its normal (`CrystalOrientation.normalAxisOpt`, step 466). A plate's cut is its substrate layer's orientation (`ElementId.fs:SampleLayer`), the kit's one statement of how its crystal sits in it. (3) `PlannerPrior = { material : OpenedMaterial; crystal : CrystalParameters }`: the opened copy, whose parameter states carry the known and calibrated values and the unknowns' priors, a tabulated source's sigma included (step 460), and its crystal at the current values, the class and point groups the report states (step 465); a crystal record is one constant tensor set, so its dispersion choice is constant. (4) `PlannerInputs = { lab : LabProfile; plates : PlannerPlate list; prior : PlannerPrior; targets : ParameterName list }`. (5) `type Study with member this.plannerInputsWith (context : StudyContext) (choiceOf : Item -> ItemModelChoice option) (material : MaterialVersionId) : Result<PlannerInputs, PlannerError>`: the opened copy is the one of `this.materials` whose `version` is `material`, else `UnopenedPlannerMaterialErr` naming the material's GUID and version number; its `currentPhysics.crystalOpt` (step 460) is the prior's crystal, else `NonCrystalPlannerMaterialErr` naming the copy's `name`; `lab` is `LabProfile.ofItems context.items choiceOf`, its error passing through; `plates` are, in item order, the items of `context.items` whose `choiceOf` is `StackSampleChoice (version, sample)` with `sample.structure.substrate` `Some layer`, `layer.materialId = material` and a finite `layer.thickness` (`Thickness.parameterValueOpt` is `Some`, step 207), each `{ item; label; sample = version; thickness = layer.thickness; substrate = sample.substrate; emission = sample.supportedEmission; normalAxisOpt = layer.orientation.normalAxisOpt }`; `targets` are the names of `this.unknownsWith (context.itemsUsedBy this)` whose `parameter` is `MaterialParameterRef (material, name)`, in order, so a link follower is left out as that member leaves it out and a known or calibrated component is prior, not target. Item unknowns (a CPL retardance, a gain) are not crystal components; layer 2 (S14.2) weighs them. No cache, store or other member is added. Tests, in `PlannerInputsTests` (step 470), over a test-local `StudyContext` record (step 366) holding no experiment and a `choiceOf` answering each item's draft model: a test-local uniaxial crystal material entry and version built as `StudyMaterialTests` builds its crystal entries (step 361); plate samples written as records whose substrate layer is that version, 0.5 mm thick, `QZ-Z` with `PrimaryAxes`, `ThickPlate` and `EmitBoth` and `QZ-X` with an `EulerRotation` under `ZmYpXp` at theta = 90 degrees and `EmitTransmittedOnly`; and a study made by `Study.create`, `openMaterial` of the version and `withMaterialParameterState` freeing n_e and g33 (`UnknownParameter` starting at their values within +-5 %). `the planner's inputs are the kit's items, its plates of the material, the opened copy and the study's unknowns of it`: with items Laser, LP1, CPL1, Polarimeter, QZ-Z, QZ-X and GL (step 470), the inputs' `lab` equals `LabProfile.ofItems` of the items; `plates` are QZ-Z on `ThirdCrystalAxis` (`EmitBoth`) and QZ-X on `FirstCrystalAxis` (`EmitTransmittedOnly`), each 0.5 mm; `prior.material` is the study's copy and `prior.crystal` its `currentPhysics` crystal; `targets` are [n_e; g33]. `a material the study does not open, or a tabulated one, gives no planner inputs`: a version the study does not open answers `UnopenedPlannerMaterialErr`; a study that opens a test-local isotropic tabulated material (built as step 460's facts build theirs) answers `NonCrystalPlannerMaterialErr` naming it for its version. `a film of the material, or a substrate of infinite thickness, is no plate`: a sample whose single film layer is the version, and one whose substrate is the version at `Thickness.Infinity`, are in no input's `plates`. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the inputs land, `Study.plannerInputsWith` MUST answer the kit's lab profile, its finite plates of the material with the axis their orientation puts on the normal, the opened copy with its current crystal as the prior and the study's unknown components of it as targets; constructor-unit-tests MUST pass, including `the planner's inputs are the kit's items, its plates of the material, the opened copy and the study's unknowns of it`, `a material the study does not open, or a tabulated one, gives no planner inputs` and `a film of the material, or a substrate of infinite thickness, is no plate`, the count rising by 3; and build, elevation and the twenty-one s45 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.the planner's inputs are the kit's items, its plates of the material, the opened copy and the study's unknowns of it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-PLANNER-INPUTS"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a material the study does not open, or a tabulated one, gives no planner inputs","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-PLANNER-INPUTS"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a film of the material, or a substrate of infinite thickness, is no plate","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-PLANNER-INPUTS"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError.UnopenedPlannerMaterialErr","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-PLANNER-INPUTS"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError.NonCrystalPlannerMaterialErr","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-PLANNER-INPUTS"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerPlate","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-PLANNER-INPUTS"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerPrior","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-PLANNER-INPUTS"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-PLANNER-INPUTS"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.Study.plannerInputsWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-PLANNER-INPUTS"]}],"packages":[],"checks":[]},"section":"S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number":472,"anchor":"IMPLEMENT","ac":"AC-S141h","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[471],"how_to":"The kit's looks, and the structural report over them: 'this kit can never recover X' and 'you need an off-axis cut' for a real kit (001 §M 'It answers outright \"this kit can never recover X\" and \"you need an off-axis cut\"'; the S14.1 brief). The kit holds no angle limit, because no item model publishes one (step 208), so its angle range is the table's: any plate tilts from normal incidence to `IncidenceAngle.maxValue` (`Fields.fs:30`), and those two incidences bound everything layer 1 can tell of a tilt. In `MeasurementPlanner.fs`, on `PlannerInputs` (step 471), each doc one to three lines citing spec 0050 S14.1: (1) `member this.looks : PlannerLook list`: for each plate in order, each reach of `this.lab.reaches` in order (step 470), each incidence of `[ IncidenceAngle.normal; IncidenceAngle.maxValue ]` and each observable the plate's emission allows (`EmitBoth` transmitted then reflected, `EmitTransmittedOnly` transmitted, `EmitReflectedOnly` reflected, `Placement.fs:Emission`, matched by case), the look `{ normalAxisOpt = plate.normalAxisOpt; incidence; observable; reach }`. (2) `member this.structuralReport : Result<RecoverabilityReport, PlannerError>`: `this.prior.crystal.structuralReport this.targets this.looks` (step 469). No other member is added; the numerical layer, the plan and its cache are S14.2's. Tests, in `PlannerInputsTests`, over step 471's kit (its uniaxial version, plates QZ-Z and QZ-X, and items from step 470), each study freeing all four components so the targets are n_o, n_e, g11 and g33: `a kit's looks are each plate under each reach, at normal and steepest incidence, on each branch its emission allows`: with plates QZ-Z (`EmitBoth`) and QZ-X (`EmitTransmittedOnly`) and the Polarimeter and Ellipsometer, `looks` holds twelve looks in the order above: QZ-Z's eight (full Mueller, then ellipsometric; normal, then 89 degrees; transmitted, then reflected) on `ThirdCrystalAxis`, then QZ-X's four, transmitted only, on `FirstCrystalAxis`. `a kit of z-cut plates needs an off-axis cut, and one without a full Mueller reach never recovers the gyration`: with QZ-Z and the Polarimeter, the report has every target reachable and one finding, `OffAxisCutFinding { targets = [ n_e; g33 ]; capAngle = <the crystal's snellCap>; cuts = [ XCut ] }`: a tilt reaches n_e and g33, at most the cap off the normal; adding QZ-X removes it; with QZ-Z, QZ-X, Phone and LP1 (a single polarizer), g11 and g33 are `UnrecoverableTargetFinding`s of `FullMuellerNeededReason` with `[ FullMuellerRemedy ]` while n_o and n_e are reachable. `a kit with no plate of the material can never recover any target`: with the Polarimeter and no plate of the material (GL only), every target's finding is `NoLookReason`, its remedies ending in `FullMuellerRemedy` after at least one `AddPlateRemedy`, and there is no off-axis finding.","acceptance":"After the kit report lands, `PlannerInputs.looks` MUST be every plate under every reach at normal and steepest incidence on every branch its emission allows, and `PlannerInputs.structuralReport` MUST report the kit's unrecoverable targets and its need of an off-axis cut; constructor-unit-tests MUST pass, including `a kit's looks are each plate under each reach, at normal and steepest incidence, on each branch its emission allows`, `a kit of z-cut plates needs an off-axis cut, and one without a full Mueller reach never recovers the gyration` and `a kit with no plate of the material can never recover any target`, the count rising by 3; and build, elevation and the twenty-one s45 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a kit's looks are each plate under each reach, at normal and steepest incidence, on each branch its emission allows","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-KIT-REPORT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a kit of z-cut plates needs an off-axis cut, and one without a full Mueller reach never recovers the gyration","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-KIT-REPORT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a kit with no plate of the material can never recover any target","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S141-KIT-REPORT"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.looks","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-KIT-REPORT"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.structuralReport","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S141-KIT-REPORT"]}],"packages":[],"checks":[]},"section":"S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 473, "anchor": "IMPLEMENT", "ac": "AC-S141i", "touches": ["BerremanTestSupport", "BerremanTests"], "depends_on": [472], "how_to": "MuellerInverseTests' quartz ground truth and its C1-C4 measurement design move into `BerremanTestSupport`, so the Planner's acceptance facts (step 475) read the design instead of transcribing it (the S14.1 brief 'Acceptance REUSES the existing facts' designs and helpers … Move a design definition into BerremanTestSupport if a fact needs it outside its class'; 001 §M 'Their designs and helpers are reused; no new physics test is written'; 001 §Q 'The ground truth and designs … move into a shared test-support project'; AGENTS.md 'Reuse, never copy'). The design moves whole, because C1-C4 is one table (specs/0044/.manual/004 §3.4) and the Planner's facts read C1, C3 and the full set. This is a MOVE (.spec-md §4 'A reuse is a move or a call: the new home is created and the old body deleted in the same step'; .spec-md §7 'Harness and samples … Migration provided: a move'): after the step each moved name is declared once. (1) New `Berreman/BerremanTestSupport/QuartzSample.fs`, `module BerremanTestSupport.QuartzSample`, declared as `BiaxialSample.fs` is (step 345), appended at the end of `BerremanTestSupport.fsproj`'s compile list with no comment. It receives from `MuellerInverseTests` (`MuellerInverseTests.fs:waveLength` to `:fullConfigurations`), in this order and with their bodies and docs as S10.1 to S12.2 leave them: `waveLength`, `quartzOrdinaryIndex`, `quartzExtraordinaryIndex`, `quartzG11`, `quartzG33`, `quartz` (a `CrystalPhysics.UniaxialParameters`, step 353), `thickPlate`, `thinPlate`, `configuration` (over `MuellerFitting.configurationOf`, step 335), `c1`, `c2`, `c3`, `c4` and `fullConfigurations`, with the two banner comments above them (the quartz ground truth and its provenance; the C1-C4 measurement set and why each configuration exists); in the first banner 'Spec R3 puts the material in the TEST' becomes 'in test code', in the second 'the ablation fact below' (twice) becomes '`MuellerInverseTests`' ablation fact', and every other line keeps its text. It opens what they read (the engine's `Constants`, `Fields`, `MaterialProperties` and `Media`, `OpticalConstructor.Domain.CrystalPhysics` and `MuellerInverse`, and `OpticalConstructor.Optimization.MuellerFitting`), reads no name of the `BerremanTests` namespace, and its module doc says in one to three lines that it is spec 0044's quartz ground truth and its C1-C4 design, shared by `MuellerInverseTests` and the Planner's facts (spec 0050 S14.1). No reference is added: `BerremanTestSupport` already references Domain and Optimization (steps 344, 345). (2) `Berreman/BerremanTests/MuellerInverseTests.fs` deletes those declarations and their banners and opens `BerremanTestSupport.QuartzSample` after its last `open`; every other binding (`degree`, `solverParameters`, `forward`, `observe`, `scalingAround`, `perturbedStart`, the boxes, the fit runners, `blindStart`, the noisy helpers) and every fact stays and reads the moved names unqualified; the class doc keeps its text. BerremanTests' numbers are bit-identical (.spec-md §4 'BerremanTests' numbers stay unchanged'): every expression is unchanged, and a module value is the value the class computed for every instance. No test is added or removed. `MuellerInverseTests`, the class whose design moved, is selected.", "acceptance": "After the move, `Berreman/BerremanTestSupport/QuartzSample.fs` MUST declare the quartz ground truth and the C1-C4 design once, every value unchanged, and `MuellerInverseTests` MUST read them from it and declare none of them; unit-tests MUST pass over the selected class `BerremanTests.MuellerInverseTests`, its numbers and count unchanged; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests", "kit-acceptance"], "gate_selection": {"unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.MuellerInverseTests"]}, "kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/BerremanTestSupport/QuartzSample.fs", "Berreman/BerremanTestSupport/BerremanTestSupport.fsproj", "Berreman/BerremanTests/MuellerInverseTests.fs"], "tests": [{"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.gyrationProjection collapses to g33 along the optic axis and to g11 across it", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.internalAngle is capped by the critical angle, so a z-cut plate cannot reach the g11 regime", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.orientForCut carries the optic axis from the surface normal into the surface plane", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.toScaled and ofScaled round-trip, and a unit scaled step is the intended physical step", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.muellerOfBirefringence reproduces the repository's own retarder and rotator primitives", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.analyticInversion inverts muellerOfBirefringence exactly and reports zero dichroism", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.analyticInversion reports the degenerate cases as typed errors rather than plausible numbers", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.cloudeEigenvalues identify a non-depolarizing matrix and the depolarization index agrees", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.C1 is a pure optical rotator whose rotatory power is exactly 2 pi g11 d over lambda", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.C1 is completely blind to g33, which is why a second crystal cut is required", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.every configuration produces a physically realizable, essentially non-depolarizing Mueller matrix", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the residual pipeline runs end to end against mock proxies, with no solver and no optimizer", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.both proxies compare by reference (the ReferenceEquality convention)", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.every boundary maps failure to a typed error, never a throw", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the full C1-C4 measurement set recovers every material constant from a perturbed start", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the full measurement set is well conditioned and every parameter is observable", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.C1 alone cannot determine three of the four constants, which is why the design needs more cuts", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the measurement-error model is reproducible, bounded, and files data against the NOMINAL angles", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.a blind n = 1.5 start with no assumed optical activity still recovers every constant from noiseless data", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.an ensemble of noisy experiments recovers every constant, and its scatter IS what one fit's own covariance predicts", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}], "contracts": [{"symbol": "BerremanTestSupport.QuartzSample", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S141-QUARTZ-DESIGN-MOVE"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 474, "anchor": "IMPLEMENT", "ac": "AC-S141j", "touches": ["BerremanTestSupport", "BerremanTests"], "depends_on": [473], "how_to": "BiaxialInverseTests' measurement design moves into `BerremanTestSupport` beside its ground truth, so the Planner's acceptance facts (step 475) read the normal-incidence and full designs instead of transcribing them (the S14.1 brief 'For a normal-incidence-only BiaxialInverseTests design, it flags g12, g13 and g23 … Move a design definition into BerremanTestSupport if a fact needs it outside its class'; 001 §M; AGENTS.md 'Reuse, never copy'). This is a MOVE (.spec-md §4; .spec-md §7): after the step each moved name is declared once. (1) New `Berreman/BerremanTestSupport/BiaxialDesign.fs`, `module BerremanTestSupport.BiaxialDesign`, appended at the end of `BerremanTestSupport.fsproj`'s compile list (after `BiaxialSample.fs`, whose `referenceWaveLength` it reads) with no comment. It receives from `BiaxialInverseTests` (`BiaxialInverseTests.fs:plate` to `:fullConfigurations`), with the measurement-set banner (thickness, the three cuts and their transverse planes, the oblique sweeps) and their docs: `plate`, `configuration`, `principalCuts`, `b1`, `b2`, `b3` and `fullConfigurations`; and the ablation fact's local `normalOn` (in `the cuts buy the gyration DIAGONAL and only the tilt buys its OFF-DIAGONAL`) as `normalIncidenceOn (cut : SampleCut) : MeasurementConfiguration list`, its body unchanged (the four azimuths 0, 22.5, 45 and 67.5 degrees at normal incidence, transmitted) and a one-line doc. `configuration` reads `referenceWaveLength` (`BerremanTestSupport/BiaxialSample.fs`), the value the class's `waveLength` alias holds. `b1` becomes `principalCuts |> List.collect normalIncidenceOn`, the same twelve configurations in the same order (cut by cut, azimuth by azimuth), so the azimuth list is written once. It opens what they read (`MuellerInverse`, `OpticalConstructor.Optimization.MuellerFitting`, the engine's `Constants` and `Media`, `BerremanTestSupport.BiaxialSample`), reads no name of the `BerremanTests` namespace, and its module doc says in one to three lines that it is spec 0044's biaxial measurement design, shared by `BiaxialInverseTests` and the Planner's facts (spec 0050 S14.1). (2) `Berreman/BerremanTests/BiaxialInverseTests.fs` deletes those declarations and their banner and opens `BerremanTestSupport.BiaxialDesign` after its last `open`; its ablation fact deletes the local `normalOn` and builds `zOnly`, `zAndX` and `everyCutNormal` from `normalIncidenceOn`; `waveLength`, `forward`, `observe`, `perturbedStart`, `box`, `blindStart`, `wideBox`, the noisy helpers and every fact stay. `FeasibleBiaxialInverseTests` and the absorbing suites keep their own designs and do not open the module. BerremanTests' numbers are bit-identical (.spec-md §4): every configuration list holds the same configurations in the same order. No test is added or removed. `BiaxialInverseTests`, the class whose design moved, is selected (about 997 s).", "acceptance": "After the move, `Berreman/BerremanTestSupport/BiaxialDesign.fs` MUST declare the biaxial plate, configuration, principal cuts, `normalIncidenceOn`, B1-B3 and the full set once, `b1` being `principalCuts |> List.collect normalIncidenceOn`, and `BiaxialInverseTests` MUST read them from it and declare none of them; unit-tests MUST pass over the selected class `BerremanTests.BiaxialInverseTests`, its numbers and count unchanged; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests", "kit-acceptance"], "gate_selection": {"unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.BiaxialInverseTests"]}, "kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/BerremanTestSupport/BiaxialDesign.fs", "Berreman/BerremanTestSupport/BerremanTestSupport.fsproj", "Berreman/BerremanTests/BiaxialInverseTests.fs"], "tests": [{"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.the triclinic builder produces a biaxial permittivity and a FULL symmetric gyration tensor", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.orientForCut carries each of the three principal axes onto the surface normal, gyration tensor and all", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.the triclinic parameter set is a strict generalization of the uniaxial one", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.an optic axis is reachable from the x-cut and unreachable from the z-cut, which is what the steep configurations are for", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.every configuration produces a physically realizable, essentially non-depolarizing Mueller matrix", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.the scaled parameter space round-trips all nine coordinates and a unit step moves exactly one", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.the full biaxial measurement set recovers all NINE material constants from a perturbed start", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.the full biaxial measurement set is well conditioned and every one of the nine parameters is observable", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.the cuts buy the gyration DIAGONAL and only the tilt buys its OFF-DIAGONAL", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.a blind isotropic n = 1.5 start still recovers all nine constants from noiseless data", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.BiaxialInverseTests.an ensemble of noisy experiments recovers all nine constants, and the birefringences survive far better", "path": "Berreman/BerremanTests/BiaxialInverseTests.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}], "contracts": [{"symbol": "BerremanTestSupport.BiaxialDesign", "op": "create", "path": "Berreman/BerremanTestSupport/BiaxialDesign.fs", "obligations": ["S141-BIAXIAL-DESIGN-MOVE"]}], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number": 475, "anchor": "IMPLEMENT", "ac": "AC-S141k", "touches": ["BerremanTests"], "depends_on": [474], "actions": ["ADD_TEST BerremanTests.MeasurementPlannerTests"], "how_to": "The Planner reproduces the existing facts over their own designs (001 §M 'Acceptance — the planner reproduces existing facts. Their designs and helpers are reused; no new physics test is written': 'C1 is completely blind to g33, which is why a second crystal cut is required', 'C1 alone cannot determine three of the four constants, which is why the design needs more cuts', 'the cuts buy the gyration DIAGONAL and only the tilt buys its OFF-DIAGONAL'; the S14.1 brief 'The facts live in BerremanTests (a new planner class) beside the designs they reuse'). No forward solve and no fit runs: each fact reads a design (steps 473, 474) as looks through `plannerLookWith FullMuellerReach` (step 467; the designs are full Mueller observations) and asks `structuralReport` (step 469) about every parameter of its record. New `Berreman/BerremanTests/MeasurementPlannerTests.fs`: `type MeasurementPlannerTests()` in `namespace BerremanTests`, a class as its neighbours are, appended at the end of `BerremanTests.fsproj`'s compile `ItemGroup` with no comment. Class doc, one to three lines: the Measurement Planner's layer-1 report over spec 0044's own designs reproduces their ablation facts (spec 0050 S14.1). It opens `OpticalConstructor.Domain` with `CrystalPhysics`, `MuellerInverse`, `Studies` (`parameterAxes`), `PlannerSymmetry`, `MeasurementPlanner` and `ItemModels`, `BerremanTests.InverseFitHarness` (`expectOk`, step 335) and the `BerremanTestSupport` namespace; it names each design by its module (`QuartzSample.c1`, `BiaxialDesign.normalIncidenceOn`, `BiaxialSample.triclinic`) rather than opening them, because `configuration`, `fullConfigurations` and the plates share names across them. A private helper of the class, documented in one line, is `reportOver (crystal : CrystalParameters) (design : MeasurementConfiguration list) : RecoverabilityReport`: `crystal.structuralReport` of the names of `crystal.parameterAxes` (step 361) over the design's looks, through `expectOk`. Each fact compares `ParameterName`s, reasons, remedies and findings with `Assert.Equal` and names the report's finding texts in its failure messages. `the planner finds C1 blind to g33, leaves three of the four quartz constants unrecoverable and proposes the second cut`: over `UniaxialCrystal QuartzSample.quartz` and `QuartzSample.c1`, the report's `unrecoverable` names are [n_o; n_e; g33] and `reachable` [g11]; g33's finding has `AlongEveryPropagationReason` and n_o's `NoRetardanceReason`; each of the three has the remedies `[ AddPlateRemedy XCut; ObliqueIncidenceRemedy cap ]`, cap being `internalAngle QuartzSample.quartzOrdinaryIndex IncidenceAngle.maxValue` (`MuellerInverse.fs:internalAngle`; 40.40 degrees); and `offAxisCutOpt` is `Some { targets = [ n_e; g33 ]; capAngle = cap; cuts = [ XCut ] }`, the second cut. `the planner finds every quartz constant reachable once the second cut joins C1, and over the full C1-C4 set`: over `QuartzSample.c1 @ QuartzSample.c3` (the cut restored in `C1 alone cannot determine three of the four constants`) and over `QuartzSample.fullConfigurations` (`the full measurement set is well conditioned and every parameter is observable`), every parameter is reachable and there is no finding. `the planner flags g12, g13 and g23 for a normal-incidence-only biaxial design and names oblique incidence and further cuts as the remedy`: over `TriclinicCrystal BiaxialSample.triclinic` and `BiaxialDesign.normalIncidenceOn ZCut`, the `unrecoverable` names are [n3; g33; g23; g13; g12]: g23, g13 and g12 have `NormalIncidenceOnlyReason` and `[ ObliqueIncidenceRemedy cap ]` alone, cap being `internalAngle BiaxialSample.index1 IncidenceAngle.maxValue` (its smallest index), while n3 and g33 have `AlongEveryPropagationReason` and `[ AddPlateRemedy XCut; AddPlateRemedy YCut; ObliqueIncidenceRemedy cap ]`, and the off-axis finding names [n3; g33] with the cuts [XCut; YCut]: oblique incidence and further cuts; over that design followed by `normalIncidenceOn XCut`, and over `BiaxialDesign.b1` (every principal cut at normal incidence), the `unrecoverable` names are exactly [g23; g13; g12], each with the oblique remedy alone, and there is no off-axis finding: cutting more plates does not substitute for tilting them. `the planner finds all nine biaxial constants reachable over the full biaxial measurement set`: over `BiaxialDesign.fullConfigurations` every one of the nine parameters is reachable and there is no finding.", "acceptance": "After the facts land, the Planner's structural report MUST find C1 blind to g33 with three of the four quartz constants unrecoverable and propose the x-cut, MUST flag g12, g13 and g23 for the normal-incidence biaxial designs with oblique incidence (and, for the z-cut alone, further cuts) as the remedy, and MUST find every constant reachable over the full designs; unit-tests MUST pass over the selected class `BerremanTests.MeasurementPlannerTests`, including `the planner finds C1 blind to g33, leaves three of the four quartz constants unrecoverable and proposes the second cut`, `the planner finds every quartz constant reachable once the second cut joins C1, and over the full C1-C4 set`, `the planner flags g12, g13 and g23 for a normal-incidence-only biaxial design and names oblique incidence and further cuts as the remedy` and `the planner finds all nine biaxial constants reachable over the full biaxial measurement set`, the count rising by 4; and build, elevation and the twenty-one s45 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests"], "gate_selection": {"unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.MeasurementPlannerTests"]}}, "effects": {"edits": ["Berreman/BerremanTests/MeasurementPlannerTests.fs", "Berreman/BerremanTests/BerremanTests.fsproj"], "tests": [{"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner finds C1 blind to g33, leaves three of the four quartz constants unrecoverable and proposes the second cut", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S141-PLANNER-ACCEPTANCE"]}, {"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner finds every quartz constant reachable once the second cut joins C1, and over the full C1-C4 set", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S141-PLANNER-ACCEPTANCE"]}, {"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner flags g12, g13 and g23 for a normal-incidence-only biaxial design and names oblique incidence and further cuts as the remedy", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S141-PLANNER-ACCEPTANCE"]}, {"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner finds all nine biaxial constants reachable over the full biaxial measurement set", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S141-PLANNER-ACCEPTANCE"]}], "contracts": [], "packages": [], "checks": []}, "section": "S14.1 -- The Measurement Planner: kit inputs and the structural layer"}
{"number":476,"anchor":"IMPLEMENT","ac":"AC-S142a","touches":["OpticalConstructor.Optimization"],"depends_on":[475],"how_to":"Layer 2 reuses the study engine's own algebra (the S14.2 brief: 'REUSING the study engine's OWN forward model and FitQuality.residualJacobian / MuellerInverse.ResidualJacobian'; 001 §M 'the study engine's own forward model and Jacobian, REUSED'), so four rules it needs become callable where they live. Each is a MOVE (.spec-md §4 'A reuse is a move or a call: the new home is created and the old body deleted in the same step'; AGENTS.md 'Reuse, never copy'): after the step each rule has one body, and every number BerremanTests and the study engine compute is unchanged. Each doc is one to three lines citing spec 0050 S14.2. (1) `OpticalConstructor.Optimization/FitQuality.fs`: the private `covarianceMatrix` (`FitQuality.fs:covarianceMatrix`, Cov = reducedχ² · (JᵀJ)⁻¹ through the `RealMatrix` seam) becomes the public `covarianceOf (jacobian : ResidualJacobian) (reduced : ReducedChiSquared) : ParameterMatrix`, its body unchanged, and `reportFrom` (`FitQuality.fs:reportFrom`) calls it; its doc keeps the line naming the `MathNetNumericsMath` seam. (2) `OpticalConstructor.Optimization/FittedProblems.fs` (step 397): the offset frame that `FittedProblem.jacobian` and `FittedProblem.report` both evaluate (the residual y ↦ residual (start + y − 100), taken at the vector holding 100 in every coordinate, so FitQuality's relative step is about 1.5e-6 in the solve's own coordinates and a coordinate at zero is still perturbed) MOVES, before `FittedProblem`, into `type ScaledVector with` (`MuellerInverse.fs:ScaledVector`) `member this.offsetResidualOf (residual : ScaledVector -> ResidualVector) : Residual` (`OptimizationInterface.fs:Residual`), that closure about this point; `member this.offsetOrigin : DesignVector`, the vector of hundreds of this point's length; and `member this.offsetJacobianOf (residual : ScaledVector -> ResidualVector) : ResidualJacobian`, `FitQuality.residualJacobian (this.offsetResidualOf residual) this.offsetOrigin` (`FitQuality.fs:residualJacobian`), whose doc keeps step 397's one line on why the frame is offset. `jacobian` becomes `this.search.start.offsetJacobianOf this.residual`, and `report` becomes `FitQuality.reportFrom (this.search.start.offsetResidualOf this.residual) this.search.start.offsetOrigin (this.residual this.search.start)`, so the same doubles flow. (3) `OpticalConstructor.Optimization/BenchNoise.fs` (step 339): the angle shift `disturb` applies (`InverseFitHarness.fs:disturb`: the incidence through the engine's `IncidenceAngle + Angle` operator, the azimuth through `SampleAzimuth`) MOVES into `type MeasurementConfiguration with member this.misalignedBy (incidence : Angle) (azimuth : Angle) : MeasurementConfiguration` (`MuellerInverse.fs:MeasurementConfiguration`), declared before `disturb`, its doc keeping in one line why the operator and not `IncidenceAngle.create` carries a signed excursion; `disturb` becomes `c.misalignedBy (wobble ()) (wobble ())`. F# evaluates the two arguments left to right, so the incidence draw still comes first and every seeded experiment is bit-identical. (4) `OpticalConstructor.Optimization/StudyEngine.fs` (step 387): the per-entry unit `scaledProblemWith` computes (the bounds' span over twice `studySearchBox.halfWidth`) MOVES into `type ParameterInterval with member this.searchUnit : ParameterValue` (`ParameterInterval`, S7.1 step 214), declared directly after `studySearchBox`, and `scaledProblemWith` calls it. Every consumer opens the module where the compiler asks and changes nothing else. No other declaration of the four files changes, no test is removed, and the fit, profile, noise and study numbers are unchanged: `MuellerInverseTests` reaches `reportFrom` through `MuellerFitData.report` and `disturb` through its noisy facts, and AT-1 and AT-2 reach `FittedProblem`, `scaledProblemWith` and the bench through their study fits and AT-2's data. Tests: `FitResultsTests` (step 397) gains `the offset frame differentiates a residual about any point, zero included, and covarianceOf scales the inverse normal matrix`: for the linear residual r(x) = A x − b with A = [[1; 2]; [0; 1]; [3; 0]], `(ScaledVector [| 0.0; 0.0 |]).offsetJacobianOf` answers A and so does `(ScaledVector [| 5.0; −3.0 |]).offsetJacobianOf`, with b = 0, each entry within 1e-6 (forward differences at a step of about 1.5e-6), and `FitQuality.covarianceOf (ResidualJacobian A) (ReducedChiSquared 0.5)` is 0.5 · (AᵀA)⁻¹ written out in the test ((AᵀA) = [[10; 2]; [2; 5]]), within 1e-12. `StudyEngineTests` (step 381) gains `an interval's search unit is its span over twice the search box's half-width`: `{ lower = ParameterValue 1.0; upper = ParameterValue 2.0 }.searchUnit` is `ParameterValue 0.01` (a span of 1 over 2 · 50) within 1e-15.","acceptance":"After the moves, `FitQuality.covarianceOf`, `ScaledVector.offsetResidualOf`, `offsetOrigin` and `offsetJacobianOf`, `MeasurementConfiguration.misalignedBy` and `ParameterInterval.searchUnit` MUST each hold the one body of the rule it names, called by `reportFrom`, `FittedProblem.jacobian` and `report`, `disturb` and `scaledProblemWith`; constructor-unit-tests MUST pass, including `the offset frame differentiates a residual about any point, zero included, and covarianceOf scales the inverse normal matrix` and `an interval's search unit is its span over twice the search box's half-width`, the count rising by 2; unit-tests MUST pass over the selected class `BerremanTests.MuellerInverseTests`, its numbers and count unchanged; kit-acceptance MUST pass over `OpticalConstructor.Ui.Tests.KitAcceptanceTests`, its count unchanged; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","unit-tests","kit-acceptance"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"unit-tests":{"mode":"selected","suite":"unit-tests","values":["BerremanTests.MuellerInverseTests"]},"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Optimization/FitQuality.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/FittedProblems.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/StudyEngine.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/FitResultsTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyEngineTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.FitResultsTests.the offset frame differentiates a residual about any point, zero included, and covarianceOf scales the inverse normal matrix","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/FitResultsTests.fs","class":"OpticalConstructor.Tests.FitResultsTests","discovery_gate":"constructor-unit-tests","obligations":["S142-REUSE-SEAMS"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.StudyEngineTests.an interval's search unit is its span over twice the search box's half-width","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/StudyEngineTests.fs","class":"OpticalConstructor.Tests.StudyEngineTests","discovery_gate":"constructor-unit-tests","obligations":["S142-REUSE-SEAMS"]}],"contracts":[{"symbol":"OpticalConstructor.Optimization.FitQuality.covarianceOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/FitQuality.fs","obligations":["S142-REUSE-SEAMS"]},{"symbol":"OpticalConstructor.Optimization.FitQuality.covarianceMatrix","op":"retire","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/FitQuality.fs","obligations":["S142-REUSE-SEAMS"],"preserves_obligations":["S142-REUSE-SEAMS"]},{"symbol":"OpticalConstructor.Optimization.FittedProblems.ScaledVector.offsetResidualOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/FittedProblems.fs","obligations":["S142-REUSE-SEAMS"]},{"symbol":"OpticalConstructor.Optimization.FittedProblems.ScaledVector.offsetOrigin","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/FittedProblems.fs","obligations":["S142-REUSE-SEAMS"]},{"symbol":"OpticalConstructor.Optimization.FittedProblems.ScaledVector.offsetJacobianOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/FittedProblems.fs","obligations":["S142-REUSE-SEAMS"]},{"symbol":"OpticalConstructor.Optimization.BenchNoise.MeasurementConfiguration.misalignedBy","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs","obligations":["S142-REUSE-SEAMS"]},{"symbol":"OpticalConstructor.Optimization.StudyEngine.ParameterInterval.searchUnit","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/StudyEngine.fs","obligations":["S142-REUSE-SEAMS"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":477,"anchor":"IMPLEMENT","ac":"AC-S142b","touches":["OpticalConstructor.Domain","OpticalConstructor.Optimization","OpticalConstructor.Tests"],"depends_on":[476],"actions":["ADD_TEST OpticalConstructor.Tests.PlannerInformationTests"],"how_to":"The Measurement Planner's layer-2 core: the Fisher information of a set of candidate experiments, its rank, its confounded combinations and the Cramér–Rao bound per target (001 §M 'Layer 2, numerical (local, at a nominal point): the Fisher information from the Jacobians of every candidate experiment …; rank (identifiable combinations); smallest singular vectors (confounded combinations, e.g. thickness ↔ n); Cramér–Rao bounds per target'; the S14.2 brief). It REUSES `ResidualJacobian` (`MuellerInverse.fs:ResidualJacobian`: its `rank`, step 394, and `conditionNumber`), `FitQuality.covarianceOf` (step 476) and `FitUncertainty.ParameterWeights` (step 342); no second inverse, rank floor or condition number is written. The information of candidates whose rows J_i carry noise variances σ_i² is F = Σ J_iᵀ J_i / σ_i², and the bound per target is √diag(F⁻¹). The rows are kept scaled to one reference noise, the first candidate's, so the bound is `covarianceOf` of those rows with that noise as its reduced χ²: by construction the covariance a fit of those candidates reports when its residual level is their noise, which the promoted `predictedRelativeErrors` reads (step 342). Each doc is one to three lines citing spec 0050 S14.2; every case name has two words; no `bool` appears. (1) Domain, `MeasurementPlanner.fs`, after step 472's members, because the planner's cache stores them (step 485): `NoiseVariance of float` with `.value`, the variance of one residual entry of a candidate in its residual's units squared; `CandidateRows = { jacobian : ResidualJacobian; noise : NoiseVariance }`, one candidate's information, its residual Jacobian over the targets' scaled coordinates and its entries' noise; and `PlannerError` (step 469) gains `NoiselessPlannerCandidateErr` (`the candidate's noise variance is not above zero: <reason>`) and `PlannerShapeErr` (`the candidate's Jacobian does not fit the targets: <reason>`), each `of reason : string` with its `describe` arm. (2) New `Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs`, `module PlannerInformation` in `namespace OpticalConstructor.Optimization`, appended at the end of `OpticalConstructor.Optimization.fsproj`'s compile list (one `<Compile Include=\"PlannerInformation.fs\" />` line, no comment), because it reads `FitQuality`, `FitUncertainty`, `MuellerFitting`, `BenchNoise`, `FittedProblems` (step 476) and `StudyEngine`. Module doc: the Measurement Planner's numerical layer, the Fisher information of candidate experiments at a nominal point (spec 0050 S14.2). In order: (a) `SingularValue of float` with `.value`. (b) `[<Softellect.Sys.NumericCarrier(\"the singular values and right singular vectors of a residual Jacobian, read whole from the MathNet SVD\")>] SingularSpectrum = { values : float[]; rightVectors : float[][] }`, with `static member ofRows (rows : float[][]) (coordinateCount : int) : SingularSpectrum`, marked `[<ElevationBoundary(nameof InteropBoundary, \"the MathNet SVD of a residual Jacobian, its right singular vectors read whole\")>]` (AGENTS.md: a call into a third-party numeric library is marked on its own declaration): with no row, `coordinateCount` zeros and the identity's rows; otherwise `Svd(true)` of `RealMatrix.create rows`, reached as `MuellerInverse.fs:conditionNumber` reaches it, its `S` in MathNet's descending order padded with zeros to `coordinateCount` and the rows of its `VT`. (c) `SingularDirection = { singularValue : SingularValue; weights : ParameterWeights }`, with `member this.text (coordinates : ParameterName list) : string`: each coordinate whose weight is at least a tenth of the largest in magnitude, in coordinate order, written `+<w> <name>` or `-<w> <name>` with two decimals under `CultureInfo.InvariantCulture`, joined by single spaces. (d) `InformationLogDeterminant of float` and `CovarianceTrace of float`, each with `.value`. (e) `TargetBound = { name : ParameterName; sigma : ParameterSigma }` (`ParameterSigma`, S7.1 step 214). (f) `PlannerInformation = { coordinates : ParameterName list; rows : ResidualJacobian; noise : NoiseVariance }`: the targets, every candidate's rows stacked in order, each multiplied by √(noise / its noise), and the reference noise, the first candidate's (`NoiseVariance 1.0` with none). `static member over (coordinates : ParameterName list) (candidates : CandidateRows list) : Result<PlannerInformation, PlannerError>`: a candidate whose noise is not finite or not above zero answers `NoiselessPlannerCandidateErr` naming its 1-based position and noise, and one whose rows do not each hold one entry per coordinate `PlannerShapeErr` naming its position and both counts; nothing is answered in part. Members: `this.rank : MatrixRank`, `this.rows.rank` (`MatrixRank 0` with no row, step 394); `this.spectrum : SingularSpectrum`, `SingularSpectrum.ofRows` of the rows and the coordinate count; `this.confounded : SingularDirection list`, the spectrum's directions from index `rank` on, in its order: the combinations the candidates do not determine, below step 394's floor; `this.weakestOpt : SingularDirection option`, the direction at index `rank − 1` when the rank is at least one, the identifiable combination determined worst; `this.conditionOpt : ConditionNumber option`, `this.rows.conditionNumber` (`MuellerInverse.fs:conditionNumber`) when the rank equals the coordinate count and it is finite; `this.scaledSigmasOpt : DesignVector option`, at full rank the square roots of the diagonal of `FitQuality.covarianceOf this.rows (ReducedChiSquared this.noise.value)` in coordinate order, the Cramér–Rao bound in the scaled coordinates, and `None` otherwise; `this.logDeterminant : InformationLogDeterminant`, the sum over the first `rank` singular values s of 2 · ln s, less `rank · ln noise`, the log pseudo-determinant of F over its identifiable combinations (0 at rank 0); `this.traceOpt : CovarianceTrace option`, the sum of the squares of `scaledSigmasOpt` when it is `Some`; and `this.boundsOver (scaling : ParameterScaling<'Parameters>) : TargetBound list option` (`MuellerInverse.fs:ParameterScaling`), for `scaledSigmasOpt = Some s` each coordinate k's bound `ParameterSigma (s_k · |axis.read scaling.scale|)`, the axis being `scaling.axes`' k-th, the one the rows' coordinate k is scaled by, and `None` otherwise. (g) `type ReducedChiSquared with member this.noiseVariance : NoiseVariance` (`FitQuality.fs:ReducedChiSquared`): the noise variance a fit's reduced χ² estimates, the residual level of measured data read as a candidate's noise. No cache, threshold, regularisation or option is added. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs`, `module PlannerInformationTests` in `namespace OpticalConstructor.Tests`, appended at the end of `OpticalConstructor.Tests.fsproj`'s compile list with no comment, over Jacobians written as literals and test-local coordinate names. `the Cramer-Rao bound is the covariance a fit reports when its residual level is the noise`: over the coordinates of `UniaxialParameters.axes`' first two axes (n_o, n_e), the candidate J = [[1; 0]; [1; 1]; [0; 2]] with noise 0.04 has `scaledSigmasOpt` [0.2 · √(5/9); 0.2 · √(2/9)] within 1e-12 ((JᵀJ)⁻¹ = [[5; −1]; [−1; 2]] / 9, written out in the test); the same rows as two candidates, the first row at noise 0.04 and the last two doubled at noise 0.16, give the same sigmas within 1e-12; and `boundsOver` a scaling over those two axes whose scale holds 1e-3 for both indices answers those sigmas times 1e-3 under the names n_o and n_e. `two coordinates the candidates move only together are one confounded combination`: over coordinates a, b and c, J = [[1; 1; 0]; [2; 2; 1]] at noise 1 has rank 2, `conditionOpt`, `scaledSigmasOpt` and `boundsOver` `None`, one confounded direction whose weights are ±(1/√2, −1/√2, 0) within 1e-12 and whose text is `+0.71 a -0.71 b` or `-0.71 a +0.71 b`, and a weakest direction whose singular value is above zero. `with no candidate nothing is identifiable, and a noiseless or misshapen candidate is refused`: over no candidate the rank is 0, the three confounded directions are the identity's and `logDeterminant` is 0; a candidate at noise 0 answers `NoiselessPlannerCandidateErr` naming candidate 1, and one of two columns over three coordinates `PlannerShapeErr` naming both counts, each `describe` starting with its rendered prefix. `the log determinant counts each identifiable combination, and the trace sums the targets' variances`: J = [[2; 0]; [0; 3]] at noise 1 has `logDeterminant` 2 ln 2 + 2 ln 3 and `traceOpt` 1/4 + 1/9, and at noise 4 `logDeterminant` 2 ln 2 + 2 ln 3 − 2 ln 4, each within 1e-12; and `(ReducedChiSquared 0.25).noiseVariance` is `NoiseVariance 0.25`.","acceptance":"After the core lands, `PlannerInformation.over` MUST stack each candidate's rows scaled to the reference noise and answer its rank, confounded and weakest combinations, condition, log determinant, trace and Cramér–Rao sigmas as `FitQuality.covarianceOf` gives them, refusing a noiseless or misshapen candidate; constructor-unit-tests MUST pass, including `the Cramer-Rao bound is the covariance a fit reports when its residual level is the noise`, `two coordinates the candidates move only together are one confounded combination`, `with no candidate nothing is identifiable, and a noiseless or misshapen candidate is refused` and `the log determinant counts each identifiable combination, and the trace sums the targets' variances`, the count rising by 4; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","kit-acceptance","unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"unit-tests":{"mode":"selected","suite":"unit-tests","values":["BerremanTests.MuellerInverseTests","BerremanTests.BiaxialInverseTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/OpticalConstructor.Optimization.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInformationTests.the Cramer-Rao bound is the covariance a fit reports when its residual level is the noise","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","class":"OpticalConstructor.Tests.PlannerInformationTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INFORMATION"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInformationTests.two coordinates the candidates move only together are one confounded combination","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","class":"OpticalConstructor.Tests.PlannerInformationTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INFORMATION"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInformationTests.with no candidate nothing is identifiable, and a noiseless or misshapen candidate is refused","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","class":"OpticalConstructor.Tests.PlannerInformationTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INFORMATION"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInformationTests.the log determinant counts each identifiable combination, and the trace sums the targets' variances","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","class":"OpticalConstructor.Tests.PlannerInformationTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INFORMATION"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.NoiseVariance","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.CandidateRows","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError","op":"change_shape","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.SingularValue","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.SingularSpectrum","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.SingularDirection","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.InformationLogDeterminant","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.CovarianceTrace","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.TargetBound","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.PlannerInformation","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.ReducedChiSquared.noiseVariance","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-INFORMATION"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 478, "anchor": "IMPLEMENT", "ac": "AC-S142c", "touches": ["OpticalConstructor.Optimization", "OpticalConstructor.Tests"], "depends_on": [477], "how_to": "Greedy D-optimal (or target-restricted A-optimal) selection: the candidates in the order a planner adds them (001 §M 'greedy D-optimal (or target-restricted A-optimal) selection of the next experiment'; the S14.2 brief). The coordinates are the study's targets (step 471: the opened material's unknown components), so A-optimality restricted to the targets is the trace of their Cramér–Rao covariance. In `PlannerInformation.fs`, after step 477's declarations, each doc one to three lines citing spec 0050 S14.2: (1) `PlanCriterion` = `DeterminantPlanCriterion` | `TargetTracePlanCriterion`, with `member this.text : string`: `D-optimal: most information` and `A-optimal: smallest target variances`; it is window state, never stored, so it carries no wire tag. (2) `PlanOption<'Candidate> = { candidate : 'Candidate; rows : CandidateRows }`, one candidate and its information, and `RankedOption<'Candidate> = { option : PlanOption<'Candidate>; information : PlannerInformation }`, an option with the information the baseline and every option ranked up to it hold. (3) `type PlannerInformation with static member rankWith (criterion : PlanCriterion) (coordinates : ParameterName list) (baseline : CandidateRows list) (options : PlanOption<'Candidate> list) : Result<RankedOption<'Candidate> list, PlannerError>`: every option once, each round the one among those left whose joining gives the best `PlannerInformation.over coordinates` of the baseline, the options already ranked and it, in that order. Better is, first, the higher rank; at equal rank, under `DeterminantPlanCriterion` the larger `logDeterminant`, and under `TargetTracePlanCriterion` the smaller `traceOpt` when both are full rank and otherwise the larger `logDeterminant`, because a trace exists only at full rank; a tie keeps the option earlier in `options`. The first `over` error answers that error, so nothing is ranked in part. No threshold, stopping rule, cache or option is added: how many of the ranked candidates join the kit is the user's (the Plan view's Add to kit, step 491). Tests, in `PlannerInformationTests`, over literal rows at noise 1 and coordinates a and b: `the planner adds first the candidate that makes a confounded combination identifiable`: over the baseline [[1; 1]] (a + b known), the options X = [[2; 2]] and Y = [[0.1; −0.1]] rank Y then X under both criteria, Y's information at rank 2. `D-optimality takes the larger determinant and A-optimality the smaller sum of variances`: over the baseline [[1; 0]; [0; 2]], P = [[√3; 0]] and Q = [[0; √20]] rank Q then P under `DeterminantPlanCriterion` (determinants 24 against 16) and P then Q under `TargetTracePlanCriterion` (traces 1/4 + 1/4 against 1 + 1/24). `equal candidates keep their given order, and a refused candidate stops the ranking`: two equal options rank in their given order under both criteria, and an option at noise 0 answers `NoiselessPlannerCandidateErr`.", "acceptance": "After the ranking lands, `PlannerInformation.rankWith` MUST order every candidate greedily by rank and then by the larger log determinant (D) or the smaller target trace at full rank (A), keeping the given order on a tie and refusing a noiseless candidate; constructor-unit-tests MUST pass, including `the planner adds first the candidate that makes a confounded combination identifiable`, `D-optimality takes the larger determinant and A-optimality the smaller sum of variances` and `equal candidates keep their given order, and a refused candidate stops the ranking`, the count rising by 3; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "kit-acceptance", "unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}, "unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.MuellerInverseTests", "BerremanTests.BiaxialInverseTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerInformationTests.the planner adds first the candidate that makes a confounded combination identifiable", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs", "class": "OpticalConstructor.Tests.PlannerInformationTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-RANKING"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerInformationTests.D-optimality takes the larger determinant and A-optimality the smaller sum of variances", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs", "class": "OpticalConstructor.Tests.PlannerInformationTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-RANKING"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerInformationTests.equal candidates keep their given order, and a refused candidate stops the ranking", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs", "class": "OpticalConstructor.Tests.PlannerInformationTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-RANKING"]}], "contracts": [{"symbol": "OpticalConstructor.Optimization.PlannerInformation.PlanCriterion", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs", "obligations": ["S142-RANKING"]}, {"symbol": "OpticalConstructor.Optimization.PlannerInformation.PlanOption", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs", "obligations": ["S142-RANKING"]}, {"symbol": "OpticalConstructor.Optimization.PlannerInformation.RankedOption", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs", "obligations": ["S142-RANKING"]}, {"symbol": "OpticalConstructor.Optimization.PlannerInformation.PlannerInformation.rankWith", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs", "obligations": ["S142-RANKING"]}], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":479,"anchor":"IMPLEMENT","ac":"AC-S142d","touches":["OpticalConstructor.Optimization","OpticalConstructor.Tests"],"depends_on":[478],"how_to":"A candidate's information from its measurement configurations, through the study engine's own forward model and residual, and its noise from the detector's bench budget (001 §M 'each detector's noise model (the bench model §Q promotes)'; 001 §Q AT-2 'Promoted to product … because the study engine, the \"simulate measurement\" path and the Planner need them: the bench noise model'; the S14.2 brief). A polarimeter observation of a plate is predicted by the forward the study engine solves it with (`createBerremanForward`, step 375), and its residual entries are `MuellerFitting.throughputResidualFor`'s (step 336), the study residual's layout (step 379): the fifteen normalized-element entries of every observation, then one log-throughput entry per observation. A budget's numbers are uniform max errors (`NoiseParam`, Optimization/BenchNoise.fs from S10.1 step 339), a half-width u having the variance u² / 3, on each normalized element (`element`), on the throughput (`throughput`) and on the incidence and the azimuth of every configuration (`rotation`, the misalignment `BenchNoise.disturb` draws, steps 339 and 476). The planner takes, linearised at the nominal point, the mean over a candidate's entries of each entry's expected squared error: the reduced χ² a fit of its noisy data expects. In `PlannerInformation.fs`, after step 478's declarations, each doc one to three lines citing spec 0050 S14.2: (1) `type NoiseParam with member this.noiseVarianceOver (forward : ForwardModelProxy<'Parameters>) (nominal : 'Parameters) (configurations : MeasurementConfiguration list) : Result<NoiseVariance, MuellerFitError>`. The observations are `MuellerFitting.observeWith forward nominal configurations` (step 335), an error passing through. The angle sensitivity is the two-column `ResidualJacobian` `(ScaledVector [| 0.0; 0.0 |]).offsetJacobianOf` (step 476) of the closure that, for a scaled vector (Δi, Δa) in radians, files at each nominal configuration c the matrix `forward.muellerOf (c.misalignedBy (Angle Δi) (Angle Δa)) nominal` (step 476; data filed against the nominal configuration, as `noisyObserveWith` files it) and answers `throughputResidualFor forward <those observations> (MuellerFitting.scalingAround [] nominal nominal)` at `ScaledVector [||]` (a scaling of no axis, whose closure evaluates `nominal`); a forward error inside gives every entry of a residual of that length the 1.0e3 penalty `residualFor` uses (step 336), so the closure is total. For entry i of the 16 · m entries of m observations the variance is `this.element.value² / 3` for i below 15 · m and `this.throughput.value² / 3` from there, plus `this.rotation.value² / 3 · (a_i0² + a_i1²)`, `rotation.value` in radians and a_i the entry's row of the angle sensitivity; the answer is the mean over the entries as a `NoiseVariance`. (2) `candidateRowsOver (forward : ForwardModelProxy<'Parameters>) (scaling : ParameterScaling<'Parameters>) (nominal : 'Parameters) (noise : NoiseParam) (configurations : MeasurementConfiguration list) : Result<CandidateRows, MuellerFitError>`, a generic function of the module: its `jacobian` is `(toScaled scaling nominal).offsetJacobianOf (throughputResidualFor forward <observeWith forward nominal configurations> scaling)` (`MuellerInverse.fs:toScaled`), the residual of noiseless observations at the nominal point, whose Jacobian is the study residual's there because the measured readings enter it as constants; its `noise` is `noise.noiseVarianceOver forward nominal configurations`. The offset frame (step 476) takes the derivative about the nominal point however its scaling is centred, a component at zero included. No cache, simulation seed or option is added. Tests, in `PlannerInformationTests`, over a test-local `ForwardModelProxy<UniaxialParameters>` (`MuellerInverse.fs:ForwardModelProxy`) and two configurations built by `MuellerFitting.configurationOf` (`XCut`, 1 mm, incidences 10° and 20°, azimuth 0°, `TransmittedMueller`, 632.8 nm): `a noise budget's variance is each reading's uniform variance plus the misalignment it turns into reading error`: with a forward answering the identity Mueller matrix with m01 = 0.5 × the configuration's incidence in radians (m00 = 1, the parameters ignored), `NoiseParam.noiseless` gives `NoiseVariance 0.0`; a budget of element 0.006 alone gives 15 · 0.006² / 3 / 16, of throughput 0.03 alone 0.03² / 3 / 16, and of rotation 0.01 rad alone (0.01² / 3) · 0.5² / 16, each within 1e-9 relative. `a candidate's rows are the study residual's Jacobian at the nominal point in its scaling's units`: with a forward whose m01 is 2 · n_o and m02 is 0.5 · n_e (m00 = 1), over a scaling of `UniaxialParameters.axes`' first two axes whose scale holds 1e-3 for both indices, centred at a nominal crystal of n_o 1.544 and n_e 1.553, `candidateRowsOver` over the first configuration answers 16 rows of two columns whose only non-zero entries are one of magnitude 2e-3 in the n_o column and one of magnitude 0.5e-3 in the n_e column, each within 1e-9 relative, every other entry within 1e-12 of zero; the same at a nominal n_o of 0.0, the component at zero; and its noise the budget's variance over that configuration. Add type ParameterValues with member this.benchNoise : Result<NoiseParam, ItemEvaluationError> in Optimization/BenchNoise.fs. It MUST read the three ParameterName noise members, reject missing, non-finite or negative values (and element/throughput values above one) through the typed evaluation errors, and construct the three promoted uncertainty quantities through named source-type conversions. It MUST ignore unrelated parameter entries. This conversion is from a general parameter map to a numerical budget; no second Domain noise record or reverse conversion is introduced. Extend the variance fact to read a budget through this member, with all three nonzero, and to reject a missing axis before any forward evaluation. The source conversions MUST be ParameterValue.angleUncertainty, ParameterValue.elementUncertainty and ParameterValue.throughputUncertainty, declared in BenchNoise.fs. benchNoise MUST call those members after validating the values. The ParameterValues member ignores unrelated entries, so it is not a second representation of the closed NoiseParam record.","acceptance":"After the candidate rows land, `NoiseParam.noiseVarianceOver` MUST answer the mean over a candidate's throughput-residual entries of each reading's uniform variance plus the rotation budget turned through the entry's sensitivity to the configuration's angles, and `candidateRowsOver` MUST answer the offset-frame Jacobian of the noiseless throughput residual at the nominal point with that noise; constructor-unit-tests MUST pass, including `a noise budget's variance is each reading's uniform variance plus the misalignment it turns into reading error` and `a candidate's rows are the study residual's Jacobian at the nominal point in its scaling's units`, the count rising by 2; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","kit-acceptance","unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"unit-tests":{"mode":"selected","suite":"unit-tests","values":["BerremanTests.MuellerInverseTests","BerremanTests.BiaxialInverseTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInformationTests.a noise budget's variance is each reading's uniform variance plus the misalignment it turns into reading error","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","class":"OpticalConstructor.Tests.PlannerInformationTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CANDIDATE-ROWS"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInformationTests.a candidate's rows are the study residual's Jacobian at the nominal point in its scaling's units","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInformationTests.fs","class":"OpticalConstructor.Tests.PlannerInformationTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CANDIDATE-ROWS"]}],"contracts":[{"symbol":"OpticalConstructor.Optimization.PlannerInformation.NoiseParam.noiseVarianceOver","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-CANDIDATE-ROWS"]},{"symbol":"OpticalConstructor.Optimization.PlannerInformation.candidateRowsOver","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerInformation.fs","obligations":["S142-CANDIDATE-ROWS"]},{"symbol":"OpticalConstructor.Optimization.BenchNoise.ParameterValues.benchNoise","op":"create","obligations":["S142-CANDIDATE-ROWS"],"path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs"},{"symbol":"OpticalConstructor.Optimization.BenchNoise.ParameterValue.angleUncertainty","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs","obligations":["S142-CANDIDATE-ROWS"]},{"symbol":"OpticalConstructor.Optimization.BenchNoise.ParameterValue.elementUncertainty","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs","obligations":["S142-CANDIDATE-ROWS"]},{"symbol":"OpticalConstructor.Optimization.BenchNoise.ParameterValue.throughputUncertainty","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/BenchNoise.fs","obligations":["S142-CANDIDATE-ROWS"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 480, "anchor": "IMPLEMENT", "ac": "AC-S142e", "touches": ["BerremanTestSupport", "BerremanTests"], "depends_on": [479], "how_to": "The acceptance facts (step 481) run one noisy fit of each existing design, so the noisy-experiment runners leave their classes for the shared test support (the S14.1 mapper's note: '`perturbedStart`, `scalingAround` and the noisy-ensemble helpers are still MuellerInverseTests class bindings, to move if a layer-2 fact needs them'; 001 §Q 'The ground truth and designs … move into a shared test-support project'; AGENTS.md 'Reuse, never copy'). Each is a MOVE (.spec-md §4 'A reuse is a move or a call'; .spec-md §7 'Harness and samples … a move'): one declaration of each moved name exists afterwards, and BerremanTests' numbers are bit-identical (.spec-md §4 'BerremanTests' numbers stay unchanged'). `BerremanTestSupport` references no test framework (step 344), so a moved runner answers the product's `Result` and its callers pipe it through `expectOk` (step 335). Each moved doc is cut to its contract in one to three lines, citing spec 0050 S14.2. (1) `Berreman/BerremanTestSupport/QuartzSample.fs` (step 473), after `fullConfigurations`, opening the product modules where the compiler asks: `solverParameters` (`MuellerInverseTests.fs:solverParameters`, three reflections, its reason kept in one line); `forward` (`MuellerInverseTests.fs:forward`, `createBerremanForward` of the uniaxial builder as S10.1 leaves it, `fun (p : UniaxialParameters) -> p.opticalProperties`, step 332); `quartzScalingAround` (the class's `scalingAround`, `MuellerInverseTests.fs:scalingAround`, renamed as `AbsorbingBiaxialSample` names its own `absorbingScalingAround`, so no reader's `open` shadows `MuellerFitting.scalingAround`, step 336); `blindStart` and `wideBox` (`MuellerInverseTests.fs:blindStart`, `:wideBox`); `noisyQuartzObservations (noise : NoiseParam) (seed : NoiseSeed) (configurations : MeasurementConfiguration list) : Result<MuellerObservation list, MuellerFitError>`, the class's `noisyObserve` (`MuellerInverseTests.fs:noisyObserve`) without its `expectOk`: `noisyObserveWith forward quartz noise seed configurations` (step 339); and `recoverQuartzFromNoisy (noise : NoiseParam) (seed : NoiseSeed) : Result<NoisyExperiment<UniaxialParameters>, MuellerFitError>`, the class's `recoverFromNoisy` (`MuellerInverseTests.fs:recoverFromNoisy`): `noisyQuartzObservations noise seed fullConfigurations`, then `MuellerFitting.fitObservations forward wideBox <them> (quartzScalingAround blindStart)` (step 337), then `{ seed = seed; fit = <its MuellerFitData> }` (step 341). The record `fitWithResidual` answers holds the scaling, residual and solution the class's literal rebuilt it from, `recovered` being `ofScaled scaling solution.solution` in both (step 337), so every number is unchanged. `MuellerInverseTests.fs` deletes the seven and reads them from `QuartzSample` as it reads the moved design (step 473); its `noisyObserve` uses become `noisyQuartzObservations … |> expectOk` and its `recoverFromNoisy` uses `recoverQuartzFromNoisy … |> expectOk`; its own `fitObservations` wrapper, `runFit`, `observe`, `perturbedStart`, `nearBox` and `recoveredQuantities` stay, over the moved `forward` and `quartzScalingAround`. (2) `Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs` (steps 346, 431), after `absorbingBandBreaches`: `absorbingForward`, the class's `forward` (`AbsorbingBiaxialNoisyTests.fs:forward`: `createBerremanForward` of the absorbing builder over `BiaxialSample.solverParameters`, step 334), and `recoverAbsorbingFromNoisy (noise : NoiseParam) (seed : NoiseSeed) : Result<NoisyExperiment<AbsorbingTriclinicParameters>, MuellerFitError>`, the class's `recoverFromNoisy` (`AbsorbingBiaxialNoisyTests.fs:recoverFromNoisy`): `noisyObserveAbsoluteWith absorbingForward absorbing noise seed fullConfigurations` (step 340), then `fitAbsorbingObservations absorbingForward searchBox <them> (absorbingScalingAround perturbedStart)` (step 337), then the record. `AbsorbingBiaxialNoisyTests.fs` deletes its `forward` and `recoverFromNoisy` and maps `noisySeeds` (step 431) through `recoverAbsorbingFromNoisy NoiseParam.decentLab … |> expectOk`. `KitAcceptanceTests`' own observation helper (step 434) is not touched. No test is added or removed.", "acceptance": "After the moves, `QuartzSample` MUST declare `solverParameters`, `forward`, `quartzScalingAround`, `blindStart`, `wideBox`, `noisyQuartzObservations` and `recoverQuartzFromNoisy`, and `AbsorbingBiaxialSample` `absorbingForward` and `recoverAbsorbingFromNoisy`, each once and answering `Result`, with `MuellerInverseTests` and `AbsorbingBiaxialNoisyTests` reading them and declaring none; unit-tests MUST pass over the selected classes `BerremanTests.AbsorbingBiaxialNoisyTests` and `BerremanTests.MuellerInverseTests`, their numbers and counts unchanged; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests", "kit-acceptance"], "gate_selection": {"unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.AbsorbingBiaxialNoisyTests", "BerremanTests.MuellerInverseTests"]}, "kit-acceptance": {"mode": "selected", "suite": "kit-acceptance", "values": ["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]}}, "effects": {"edits": ["Berreman/BerremanTestSupport/QuartzSample.fs", "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "Berreman/BerremanTests/MuellerInverseTests.fs", "Berreman/BerremanTests/AbsorbingBiaxialNoisyTests.fs"], "tests": [{"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.gyrationProjection collapses to g33 along the optic axis and to g11 across it", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.internalAngle is capped by the critical angle, so a z-cut plate cannot reach the g11 regime", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.orientForCut carries the optic axis from the surface normal into the surface plane", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.toScaled and ofScaled round-trip, and a unit scaled step is the intended physical step", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.muellerOfBirefringence reproduces the repository's own retarder and rotator primitives", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.analyticInversion inverts muellerOfBirefringence exactly and reports zero dichroism", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.analyticInversion reports the degenerate cases as typed errors rather than plausible numbers", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.cloudeEigenvalues identify a non-depolarizing matrix and the depolarization index agrees", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.C1 is a pure optical rotator whose rotatory power is exactly 2 pi g11 d over lambda", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.C1 is completely blind to g33, which is why a second crystal cut is required", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.every configuration produces a physically realizable, essentially non-depolarizing Mueller matrix", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the residual pipeline runs end to end against mock proxies, with no solver and no optimizer", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.both proxies compare by reference (the ReferenceEquality convention)", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.every boundary maps failure to a typed error, never a throw", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the full C1-C4 measurement set recovers every material constant from a perturbed start", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the full measurement set is well conditioned and every parameter is observable", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.C1 alone cannot determine three of the four constants, which is why the design needs more cuts", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.the measurement-error model is reproducible, bounded, and files data against the NOMINAL angles", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.a blind n = 1.5 start with no assumed optical activity still recovers every constant from noiseless data", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.MuellerInverseTests.an ensemble of noisy experiments recovers every constant, and its scatter IS what one fit's own covariance predicts", "path": "Berreman/BerremanTests/MuellerInverseTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"op": "change_expectation", "suite": "unit-tests", "id": "BerremanTests.AbsorbingBiaxialNoisyTests.an ensemble of noisy experiments recovers the absorption far better than the optical activity", "path": "Berreman/BerremanTests/AbsorbingBiaxialNoisyTests.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}], "contracts": [{"symbol": "BerremanTestSupport.QuartzSample.solverParameters", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.QuartzSample.forward", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.QuartzSample.quartzScalingAround", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.QuartzSample.blindStart", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.QuartzSample.wideBox", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.QuartzSample.noisyQuartzObservations", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.QuartzSample.recoverQuartzFromNoisy", "op": "create", "path": "Berreman/BerremanTestSupport/QuartzSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.AbsorbingBiaxialSample.absorbingForward", "op": "create", "path": "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}, {"symbol": "BerremanTestSupport.AbsorbingBiaxialSample.recoverAbsorbingFromNoisy", "op": "create", "path": "Berreman/BerremanTestSupport/AbsorbingBiaxialSample.fs", "obligations": ["S142-NOISY-RUNNERS-MOVE"]}], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 481, "anchor": "IMPLEMENT", "ac": "AC-S142f", "touches": ["BerremanTests"], "depends_on": [480], "how_to": "The Planner's numerical layer reproduces the existing facts over their own designs (001 §M 'Full rank, `MuellerInverseTests`: \"the full measurement set is well conditioned and every parameter is observable\". The planner reports full rank for that design'; 'Layer 2 / Cramér–Rao, `MuellerInverseTests`: \"an ensemble of noisy experiments recovers every constant, and its scatter IS what one fit's own covariance predicts\". The planner's bounds for that design equal the promoted `predictedRelativeErrors`, and likewise for AT-2's design'; the S14.2 brief; 001 §W: no new inverse-physics test). The facts join `BerremanTests.MeasurementPlannerTests` (`Berreman/BerremanTests/MeasurementPlannerTests.fs`, step 475), which opens `PlannerInformation`, `MuellerFitting`, `FitUncertainty`, `RecoveryEnsembles` and `BenchNoise` where the compiler asks and names each design by its module, as step 475 does. AT-2's design is read at design level, as the S14.1 mapper recorded: AT-2's committed kit carries each cut on its observation rows (step 433). (1) `the planner finds the full C1-C4 set full rank with every quartz constant bounded, and C1 alone blind to n_e and g33`: over the four names of `UniaxialParameters.axes`, `PlannerInformation.over` of the one candidate `candidateRowsOver QuartzSample.forward (QuartzSample.quartzScalingAround QuartzSample.quartz) QuartzSample.quartz NoiseParam.decentLab QuartzSample.fullConfigurations |> expectOk` (step 479: the nominal point the truth, the noise the bench's) has rank 4, no confounded combination, `conditionOpt` `Some` of a finite number and `scaledSigmasOpt` `Some` of four finite positive entries, so `boundsOver` its scaling answers a bound on each constant; over `QuartzSample.c1` alone the rank is 2, and the names the texts of its two confounded directions carry are exactly n_e and g33 (`C1 is completely blind to g33, which is why a second crystal cut is required`: their Jacobian columns are identically zero, the ablation `MuellerInverseTests` measures). (2) `the planner's bounds for the noisy quartz design are what one noisy fit's own covariance predicts`: `first = QuartzSample.recoverQuartzFromNoisy NoiseParam.decentLab (List.head BiaxialSample.ensembleSeeds) |> expectOk` (step 480; the ensemble fact's first experiment), `quality = first.fit.report` and `predicted = predictedRelativeErrors QuartzSample.quartz first.fit quality` (step 342); the planner's information is `PlannerInformation.over` the axis names of the one candidate `{ jacobian = MuellerFitting.residualJacobianAt first.fit.residual first.fit.solution.solution; noise = quality.reducedChiSquared.noiseVariance }` (steps 336, 477): the design's Jacobian where the fit stopped, which `reportFrom` takes there through the same `FitQuality.residualJacobian`, and the fit's residual level as the noise. For each constant, its bound of `boundsOver first.fit.scaling` divided by the magnitude of its axis's value in `QuartzSample.quartz` equals its `predicted` entry within 1e-12 relative: the Cramér–Rao bound at that noise is the covariance account the fit itself gives (step 477), in the same relative units. (3) `the planner's bounds for AT-2's noisy design are what one noisy fit's own covariance predicts`: the same over `AbsorbingBiaxialSample.recoverAbsorbingFromNoisy NoiseParam.decentLab (List.head AbsorbingBiaxialSample.noisySeeds) |> expectOk` (AT-2's design, `fullConfigurations` = a1 @ a2 @ a3, its fifteen components) and `predictedRelativeErrors AbsorbingBiaxialSample.absorbing first.fit quality`. Each failure names the constant, the planner's bound and the prediction. The class's runtime grows by one transparent and one absorbing noisy fit (`MuellerInverseTests`' ensemble fact measures about 45 s per transparent fit, `AbsorbingBiaxialNoisyTests` about 190 s per absorbing one).", "acceptance": "After the facts land, the Planner's layer 2 MUST find the full C1-C4 set full rank with a bound on every quartz constant and C1 alone rank 2 with n_e and g33 confounded, and its Cramér–Rao bounds at a noisy fit's own residual level MUST equal the promoted `predictedRelativeErrors` of that fit for the quartz design and for AT-2's design; unit-tests MUST pass over the selected class `BerremanTests.MeasurementPlannerTests`, including `the planner finds the full C1-C4 set full rank with every quartz constant bounded, and C1 alone blind to n_e and g33`, `the planner's bounds for the noisy quartz design are what one noisy fit's own covariance predicts` and `the planner's bounds for AT-2's noisy design are what one noisy fit's own covariance predicts`, the count rising by 3; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "unit-tests"], "gate_selection": {"unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.MeasurementPlannerTests"]}}, "effects": {"edits": ["Berreman/BerremanTests/MeasurementPlannerTests.fs"], "tests": [{"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner finds the full C1-C4 set full rank with every quartz constant bounded, and C1 alone blind to n_e and g33", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S142-PLANNER-ACCEPTANCE"]}, {"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner's bounds for the noisy quartz design are what one noisy fit's own covariance predicts", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S142-PLANNER-ACCEPTANCE"]}, {"op": "create", "suite": "unit-tests", "id": "BerremanTests.MeasurementPlannerTests.the planner's bounds for AT-2's noisy design are what one noisy fit's own covariance predicts", "path": "Berreman/BerremanTests/MeasurementPlannerTests.fs", "class": "BerremanTests.MeasurementPlannerTests", "discovery_gate": "unit-tests", "obligations": ["S142-PLANNER-ACCEPTANCE"]}], "contracts": [], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 482, "anchor": "IMPLEMENT", "ac": "AC-S142g", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [481], "how_to": "The candidate experiments of a kit: each plate it holds, read by its Mueller polarimeter on each branch the plate emits, swept over incidence × azimuth at each source's line (001 §M 'the Fisher information from the Jacobians of every candidate experiment'; 'a measurement plan emitted as setups + experiments with role `Planned` into the same kit'; 'candidate Jacobians are cached per (sample, experiment)'; the S14.2 brief). A candidate is an experiment of AT-2's shape (step 433: one plate in Object 1, its R2 the incidence and its R1 the azimuth, read on T or R) over the spec 0044 designs' own angles, the incidences of A2 with normal incidence and the azimuths of A1 (`AbsorbingBiaxialSample.fs:a1`, `:a2`): constants of the planner, not settings (.spec-md §8: no configuration knob). Layer 2 measures a plate through the study engine's observation forward, which places a plate by its `SampleCut` (step 375), so a plate whose orientation puts no principal axis on its normal (`PlannerPlate.normalAxisOpt` `None`, step 471) has no candidate and the plan names it; this departs from step 467's note that layer 2 measures such a plate, and is recorded here. Only a full Mueller polarimeter reads a candidate: its readings are the Mueller observations the bench budget describes (step 479), and layer 1 shows that gyration needs a full Mueller reach (step 467). In `MeasurementPlanner.fs`, after step 477's declarations. Each doc is one to three lines citing spec 0050 S14.2; every case name has two words; no `bool` appears. (1) `PlanCandidate = { source : PlannerSource; plate : PlannerPlate; cut : SampleCut; observable : Observable }` (steps 470, 471; `MuellerInverse.fs:SampleCut`, `:Observable`), with `static member incidenceRange : VariableRange`, `{ min = SweptValue 0.0; max = SweptValue 60.0; points = CurvePointCount 4 }`, whose `sweptValues` (step 287) are 0, 20, 40 and 60 degrees, and `static member azimuthRange : VariableRange`, `{ min = SweptValue 0.0; max = SweptValue 67.5; points = CurvePointCount 4 }`: 0, 22.5, 45 and 67.5 degrees (`Experiments.fs:VariableRange`); `member this.capture : MeasurementMode`, `CaptureTransmitted` for `TransmittedMueller` and `CaptureReflected` for `ReflectedMueller` (`Experiments.fs:MeasurementMode`); and `member this.caption : string`, `<the plate's label> (<the cut's plateText>), transmitted` or `…, reflected`, then `, <the source's wavelength in nm with one decimal> nm`, under `CultureInfo.InvariantCulture` (`SampleCut.plateText`, step 469). (2) `PlanCoverage` = `CandidateInKit of ExperimentName` | `CandidateNotInKit`, and on `PlanCandidate` `member this.coverageIn (setups : Setup list) (experiments : Experiment list) : PlanCoverage`: `CandidateInKit` of the first experiment whose setup resolves (`slotsIn setups`, step 261), whose Object 1 slot (`SetupSlot.inLightOrder`, step 257) holds the plate's item, and whose scan is one block read on `this.capture` or `CaptureBoth` whose axes are, in order, a `VaryR2` axis and a `VaryR1` axis on that slot over `incidenceRange` and `azimuthRange`, with no `sourceWaveLengthOpt` (labels are not compared), whatever its role: a planned or a measured run already holds the candidate. (3) On `PlannerInputs` (step 471): `member this.polarimeterOpt : PlannerDetector option`, the first of `this.lab.detectors` recording `RecordsMuellerMatrix` (step 470); `member this.unplacedPlates : PlannerPlate list`, the plates whose `normalAxisOpt` is `None`; and `member this.candidates : PlanCandidate list`, empty without a polarimeter and otherwise, for each source of `this.lab.sources` in order, each plate in order whose cut is the one of `[ ZCut; XCut; YCut ]` whose `normalAxisOpt` (step 466) equals the plate's, and each observable its emission allows in the order step 472 reads them (`EmitBoth` transmitted then reflected), the candidate of that source, plate, cut and observable. No cache, store or other member is added. Tests, in `PlannerInputsTests` (steps 470-472), over its items and its plates QZ-Z (`PrimaryAxes`, `EmitBoth`) and QZ-X (theta 90°, `EmitTransmittedOnly`) and a third plate QZ-T, an `EulerRotation` under `ZmYpXp` at theta 30°: `a kit's candidates are each placed plate on each branch it emits at each source's line, read by its polarimeter`: with Laser, Polarimeter, QZ-Z, QZ-X and QZ-T, `candidates` are QZ-Z z-cut transmitted, QZ-Z z-cut reflected and QZ-X x-cut transmitted, each at the Laser's wavelength, with the captions `QZ-Z (z-cut plate), transmitted, 632.8 nm` and so on; `unplacedPlates` is [QZ-T]; the ranges' `sweptValues` are 0, 20, 40, 60 and 0, 22.5, 45, 67.5; and with the Phone in place of the Polarimeter the candidates are none. `a candidate is in the kit once an experiment over its plate sweeps its angles on its branch`: over a setup built as `SetupTests` builds its setups (step 256), Laser in `src`, QZ-Z in `sample` and the Polarimeter in `det`, an experiment E1 whose scan is one block of the sample's R2 over `incidenceRange` then its R1 over `azimuthRange`, read `CaptureTransmitted`, makes QZ-Z's transmitted candidate `CandidateInKit E1` and its reflected one `CandidateNotInKit`; read `CaptureBoth` it holds both; with the axes in the other order, another range or a setup holding QZ-X it holds neither.", "acceptance": "After the candidates land, `PlannerInputs.candidates` MUST answer each placed plate on each branch its emission allows at each source's line when the kit has a Mueller polarimeter, `unplacedPlates` the plates with no principal axis on their normal, and `PlanCandidate.coverageIn` the kit experiment whose one block sweeps the candidate's R2 then R1 ranges on its plate and branch; constructor-unit-tests MUST pass, including `a kit's candidates are each placed plate on each branch it emits at each source's line, read by its polarimeter` and `a candidate is in the kit once an experiment over its plate sweeps its angles on its branch`, the count rising by 2; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerInputsTests.a kit's candidates are each placed plate on each branch it emits at each source's line, read by its polarimeter", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs", "class": "OpticalConstructor.Tests.PlannerInputsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-KIT-CANDIDATES"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlannerInputsTests.a candidate is in the kit once an experiment over its plate sweeps its angles on its branch", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs", "class": "OpticalConstructor.Tests.PlannerInputsTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-KIT-CANDIDATES"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlanCandidate", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S142-KIT-CANDIDATES"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlanCoverage", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S142-KIT-CANDIDATES"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.polarimeterOpt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S142-KIT-CANDIDATES"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.unplacedPlates", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S142-KIT-CANDIDATES"]}, {"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.candidates", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S142-KIT-CANDIDATES"]}], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":483,"anchor":"IMPLEMENT","ac":"AC-S142h","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[482],"how_to":"The instrument-matrix condition number for choosing the polarizer and compensator states (001 §M 'the instrument-matrix condition number for choosing polarizer and compensator states'; the S14.2 brief). A state generator of the kit's polarizer followed by its compensator turned to θ makes the Stokes state s(θ) = M_C(θ) · M_P(0) · (1, 0, 0, 0); the analyzer, the same pair in reverse, reads the row a(θ), row 0 of M_P(0) · M_C(θ); a reading at generator angle θ_g and analyzer angle θ_a is the design row `MuellerReconstruction.designRow (s θ_g) (a θ_a)` (`MuellerReconstruction.fs:designRow`, the row the linear engine solves, step 388), so the instrument matrix of four generator and four analyzer states is the 16 × 16 stack of those rows, and its condition number (`MuellerInverse.fs:conditionNumber`) is how much it amplifies reading noise into the reconstructed Mueller matrix. The four angles are the set, from the grid 0°, 15°, …, 165°, whose 4 × 4 generator matrix has the least condition number (a regular tetrahedron on the Poincaré sphere reaches √3), the analyzer turned to the same four; the grid is a constant of the planner. Each optic is evaluated by the one item evaluator (`ItemModelChoice.boundWith`, step 251, at `ParameterValues.ofParameters item.parameters`, step 245; `BoundOpticalElement.muellerAt` at `ElementOrientation.transmittingAt θ`, step 247) at the first source's wavelength. A compound optic (a circular polarizer, step 210) turns as one piece, so it generates states of one ellipticity and cannot complete a basis; it is not paired. In `MeasurementPlanner.fs`, after step 482's declarations. Each doc is one to three lines citing spec 0050 S14.2; every case name has two words; no `bool` appears. (1) `PlannerError` gains `InstrumentEvaluationErr` (`an optic of the kit cannot be evaluated: <reason>`). (2) `InstrumentChoice = { polarizer : PlannerOptic; compensator : PlannerOptic; angles : Angle list; condition : ConditionNumber }`. (3) `InstrumentFinding` = `ConditionedInstrumentFinding of InstrumentChoice` | `CompensatorMissingFinding of PlannerOptic`, with `member this.text : string`: `<the polarizer's label> with <the compensator's label> at <the four angles in degrees, one decimal, joined by \", \">°: the instrument matrix's condition number is <κ, two decimals>.` and `<the polarizer's label> has no compensator to pair: it generates linear states only, so a full Mueller matrix needs a retarder.`, under `CultureInfo.InvariantCulture`. (4) `type PlannerInputs with member this.instrumentFindingsWith (items : Item list) (choiceOf : Item -> ItemModelChoice option) (materials : MaterialProxy) : Result<InstrumentFinding list, PlannerError>`: none without a source; otherwise, for each `PolarizerOptic` of `this.lab.optics` in order, one `ConditionedInstrumentFinding` per `CompensatorOptic` in order — the four grid angles of least generator condition, a tie keeping the earliest set in the grid's lexicographic order, and the condition of the instrument matrix built over them — or, when the lab holds no compensator, one `CompensatorMissingFinding` of it. An optic's item missing from `items`, a `choiceOf` answering `None` or an `ItemEvaluationError` answers `InstrumentEvaluationErr` naming the item's label and the cause. No cache or option is added. Tests, in `PlannerInputsTests`, over step 470's items (LP1 the linear-polarizer preset, RET the retarder plate at its quarter-wave default, step 208): `a polarizer and a retarder give the four compensator angles of least generator condition, and the instrument's condition follows`: with Laser, LP1 and RET the answer is one `ConditionedInstrumentFinding` of LP1 with RET whose four angles are distinct grid angles at which the generator matrix's condition, computed in the test through the same evaluator and `conditionNumber`, is no greater than at any other four of the grid's twelve angles (all 495 sets checked), and whose instrument condition is finite and at least 3 (a Kronecker product's condition is its factors' product, each at least √3); its text names both labels and the four angles. `a polarizer alone is told it needs a compensator, and a compound optic is not paired`: with Laser and LP1, or Laser, LP1 and CPL1, the answer is `[ CompensatorMissingFinding LP1 ]` with its text; with no source it is empty. `an optic the library does not resolve refuses the instrument findings, naming it`: a `choiceOf` answering `None` for RET answers `InstrumentEvaluationErr` naming `RET`. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the instrument findings land, `PlannerInputs.instrumentFindingsWith` MUST pair each polarizer with each compensator at the four grid angles of least generator condition and report the instrument matrix's condition, tell a polarizer with no compensator that it needs one, leave compound optics unpaired and refuse an unresolved optic; constructor-unit-tests MUST pass, including `a polarizer and a retarder give the four compensator angles of least generator condition, and the instrument's condition follows`, `a polarizer alone is told it needs a compensator, and a compound optic is not paired` and `an optic the library does not resolve refuses the instrument findings, naming it`, the count rising by 3; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a polarizer and a retarder give the four compensator angles of least generator condition, and the instrument's condition follows","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INSTRUMENT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.a polarizer alone is told it needs a compensator, and a compound optic is not paired","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INSTRUMENT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerInputsTests.an optic the library does not resolve refuses the instrument findings, naming it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerInputsTests.fs","class":"OpticalConstructor.Tests.PlannerInputsTests","discovery_gate":"constructor-unit-tests","obligations":["S142-INSTRUMENT"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError","op":"change_shape","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INSTRUMENT"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.InstrumentChoice","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INSTRUMENT"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.InstrumentFinding","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INSTRUMENT"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.instrumentFindingsWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-INSTRUMENT"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 484, "anchor": "IMPLEMENT", "ac": "AC-S142i", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [483], "how_to": "The kit's app cache gains the Planner's folder, reached through two proxy verbs (001 §M 'Cache: … stored in the kit's `.oc/planner/` (derived, safe to delete, never sent)'; 001 §A '.oc/ app-owned cache and lock; safe to delete'; .spec-md §3.12 'A read-only open writes nothing: no .oc/lock, no .oc/planner/'; .spec-md §5 `KitProxy`: 'Fields grow as kinds land'). Sending already leaves `.oc/` out (`KitFile.sendChoiceOf`, step 196, whose facts place `.oc/planner/c.json`, step 198), so 'never sent' holds with no change here. Each doc is one to three lines citing spec 0050 S14.2. (1) `OpticalConstructor.Domain/Kit.fs`: `KitRelativePath` (step 123) gains `static member plannerCacheFolder : KitRelativePath`, `appCacheFolder` (step 196) followed by `/planner`, so the text `.oc` stays written once. (2) `OpticalConstructor.Domain/KitFolders.fs`: `KitProxy` (step 125) gains two fields, each with a one-line doc: `readPlannerCacheFile : FileName -> Result<KitFileText option, KitError>`, the text of `<plannerCacheFolder>/<name>` or `None` when there is none; and `writePlannerCacheFile : FileName -> KitFileText -> Result<unit, KitError>`, which creates or replaces that file whole, creating `.oc` and `.oc/planner` when missing as the lock creates `.oc` (step 129). A name holding `/` or `\\\\`, `.` or `..`, or no character answers `InvalidKitPathErr` and touches nothing, so neither verb reaches outside the planner folder. `KitProxy.readOnlyView` (step 131) refuses `writePlannerCacheFile` with `KitReadOnlyErr` naming it and passes `readPlannerCacheFile` through. (3) `KitProxy.createInMemory` keeps the texts in the folder's one map under their kit-relative paths, which `paths` lists with `.oc` and `.oc/planner`. (4) `KitProxy.create` (`OpticalConstructor.Storage/KitFolderStore.fs`, step 126) reads with a leading byte-order mark dropped and writes through `writeBytesAtomically` (step 126) as UTF-8 without one; IO exceptions are `KitIoErr` as there. No delete, listing or eviction verb is added: the cache is safe to delete by hand, and an entry nothing asks for is never read. Tests, each in `KitProxyTests` (the in-memory folder) and `KitProxyFolderTests` (a folder under the test output), over an initialised kit: `a planner cache file is written under .oc/planner and read back, and a name reaching outside it is refused`: `readPlannerCacheFile` of `a.candidate-json` answers `None`; after `writePlannerCacheFile` of it with `{}` the kit holds `.oc/planner/a.candidate-json` (`paths`, or the file on disk) and the read answers `Some` of `{}`; a second write replaces it; the names `../x.candidate-json` and `p/x.candidate-json` answer `InvalidKitPathErr` and nothing is written. `a read-only kit refuses a planner cache write and still reads the cache`: through `readOnlyView` a write answers `KitReadOnlyErr` and the kit is unchanged, and a file the read-write proxy wrote is read back.", "acceptance": "After the verbs land, `KitProxy.readPlannerCacheFile` and `writePlannerCacheFile` MUST read and write files only directly under `.oc/planner/` in both stores, the read-only view refusing the write and passing the read; constructor-unit-tests MUST pass, including `a planner cache file is written under .oc/planner and read back, and a name reaching outside it is refused` and `a read-only kit refuses a planner cache write and still reads the cache` in both `KitProxyTests` and `KitProxyFolderTests`, the count rising by 4; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/Kit.fs", "Berreman/OpticalConstructor/OpticalConstructor.Domain/KitFolders.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/KitFolderStore.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitProxyTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitProxyFolderTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitProxyTests.a planner cache file is written under .oc/planner and read back, and a name reaching outside it is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitProxyTests.fs", "class": "OpticalConstructor.Tests.KitProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-CACHE-VERBS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitProxyTests.a read-only kit refuses a planner cache write and still reads the cache", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitProxyTests.fs", "class": "OpticalConstructor.Tests.KitProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-CACHE-VERBS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitProxyFolderTests.a planner cache file is written under .oc/planner and read back, and a name reaching outside it is refused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitProxyFolderTests.fs", "class": "OpticalConstructor.Tests.KitProxyFolderTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-CACHE-VERBS"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitProxyFolderTests.a read-only kit refuses a planner cache write and still reads the cache", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitProxyFolderTests.fs", "class": "OpticalConstructor.Tests.KitProxyFolderTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-CACHE-VERBS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.Kit.KitRelativePath.plannerCacheFolder", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/Kit.fs", "obligations": ["S142-CACHE-VERBS"]}, {"symbol": "OpticalConstructor.Domain.KitFolders.KitProxy", "op": "change_shape", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/KitFolders.fs", "obligations": ["S142-CACHE-VERBS"]}], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":485,"anchor":"IMPLEMENT","ac":"AC-S142j","touches":["OpticalConstructor.Domain","OpticalConstructor.Storage","OpticalConstructor.Tests"],"depends_on":[484],"actions":["ADD_TEST OpticalConstructor.Tests.PlannerCacheTests"],"how_to":"Candidate Jacobians are cached per (sample, experiment) under a key hashing what they depend on (001 §M 'Cache: key = hash of (items + parameter states + targets + nominal point); stored in the kit's `.oc/planner/` (derived, safe to delete, never sent); candidate Jacobians are cached per (sample, experiment), so adding one item computes only the new candidates'; the S14.2 brief). One candidate's key holds its own items with their parameter states (the source, the plate and the polarimeter: `Item`, step 213, whose `parameters` carry their states), its branch, the opened material (`OpenedMaterial`, steps 361 and 460, whose physics and parameter states are the nominal point and the targets' bounds) and the targets; an item no candidate reads is in no key, so adding one leaves every other key and its entry unchanged, which is how adding one item computes only the new candidates. The file is named by the key's hash and the entry keeps its key, so a stale or colliding file is a miss. Each doc is one to three lines citing spec 0050 S14.2. (1) `MeasurementPlanner.fs`, after step 483's declarations: `PlannerError` gains `PlannerCacheErr` (`the planner's cache cannot be read or written: <reason>`); `PlannerCacheKey = { source : Item; plate : Item; detector : Item; observable : Observable; material : OpenedMaterial; targets : ParameterName list }`; `PlannerCacheEntry = { key : PlannerCacheKey; rows : CandidateRows }` (step 477); and `type PlannerInputs with member this.cacheKeyWith (items : Item list) (candidate : PlanCandidate) : Result<PlannerCacheKey, PlannerError>`: the items of `items` whose ids are the candidate's source's, its plate's and `this.polarimeterOpt`'s detector's (an id `items` lacks, or no polarimeter, answering `UnresolvedPlannerItemErr` naming it), the candidate's observable, `this.prior.material` and `this.targets`. (2) New `Berreman/OpticalConstructor/OpticalConstructor.Storage/PlannerCacheStore.fs`, `module PlannerCacheStore` in `namespace OpticalConstructor.Storage`, compiled directly after `KitContentFiles.fs` (one `<Compile>` line in `OpticalConstructor.Storage.fsproj`, no comment). Module doc: the Planner's candidate cache under a kit's `.oc/planner/` (spec 0050 S14.2). It reuses step 124's stack (`nodeOf`, `JsonNode.canonicalFileText`, `CanonicalJson.options`) and the content hash (`CanonicalJson.contentHashOf`, step 123); no schema covers the file, because `.oc/` is cache (the lock's rule, step 129). (a) `type PlannerCacheKey with member this.cacheFileName : Result<FileName, StorageError>`: the text of `contentHashOf` of `nodeOf this` (a lower-case hexadecimal SHA-256, step 24) followed by `.candidate-json`. (b) `type PlannerCacheEntry with member this.fileText : Result<KitFileText, StorageError>` (`nodeOf` rendered by `canonicalFileText`) and `type KitFileText with member this.parsePlannerCacheEntry : Result<PlannerCacheEntry, StorageError>`, bound through `CanonicalJson.options` (`MalformedJsonErr`), the lock's pair (step 129). (c) `type KitContext with member this.cachedPlannerRows (key : PlannerCacheKey) (compute : unit -> Result<CandidateRows, PlannerError>) : Result<CandidateRows, PlannerError>`: `this.proxy.readPlannerCacheFile` (step 484) of the key's file name; a text binding to an entry whose `key` equals `key` is a hit, answered without calling `compute`; no file, a text that does not bind and an entry of another key are a miss: `compute ()`, whose `Ok rows` is, under `ReadWriteKitAccess`, written as `{ key; rows }` through `writePlannerCacheFile`, and under `ReadOnlyKitAccess` written nowhere (.spec-md §3.12). A `KitError` or `StorageError` of the read or the write answers `PlannerCacheErr` with its `describe`; a `compute` error passes through and nothing is written. No eviction, size limit, retry or option is added. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs`, `module PlannerCacheTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, over keys built by `cacheKeyWith` from `PlannerInputsTests`' kit (step 482: Laser, Polarimeter, QZ-Z and its opened material, targets n_e and g33), rows written as literals and a `compute` that counts its calls; the contexts are `KitContext.openKit` (step 131) of `KitProxy.createInMemory` over one initialised `InMemoryKitFolder` unless named otherwise. `a cache miss computes once and writes one file under .oc/planner, and a hit reads it back without computing`: the first call computes once and leaves exactly one `.oc/planner/<64 hex>.candidate-json` in `paths`; a second call with the same key answers rows equal to the first and computes nothing. `a changed item or target is a new key, and an item no candidate reads leaves every key unchanged`: QZ-Z with its `substrateThickness` state changed, or the targets [g33] alone, give another file name; adding an item LP1 to the items leaves `cacheKeyWith` of every candidate equal. `a read-only kit computes and writes nothing, and reads what a read-write open cached`: a read-only context over the folder a read-write one cached reads the hit without computing, and on a miss computes and leaves `paths` unchanged. `a cache file that does not bind, or holds another key, is a miss that is written over`: a file placed at the key's path holding `{`, or the entry of another key, makes the call compute and replace it with the entry of this key. `a folder kit keeps the planner's cache across opens`: over `KitProxy.create` of a folder under the test output, an entry written through a read-write context is read, after that context is closed, through a read-only one without computing.","acceptance":"After the cache lands, `PlannerInputs.cacheKeyWith` MUST key a candidate by its own items, branch, opened material and targets, and `KitContext.cachedPlannerRows` MUST answer a hit from `.oc/planner/<hash>.candidate-json` without computing, compute a miss and write it under read-write access only, and treat an unreadable or foreign file as a miss; constructor-unit-tests MUST pass, including `a cache miss computes once and writes one file under .oc/planner, and a hit reads it back without computing`, `a changed item or target is a new key, and an item no candidate reads leaves every key unchanged`, `a read-only kit computes and writes nothing, and reads what a read-write open cached`, `a cache file that does not bind, or holds another key, is a miss that is written over` and `a folder kit keeps the planner's cache across opens`, the count rising by 5; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Storage/PlannerCacheStore.fs","Berreman/OpticalConstructor/OpticalConstructor.Storage/OpticalConstructor.Storage.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerCacheTests.a cache miss computes once and writes one file under .oc/planner, and a hit reads it back without computing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs","class":"OpticalConstructor.Tests.PlannerCacheTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CACHE-ENTRIES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerCacheTests.a changed item or target is a new key, and an item no candidate reads leaves every key unchanged","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs","class":"OpticalConstructor.Tests.PlannerCacheTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CACHE-ENTRIES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerCacheTests.a read-only kit computes and writes nothing, and reads what a read-write open cached","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs","class":"OpticalConstructor.Tests.PlannerCacheTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CACHE-ENTRIES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerCacheTests.a cache file that does not bind, or holds another key, is a miss that is written over","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs","class":"OpticalConstructor.Tests.PlannerCacheTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CACHE-ENTRIES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlannerCacheTests.a folder kit keeps the planner's cache across opens","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlannerCacheTests.fs","class":"OpticalConstructor.Tests.PlannerCacheTests","discovery_gate":"constructor-unit-tests","obligations":["S142-CACHE-ENTRIES"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError","op":"change_shape","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerCacheKey","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerCacheEntry","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerInputs.cacheKeyWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Storage.PlannerCacheStore.PlannerCacheKey.cacheFileName","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Storage/PlannerCacheStore.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Storage.PlannerCacheStore.PlannerCacheEntry.fileText","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Storage/PlannerCacheStore.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Storage.PlannerCacheStore.KitFileText.parsePlannerCacheEntry","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Storage/PlannerCacheStore.fs","obligations":["S142-CACHE-ENTRIES"]},{"symbol":"OpticalConstructor.Storage.PlannerCacheStore.KitContext.cachedPlannerRows","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Storage/PlannerCacheStore.fs","obligations":["S142-CACHE-ENTRIES"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":486,"anchor":"IMPLEMENT","ac":"AC-S142k","touches":["OpticalConstructor.Domain","OpticalConstructor.Optimization","OpticalConstructor.Tests"],"depends_on":[485],"actions":["ADD_TEST OpticalConstructor.Tests.PlanRunTests"],"how_to":"The Planner's run over a kit: its candidates' information, what the kit already holds, the greedy ranking, the bound per target, the structural report and the instrument findings, with per-candidate progress and Cancel (001 §M 'Output: a recoverability report'; 'Workflow: … 7. the planner proposes the next experiment'; 001 §P `RunPlan`; .spec-md §10.2 'one Planner candidate' per progress step, §10.3 'Planner runs … are one click with Cancel'; the S14.2 brief). The baseline is what the kit already knows of the targets: their Gaussian priors (`UnknownParameterData.priorOpt`, step 214; a PTB σ among them, step 460) and every candidate a kit experiment already holds (`coverageIn`, step 482: a planned or measured run), so the ranking proposes the next experiments. Each doc is one to three lines citing spec 0050 S14.2. (1) `MeasurementPlanner.fs`: `PlannerError` gains `PlanCancelledErr` (`the plan was cancelled: <reason>`) and `PlannerForwardErr` (`the forward model refused a candidate: <reason>`). (2) New `Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs`, `module PlannerRuns` in `namespace OpticalConstructor.Optimization`, compiled directly after `PlannerInformation.fs` (one `<Compile>` line, no comment). Module doc: the Measurement Planner's run over a kit (spec 0050 S14.2). In order: (a) `PlanCandidateCount of int` with `.value`; `PlanProgress = { evaluated : PlanCandidateCount; total : PlanCandidateCount }`; and `[<ReferenceEquality>] PlanObserver = { reportCandidate : PlanProgress -> unit; cancellation : CancellationToken }`, told after each candidate how many of how many are evaluated and read before each whether to stop (the shape of `OptimizerIterationObserver`, step 380). (b) `type PlanCandidate with member this.configurations : MeasurementConfiguration list`: for each incidence of `PlanCandidate.incidenceRange.sweptValues` (outer) and each azimuth of `azimuthRange.sweptValues` (inner), the order `ScanBlock.points` gives an R2 axis before an R1 axis (step 287), `MuellerFitting.configurationOf this.cut this.plate.thickness (<incidence> * 1.0<deg>) (<azimuth> * 1.0<deg>) this.observable this.source.waveLength` (step 335): the sixteen configurations the candidate's experiment records, point for point. (c) On `PlannerInputs` (step 471): `member this.scalingWith : Result<ParameterScaling<CrystalParameters>, PlannerError>`, the axes of `this.prior.crystal.parameterAxes` (step 361) named by `this.targets`, in target order, centred at `this.prior.crystal`, its scale the crystal with each target's axis written (`writeValue`, step 361) at its unknown's `bounds.searchUnit` (step 476, the study engine's unit), a target of another state answering `UnknownPlannerTargetErr` naming it; `member this.forwardWith (solverParameters : SolverParameters) : ForwardModelProxy<CrystalParameters>`, `createBerremanForward (fun (c : CrystalParameters) -> c.opticalProperties) solverParameters`, the forward the study engine solves an observation with (step 375); `member this.candidateRowsWith (solverParameters : SolverParameters) (candidate : PlanCandidate) : Result<CandidateRows, PlannerError>`, `candidateRowsOver (this.forwardWith solverParameters) <the scaling> this.prior.crystal <the polarimeter's noise.benchNoise result> candidate.configurations` (step 479), a `MuellerFitError` answering `PlannerForwardErr` and no polarimeter `UnresolvedPlannerItemErr`; and `member this.priorRows : Result<CandidateRows list, PlannerError>`, for each target with a prior, in target order, one row over the targets holding unit_k / σ_k at its own coordinate and zero elsewhere, at noise 1: the derivative, with respect to the scaled coordinate, of the prior row (x − centre) / σ the study engine adds (step 387). (d) `PlanStanding = { information : PlannerInformation; boundsOpt : TargetBound list option }`, `RankedPlanStep = { candidate : PlanCandidate; standing : PlanStanding }` and `PlanReport = { study : StudyName; material : MaterialVersionId; criterion : PlanCriterion; structural : RecoverabilityReport; nominal : CrystalParameters; baseline : PlanStanding; inKit : PlanCandidate list; ranked : RankedPlanStep list; unplacedPlates : PlannerPlate list; polarimeterOpt : PlannerDetector option; instrument : InstrumentFinding list }`. (e) `type PlannerInputs with member this.planWith (context : StudyForwardContext) (study : StudyName) (material : MaterialVersionId) (criterion : PlanCriterion) (rowsOf : PlanCandidate -> Result<CandidateRows, PlannerError>) (observer : PlanObserver) : Result<PlanReport, PlannerError>`, in order: `this.structuralReport` (step 472); `this.instrumentFindingsWith context.kit.items context.choiceOf context.materials` (step 483); `this.scalingWith`; `this.candidates`, each `coverageIn context.kit.setups context.kit.experiments` deciding whether it is in the kit or open; then each candidate in order, the cancellation read before it (requested: `PlanCancelledErr` naming how many of how many were evaluated), its `rowsOf`, and `observer.reportCandidate` of the count so far and the total; then the baseline `PlannerInformation.over` the targets of `this.priorRows` followed by the in-kit candidates' rows, with its `boundsOver` the scaling, and `PlannerInformation.rankWith criterion` of the open candidates over that baseline (step 478), each ranked step's bounds likewise. The first error stops the run. `rowsOf` is the caller's, so the cache (step 485) wraps `candidateRowsWith` where the kit is open (step 487). No retry, cache or option is added here. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs`, `module PlanRunTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, over `PlannerInputsTests`' kit (Laser, Polarimeter and QZ-Z) with a study opening its uniaxial version and freeing g11 and g33 (`UnknownParameter` at their values within ±50 %), a test-local `StudyForwardContext` (step 372) over those items, and either a `rowsOf` answering literal rows and counting its calls or `candidateRowsWith SolverParameters.defaultValue`. `a plan reports each candidate as it is evaluated and stops when cancelled`: the observer records (1, 2) and (2, 2); a token the first report cancels answers `PlanCancelledErr` naming 1 of 2, `rowsOf` called once. `a candidate a kit experiment already holds joins the baseline and is not proposed again`: with a setup and an experiment E1 holding QZ-Z's transmitted candidate (built as step 482's fact builds them), `inKit` is that candidate, `ranked` holds the reflected one alone, and the baseline's rank counts E1's rows. `a target's prior is information the kit already holds`: with g33's state carrying a prior of σ 1e-6, `priorRows` is one row holding g33's unit over 1e-6 and the baseline's rank is 1 before any candidate. `a plan over a z-cut plate reports its structural findings, the rank its candidates raise and a bound on each target`: through `candidateRowsWith`, the report's `structural` holds the off-axis-cut finding of a z-cut-only kit (step 472), the last ranked step's information has rank 2 with a finite positive bound on g11 and on g33, and `instrument` is empty (no polarizer). `a plate added to the kit computes only its own candidates`: through `KitContext.cachedPlannerRows` (step 485) over an in-memory read-write kit wrapping `candidateRowsWith` with a counter, the first plan computes 2 candidates, and a second plan after QZ-X joins the items computes 1. The PlannerRuns numerical boundary MUST resolve polarimeter.noise.benchNoise before candidateRowsOver; its typed evaluation failure MUST become UnresolvedPlannerItemErr identifying the detector and axis. No Domain module may reference BenchNoise. PlanRunTests MUST assert that an edited detector noise parameter reaches the candidate information calculation.","acceptance":"After the run lands, `PlannerInputs.planWith` MUST evaluate each candidate through the caller's rows with per-candidate progress and Cancel, put the targets' priors and the in-kit candidates in the baseline, rank the open candidates greedily with bounds per target, and report the structural findings and the instrument findings; constructor-unit-tests MUST pass, including `a plan reports each candidate as it is evaluated and stops when cancelled`, `a candidate a kit experiment already holds joins the baseline and is not proposed again`, `a target's prior is information the kit already holds`, `a plan over a z-cut plate reports its structural findings, the rank its candidates raise and a bound on each target` and `a plate added to the kit computes only its own candidates`, the count rising by 5; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","kit-acceptance","unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"kit-acceptance":{"mode":"selected","suite":"kit-acceptance","values":["OpticalConstructor.Ui.Tests.KitAcceptanceTests"]},"unit-tests":{"mode":"selected","suite":"unit-tests","values":["BerremanTests.MuellerInverseTests","BerremanTests.BiaxialInverseTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","Berreman/OpticalConstructor/OpticalConstructor.Optimization/OpticalConstructor.Optimization.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanRunTests.a plan reports each candidate as it is evaluated and stops when cancelled","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs","class":"OpticalConstructor.Tests.PlanRunTests","discovery_gate":"constructor-unit-tests","obligations":["S142-PLAN-RUN"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanRunTests.a candidate a kit experiment already holds joins the baseline and is not proposed again","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs","class":"OpticalConstructor.Tests.PlanRunTests","discovery_gate":"constructor-unit-tests","obligations":["S142-PLAN-RUN"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanRunTests.a target's prior is information the kit already holds","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs","class":"OpticalConstructor.Tests.PlanRunTests","discovery_gate":"constructor-unit-tests","obligations":["S142-PLAN-RUN"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanRunTests.a plan over a z-cut plate reports its structural findings, the rank its candidates raise and a bound on each target","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs","class":"OpticalConstructor.Tests.PlanRunTests","discovery_gate":"constructor-unit-tests","obligations":["S142-PLAN-RUN"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanRunTests.a plate added to the kit computes only its own candidates","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanRunTests.fs","class":"OpticalConstructor.Tests.PlanRunTests","discovery_gate":"constructor-unit-tests","obligations":["S142-PLAN-RUN"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.MeasurementPlanner.PlannerError","op":"change_shape","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlanCandidateCount","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlanProgress","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlanObserver","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlanCandidate.configurations","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlannerInputs.scalingWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlannerInputs.forwardWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlannerInputs.candidateRowsWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlannerInputs.priorRows","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlanStanding","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.RankedPlanStep","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlanReport","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]},{"symbol":"OpticalConstructor.Optimization.PlannerRuns.PlannerInputs.planWith","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Optimization/PlannerRuns.fs","obligations":["S142-PLAN-RUN"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 487, "anchor": "IMPLEMENT", "ac": "AC-S142l", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Ui", "OpticalConstructor.Tests"], "depends_on": [486], "actions": ["ADD_TEST OpticalConstructor.Tests.PlanJobTests"], "how_to": "`RunPlan` runs off the UI thread on `JobRunner` with per-candidate progress and Cancel (001 §P `RunPlan`; the S14.2 brief 'RunPlan on JobRunner with per-candidate progress'; .spec-md §10.2, §10.3 one click with Cancel, §10.4 'the job's completion message updates the Elmish model, so … the plan view re-render[s] without a manual reload'). It hosts the plan as step 393 hosts a study fit, over `JobRunner.fs:startBackground`, `:updateJob` and `:JobModel`. A plan writes no kit file; its only write is the cache, which a read-only kit does not take (step 485). Each doc is one to three lines citing spec 0050 S14.2. (1) `MeasurementPlanner.fs`: `PlannerError` gains `PlanRaisedErr` (`the plan raised: <reason>`) and `UnknownPlannerStudyErr` (`the kit has no such study: <reason>`). (2) New `Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs`, `module OpticalConstructor.Ui.PlanJob`, compiled directly after `StudyFitJob.fs` (step 393): one `<Compile>` line, no comment. In order: (a) `[<ReferenceEquality>] PlanJobHandle = { cancelPlan : unit -> unit }`. (b) `[<ReferenceEquality>] PlanJobHost = { startPlan : (PlanObserver -> Result<PlanReport, PlannerError>) -> PlanJobHandle }`, with `static member posting (post : (unit -> unit) -> unit) (progressed : JobProgress -> unit) (ended : Result<PlanReport, PlannerError> -> unit) : PlanJobHost`: a `CancellationTokenSource` and a `Stopwatch` per job; the plan runs through `JobRunner.startBackground` as `RanToCompletion [ plan o ]`, `o` posting each `PlanProgress` p as `progressed { completed = JobStepCount p.evaluated.value; total = Some (JobStepCount p.total.value); elapsed = JobElapsed <the stopwatch's elapsed> }` (a known total, which `progressText` shows as `<k> / <n> (<t> s)`, `JobRunner.fs:JobModel`) over the source's token; `onDone` posts `ended` of the plan's result, a raise (`Error (JobRunExn e)`) ending as `Error (PlanRaisedErr e.Message)` and an outcome holding no result as `Error (PlanRaisedErr <a reason naming it>)`; the handle cancels the source. `static member onUiThread (progressed) (ended) : PlanJobHost` is `posting` through Avalonia's `Dispatcher.UIThread.Post`, and `static member inert : PlanJobHost` runs nothing and answers a handle that does nothing (`StudyFitJobHost.inert`'s shape, step 412). (c) `PlanJobState = { job : JobModel<PlanReport>; handleOpt : PlanJobHandle option; errorOpt : PlannerError option }` with `static member idle`. (d) `PlanRequest = { study : StudyName; material : MaterialVersionId; criterion : PlanCriterion }`. (e) `PlanMsg` = `RunPlan of request : PlanRequest` (the semantic message `PlanRunButton` and the tests send, 001 §P) | `CancelPlan` | `PlanProgressed of progress : JobProgress` | `PlanEnded of result : Result<PlanReport, PlannerError>`, each case documented. (f) `[<ReferenceEquality>] PlanEnvironment = { host : PlanJobHost; planWith : PlanRequest -> PlanObserver -> Result<PlanReport, PlannerError> }`, with `static member create (host : PlanJobHost) (kit : KitContext) (forward : StudyForwardContext) : PlanEnvironment`, whose `planWith request observer` takes the study of `forward.kit.studies` named `request.study` (none: `UnknownPlannerStudyErr`), its `plannerInputsWith forward.kit forward.choiceOf request.material` (step 471), and answers `inputs.planWith forward request.study request.material request.criterion rowsOf observer` (step 486), `rowsOf c` being `inputs.cacheKeyWith forward.kit.items c` bound to `kit.cachedPlannerRows key (fun () -> inputs.candidateRowsWith forward.solverParameters c)` (steps 485, 486). (g) `type PlanMsg with member this.updateWith (environment : PlanEnvironment) (state : PlanJobState) : PlanJobState`: `RunPlan r` while `state.job.isRunning` changes nothing (one plan at a time) and otherwise starts `environment.planWith r` through `environment.host.startPlan`, the job through `updateJob StartRequested`, holding the handle and clearing the error; `CancelPlan` calls the handle's `cancelPlan` while the job runs; `PlanProgressed p` is `updateJob (ProgressReported p)`; `PlanEnded (Ok report)` is `updateJob (RunCompleted report)` with no handle and no error; `PlanEnded (Error (PlanCancelledErr _))` is `updateJob RunCancelled` with no handle, the committed report kept; any other error returns the job to `Idle` with its committed report kept and holds the error. No queue, retry, second job or option is added. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs`, `module PlanJobTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, over a host `posting` whose `post` calls at once and whose `progressed` and `ended` feed `PlanProgressed` and `PlanEnded` back through `updateWith`, test-local `planWith` stubs answering a test-local report, and waits on a `ManualResetEventSlim` with a ten-second limit, never a sleep (`StudyFitJobTests`' pattern, step 393): `RunPlan reports each candidate against the total and commits the report once the plan completes`: a stub reporting 1 of 2 and 2 of 2 then answering the report leaves the state `Completed` with that report committed and a progress text starting `2 / 2`; `a cancelled plan keeps the last committed report`: after a completed run, a stub waiting until its observer's cancellation is requested and answering `PlanCancelledErr`, sent `CancelPlan`, leaves the state `Cancelled` with the first report still committed; `a plan that raises ends with PlanRaisedErr carrying its message`: a stub raising `InvalidOperationException \"solver gone\"` ends with `PlanRaisedErr` holding `solver gone`; `RunPlan while a plan runs starts nothing`: a second `RunPlan` while the first stub waits starts no second plan; `the plan environment caches the kit's candidates under .oc/planner, and a read-only kit caches nothing`: `PlanEnvironment.create` over a read-write in-memory kit holding `PlanRunTests`' study runs the real plan to a report and leaves two `.oc/planner/*.candidate-json` files, and over the same folder opened read-only runs it to an equal report, writing nothing.", "acceptance": "After the job lands, `PlanMsg.updateWith` MUST run one plan at a time off the UI thread through the host with per-candidate progress against the total, commit its report on completion, keep the last report on Cancel, hold any other error, and `PlanEnvironment.create` MUST plan the named study's material through the kit's cache; constructor-unit-tests MUST pass, including `RunPlan reports each candidate against the total and commits the report once the plan completes`, `a cancelled plan keeps the last committed report`, `a plan that raises ends with PlanRaisedErr carrying its message`, `RunPlan while a plan runs starts nothing` and `the plan environment caches the kit's candidates under .oc/planner, and a read-only kit caches nothing`, the count rising by 5; ui-smoke MUST pass; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.KitWindowTests", "OpticalConstructor.Ui.Tests.StudyViewTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/OpticalConstructor.Ui.fsproj", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanJobTests.RunPlan reports each candidate against the total and commits the report once the plan completes", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs", "class": "OpticalConstructor.Tests.PlanJobTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-JOB"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanJobTests.a cancelled plan keeps the last committed report", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs", "class": "OpticalConstructor.Tests.PlanJobTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-JOB"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanJobTests.a plan that raises ends with PlanRaisedErr carrying its message", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs", "class": "OpticalConstructor.Tests.PlanJobTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-JOB"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanJobTests.RunPlan while a plan runs starts nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs", "class": "OpticalConstructor.Tests.PlanJobTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-JOB"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanJobTests.the plan environment caches the kit's candidates under .oc/planner, and a read-only kit caches nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanJobTests.fs", "class": "OpticalConstructor.Tests.PlanJobTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-JOB"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MeasurementPlanner.PlannerError", "op": "change_shape", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MeasurementPlanner.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanJobHandle", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanJobHost", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanJobState", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanRequest", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanMsg", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanEnvironment", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}, {"symbol": "OpticalConstructor.Ui.PlanJob.PlanMsg.updateWith", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanJob.fs", "obligations": ["S142-PLAN-JOB"]}], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number": 488, "anchor": "IMPLEMENT", "ac": "AC-S142m", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Tests"], "depends_on": [487], "actions": ["ADD_TEST OpticalConstructor.Tests.PlanWindowModelTests"], "how_to": "The constructor window plans a study's material through a job host its shell carries, and a completed plan's report re-renders the Plan step at once (001 §P `RunPlan`; .spec-md §10.2 per-candidate progress with Cancel, §10.4 completion refresh). It hosts the plan job (step 487) as step 412 hosts the study fit. Each doc is one to three lines citing spec 0050 S14.2. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `KitWindowShell` (steps 186, 201, 412) gains `planRuns : PlanJobHost`, documented in one line, and `KitWindowShell.inert` holds `PlanJobHost.inert`, so every shell built as an update of `inert` keeps its behaviour until the windows compose the real host (step 492). (2) Before `TableAndElementRotationModel`: `PlanSurfaceState = { materialOpt : MaterialVersionId option; criterion : PlanCriterion }`, the Plan step's choices, window state never stored. The model gains `planJob : PlanJobState` and `planSurface : PlanSurfaceState` after `studyFit` (step 412), each documented in one line; `initWith` sets `PlanJobState.idle` and `{ materialOpt = None; criterion = DeterminantPlanCriterion }`. (3) On the model extension holding `studyForwardContext` (step 412), each documented in one line: `member model.planMaterials : OpenedMaterial list`, the chosen study's opened materials whose physics is a crystal (`physics.crystalOpt`, step 460), in study order; `member model.planMaterialOpt : MaterialVersionId option`, `planSurface.materialOpt` when `planMaterials` holds it and otherwise the first of `planMaterials`; and `member model.planReportOpt : PlanReport option`, `planJob.job.committedResults` when its `study` is the chosen study's name and its `material` is `planMaterialOpt`. (4) `TableAndElementRotationMsg` gains, each documented in one line, `StudyPlan of PlanMsg` (the Plan step's run and the job's progress and end), `SetPlanMaterial of MaterialVersionId` (taken when `planMaterials` holds it, else nothing changes) and `SetPlanCriterion of PlanCriterion`; none writes. `StudyPlan msg` is `msg.updateWith (PlanEnvironment.create model.kitShell.planRuns model.kit model.studyForwardContext) model.planJob` (step 487), the model taking the answered state. `RunPlan` is not refused under a read-only kit: it writes no kit file, and a read-only open writes no cache (step 485). No queue, second job or option is added. Tests: new `Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs`, `module PlanWindowModelTests` in `namespace OpticalConstructor.Tests`, appended at the end of the compile list with no comment, over `initInverse` (`TableAndElementRotationView.fs:initInverse`) loaded from an in-memory kit holding `PlanRunTests`' items, its uniaxial version and a study QZ opening it with g11 and g33 unknown, as `StudyWindowModelTests` loads its kit (step 410), the shell's `planRuns` a test-local host recording its jobs and its cancel or `PlanJobHost.posting` as `PlanJobTests` drives it: `RunPlan starts one plan through the shell's host, Cancel cancels it, and a read-only kit plans too`: `StudyPlan (RunPlan { study = QZ; material = <the version>; criterion = DeterminantPlanCriterion })` records one job and leaves `planJob.job.isRunning`; a second `RunPlan` records none; `StudyPlan CancelPlan` records the cancel; over the kit opened read-only a `RunPlan` records one job too. `the Plan step plans the chosen study's opened crystal material, the first by default`: with the study opening a crystal version and a tabulated one (built as step 460's facts build it), `planMaterials` is the crystal one alone and `planMaterialOpt` it; `SetPlanMaterial` of a version the study does not open changes nothing; `SetPlanCriterion TargetTracePlanCriterion` sets the surface's criterion. `a plan's end commits its report, which the Plan step shows for its study and material`: through the posting host, `RunPlan` of QZ's version ends with `planReportOpt` `Some` of a report whose `ranked` holds QZ-Z's two candidates, and choosing another study makes it `None`.", "acceptance": "After the window plans, `StudyPlan` MUST run one plan at a time through the shell's host for the chosen study's crystal material and criterion, under a read-write or read-only kit, and `planReportOpt` MUST show the committed report of that study and material; constructor-unit-tests MUST pass, including `RunPlan starts one plan through the shell's host, Cancel cancels it, and a read-only kit plans too`, `the Plan step plans the chosen study's opened crystal material, the first by default` and `a plan's end commits its report, which the Plan step shows for its study and material`, the count rising by 3; ui-smoke MUST pass; and build, elevation and the twenty-one s46 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.KitWindowTests", "OpticalConstructor.Ui.Tests.StudyViewTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanWindowModelTests.RunPlan starts one plan through the shell's host, Cancel cancels it, and a read-only kit plans too", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs", "class": "OpticalConstructor.Tests.PlanWindowModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-MODEL"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanWindowModelTests.the Plan step plans the chosen study's opened crystal material, the first by default", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs", "class": "OpticalConstructor.Tests.PlanWindowModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-MODEL"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.PlanWindowModelTests.a plan's end commits its report, which the Plan step shows for its study and material", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs", "class": "OpticalConstructor.Tests.PlanWindowModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S142-PLAN-MODEL"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.KitWindowShell.planRuns", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.PlanSurfaceState", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.planJob", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.planSurface", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.planMaterials", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.planMaterialOpt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.planReportOpt", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.StudyPlan", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SetPlanMaterial", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SetPlanCriterion", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S142-PLAN-MODEL"]}], "packages": [], "checks": []}, "section": "S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":489,"anchor":"IMPLEMENT","ac":"AC-S142n","touches":["OpticalConstructor.Ui","OpticalConstructor.Tests"],"depends_on":[488],"how_to":"The plan is emitted into the kit as setups and experiments of role `PlannedRun`, so plan → measure → attach → fit is one object model (001 §M 'a measurement plan emitted as setups + experiments with role `Planned` into the same kit'; 001 §O 'Plan view: … with \"Add to kit\"'; the S14.2 brief). A candidate is added over the window's table as the grid generator adds a combination (step 276), REUSING its body: the candidate's plate goes into the table's Object 1 slot, its experiment is the draft's own commit over the setup (step 275), and the role is set as `SetExperimentRole` sets it (step 294). Each doc is one to three lines citing spec 0050 S14.2. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `GenerateSetupGrid`'s arm body (step 276, which records through step 278's two private functions) becomes a private function of the update taking the grid, the collection to commit from and the role its appended experiments take (`Experiment.withRole`, step 294, before each is recorded) and answering the model with what was written, the setups and the appended experiments; `GenerateSetupGrid grid` calls it with the window's collection and `ScienceRun` and keeps its texts and outcomes, so `SetupModelTests`' facts (step 276) hold unchanged. (2) `TableAndElementRotationMsg` gains `AddPlannedExperiment of PlanCandidate`, documented in one line, refused by step 185's read-only guard and otherwise, in order: the table's Object 1 slot (`ObjectSlotRole (SlotPosition 1)` of `SetupSlot.inLightOrder model.elements`, step 257), none setting `kitStatus` to `Not added — the table has no sample slot.`; the candidate already in the kit (`coverageIn model.kitSetups model.experimentCollection.experiments`, step 482) setting `Not added — <the experiment's name> already plans it.`; the candidate's `capture` not among `availableCaptures model <the slot's id>` (`TableAndElementRotationView.fs:availableCaptures`) setting `Not added — no detector of the table captures the transmitted light of the sample.` (or `reflected`); otherwise the function of (1) over the grid `SetupGrid.create [ { slot = <the slot's id>; choices = [ { itemOpt = Some candidate.plate.item; r1 = Angle.zero } ] } ] model.elements model.kitItems model.tryItemModelChoice` (step 274: a held setup of equal slots is reused, a new one named by the template), the collection whose draft is built from `ExperimentDraft.empty` (`Experiments.fs:ExperimentDraft`) by the draft's own functions — `chooseElement` of the slot's id, its `experimentElementLabel`, `[ VaryR2 ]` and the capture (`Experiments.fs:chooseElement`), `setRange PlanCandidate.incidenceRange`, `addScanAxis` (step 288), `chooseElement` again with `[ VaryR1 ]`, `setRange PlanCandidate.azimuthRange` and `chooseMeasurement candidate.capture` — so its scan is the one block `coverageIn` reads, and `PlannedRun`; then the window's own draft is put back. Success sets `kitStatus` to `Planned <the experiment's name> over <the setup reference's describe>.`; a grid that cannot be made, or a write that fails, keeps step 276's texts (`Not generated — …`, `Not saved to the kit — …`). An added experiment is removed as any experiment is, through the Experiments bay's Remove (step 152), so Add to kit needs no undo of its own (.spec-md §10.5). No other message, field or option is added. Tests, in `PlanWindowModelTests` (step 488), over its kit with the Polarimeter assigned to the inverse table's `det`: `Add to kit records the candidate's setup and a planned experiment sweeping its angles on its branch`: `AddPlannedExperiment` of QZ-Z's transmitted candidate leaves the kit holding a setup whose `sample` slot holds QZ-Z and an experiment over it whose role is `PlannedRun` and whose `coverageIn` answers `CandidateInKit` of it, `kitStatus` starting `Planned `, and the window's draft unchanged. `a candidate the kit already holds is not added again`: adding it again writes no file, leaves the kit's setups and experiments as they were and sets `kitStatus` to `Not added — <the experiment's name> already plans it.`. `a candidate the table cannot capture, or a table with no sample slot, adds nothing, and a read-only kit adds nothing`: the reflected candidate over the default table (`det` on the transmitted beam alone) writes nothing and names the reflected light; a table with its sample removed writes nothing and says `no sample slot`; over the kit opened read-only nothing is written and `kitStatus` is the guard's. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After Add to kit lands, `AddPlannedExperiment` MUST record the candidate's plate in the table's Object 1 slot as a setup and a `PlannedRun` experiment sweeping its R2 then R1 ranges on its branch through the grid generator's own recording, refuse a candidate the kit holds, a branch no detector captures, a table with no sample slot and a read-only kit, and leave `GenerateSetupGrid` unchanged; constructor-unit-tests MUST pass, including `Add to kit records the candidate's setup and a planned experiment sweeping its angles on its branch`, `a candidate the kit already holds is not added again` and `a candidate the table cannot capture, or a table with no sample slot, adds nothing, and a read-only kit adds nothing`, the count rising by 3, and `SetupModelTests` unchanged; ui-smoke MUST pass; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.KitWindowTests","OpticalConstructor.Ui.Tests.StudyViewTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanWindowModelTests.Add to kit records the candidate's setup and a planned experiment sweeping its angles on its branch","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs","class":"OpticalConstructor.Tests.PlanWindowModelTests","discovery_gate":"constructor-unit-tests","obligations":["S142-ADD-TO-KIT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanWindowModelTests.a candidate the kit already holds is not added again","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs","class":"OpticalConstructor.Tests.PlanWindowModelTests","discovery_gate":"constructor-unit-tests","obligations":["S142-ADD-TO-KIT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.PlanWindowModelTests.a candidate the table cannot capture, or a table with no sample slot, adds nothing, and a read-only kit adds nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/PlanWindowModelTests.fs","class":"OpticalConstructor.Tests.PlanWindowModelTests","discovery_gate":"constructor-unit-tests","obligations":["S142-ADD-TO-KIT"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.AddPlannedExperiment","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S142-ADD-TO-KIT"]}],"packages":[],"checks":[]},"section":"S14.2 -- The Planner's numerical layer, the plan, the cache and the Plan view"}
{"number":490,"anchor":"IMPLEMENT","ac":"AC-S142o","touches":["OpticalConstructor.Controls","OpticalConstructor.Ui","OpticalConstructor.Tests","OpticalConstructor.Ui.Tests"],"depends_on":[489],"actions":["ADD_TEST OpticalConstructor.Ui.Tests.PlanViewTests"],"how_to":"The Plan view, its own surface and the flow strip's Plan step between Unknowns and Fit (001 §O 'a left flow strip: Items → Setups → Experiments → Data → Unknowns → Plan → Fit → Results → Publish'; 'Plan view: the recoverability report (rank, confounded combinations, CRB per target)'; 'Automation: … `PlanRunButton`'; the S14.2 brief; .spec-md §3.22: a step appears when it works; .spec-md §10.1 discoverability: the plan view is a flow-strip step, §10.5 opposing pairs on one row). The Plan step is the Inverse constructor's alone, as the study's steps are (step 414); it is a step of the kit window, not a window, so no `WindowFit.keepOnScreen` call is added, and it joins `ScrollExtentTests` (.spec-md §4 'UI'). Each doc is one to three lines citing spec 0050 S14.2. (1) `OpticalConstructor.Ui/TableAndElementRotationView.fs`: `ConstructorFlowStep` (steps 238, 242, 323, 414-418) gains `PlanFlowStep` between `UnknownsFlowStep` and `FitFlowStep`, its `caption` `Plan` and its `flowUiId` `flowPlanStep`; `all` lists Items, Setups, Experiments, Data, Unknowns, Plan, Fit, Results and Publish, and `stepsOf ForwardConstructor` answers `all` without Data and the study's steps, Plan among them. (2) `OpticalConstructor.Controls/UiIds.fs`, a group after the Unknowns step's under `// --- The study's Plan step (PlanView). ---`, each with a one-line doc: `flowPlanStep` (`\"FlowPlanStep\"`), `planPanel` (`\"PlanPanel\"`), `planRunButton` (`\"PlanRunButton\"`, 001 §O), `planCriterionDeterminantChoice` (`\"PlanCriterionDeterminantChoice\"`), `planCriterionTraceChoice` (`\"PlanCriterionTraceChoice\"`), `planProgressBar` (`\"PlanProgressBar\"`), `planProgressText` (`\"PlanProgressText\"`), `planCancelButton` (`\"PlanCancelButton\"`), `planErrorText` (`\"PlanErrorText\"`), `planFindingsList` (`\"PlanFindingsList\"`), `planRankText` (`\"PlanRankText\"`), `planConfoundedList` (`\"PlanConfoundedList\"`), `planBoundsGrid` (`\"PlanBoundsGrid\"`) and `planInstrumentList` (`\"PlanInstrumentList\"`). `OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs`: `planMaterialChoice (version : MaterialVersionId)` is `PlanMaterial_<the GUID>_v<n>`. (3) New `Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanView.fs`, `module OpticalConstructor.Ui.PlanView`, compiled directly after `StudyUnknownsView.fs` (step 414) and before `StudyFitView.fs`: one `<Compile>` line, no comment; its module doc one to three lines citing 001 §O and spec 0050 S14.2. `planView (model : TableAndElementRotationModel) (dispatch : TableAndElementRotationMsg -> unit) : IView`: a `ScrollViewer` scrolling both ways around a vertical `StackPanel` carrying `planPanel`, margin 8, holding `StudyUnknownsView.studyBarView` (step 414) and, for the chosen study, in order: (a) `Material:` and one box per `model.planMaterials` carrying `planMaterialChoice` and its name and version, sending `SetPlanMaterial`, the chosen one an `actionButton` on `positiveBackground` and the others `MaterialsWindowView.verbButton`s (step 241's chosen-option look), or the line `The study opens no crystal material: open one in Unknowns.`; (b) `Rank candidates by:` and the two boxes of `PlanCriterion.text` (`planCriterionDeterminantChoice`, `planCriterionTraceChoice`) sending `SetPlanCriterion`, the chosen one on `positiveBackground`; (c) one horizontal `StackPanel` of `Run plan` (`planRunButton`, an `actionButton` on `positiveBackground`, sending `StudyPlan (RunPlan { study; material = <planMaterialOpt>; criterion })`, present with a material and disabled while the job runs) and, while it runs, with a right margin as the gap, `Cancel` (`planCancelButton`, on `negativeBackground`, sending `StudyPlan CancelPlan`); while it runs a determinate `ProgressBar` carrying `planProgressBar` at the progress's `fraction` and `planJob.job.progressText` in a `TextBlock` carrying `planProgressText` (`JobRunner.fs:JobModel`): progress per candidate, one click with Cancel (.spec-md §10.2, §10.3); (d) `planJob.errorOpt`'s `describe` in a wrapping `TextBlock` carrying `planErrorText`, in `MaterialsWindowView.messageColor`; (e) for `model.planReportOpt`: `What the kit can recover:` and a vertical `StackPanel` carrying `planFindingsList`, one wrapping line per structural finding's `text` (step 469), then `<label>: no principal axis lies on its normal, so the plan places no candidate on it.` per unplaced plate and `The kit has no Mueller polarimeter, so the plan has no candidate.` without one; a `TextBlock` carrying `planRankText`, `Rank <r> of <n> from what the kit holds; condition <κ, two decimals>.` or, below full rank, `Rank <r> of <n> from what the kit holds: <n − r> combination(s) confounded.`; a vertical `StackPanel` carrying `planConfoundedList`, one line per confounded direction's `text` over the report's targets and `Weakest: <its text>` for the weakest; a `Grid` carrying `planBoundsGrid`, four `Auto` columns `Target`, `Value`, `σ` and `σ / value`, a semi-bold header and one row per baseline bound (the value the target's axis reads in `nominal`, invariant culture, `G6`), or the line `No bound yet: what the kit holds leaves a combination confounded.`; and `Instrument states:` with a vertical `StackPanel` carrying `planInstrumentList`, one line per instrument finding's `text` (step 483). The ranked candidates are step 491's. (4) `OpticalConstructor.Ui/KitWindowView.fs`: `PlanFlowStep` shows `PlanView.planView model dispatch` keyed `plan`. Tests. `OpticalConstructor.Ui.Tests/TestAppScope.fs` gains `planKitOver (context : AppContext) (owner : FolderName) : TableAndElementRotationModel` and `planKitIn (owner : FolderName) : TableAndElementRotationModel`, `planKitOver (freshAppContext owner) owner`, each with a one-line doc citing spec 0050 S14.2, the one plan fixture of the UI suite, built as `studyKitIn` builds its kit (step 414): over `context` and a kit from `openedKitIn owner`, a user uniaxial crystal material (n_o 1.544, n_e 1.553, g11 3.0e-5, g33 −1.0e-5, step 355's probe) saved through the context's material store, a plate sample of it, 0.5 mm, `PrimaryAxes`, `EmitBoth`, built as `PlannerInputsTests` builds QZ-Z and saved through the context's sample store, and the items Laser (`PresetIds.heNe633`), QZ-Z (that sample) and Polarimeter (`ItemModelIds.muellerPolarimeterModelId`) recorded through the kit's library (`recordItem`, step 219); the kit is closed, opened again through `KitOpening.openKitAt` and loaded into an Inverse model, the Polarimeter assigned to `det` (`AssignSlot`, step 263), and the study QZ created, the material opened and g11 and g33 freed (`StudyCommand`, `SetOpenedMaterialParameter`, steps 366, 409) at their values within ±50 %. New `OpticalConstructor.Ui.Tests/PlanViewTests.fs`, `module PlanViewTests` in `namespace OpticalConstructor.Ui.Tests`, appended at the end of the compile list with no comment, its screens mounted as `KitWindowTests` mounts `kitWindowView` (step 242). Without a trait: `the plan view UiIds are the stable intent-named ids`: the fourteen fixed ids' texts and `planMaterialChoice` of a test-local version; `the Plan step shows a plan's findings, rank, confounded combinations, bounds and instrument choices`: over `planKitIn` with a plan run through `PlanJobHost.posting` as `PlanJobTests` drives it (step 487), on `PlanFlowStep`, `planFindingsList` holds the off-axis-cut finding, `planRankText` reads `Rank 0 of 2 from what the kit holds: 2 combination(s) confounded.`, `planBoundsGrid` is absent and the no-bound line shown, and `planInstrumentList` holds no line. With trait `ui-smoke`: `pressing Run plan starts one plan through the shell's host, and Cancel cancels it`: with the shell's `planRuns` a test-local host recording its jobs and its cancel, pressing `flowPlanStep` and `planRunButton` records one job and shows `planProgressBar` and `planCancelButton` on the run's row, and pressing `planCancelButton` records the cancel. `KitWindowTests` (steps 414-418): `the flow strip UiIds are the stable intent-named ids` also pins `FlowPlanStep`; `the flow strip shows Items, Setups and Experiments left of the surface its step shows` also finds, in the Inverse window, the Plan box between Unknowns and Fit and, on `PlanFlowStep`, `planPanel`, and in the Main window no Plan box; `a read-only window withholds every write control` finds `planRunButton` present in `planView` over the read-only model (a plan writes no kit file). `KitWindowModelTests` (steps 414-418): `the flow strip's steps follow 001's order and a window opens on Setups` lists Items, Setups, Experiments, Data, Unknowns, Plan, Fit, Results and Publish with their captions; `the Data step is the Inverse constructor's alone, and leaving the Inverse constructor leaves it` also finds `stepsOf ForwardConstructor` without Plan, `ShowFlowStep PlanFlowStep` over `initMain ()` changing nothing, and `SwitchConstructorMode ForwardConstructor` from `PlanFlowStep` answering `ExperimentsFlowStep`. `ScrollExtentTests` gains `the kit window's Plan step leaves everything reachable`: `assertReachable \"KitWindowPlan\"` (`ScrollExtentTests.fs:assertReachable`) over a `HostWindow` running `kitWindowView` over `planKitIn`'s model on `PlanFlowStep` with a completed plan and a running one (its `planJob` started through a test-local host and given one `PlanProgressed`).","acceptance":"After the Plan step lands, the Inverse constructor's flow strip MUST show Plan between Unknowns and Fit and the Main constructor's none, and `planView` MUST offer the study's crystal materials, the two criteria and Run plan with per-candidate progress and Cancel on one row, and show the committed report's findings, rank, confounded combinations, bounds and instrument choices under their `ConstructorUiId`s; constructor-unit-tests MUST pass, including the changed `the flow strip's steps follow 001's order and a window opens on Setups` and `the Data step is the Inverse constructor's alone, and leaving the Inverse constructor leaves it`; ui-smoke MUST pass, including `pressing Run plan starts one plan through the shell's host, and Cancel cancels it`, the count rising by 1; ui-tests MUST pass over the selected classes, including `the plan view UiIds are the stable intent-named ids`, `the Plan step shows a plan's findings, rank, confounded combinations, bounds and instrument choices` and `the kit window's Plan step leaves everything reachable`, the count rising by 3, and the changed `the flow strip UiIds are the stable intent-named ids`, `the flow strip shows Items, Setups and Experiments left of the surface its step shows` and `a read-only window withholds every write control`; and build, elevation and the twenty-one s46 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.KitWindowTests","OpticalConstructor.Ui.Tests.PlanViewTests","OpticalConstructor.Ui.Tests.ScrollExtentTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/PlanView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/OpticalConstructor.Ui.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Ui/KitWindowView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/TestAppScope.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/PlanViewTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OpticalConstructor.Ui.Tests.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs"],"tests":[{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.PlanViewTests.the plan view UiIds are the stable intent-named ids","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/PlanViewTests.fs","class":"OpticalConstructor.Ui.Tests.PlanViewTests","discovery_gate":"ui-tests","obligations":["S142-PLAN-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.PlanViewTests.the Plan step shows a plan's findings, rank, confounded combinations, bounds and instrument choices","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/PlanViewTests.fs","class":"OpticalConstructor.Ui.Tests.PlanViewTests","discovery_gate":"ui-tests","obligations":["S142-PLAN-VIEW"]},{"op":"create","suite":"ui-smoke","id":"OpticalConstructor.Ui.Tests.PlanViewTests.pressing Run plan starts one plan through the shell's host, and Cancel cancels it","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/PlanViewTests.fs","class":"OpticalConstructor.Ui.Tests.PlanViewTests","discovery_gate":"ui-smoke","obligations":["S142-PLAN-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ScrollExtentTests.the kit window's Plan step leaves everything reachable","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs","class":"OpticalConstructor.Ui.Tests.ScrollExtentTests","discovery_gate":"ui-tests","obligations":["S142-PLAN-VIEW"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.KitWindowTests.the flow strip UiIds are the stable intent-named ids","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","obligations":["S142-PLAN-VIEW"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.KitWindowTests.the flow strip shows Items, Setups and Experiments left of the surface its step shows","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","obligations":["S142-PLAN-VIEW"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.KitWindowTests.a read-only window withholds every write control","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","obligations":["S142-PLAN-VIEW"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.KitWindowModelTests.the flow strip's steps follow 001's order and a window opens on Setups","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs","obligations":["S142-PLAN-VIEW"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.KitWindowModelTests.the Data step is the Inverse constructor's alone, and leaving the Inverse constructor leaves it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs","obligations":["S142-PLAN-VIEW"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.ConstructorFlowStep.PlanFlowStep","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S142-PLAN-VIEW"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.ConstructorFlowStep.stepsOf","op":"change_behavior","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S142-PLAN-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.flowPlanStep","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S142-PLAN-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.planPanel","op":"create","path":"Berreman/OpticalConstructor/OpticalConstr