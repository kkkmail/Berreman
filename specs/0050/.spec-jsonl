icalConstructor/OpticalConstructor.Ui.Tests/LibraryWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/LightSourceEditorTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MainWorkbenchTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialEditorWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/MaterialsWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OutOfBandBadgeTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SampleEditorWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SolverHandoffWindowTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/WindowLauncherTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/WorkbenchInfoAndCaptureTests.fs"], "tests": [{"op": "rename", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.LifecycleTests.identical save keeps the current version — unused", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/LifecycleTests.fs", "class": "OpticalConstructor.Tests.LifecycleTests", "discovery_gate": "constructor-unit-tests", "successor": "OpticalConstructor.Tests.LifecycleTests.identical save keeps the current version — unpinned", "obligations": ["S22-PIN"]}, {"op": "rename", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.LifecycleTests.identical save keeps the current version — used", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/LifecycleTests.fs", "class": "OpticalConstructor.Tests.LifecycleTests", "discovery_gate": "constructor-unit-tests", "successor": "OpticalConstructor.Tests.LifecycleTests.identical save keeps the current version — pinned", "obligations": ["S22-PIN"]}, {"op": "rename", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.LifecycleTests.metadata-only edit never versions — unused mutate