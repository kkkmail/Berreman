RIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a data file two copied experiments share is copied once","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a snapshot the kit already holds is kept and not written again","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a copy whose data file the source lacks writes nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a kit opened read-only copies nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.an experiment the source does not hold is refused and nothing is written","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a copy adds the items its experiments use, with their model snapshots","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.an item the kit holds by id, or by model and label, is mapped and not added","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.an added item whose label the kit holds takes the next free label","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.the user's choice overrides the default, and a choice the kit cannot take writes nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.an added item's photo is copied with it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a copy brings the setups its experiments reference, their items mapped onto the kit's","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","class":"OpticalConstructor.Tests.ExperimentCopyTests","discovery_gate":"constructor-unit-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.ExperimentCopyTests.a copied setup the kit holds with the same content is not written again, and one with other content takes the next free name","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentCopyTests.fs","class":"OpticalConstructor.Tests.ExperimentCopyTests","discovery_gate":"constructor-unit-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.OutOfBandDiagnosticTests.requestedWavelengthsOf: a wavelength-sweep experiment requests its range; a dark line is fixed","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/OutOfBandDiagnosticTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupTests.an experiment pins the revision it references, and its slots resolve through the kit's setups","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupTests.fs","class":"OpticalConstructor.Tests.SetupTests","discovery_gate":"constructor-unit-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a commit on a table that is no setup yet records it as the first free setup and references it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a commit over a changed table whose revision an experiment references mints the next revision, and the earlier experiment keeps its own","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a commit over a changed table no experiment references changes the setup in place","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.KitWindowModelTests.copying the chosen experiments brings them into the kit and the window, and closes the source","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.KitWindowModelTests.choosing experiments lists the items they use, each at its default","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.KitWindowModelTests.the user's choice for an item is kept and copied","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.InverseConstructorTests.committed experiments and their attachments are kept in the kit and reopen with it","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/InverseConstructorTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.InverseConstructorTests.a commit, an attach and a removal write the kit's experiment files","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/InverseConstructorTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.InverseConstructorTests.opening a kit re-validates an attachment whose data is unchanged","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/InverseConstructorTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.InverseConstructorTests.opening a kit flags an attachment whose data changed since attach or is missing","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/InverseConstructorTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.InverseConstructorTests.the detector kind selects the ellipsometric load path","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/InverseConstructorTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SolverHandoffWindowTests.an unbound non-sample element yields UnspecifiedElements","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SolverHandoffWindowTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SolverHandoffWindowTests.the detector kind selects the ellipsometric load path","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SolverHandoffWindowTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SolverHandoffWindowTests.init validates every received experiment and carries the collection name","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SolverHandoffWindowTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SolverHandoffWindowTests.an experiment whose setup the collection lacks yields UnspecifiedElements naming the setup","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SolverHandoffWindowTests.fs","class":"OpticalConstructor.Ui.Tests.SolverHandoffWindowTests","discovery_gate":"ui-tests","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ScrollExtentTests.the chart and solver-handoff windows leave everything reachable","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-smoke","id":"OpticalConstructor.Ui.Tests.WireUiFinalCompositionTests.the root window-launcher factory opens and renders Materials, Library, the three editors, and the SolverHandoff","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/WireUiFinalCompositionTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-smoke","id":"OpticalConstructor.Ui.Tests.KitWindowTests.pressing Copy experiments, a toggle and Copy brings the experiment into the kit","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"op":"change_expectation","suite":"ui-smoke","id":"OpticalConstructor.Ui.Tests.KitWindowTests.pressing a mapping choice and Copy adds or maps the item as chosen","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","obligations":["S82-EXPERIMENT-SETUP"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.Experiments.commit","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.Experiments.Experiment.libraryReferences","op":"retire","obligations":["S82-EXPERIMENT-SETUP"],"preserves_obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.Experiments.Experiment.itemsUsedBy","op":"retire","obligations":["S82-EXPERIMENT-SETUP"],"preserves_obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.Setups.Setup.pinFor","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.Setups.Experiment.slotsIn","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.Setups.Experiment.itemsUsedBy","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.ExperimentDataLoad.detectorKindOf","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.ExperimentDataLoad.loadAndValidate","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Domain.KitLibrary.KitLibraryError","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Storage.KitContentFiles.KitLibraryContext.recordExperiment","op":"change_behavior","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Storage.KitContentFiles.ExperimentCopyReport","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Storage.KitContentFiles.KitContext.copyExperimentsFrom","op":"change_behavior","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.experimentSetup","op":"retire","obligations":["S82-EXPERIMENT-SETUP"],"preserves_obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.descriptorBinding","op":"retire","obligations":["S82-EXPERIMENT-SETUP"],"preserves_obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Ui.SolverHandoffView.validateExperiment","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]},{"symbol":"OpticalConstructor.Ui.SolverHandoffView.buildRows","op":"change_shape","obligations":["S82-EXPERIMENT-SETUP"]}],"packages":[],"checks":[]},"section":"S8.2 -- Setups as slots"}
{"number": 262, "anchor": "IMPLEMENT", "ac": "AC-S82h", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Controls", "OpticalConstructor.Tests", "OpticalConstructor.Ui.Tests"], "depends_on": [261], "how_to": "The setup row saves the active setup and shows which setup the table draws (the S8.2 brief: 'the constructor's scene save / load becomes setup save / load'; 'The constructor model keeps the active setup and writes it through KitProxy'; 'editing a setup that an experiment uses mints the next revision'). Each doc is one to three lines citing spec 0050 S8.2. (1) `OpticalConstructor.Ui/TableAndElementRotationView.fs`. (a) `TableAndElementRotationMsg` gains `SaveSetup`, with a one-line doc: write the table over the active setup. (b) Its arm is refused by the read-only guard of step 185 like `CreateSetup`. With `activeSetupOpt = None` it writes nothing and sets `kitStatus` to `No setup is active: create one first.`. With `Some active`, the revised setup is `active.revisedWith (model.elements |> List.map (fun s -> s.recordedWith model.kitItems)) (active.pinFor model.experimentCollection.experiments)` (steps 256, 258 and 261): when it equals `active` nothing is written and `kitStatus` is `Setup '<name>' is unchanged.`; otherwise it is recorded through `recordSetup` (step 260): on `Ok`, `kitSetups` holds it in place of its name's, `activeSetupOpt` is `Some` it and `kitStatus` is `Saved setup '<name>', revision <n>.`; on `Error e` nothing else changes and `kitStatus` is `Not saved to the kit — <e.describe>`. (c) The view: the setup row (step 260) shows first, in a wrapping `TextBlock` carrying `ConstructorUiId.activeSetupText`, `Active setup: <name>, revision <n>` or, with none, `The table is not a setup of the kit yet.`; after `Create setup`, the `workbenchButton` `Save setup` (`ConstructorUiId.saveSetupButton`, dispatching `SaveSetup`), withheld (`availableWorkbenchButton`, step 185) when no setup is active or the kit is open read-only. (2) `OpticalConstructor.Controls/UiIds.fs`, beside step 260's setup-row ids, each with a one-line doc: `activeSetupText` (`\"ActiveSetupText\"`) and `saveSetupButton` (`\"SaveSetupButton\"`). No other message, field or id is added. Tests. `SetupModelTests` (step 260): `SaveSetup writes the active setup in place until an experiment references its revision, then mints the next`: after `CreateSetup` of `Bench` and the polarizer turned (`RotSetAxis (R1, BarDegrees 30.0)`), `SaveSetup` leaves `Bench` at revision 1 holding the turned slots; after `ExpChooseElement` of the polarizer and an `ExpCommit` over it (the table unchanged, so `Bench` stays at revision 1) and the polarizer turned again, `SaveSetup` gives `Bench` revision 2 with revision 1 in its history, the experiment still referencing revision 1, and `kitStatus` `Saved setup 'Bench', revision 2.`. `SaveSetup with no active setup, or over an unchanged table, writes nothing and says why`: with no active setup `SaveSetup` writes no setup file and sets `No setup is active: create one first.`; over an unchanged table it rewrites nothing (the file's bytes are unchanged) and sets `Setup 'Bench' is unchanged.`. `KitWindowModelTests` (step 185): `a kit opened read-only refuses every write message and writes nothing` also sends `SaveSetup` after a setup is active, with the same assertions. `SetupSaveLoadTests` (step 260): `the setup row renders its name field, Create setup and the saved setups` (trait `ui-smoke`) becomes `the setup row renders the active setup, its name field, Create setup, Save setup and the saved setups`, also holding `activeSetupText` and `saveSetupButton`; and `Save setup over a table an experiment uses keeps the earlier revision in the setup's kit file`: through the setup row's buttons and the Experiments bay's commit, a setup created, committed over and then saved changed holds both revisions in its `.setup-json`, read back through `readSetups`. `KitWindowTests` (step 185): `a read-only window withholds every write control` also finds no `saveSetupButton`.", "acceptance": "After Save setup lands, `SaveSetup` MUST write the table over the active setup, in place until an experiment references its revision and as the next revision after, and refuse to write with no active setup, over an unchanged table or under a read-only kit, the setup row showing the active setup; constructor-unit-tests MUST pass, including `SaveSetup writes the active setup in place until an experiment references its revision, then mints the next`, `SaveSetup with no active setup, or over an unchanged table, writes nothing and says why` and `a kit opened read-only refuses every write message and writes nothing`, the count rising by 2; ui-smoke MUST pass, including `the setup row renders the active setup, its name field, Create setup, Save setup and the saved setups`; ui-tests MUST pass over the selected classes, including `Save setup over a table an experiment uses keeps the earlier revision in the setup's kit file` and `a read-only window withholds every write control`, the count rising by 1; and build, elevation and the fifteen s26 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.KitWindowTests", "OpticalConstructor.Ui.Tests.SetupSaveLoadTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupSaveLoadTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.SaveSetup writes the active setup in place until an experiment references its revision, then mints the next", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S82-SAVE-SETUP"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.SaveSetup with no active setup, or over an unchanged table, writes nothing and says why", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S82-SAVE-SETUP"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitWindowModelTests.a kit opened read-only refuses every write message and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "obligations": ["S82-SAVE-SETUP"]}, {"op": "rename", "suite": "ui-smoke", "id": "OpticalConstructor.Ui.Tests.SetupSaveLoadTests.the setup row renders its name field, Create setup and the saved setups", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupSaveLoadTests.fs", "class": "OpticalConstructor.Ui.Tests.SetupSaveLoadTests", "discovery_gate": "ui-smoke", "successor": "OpticalConstructor.Ui.Tests.SetupSaveLoadTests.the setup row renders the active setup, its name field, Create setup, Save setup and the saved setups", "obligations": ["S82-SAVE-SETUP"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.SetupSaveLoadTests.Save setup over a table an experiment uses keeps the earlier revision in the setup's kit file", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupSaveLoadTests.fs", "class": "OpticalConstructor.Ui.Tests.SetupSaveLoadTests", "discovery_gate": "ui-tests", "obligations": ["S82-SAVE-SETUP"]}, {"op": "change_expectation", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.KitWindowTests.a read-only window withholds every write control", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs", "obligations": ["S82-SAVE-SETUP"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SaveSetup", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S82-SAVE-SETUP"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.activeSetupText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S82-SAVE-SETUP"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.saveSetupButton", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S82-SAVE-SETUP"]}], "packages": [], "checks": []}, "section": "S8.2 -- Setups as slots"}
{"number":263,"anchor":"IMPLEMENT","ac":"AC-S82i","touches":["OpticalConstructor.Ui","OpticalConstructor.Tests"],"depends_on":[262],"how_to":"Putting a kit item into a slot of the table, as a semantic message (001 §P `AssignSlot`; 001 §J 'each holding an item or nothing'; the S8.2 brief: 'Placing an element binds a slot … Messages CreateSetup, AssignSlot and SwapSlot are pure updates with tests'). Each doc is one to three lines citing spec 0050 S8.2. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) On the model extension holding `itemModelCaption` (step 241): `member model.tryItemModelChoice (item : Item) : ItemModelChoice option`, the model as the window's stores resolve it: a `PresetInstance (modelVersion, id)` whose `model.library.tryGetEntry id` answers a `SourceItem` or a `PolarizerItem` is its `SourcePresetChoice` or `PolarizerPresetChoice`; a `SampleInstance (modelVersion, v)` whose `model.samples.resolveVersion v` answers a sample is `StackSampleChoice (sampleModel, v, sample)`; an `ItemModelVersionInstance v` whose `model.itemModels.resolveItemModelVersion v` answers a version is its `LibraryModelChoice` (step 216); anything else, `None` or an error, is `None`. `itemModelCaption` becomes the resolved choice's `caption` (step 241) or `(model not in the library)`, its three store reads replaced by this one resolution, so its texts are unchanged. (2) `TableAndElementRotationMsg` gains `AssignSlot of Library.ElementId * ItemId option`, with a one-line doc: put a kit item, or nothing, into that slot of the table. (3) Its arm writes nothing, so a read-only kit takes it too. A slot id the table lacks sets `kitStatus` to `Not assigned — <describe>` of `UnknownSetupSlotErr` naming it. `None` makes the slot `withoutItem` (step 258). `Some id` takes the item of that id in `kitItems` (else `UnknownSlotItemErr` naming the id) and its `tryItemModelChoice` (else `UnknownSlotItemErr` naming the item's label and that its model is not in the library), and the slot becomes `slot.withItem item choice` (step 258); a refusal sets `kitStatus` to `Not assigned — <e.describe>` and changes nothing else; on success the slot is replaced in `elements` and `kitStatus` is `None`. The setup records the slot at the next CreateSetup, SaveSetup or commit (steps 260-262). No other message, field or option is added. Tests, in `SetupModelTests` (step 260), whose kit holds items added through `AddItem` (step 239): `LP1` (the `PresetIds.polarizerLp` preset, `FixedMounting`), `QZ` (the glass plate at version 1), `Laser` (the HeNe preset) and `LPd` (that polarizer preset, `DialMounted DialNegative`, its `dialZero` set to 10° through `SetParameterState`, step 240). `AssignSlot puts a kit item into a table slot bound to its library entry, and AssignSlot of nothing empties it`: with a linear polarizer and a sample added, `AssignSlot (polarizer, Some LP1)` holds `ItemInSlot (LP1, PlacementTurn)` bound to the preset, `AssignSlot (sample, Some QZ)` binds the glass plate with its supported emission, and `AssignSlot (polarizer, None)` holds `EmptySlotContent` with the binding kept; no kit file changes. `AssignSlot of an item that does not fit the slot, that the kit lacks, or whose model the library lacks is told and changes nothing` : `Laser` into the polarizer slot sets a `kitStatus` starting `Not assigned` and naming `Laser`; an id the kit lacks, a slot id the table lacks, and a test-local item put in `kitItems` whose sample version the store lacks each do so too, and `elements` are unchanged. `a dial-mounted item is recorded with its reading and drawn through its current zero`: `LPd` assigned to the polarizer at R1 30° and `CreateSetup` of `Dial` write a `DialTurn` of −20° (10° − 30°); after `LPd`'s `dialZero` is set to 20°, `ActivateSetup (SetupName \"Dial\")` draws the polarizer at R1 40°, within 1e-12. `ItemsPanelModelTests` and `ItemsPanelTests`' facts on the model caption pass unchanged. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved. tryItemModelChoice MUST first resolve modelVersion for every instance and validate its form. Only then MAY it resolve the preset/sample dependency and construct the choice with that model version. An unresolved model MUST return None even when the preset/sample resolves. The slot assignment tests MUST exercise this refusal and a successful snapshot-only reopen.","acceptance":"After AssignSlot lands, `model.tryItemModelChoice` MUST resolve an item's model through the window's stores, `itemModelCaption` MUST read it, and `AssignSlot` MUST put a fitting kit item into a table slot bound to its library entry, empty a slot, and refuse an item that does not fit or is unavailable, writing nothing; constructor-unit-tests MUST pass, including `AssignSlot puts a kit item into a table slot bound to its library entry, and AssignSlot of nothing empties it`, `AssignSlot of an item that does not fit the slot, that the kit lacks, or whose model the library lacks is told and changes nothing` and `a dial-mounted item is recorded with its reading and drawn through its current zero`, the count rising by 3; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, the count unchanged; and build, elevation and the fifteen s26 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.ItemsPanelTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.AssignSlot puts a kit item into a table slot bound to its library entry, and AssignSlot of nothing empties it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S82-ASSIGN-SLOT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.AssignSlot of an item that does not fit the slot, that the kit lacks, or whose model the library lacks is told and changes nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S82-ASSIGN-SLOT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a dial-mounted item is recorded with its reading and drawn through its current zero","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S82-ASSIGN-SLOT"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.tryItemModelChoice","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S82-ASSIGN-SLOT"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.itemModelCaption","op":"change_behavior","obligations":["S82-ASSIGN-SLOT"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.AssignSlot","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S82-ASSIGN-SLOT"]}],"packages":[],"checks":[]},"section":"S8.2 -- Setups as slots"}
{"number": 264, "anchor": "IMPLEMENT", "ac": "AC-S82j", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Tests"], "depends_on": [263], "how_to": "The quick swap as a semantic message: another item into one slot is another setup, an existing one or a new one (001 §J 'Quick swap: … choosing one is either a new setup or an existing one'; 001 §P `SwapSlot`; the S8.2 brief). The slot bar that sends it is S8.4's. Each doc is one to three lines citing spec 0050 S8.2. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `TableAndElementRotationMsg` gains `SwapSlot of Library.ElementId * ItemId`, with a one-line doc: the table as the setup that holds this item in that slot. (2) Its arm resolves the slot, the item and its choice and refuses as `AssignSlot` does (step 263), with `Not swapped — <e.describe>`. The swapped slots are the table's with that slot `withItem item choice` (step 258), each `recordedWith model.kitItems`; the fresh name is `active.name.nextFreeAmong` the kit's setup names for `activeSetupOpt = Some active` and `SetupName.firstFree` of them otherwise (step 255). `Setup.swapTarget swapped model.kitSetups fresh` (step 258): `SwitchToHeldSetup s` is `ActivateSetup s.name`'s update (step 260) and writes nothing, so a read-only kit takes it; `CreateSwappedSetup s` is refused by the read-only guard of step 185, and otherwise recorded through `recordSetup` (step 260): on `Ok`, `kitSetups` holds it in name order, `activeSetupOpt` is `Some s`, `elements` are the swapped slots and `kitStatus` is `Created setup '<name>' by the swap.`; on `Error e` nothing else changes and `kitStatus` is `Not saved to the kit — <e.describe>`. The setup swapped from is never written. No other message, field or option is added. Tests, in `SetupModelTests` (steps 260, 263), whose kit holds `QZ` (the glass plate at version 1) and `QZ2` (the 2 mm plate at version 1) and a table of a source, a sample and the seeded detector: `SwapSlot switches to the kit's setup that holds the swapped content and writes nothing`: with `Bench A` created holding `QZ` and `Bench B` holding `QZ2` (each through `AssignSlot` then `CreateSetup`), and `Bench A` made active again (`ActivateSetup`), `SwapSlot (sample, QZ2)` makes `Bench B` active and the table its slots, and no kit file's bytes change. `SwapSlot to content no setup holds creates and activates a setup of the next free name, leaving the swapped-from setup as it was`: with only `Bench A` held and active, `SwapSlot (sample, QZ2)` writes `Bench A (2).setup-json` holding `QZ2` at revision 1, makes it active, and `Bench A`'s file is unchanged; from a table that is no setup yet, the swap creates `Setup 1`. `a kit opened read-only switches setups by a swap but creates none`: over the folder reopened read-only, the swap to `Bench B` switches, and the swap to new content sets `kitStatus` to `The kit is open read-only: nothing is saved.` and leaves the table, `kitSetups` and every file as they were.", "acceptance": "After SwapSlot lands, `SwapSlot` MUST switch to the kit's setup holding the swapped content without writing, and otherwise create, record and activate a setup of the next free name, never writing the setup swapped from and creating nothing under a read-only kit; constructor-unit-tests MUST pass, including `SwapSlot switches to the kit's setup that holds the swapped content and writes nothing`, `SwapSlot to content no setup holds creates and activates a setup of the next free name, leaving the swapped-from setup as it was` and `a kit opened read-only switches setups by a swap but creates none`, the count rising by 3; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, the count unchanged; and build, elevation and the fifteen s26 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.SetupSaveLoadTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.SwapSlot switches to the kit's setup that holds the swapped content and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S82-SWAP-SLOT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.SwapSlot to content no setup holds creates and activates a setup of the next free name, leaving the swapped-from setup as it was", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S82-SWAP-SLOT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.a kit opened read-only switches setups by a swap but creates none", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S82-SWAP-SLOT"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SwapSlot", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S82-SWAP-SLOT"]}], "packages": [], "checks": []}, "section": "S8.2 -- Setups as slots"}
{"number":265,"anchor":"IMPLEMENT","ac":"AC-S82k","touches":["OpticalConstructor.Ui","OpticalConstructor.Ui.Tests"],"depends_on":[264],"how_to":"The run law reads the setup's slots: a slot holding an item is evaluated through that item's model and its own parameters (the S8.2 brief: 'S8.1's run law reads the setup's slots in light order'; 001 §N 'One item-model evaluator'; the S8.1 mapper's request: Prep and Analyzer slots become `ElementStep`s and Object slots `ObjectStep`s through `ItemModelChoice.boundWith` / `BoundOpticalElement.muellerAt` at the slot's R1, its drawn incidence and its path branch). Each doc is one to three lines citing spec 0050 S8.2. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `chartForRun` (`TableAndElementRotationView.fs:chartForRun`, as step 252 left it): a path step's element whose `content` is `ItemInSlot (id, _)` is built from the item of that id in `kitItems`, its `tryItemModelChoice` (step 263) and `choice.boundWith model.materials (ParameterValues.ofParameters item.parameters)` (steps 245, 251), bound once per path step, and evaluated by `muellerAt` at each point exactly as step 252 evaluates a bound preset or sample: `{ rotation = its R1, or the swept x when its R1 is varied; incidence = its drawn incidence, or the swept x under VaryR2; branch = the path step's branch }` and the point's wavelength. It is an `ObjectStep` for a `Sample` slot and an `ElementStep` for any other. Its R1 is the drawn one, which a dial reading set (step 258's `drawnWith`). An evaluation error shows step 252's failure chart, `The run cannot be evaluated` with the error's `describe`, `SampleMaterialErr` keeping its own title; an item the kit lacks, or whose model does not resolve, shows that chart with the `describe` of `UnknownSlotItemErr` naming it (step 255). A slot of `EmptySlotContent` is built from its library binding exactly as step 252 builds it. (2) `model.objectIds` (step 254) answers the `Sample` slots that hold an item or are bound to a library sample, in table order, so a sample item is an object of the capture rule. (3) `chartForRun`'s no-analyzer check (`noPolarizerOnPath`) counts a polarizer slot that holds an item as a polarizer, and its 'nothing bound to the varied element' check passes a varied slot that holds an item. Each doc says so in one to three lines citing spec 0050 S8.2. Nothing else changes: with no item in any slot every chart is step 252's, so `FsxAcceptanceTests` and the chart classes run as they are. Tests, in `ExperimentControlsTests` (step 252), each over `initMain ()` with items added through `AddItem` (step 239) and put in slots through `AssignSlot` (step 263), at 600 nm with the seeded intensity detector: `a slot's item is run through its own parameters: a real polarizer item's leakage passes crossed light`: a linear polarizer at R1 0° bound to its preset in front of a second linear polarizer holding a real-LP item (`ItemModelIds.realLinearPolarizerModelId`, `ExtinctionRatioLeakage`) whose `extinctionRatio` is set to 0.01 (`SetParameterState`, step 240), the second varied over R1 0 … 180° in 5 points: each S₀ equals that of the item's `BoundOpticalElement.ofOpticalForm` at the point's rotation applied to `Propagation.inputStokes IdealLinear (0°)` within 1e-12, and at 90° it is above 1e-4 while the same table with the preset in place of the item reads below 1e-12. `a sample item is solved at its own thickness, as the item evaluator solves it`: a sample holding a glass-plate item (`SampleIds.glassPlate1mmId` at version 1) whose `substrate.thickness` is set to 2e-3 m, varied over R2 0 … 60° in 7 points with capture T: each S₀ equals that of `BoundOpticalElement.ofStackSample` over the item's values (step 249) on `BranchTransmitted` at the point's incidence, spin 0, applied to `Propagation.unpolarizedStokes`, within 1e-12. `a dial-mounted item is run at the angle its reading draws`: behind a first linear polarizer bound to its preset, a second polarizer at R1 30° holding a `DialMounted DialNegative` item of the linear-polarizer preset whose `dialZero` is 10° (so its reading is −20°, step 258) is recorded by `CreateSetup`; the item's `dialZero` is then set to 20° and the setup activated (`ActivateSetup`, step 260), which draws the second polarizer at R1 40°; the chart of a sweep of the first polarizer over R1 0 … 90° in 4 points equals, within 1e-12, that of a table whose second polarizer is the bare preset at R1 40°. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the run law reads the slots' items, `chartForRun` MUST evaluate a slot holding an item through the item's model and parameters at its drawn orientation, as an object for a sample slot, `model.objectIds` MUST count sample items, and every chart with no item MUST be unchanged; constructor-unit-tests MUST pass; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, including `a slot's item is run through its own parameters: a real polarizer item's leakage passes crossed light`, `a sample item is solved at its own thickness, as the item evaluator solves it` and `a dial-mounted item is run at the angle its reading draws`, the count rising by 3; and build, elevation and the fifteen s26 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.ElementMenuTests","OpticalConstructor.Ui.Tests.ExperimentControlsTests","OpticalConstructor.Ui.Tests.FsxAcceptanceTests","OpticalConstructor.Ui.Tests.InverseConstructorTests","OpticalConstructor.Ui.Tests.MainWorkbenchTests","OpticalConstructor.Ui.Tests.WorkbenchInfoAndCaptureTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs"],"tests":[{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ExperimentControlsTests.a slot's item is run through its own parameters: a real polarizer item's leakage passes crossed light","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs","class":"OpticalConstructor.Ui.Tests.ExperimentControlsTests","discovery_gate":"ui-tests","obligations":["S82-RUN-SLOT-ITEMS"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ExperimentControlsTests.a sample item is solved at its own thickness, as the item evaluator solves it","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs","class":"OpticalConstructor.Ui.Tests.ExperimentControlsTests","discovery_gate":"ui-tests","obligations":["S82-RUN-SLOT-ITEMS"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ExperimentControlsTests.a dial-mounted item is run at the angle its reading draws","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs","class":"OpticalConstructor.Ui.Tests.ExperimentControlsTests","discovery_gate":"ui-tests","obligations":["S82-RUN-SLOT-ITEMS"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.chartForRun","op":"change_behavior","obligations":["S82-RUN-SLOT-ITEMS"]}],"packages":[],"checks":[]},"section":"S8.2 -- Setups as slots"}
{"number":266,"anchor":"IMPLEMENT","ac":"AC-S82l","touches":["OpticalConstructor.Ui","OpticalConstructor.Ui.Tests"],"depends_on":[265],"how_to":"The source slot's item is the run's source: it emits its own Stokes state times its intensity scale (001 §N 'The source is real: a source item with a Stokes state and an intensity scale'; the S8.1 mapper's request: the source slot's item emits through `emissionWith (ParameterValues.ofParameters item.parameters)`; step 252 (c): every chart reads the default parameter set until S8.2's source slot gives a source item's own values). Each doc is one to three lines citing spec 0050 S8.2. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) On the model extension holding `tryItemModelChoice` (step 263): `member model.runEmission : Result<SourceEmission, ControlCaption>`, the error being the text the failure chart shows. For the first `LightSource` slot of the table holding an item whose `tryItemModelChoice` resolves, it is `choice.emissionWith (ParameterValues.ofParameters item.parameters)` (step 246), an `ItemEvaluationError` answering its `describe`; for such a slot whose item the kit lacks or whose model does not resolve, the `describe` of `UnknownSlotItemErr` naming it (step 255); and otherwise `SourceEmission.ofValues (ParameterValues.defaultsOf SourcePreset.lightSourceAxes)`, step 252's default. (2) `chartForRun` reads every point with `model.runEmission` where it read the default emission, an `Error text` showing step 252's `The run cannot be evaluated` chart with that text. The wavelength stays the bound preset's (`TableAndElementRotationView.fs:boundSource`), because a source item's slot is bound to its preset (step 258). Each doc says so in one to three lines citing spec 0050 S8.2. With no source item every chart is step 252's. Tests, in `ExperimentControlsTests`, over `initMain ()` whose source slot holds a `Laser` item of the HeNe preset (`AddItem`, `AssignSlot`), with one linear polarizer bound to its preset between it and the seeded intensity detector, varied over R1 0 … 180° in 7 points: `a source item emits its own polarization through the run`: with `degreeOfPolarization` 1 and `azimuth` 30° (`SetParameterState`, step 240) each S₀ is 1 + cos(2(x − 30°)) within 1e-12 (the polarizer is the intensity reference, r = 2, step 252), and with the item's defaults each S₀ is 1, as the default source reads. `a source item whose parameters the run cannot evaluate shows that the run cannot be evaluated`: with `degreeOfPolarization` set to 1.5 the chart's title is `The run cannot be evaluated` and its description names `degreeOfPolarization` (`ParameterOutOfRangeErr`, step 245). All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the source slot emits, `model.runEmission` MUST be the source item's emission through `emissionWith` over its own parameters, the default parameter set without one, and `chartForRun` MUST read with it; constructor-unit-tests MUST pass; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, including `a source item emits its own polarization through the run` and `a source item whose parameters the run cannot evaluate shows that the run cannot be evaluated`, the count rising by 2; and build, elevation and the fifteen s26 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.ElementMenuTests","OpticalConstructor.Ui.Tests.ExperimentControlsTests","OpticalConstructor.Ui.Tests.FsxAcceptanceTests","OpticalConstructor.Ui.Tests.InverseConstructorTests","OpticalConstructor.Ui.Tests.MainWorkbenchTests","OpticalConstructor.Ui.Tests.WorkbenchInfoAndCaptureTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs"],"tests":[{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ExperimentControlsTests.a source item emits its own polarization through the run","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs","class":"OpticalConstructor.Ui.Tests.ExperimentControlsTests","discovery_gate":"ui-tests","obligations":["S82-SOURCE-SLOT"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.ExperimentControlsTests.a source item whose parameters the run cannot evaluate shows that the run cannot be evaluated","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ExperimentControlsTests.fs","class":"OpticalConstructor.Ui.Tests.ExperimentControlsTests","discovery_gate":"ui-tests","obligations":["S82-SOURCE-SLOT"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.runEmission","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S82-SOURCE-SLOT"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.chartForRun","op":"change_behavior","obligations":["S82-SOURCE-SLOT"]}],"packages":[],"checks":[]},"section":"S8.2 -- Setups as slots"}
{"number": 267, "anchor": "IMPLEMENT", "ac": "AC-S83a", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Storage", "OpticalConstructor.Tests"], "depends_on": [266], "how_to": "The naming template becomes a field of the kit file, stored as the text the lab writes (001 §J 'Naming template: each kit carries one (e.g. `{source}-({obj1}#{phi1}-{obj2}#{phi2})-{analyzer}-{note}`)'; 001 §A 'the kit: id, name, author, notes, naming template, import profiles, sendExclude'; step 122: 'S8.3 adds the naming template'). The grammar, the reading and the writing are steps 268-271's; this step adds the stored shape and its default. Each doc is one to three lines citing spec 0050 S8.3. (1) `OpticalConstructor.Domain/Kit.fs`, directly before `KitFile` (step 122): `NamingTemplate of string` with `.value`, the kit's naming template as its text, and `static member standard : NamingTemplate`, which is `NamingTemplate \"{source}-({obj1}#{phi1}-{obj2}#{phi2})-{analyzer}-{note}\"`: 001 §J's template, the one place that text is written, every new kit's template and the grammar of the reference pipeline's labels (step 270). It is not validated here: the grammar is `NamingTemplates.fs`'s (step 268), and every use of a template answers a `Result`. (2) `KitFile` gains `namingTemplate : NamingTemplate` after `sendExclude`, and `KitFile.create` sets it to `NamingTemplate.standard`, so `KitFolder.namedKitFile` (step 145) and `scratchKit` (step 150), which call `create`, take it with no change. The shared serializer options unwrap a single-case union (`ProjectJson.fs:142`, `WithUnionUnwrapSingleCaseUnions`, moved into `CanonicalJson.fs` by step 21), so the template is written as a JSON string. (3) `OpticalConstructor.Storage/schema/kit.schema.json` (step 124): under `if` `schemaVersion` is 1, `namingTemplate` joins the required keys and the properties as a string, and `additionalProperties: false` stays. The schema version stays 1: kit files of the old shape exist only under test output folders (.spec-md §7: kit file shapes change in later parts and no migration is needed). No up-converter, default-on-read or other member is added. Tests. In `KitTests` (step 122): `a kit's naming template keeps its text, and a new kit takes the standard one`: `(NamingTemplate \"{obj1}\").value` is `{obj1}`, `NamingTemplate.standard.value` is `{source}-({obj1}#{phi1}-{obj2}#{phi2})-{analyzer}-{note}`, and `KitFile.create` over step 122's id, name, author and instant holds `NamingTemplate.standard`. In `KitFileJsonTests` (step 124), whose kit file now also holds `namingTemplate = NamingTemplate \"{source:CPL1=CPL,LP1=LP}-({obj1}#{phi1})-{analyzer:CPL2=CPL}\"`: `a kit file round-trips through its canonical text` lists the top-level keys `author`, `created`, `id`, `modified`, `name`, `namingTemplate`, `notes`, `schemaVersion` and `sendExclude` in that order and writes the template's text verbatim as the string value of `namingTemplate`; `a schema-invalid or malformed kit file is refused before it binds` also refuses the text without `namingTemplate`, and with `namingTemplate` set to the number `7`, each with `SchemaValidationErr`. Every other kit-file fact passes unchanged.", "acceptance": "After the kit file gains its naming template, `NamingTemplate` MUST exist in `Kit.fs` with `NamingTemplate.standard` holding 001 §J's text, `KitFile` MUST carry `namingTemplate`, `KitFile.create` MUST set the standard template and `kit.schema.json` MUST require it as a string; constructor-unit-tests MUST pass, including `a kit's naming template keeps its text, and a new kit takes the standard one` and the changed `a kit file round-trips through its canonical text` and `a schema-invalid or malformed kit file is refused before it binds`, the count rising by 1; and build, elevation and the fifteen s27 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/Kit.fs", "Berreman/OpticalConstructor/OpticalConstructor.Storage/schema/kit.schema.json", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitFileJsonTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitTests.a kit's naming template keeps its text, and a new kit takes the standard one", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitTests.fs", "class": "OpticalConstructor.Tests.KitTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-KIT-TEMPLATE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitFileJsonTests.a kit file round-trips through its canonical text", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitFileJsonTests.fs", "obligations": ["S83-KIT-TEMPLATE"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitFileJsonTests.a schema-invalid or malformed kit file is refused before it binds", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitFileJsonTests.fs", "obligations": ["S83-KIT-TEMPLATE"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.Kit.NamingTemplate", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/Kit.fs", "obligations": ["S83-KIT-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.Kit.KitFile", "op": "change_shape", "obligations": ["S83-KIT-TEMPLATE"]}], "packages": [], "checks": []}, "section": "S8.3 -- The naming template and the grid generator"}
{"number":268,"anchor":"IMPLEMENT","ac":"AC-S83b","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[267],"actions":["ADD_TEST OpticalConstructor.Tests.NamingTemplateTests"],"how_to":"The naming template's grammar as pure Domain: the pieces a template's text holds, and the refusal of a text that is none (001 §J 'Naming template … It names setups and experiments, and PARSES names back to match imported data'; .spec-md §5 'Setup, SetupName, slots, NamingTemplate'). The template speaks the polarimeter's words, as 001 §J's example and 001 §O's experiment matrix ('rows source × objects × φ, columns analyzer') do: the source is the polarization source, S8.2's Prep slots (step 257), and the light is the light source, S8.2's Source slot; this is what makes 001's example name a setup whose Prep 1 holds `CPL1` `CPL-(…)-CPL`, as 001 §A's kit layout does. Each doc is one to three lines citing spec 0050 S8.3. (1) New `OpticalConstructor.Domain/NamingTemplates.fs`: `module NamingTemplates` in `namespace OpticalConstructor.Domain`, compiled directly after `Setups.fs` (step 256), because a placeholder names a `SlotRole` (step 257): one `<Compile Include=\"NamingTemplates.fs\" />` line in `OpticalConstructor.Domain.fsproj` and no comment. Its module doc is one to three lines: the kit's naming template, its grammar, and the names it writes and reads (spec 0050 S8.3). It opens `Kit` and `Setups`. (2) `NamePart of string` with `.value`: one piece of text a name holds (an item's name, the note, or the literal text between placeholders). (3) `NameAlias = { label : ItemLabel; part : NamePart }`: in its placeholder, the kit item of that label is written as `part` (001 §A: the items `CPL1` and `CPL2` of a kit whose setups are named `CPL-(QZ#45-LR#45)-CPL`). (4) `PlaceholderNeed` = `RequiredPlaceholder` | `OptionalPlaceholder`. (5) `TemplatePlaceholder` = `SlotPlaceholder of SlotRole` | `AnglePlaceholder of SlotPosition` | `NotePlaceholder`. `member this.text : string` is the placeholder's word with its number: `light` (`SourceSlotRole`), `source<k>` (`PrepSlotRole k`), `obj<k>` (`ObjectSlotRole k`), `analyzer<k>` (`AnalyzerSlotRole k`), `detector<k>` (`DetectorSlotRole k`), `phi<k>` (the angle of Obj k) and `note`. `member this.need : PlaceholderNeed` is `OptionalPlaceholder` for a slot or angle of position 2 or more and for the note, and `RequiredPlaceholder` for `light` and for the first slot of each role and its angle. A placeholder is never stored apart from the template's text, so it carries no wire tag. (6) `TemplateValue = { placeholder : TemplatePlaceholder; aliases : NameAlias list }` and `TemplatePiece` = `LiteralPiece of NamePart` | `ValuePiece of TemplateValue`. (7) `NamingTemplateError`, an `*Error` union whose every case is `of reason : string` naming the template's text, the placeholder or the name: `TemplateSyntaxErr` (a brace without its partner, a word or number that names no placeholder, a malformed alias, or an alias on an angle or the note), `DuplicatePlaceholderErr` (one placeholder twice, `{source}` with `{source1}` included), `AdjacentPlaceholdersErr` (two placeholders with no text between them, which no name could tell apart), `DuplicateAliasErr` (one placeholder aliasing one label twice, ignoring case, or two labels as one part), `MissingNameValueErr` (a required placeholder holds nothing, steps 269 and 271), `NameMismatchErr` (a name the template does not fit, step 269) and `UnknownNameItemErr` (a part names no kit item, step 271); `member this.describe : string` renders them `the naming template is not valid: <reason>`, `the naming template names a placeholder twice: <reason>`, `the naming template has two placeholders with nothing between them: <reason>`, `the naming template aliases an item twice: <reason>`, `the name has nothing for a placeholder it needs: <reason>`, `the name does not fit the naming template: <reason>` and `the name names no item of the kit: <reason>`. (8) `type NamingTemplate with`: `member this.pieces : Result<TemplatePiece list, NamingTemplateError>` reads the text left to right. Text outside braces is a `LiteralPiece` (a run of it is one piece, and an empty one is never made). A `{` opens a placeholder that runs to the next `}` and holds a word (`light`, `source`, `obj`, `phi`, `analyzer`, `detector` or `note`), then an optional number (ASCII digits not starting with `0`; `light` and `note` take none; no number is 1, so `{source}` is Prep 1 and `{analyzer}` is Analyzer 1), then, after a `:`, a comma-separated list of `label=part` aliases, each label and part non-empty and holding none of `{`, `}`, `:`, `=` and `,`, the label made by `ItemLabel.tryCreate` (step 213), aliases being allowed on a slot placeholder only. A `}` outside a placeholder or a `{` inside one is `TemplateSyntaxErr`. It then refuses a placeholder that appears twice, two `ValuePiece`s with no `LiteralPiece` between them, and an alias list that repeats a label (its text ignoring case) or a part. `static member tryCreate (text : string) : Result<NamingTemplate, NamingTemplateError>` answers `NamingTemplate text` when its `pieces` answer `Ok`, and their error otherwise. The scanning is done by locals inside these members, so no module-level signature carries a primitive (ELEV003P, ELEV010P). No regular expression, cache or other member is added. Tests: new `OpticalConstructor.Tests/NamingTemplateTests.fs`, `module NamingTemplateTests` in `namespace OpticalConstructor.Tests`, appended at the end of `OpticalConstructor.Tests.fsproj`'s compile list with no comment. `the standard template is the lab's: the source, two objects at their angles, the analyzer and the note`: `NamingTemplate.standard.pieces` answers, in order, the values `SlotPlaceholder (PrepSlotRole (SlotPosition 1))`, then `ObjectSlotRole 1`, `AnglePlaceholder 1`, `ObjectSlotRole 2`, `AnglePlaceholder 2`, `AnalyzerSlotRole 1` and `NotePlaceholder`, none with an alias, with the literals `-(`, `#`, `-`, `#`, `)-` and `-` between them; Prep 1, Obj 1, its angle and Analyzer 1 are `RequiredPlaceholder`, and Obj 2, its angle and the note `OptionalPlaceholder`. `a placeholder without a number names the first slot of its role, and each role has its word`: the pieces of `{light}/{source2}/{obj3}/{phi3}/{analyzer}/{detector2}/{note}.csv` hold, between the literals `/` and ending with `.csv`, the placeholders `SourceSlotRole`, `PrepSlotRole 2`, `ObjectSlotRole 3`, `AnglePlaceholder 3`, `AnalyzerSlotRole 1`, `DetectorSlotRole 2` and `NotePlaceholder`, whose `text`s are `light`, `source2`, `obj3`, `phi3`, `analyzer1`, `detector2` and `note`. `an alias writes a kit item under another name in its placeholder`: `{source:CPL1=CPL,LP1=LP}` holds `PrepSlotRole 1` with the aliases `CPL1` as `CPL` and `LP1` as `LP`, in that order. `a text that is no naming template is refused with its reason`: `{sauce}`, `{obj0}`, `{obj01}`, `{light1}`, `{obj1`, `obj1}`, `{ob{j1}`, `{phi1:A=B}`, `{note:A=B}`, `{source:CPL1}` and `{source:=CPL}` answer `TemplateSyntaxErr`; `{source}-{source1}` `DuplicatePlaceholderErr`; `{obj1}{phi1}` `AdjacentPlaceholdersErr`; `{source:CPL1=CPL,cpl1=C}` and `{source:A=CPL,B=CPL}` `DuplicateAliasErr`; `tryCreate` of each answers the same error, and `tryCreate` of the standard text answers `NamingTemplate.standard`. `every naming template error renders its condition and its payload`: each case over a distinct test-local reason renders a distinct text holding it.","acceptance":"After the grammar lands, `NamingTemplates.fs` MUST hold `NamePart`, `NameAlias`, `PlaceholderNeed`, `TemplatePlaceholder`, `TemplateValue`, `TemplatePiece` and `NamingTemplateError`, `NamingTemplate.pieces` MUST read 001 §J's template into its values and literals and `tryCreate` MUST refuse every malformed text with its typed error; constructor-unit-tests MUST pass, including `the standard template is the lab's: the source, two objects at their angles, the analyzer and the note`, `a placeholder without a number names the first slot of its role, and each role has its word`, `an alias writes a kit item under another name in its placeholder`, `a text that is no naming template is refused with its reason` and `every naming template error renders its condition and its payload`, the count rising by 5; and build, elevation and the fifteen s27 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.the standard template is the lab's: the source, two objects at their angles, the analyzer and the note","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-TEMPLATE-GRAMMAR"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.a placeholder without a number names the first slot of its role, and each role has its word","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-TEMPLATE-GRAMMAR"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.an alias writes a kit item under another name in its placeholder","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-TEMPLATE-GRAMMAR"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.a text that is no naming template is refused with its reason","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-TEMPLATE-GRAMMAR"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.every naming template error renders its condition and its payload","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-TEMPLATE-GRAMMAR"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamePart","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NameAlias","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.PlaceholderNeed","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.TemplatePlaceholder","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.TemplateValue","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.TemplatePiece","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplateError","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplate.pieces","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplate.tryCreate","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-TEMPLATE-GRAMMAR"]}],"packages":[],"checks":[]},"section":"S8.3 -- The naming template and the grid generator"}
{"number": 269, "anchor": "IMPLEMENT", "ac": "AC-S83c", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [268], "how_to": "A name read through a template and written back, at the level of its text (001 §J 'It names setups and experiments, and PARSES names back to match imported data'; 'their cases become the template engine's first test cases': `MuellerExperimentLabel.parsed` (`MuellerReconstruction.fs:parsed`) reads the lab's labels by `experimentRegex` and `objectRegex` (`MuellerReconstruction.fs:experimentRegex`, `:objectRegex`), and step 270 re-points its callers here). In `NamingTemplates.fs`, after step 268's declarations; each doc one to three lines citing spec 0050 S8.3. (1) `NameText of string` with `.value`: a whole name as text, a setup's or an experiment's name or a label a lab file carries. (2) `SlotPart = { role : SlotRole; part : NamePart }`, `ObjectAngle = { position : SlotPosition; angle : Angle }` and `NameReading = { parts : SlotPart list; angles : ObjectAngle list; noteOpt : NamePart option }`, the values a name holds, each list in its template's order, with `member this.tryFindPart (role : SlotRole) : NamePart option` and `member this.tryFindAngle (position : SlotPosition) : Angle option`. (3) An angle is written as its degrees rounded to three decimals, in the invariant culture, with no exponent, no trailing zero and no sign on zero (`45`, `-22.5`, `0.333`, `0`); it is read as an optional `-`, ASCII digits and an optional `.` followed by ASCII digits, and becomes `Angle.degree` of that number (`Geometry.fs:degree`). (4) Each placeholder of a template owns the literal text directly before it, back to the placeholder before it; the literal after the last placeholder is the template's tail. The optional placeholders of one object, `{obj<k>}` and `{phi<k>}`, form one group, and every other optional placeholder is a group alone. (5) `type NamingTemplate with member this.writeName (reading : NameReading) : Result<NameText, NamingTemplateError>` writes, in the template's order, each placeholder's value after the text it owns: a `SlotPlaceholder` the reading's part of its role, an `AnglePlaceholder` the angle of its position, `NotePlaceholder` the note. An optional placeholder the reading lacks is left out with the text it owns; a required one answers `MissingNameValueErr` naming the placeholder's `text`. The tail ends the name. (6) `member this.readName (name : NameText) : Result<NameReading, NamingTemplateError>` tries the ways of leaving out the optional groups in one fixed order, binary counting over the groups in template order with the last group the lowest digit and a left-out group a one: every group kept comes first, and an earlier group is kept longest. One way reads the name left to right. Each kept placeholder's owned text must stand at the reading point. Its value runs from there to the first place, at least one character on, where the text that follows it in this way stands (the next kept placeholder's owned text, or the tail), or to the end of the name when that text is empty. A value is never empty, an angle's value must read as an angle, and after the last value the rest of the name must be the tail exactly. The first way that reads answers the reading; when none does, the answer is `NameMismatchErr` naming the name and the template. The scanning is done by locals inside the members (ELEV003P, ELEV010P). No regular expression, backtracking within a way, cache or other member is added. So the lab's labels read as `parsed` reads them: `LP-(LR#90)-CPL-2` holds the analyzer `CPL` and the note `2`, because keeping the note is tried before leaving it out, and `CPL-(LR#-45)-CPL` keeps its sign, because a value runs at least one character before the next owned text. Tests, in `NamingTemplateTests` (step 268), over `NamingTemplate.standard` and each label as a `NameText`: `the lab's labels read into their source, objects, angles, analyzer and note`: `CPL-(QZ#90-LR#90)-CPL` reads the source part `CPL` (`PrepSlotRole 1`), the objects `QZ` and `LR` with the angles 90° and 90°, the analyzer part `CPL` and no note; `CPL-(AIR#0)-CPL` the object `AIR` at 0° and no second object; `LP-(LR#90)-CPL-2` the source `LP`, the analyzer `CPL` and the note `2`; `CPL-(AIR#0)-CPL-BR` the note `BR`; `CPL-(LR#-45)-CPL` the angle −45°; and `LP-(QZ#22.5)-LP` 22.5°; each angle equals `Angle.degree` of its number exactly. `a name that does not fit the template is refused naming it`: `Darkness`, `BullshitCheck`, `BullshitCheck-2`, `LP-(Darkness)-CPL2`, `CPL-(QZ#ab)-CPL`, `CPL-(QZ#90-LR)-CPL` and the empty name each answer `NameMismatchErr` whose reason holds the name. `writing a reading back gives the name it was read from`: for `CPL-(QZ#90-LR#90)-CPL`, `CPL-(QZ#0-LR#0)-LP-2`, `LP-(AIR#0)-LP-2R`, `CPL-(AIR#0)-CPL-BR`, `LP-(LR#45)-CPL-2`, `CPL-(QZ#45-LR#45)-CPL-2`, `CPL-(LR#-45)-CPL` and `LP-(QZ#22.5)-LP`, `writeName` of the `readName` answers the same text. `a reading writes each value in its place and leaves out an optional one it lacks with the text it owns`: the test-local reading of the source `CPL`, the object `QZ` at 45° and the analyzer `CPL` writes `CPL-(QZ#45)-CPL`; with the note `2`, `CPL-(QZ#45)-CPL-2`; with a second object `LR` at 45°, `CPL-(QZ#45-LR#45)-CPL`; an angle of 1/3° is written `0.333` and one of −0.0001° `0`; and the reading without the analyzer answers `MissingNameValueErr` naming `analyzer1`.", "acceptance": "After names are read and written, `NameText`, `SlotPart`, `ObjectAngle` and `NameReading` MUST exist in `NamingTemplates.fs`, `NamingTemplate.readName` MUST read the lab's labels as `MuellerExperimentLabel.parsed` reads them and refuse a name the template does not fit, and `writeName` MUST write a reading back to the name it was read from; constructor-unit-tests MUST pass, including `the lab's labels read into their source, objects, angles, analyzer and note`, `a name that does not fit the template is refused naming it`, `writing a reading back gives the name it was read from` and `a reading writes each value in its place and leaves out an optional one it lacks with the text it owns`, the count rising by 4; and build, elevation and the fifteen s27 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.NamingTemplateTests.the lab's labels read into their source, objects, angles, analyzer and note", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs", "class": "OpticalConstructor.Tests.NamingTemplateTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-NAME-READING"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.NamingTemplateTests.a name that does not fit the template is refused naming it", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs", "class": "OpticalConstructor.Tests.NamingTemplateTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-NAME-READING"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.NamingTemplateTests.writing a reading back gives the name it was read from", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs", "class": "OpticalConstructor.Tests.NamingTemplateTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-NAME-READING"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.NamingTemplateTests.a reading writes each value in its place and leaves out an optional one it lacks with the text it owns", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs", "class": "OpticalConstructor.Tests.NamingTemplateTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-NAME-READING"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.NamingTemplates.NameText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "obligations": ["S83-NAME-READING"]}, {"symbol": "OpticalConstructor.Domain.NamingTemplates.SlotPart", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "obligations": ["S83-NAME-READING"]}, {"symbol": "OpticalConstructor.Domain.NamingTemplates.ObjectAngle", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "obligations": ["S83-NAME-READING"]}, {"symbol": "OpticalConstructor.Domain.NamingTemplates.NameReading", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "obligations": ["S83-NAME-READING"]}, {"symbol": "OpticalConstructor.Domain.NamingTemplates.NamingTemplate.writeName", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "obligations": ["S83-NAME-READING"]}, {"symbol": "OpticalConstructor.Domain.NamingTemplates.NamingTemplate.readName", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs", "obligations": ["S83-NAME-READING"]}], "packages": [], "checks": []}, "section": "S8.3 -- The naming template and the grid generator"}
{"number": 270, "anchor": "IMPLEMENT", "ac": "AC-S83d", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests", "BerremanTests"], "depends_on": [269], "how_to": "The reference pipeline reads its labels through the naming template, and the label regular expressions go (001 §J 'It replaces `MuellerExperimentLabel.parsed` and its `experimentRegex`'; 001 §R; 001 §T 'From section 8: `git grep -n -F \"experimentRegex\" -- Berreman/` finds nothing', which this step makes true). `MuellerReconstructionTests`' numbers are unchanged. Each doc is one to three lines citing spec 0050 S8.3. In `OpticalConstructor.Domain/MuellerReconstruction.fs`: (1) Deleted: `experimentRegex` and `objectRegex` (`MuellerReconstruction.fs:experimentRegex`, `:objectRegex`), the `MuellerExperimentLabel` extension holding `parsed` (`:parsed`), `ParsedExperiment` (`:ParsedExperiment`), `ParsedObject` (`:ParsedObject`) and `MuellerLabelToken` (`:MuellerLabelToken`), whose only readers are each other, `buildDesign` and `MuellerReconstructionTests` (the census names no other), with the doc and comment lines that describe them; and `open System.Text.RegularExpressions` (`MuellerReconstruction.fs:3`), which nothing else reads. The file opens `Kit`, `Setups` and `NamingTemplates`. (2) `MuellerExperimentLabel` (`MuellerReconstruction.fs:MuellerExperimentLabel`) gains `member this.nameText : NameText`, its text as a name (step 269); its doc says a label reads through `NamingTemplate.standard` (step 267). (3) After `MatrixKind` (`MuellerReconstruction.fs:MatrixKind`), `type NameReading with`, the reference pipeline's reading of a label, moved from `ParsedExperiment` with its rules unchanged: `member this.family : Family` takes a part as the circular family when its text contains `CPL` (the reference `canonical_polarizer`), over the source part (`tryFindPart (PrepSlotRole (SlotPosition 1))`) and the analyzer part (`AnalyzerSlotRole (SlotPosition 1)`), an absent part being linear; `member this.objectRotation : Angle * MatrixKind` takes the objects as the reading's `ObjectSlotRole` parts that have an angle of their position, in position order: none is `Angle.zero, Air`; one is its angle and, by its text upper-cased (`ToUpperInvariant`), `Qz` for `QZ`, `Lr` for `LR` and `Air` otherwise; two or more are the first's angle and `QzLrProduct`; `member this.matrixKind : MatrixKind` and `member this.objectPhi : Angle` are its halves. (4) `buildDesign` (`MuellerReconstruction.fs:buildDesign`) keeps a row whose label `NamingTemplate.standard.readName r.experiment.nameText` reads with a `matrixKind` equal to `kind`, a label the template does not read being never kept, and otherwise filters as it does; its doc says so. Every science label of the lab's files reads (`CPL-(AIR#0)-CPL`, `LP-(LR#90)-CPL-2`, `CPL-(QZ#45-LR#45)-CPL-2`, …), so every design holds the same rows in the same order. The one reading that differs is a darkness label such as `CPL-(Darkness)-LP-2`, which `parsed` read as `Air` and the template does not read; no design selects `Air`. (5) `Berreman/BerremanTests/MuellerReconstructionTests.fs` opens `OpticalConstructor.Domain.Kit`. Its fact `parseExperiment decodes CPL-(QZ#90-LR#90)-CPL and the +90 / -90 object rotation is inert (R(2 phi) invariance)` (`MuellerReconstructionTests.fs:559`) becomes `the standard naming template reads CPL-(QZ#90-LR#90)-CPL as the CPL-CPL family and the QZ LR product at phi 90, and the +90 / -90 object rotation is inert (R(2 phi) invariance)`: the label is read by `NamingTemplate.standard.readName (MuellerExperimentLabel \"CPL-(QZ#90-LR#90)-CPL\").nameText`, an `Error` failing the fact with its `describe`, and its assertions are unchanged. In the section 7.2 fact, `prepareRow` (`MuellerReconstructionTests.fs:945`) takes `phi` as that reading's `objectPhi` in the same way. Tests. `NamingTemplateTests` (it opens `MuellerReconstruction`) gains `a lab label's reading names its reference family, matrix kind and object angle`: `CPL-(QZ#90-LR#90)-CPL` is `CplCpl`, `QzLrProduct` and 90°; `CPL-(AIR#0)-CPL` `CplCpl`, `Air` and 0°; `LP-(LR#90)-CPL-2` `LpCpl`, `Lr` and 90°; `CPL-(QZ#45)-LP-2` `CplLp`, `Qz` and 45°; and `LP-(QZ#0)-LP-2R` `LpLp`, `Qz` and 0°. `MuellerReconstructionTests`' facts pass with their numbers unchanged, `buildDesign keeps only the requested kind, dropping AIR rows and the excluded contaminated point (always-run)` and the section 7.2 fact included.", "acceptance": "After the reference pipeline reads its labels through the template, `experimentRegex`, `objectRegex`, `MuellerExperimentLabel.parsed`, `ParsedExperiment`, `ParsedObject` and `MuellerLabelToken` MUST be gone and `git grep -n -F \"experimentRegex\" -- Berreman/` MUST find nothing, and `buildDesign` and `MuellerReconstructionTests` MUST read labels through `NamingTemplate.standard` and the moved `NameReading.family`, `matrixKind` and `objectPhi`; constructor-unit-tests MUST pass, including `a lab label's reading names its reference family, matrix kind and object angle`, the count rising by 1; unit-tests MUST pass over the selected class, `BerremanTests.MuellerReconstructionTests`, its fact renamed to `the standard naming template reads CPL-(QZ#90-LR#90)-CPL as the CPL-CPL family and the QZ LR product at phi 90, and the +90 / -90 object rotation is inert (R(2 phi) invariance)` and its numbers unchanged; and build, elevation and the fifteen s27 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "unit-tests": {"mode": "selected", "suite": "unit-tests", "values": ["BerremanTests.MuellerReconstructionTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/MuellerReconstruction.fs", "Berreman/BerremanTests/MuellerReconstructionTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.NamingTemplateTests.a lab label's reading names its reference family, matrix kind and object angle", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs", "class": "OpticalConstructor.Tests.NamingTemplateTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"op": "rename", "suite": "unit-tests", "id": "BerremanTests.MuellerReconstructionTests.parseExperiment decodes CPL-(QZ#90-LR#90)-CPL and the +90 / -90 object rotation is inert (R(2 phi) invariance)", "path": "Berreman/BerremanTests/MuellerReconstructionTests.fs", "class": "BerremanTests.MuellerReconstructionTests", "discovery_gate": "unit-tests", "successor": "BerremanTests.MuellerReconstructionTests.the standard naming template reads CPL-(QZ#90-LR#90)-CPL as the CPL-CPL family and the QZ LR product at phi 90, and the +90 / -90 object rotation is inert (R(2 phi) invariance)", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.MuellerReconstruction.experimentRegex", "op": "retire", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"], "preserves_obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.objectRegex", "op": "retire", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"], "preserves_obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.MuellerExperimentLabel.parsed", "op": "retire", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"], "preserves_obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.ParsedExperiment", "op": "retire", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"], "preserves_obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.ParsedObject", "op": "retire", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"], "preserves_obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.MuellerLabelToken", "op": "retire", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"], "preserves_obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.MuellerExperimentLabel.nameText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MuellerReconstruction.fs", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.NameReading.family", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MuellerReconstruction.fs", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.NameReading.objectRotation", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MuellerReconstruction.fs", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.NameReading.matrixKind", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MuellerReconstruction.fs", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.NameReading.objectPhi", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/MuellerReconstruction.fs", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}, {"symbol": "OpticalConstructor.Domain.MuellerReconstruction.buildDesign", "op": "change_behavior", "obligations": ["S83-LABELS-THROUGH-TEMPLATE"]}], "packages": [], "checks": []}, "section": "S8.3 -- The naming template and the grid generator"}
{"number":271,"anchor":"IMPLEMENT","ac":"AC-S83e","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[270],"how_to":"A setup's name written from its slots, and read back into its items and angles (001 §J 'It names setups and experiments, and PARSES names back to match imported data'; the S8.3 brief: it 'FORMATS a setup or experiment name from its slots and angles, and PARSES a name back into slot items and angles'). In `NamingTemplates.fs`, after step 269's declarations; each doc one to three lines citing spec 0050 S8.3. (1) `type ItemLabel with member this.namePart : NamePart`, a label as a name part (step 213), and `type NameText with member this.toSetupName : Result<SetupName, SetupError>`, `SetupName.tryCreate` of its text (step 255); no member converts back (ELEV006). (2) `SlotItem = { role : SlotRole; item : ItemId }`. (3) `type NamingTemplate with`: (a) `member this.nameReadingOf (slots : SetupSlot list) (items : Item list) (noteOpt : NamePart option) : Result<NameReading, NamingTemplateError>` lays the slots out in light order (`SetupSlot.inLightOrder`, step 257) and takes, for each placeholder of `pieces` in order: for a `SlotPlaceholder role`, when the slot of that role holds an item of `items` (`SlotContent.itemOpt`, step 256), the part of the placeholder's first alias whose label equals the item's label ignoring case, or else the item's `label.namePart`; for an `AnglePlaceholder k`, when Obj k holds an item, its angle: the reading of a `DialTurn reading` slot, the placement's R1 for `PlacementTurn` (S8.2's rule, after 001 §I: experiments record raw dial readings); for `NotePlaceholder`, `noteOpt`. A role the layout has no slot of, a slot holding nothing and an item `items` lacks give no value. A template whose `pieces` fail answers their error. (b) `member this.itemsOf (reading : NameReading) (items : Item list) : Result<SlotItem list, NamingTemplateError>` answers, for each part in order, the item it names in its placeholder: when an alias of the placeholder has that part (ordinal), the item whose label equals the alias's label ignoring case; otherwise the item whose label equals the part ignoring case. A part naming no item answers `UnknownNameItemErr` naming the part and the placeholder's `text`. Item labels are unique by file stem ignoring case (step 216), so at most one item matches. (c) `member this.setupNameOf (slots : SetupSlot list) (items : Item list) : Result<SetupName, NamingTemplateError>` is `writeName` of `nameReadingOf slots items None`, made a `SetupName` by `toSetupName`; a blank name answers `MissingNameValueErr` naming the template. (d) `member this.setupNameAmong (slots : SetupSlot list) (items : Item list) (taken : SetupName list) (unnamed : SetupName) : SetupName` is `setupNameOf`'s name made free among `taken` by `nextFreeAmong` (step 255), or `unnamed` when the template cannot name the slots. It names every new setup the window and the grid make (steps 272 and 276), `unnamed` being S8.2's name for it. Setups and experiments keep their names when the template changes: a template names what is made after it is saved. No other member, cache or option is added. Tests, in `NamingTemplateTests`, over slots made as `SetupTests` makes them (steps 256-258): `src` (a `LightSource` at `RayModel.defaultSourcePoint`), `lpA` (a `LinearPolarizer` at x −0.3 m), `sampleA` (a `Sample` at x −0.1 m), `sampleB` (a `Sample` at x 0.1 m), `lpB` (a `LinearPolarizer` at x 0.3 m) and `det` (a `Detector` at `RayModel.defaultDetectorPoint`), all on the main beam; test-local items made through `ItemDraft` (step 216), each `FixedMounting` unless named: `Laser` (`PresetIds.heNe633`), `CPL1` and `CPL2` (`ItemModelIds.circularPolarizerModelId`), `QZ`, `LR` and `QZd` (`ItemModelIds.blackBoxMuellerModelId`, `QZd` `DialMounted DialNegative` with its `dialZero` known at 10°), each put in its slot by `withItem` (step 258) after the slot's R1 is set; and the template `lab` = `tryCreate \"{source:CPL1=CPL,LP1=LP}-({obj1}#{phi1}-{obj2}#{phi2})-{analyzer:CPL2=CPL,LP2=LP}-{note}\"`. `a setup's name is written from its slots in light order, its items under their aliases and its objects at their angles`: `src` holding `Laser`, `lpA` `CPL1`, `sampleA` `QZ` at R1 45°, `sampleB` `LR` at 45°, `lpB` `CPL2` and `det` nothing is named `CPL-(QZ#45-LR#45)-CPL` by `lab` and `CPL1-(QZ#45-LR#45)-CPL2` by `NamingTemplate.standard`; with `sampleB` holding nothing, `CPL-(QZ#45)-CPL`; with `QZd` in `sampleA` at R1 30° (its reading −20°, step 258) and `sampleB` holding nothing, `CPL-(QZd#-20)-CPL`; and `nameReadingOf` with the note `2`, written by `writeName`, is `CPL-(QZ#45-LR#45)-CPL-2`. `a name reads back into the items of its slots and their angles`: `itemsOf` of `lab`'s reading of `CPL-(QZ#45-LR#45)-CPL` over those items is `CPL1` at `PrepSlotRole 1`, `QZ` at `ObjectSlotRole 1`, `LR` at `ObjectSlotRole 2` and `CPL2` at `AnalyzerSlotRole 1`, with the angles 45° and 45°; the object part `qz` reads as `QZ`; and `CPL-(XX#45)-CPL` answers `UnknownNameItemErr` naming `XX` and `obj1`. `writing a setup's name and reading it back gives its items and angles`: for each slot list of the first fact and for one with `sampleA` at 22.5°, the slots' items by role equal `itemsOf` of the `readName` of their `setupNameOf`, and each object's angle equals the read angle within 1e-12. `a setup the template cannot name says which placeholder is empty, and a new setup takes the template's name made free, or the name it is given`: with `lpA` holding nothing, `setupNameOf` answers `MissingNameValueErr` naming `source1` and `setupNameAmong … [] (SetupName \"Setup 3\")` answers `Setup 3`; the full slots among `[]` answer `CPL-(QZ#45-LR#45)-CPL`, and among `cpl-(qz#45-lr#45)-cpl` `CPL-(QZ#45-LR#45)-CPL (2)`.","acceptance":"After names come from slots, `NamingTemplate.nameReadingOf`, `itemsOf`, `setupNameOf` and `setupNameAmong`, `SlotItem`, `ItemLabel.namePart` and `NameText.toSetupName` MUST exist in `NamingTemplates.fs`, a setup's name MUST be written from its slots in light order under the template's aliases and read back into the same items and angles; constructor-unit-tests MUST pass, including `a setup's name is written from its slots in light order, its items under their aliases and its objects at their angles`, `a name reads back into the items of its slots and their angles`, `writing a setup's name and reading it back gives its items and angles` and `a setup the template cannot name says which placeholder is empty, and a new setup takes the template's name made free, or the name it is given`, the count rising by 4; and build, elevation and the fifteen s27 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.a setup's name is written from its slots in light order, its items under their aliases and its objects at their angles","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-SLOT-NAMES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.a name reads back into the items of its slots and their angles","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-SLOT-NAMES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.writing a setup's name and reading it back gives its items and angles","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-SLOT-NAMES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.NamingTemplateTests.a setup the template cannot name says which placeholder is empty, and a new setup takes the template's name made free, or the name it is given","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/NamingTemplateTests.fs","class":"OpticalConstructor.Tests.NamingTemplateTests","discovery_gate":"constructor-unit-tests","obligations":["S83-SLOT-NAMES"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.NamingTemplates.ItemLabel.namePart","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NameText.toSetupName","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.SlotItem","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplate.nameReadingOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplate.itemsOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplate.setupNameOf","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]},{"symbol":"OpticalConstructor.Domain.NamingTemplates.NamingTemplate.setupNameAmong","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","obligations":["S83-SLOT-NAMES"]}],"packages":[],"checks":[]},"section":"S8.3 -- The naming template and the grid generator"}
{"number": 272, "anchor": "IMPLEMENT", "ac": "AC-S83f", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Tests"], "depends_on": [271], "how_to": "The window names every new setup by the kit's naming template (001 §J 'It names setups and experiments'; S8.2 interpretation 8: a table that is no setup yet takes `Setup <n>` at a commit or a swap, a swap from an active setup `<name> (2)`, and 'S8.3's template replaces these names'). Each doc is one to three lines citing spec 0050 S8.3. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`, which opens `NamingTemplates`: (1) `ExpCommit` on a table that is no setup yet (step 261 (8)(b)): the setup is `Setup.create name slots model.kitSetups` with `name` = `model.kit.kitFile.namingTemplate.setupNameAmong slots model.kitItems taken (SetupName.firstFree taken)` (step 271), `taken` being the names of `kitSetups` and `slots` the recorded table step 261 builds; `nextFreeAmong` keeps the name free, so `create` refuses none. (2) `SwapSlot` (step 264): the fresh name of a `CreateSwappedSetup` is `setupNameAmong swapped model.kitItems taken <step 264's fresh name>`, so a swapped table the template names takes that name and one it cannot name keeps `<active> (2)` or `Setup <n>`. (3) Nothing else is named here: `CreateSetup` keeps the typed name (step 260), and a copied setup keeps its own (step 261). The template is read from the kit file the window holds (`KitContext.kitFile`, step 131), so a template saved in the window names the next setup (step 273). No other message, field or option is added. Tests, in `SetupModelTests` (steps 260, 263, 264), whose kit holds step 263's items `LP1`, `QZ`, `Laser` and `LPd` and step 264's `QZ2`, and whose kit file holds `NamingTemplate.standard`: `a commit on a table the kit's template names records it under that name`: with a linear polarizer, a sample and a second linear polarizer added, as step 263's facts add elements, so that the light meets them in that order before the seeded detector; `LP1` assigned to the first, `QZ` to the sample, turned to R1 45° (`RotSetAxis (R1, BarDegrees 45.0)` with it selected), and `LPd` to the second, each by `AssignSlot` (step 263); the first polarizer chosen (`ExpChooseElement`) and `ExpCommit`: the kit holds `LP1-(QZ#45)-LPd.setup-json` at revision 1, `E1` references it, and `activeSetupOpt` is that setup. `a swap to content no setup holds takes the template's name of the swapped table`: after that commit, `SwapSlot (sample, QZ2)` writes `LP1-(QZ2#45)-LPd.setup-json`, makes it active, and leaves the bytes of `LP1-(QZ#45)-LPd.setup-json` unchanged. Step 261's and 264's facts keep their names (`Setup 1`, `Bench A (2)`), and so do the UI facts that find `Setup 1.setup-json` (step 261): their tables hold no item in Prep 1, Obj 1 or Analyzer 1, which `NamingTemplate.standard` requires (step 268).", "acceptance": "After the window names new setups by the template, a commit on a table that is no setup yet and a swap to content no setup holds MUST name the new setup by the kit's naming template made free, and keep S8.2's name for a table the template cannot name; constructor-unit-tests MUST pass, including `a commit on a table the kit's template names records it under that name` and `a swap to content no setup holds takes the template's name of the swapped table`, the count rising by 2; ui-smoke MUST pass; ui-tests MUST pass over the selected classes; and build, elevation and the fifteen s27 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.ExperimentControlsTests", "OpticalConstructor.Ui.Tests.FsxAcceptanceTests", "OpticalConstructor.Ui.Tests.InverseConstructorTests", "OpticalConstructor.Ui.Tests.SetupSaveLoadTests", "OpticalConstructor.Ui.Tests.SolverHandoffWindowTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.a commit on a table the kit's template names records it under that name", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-WINDOW-NAMES"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.a swap to content no setup holds takes the template's name of the swapped table", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-WINDOW-NAMES"]}], "contracts": [], "packages": [], "checks": []}, "section": "S8.3 -- The naming template and the grid generator"}
{"number": 273, "anchor": "IMPLEMENT", "ac": "AC-S83g", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Controls", "OpticalConstructor.Tests", "OpticalConstructor.Ui.Tests"], "depends_on": [272], "how_to": "The kit's naming template is shown and saved in the kit bar, through semantic messages (001 §J 'Naming template: each kit carries one'; 001 §P and .spec-md §4 'UI': every user step is a semantic message, and the button and the test send the same one; S12.1 builds its kit with the lab's template). Each doc is one to three lines citing spec 0050 S8.3. (1) `OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs`: `type Kit.NamingTemplate with member this.caption : ControlCaption`, the template's text, with a one-line doc. (2) `OpticalConstructor.Controls/UiIds.fs`, in the kit bar group (step 188), each with a one-line doc: `namingTemplateField` (`\"NamingTemplateField\"`) and `saveNamingTemplateButton` (`\"SaveNamingTemplateButton\"`). (3) `OpticalConstructor.Ui/TableAndElementRotationView.fs`. (a) The model gains `namingTemplateText : ControlCaption`, the template being typed, with a one-line doc; it is the kit file's `namingTemplate.caption` wherever the model takes a kit file: `initWith`, the open's `loadKit` and `ReloadKitChanges` (step 187), so a reload shows a template another writer saved. (b) Messages, each with a one-line doc: `SetNamingTemplateText of ControlCaption` (the field's text) and `SaveNamingTemplate` (the kit's naming template becomes the field's). (c) Arms. `SetNamingTemplateText text` sets `namingTemplateText`. `SaveNamingTemplate` is refused by the read-only guard of step 185, as `SaveSetup` is (step 262). Otherwise `NamingTemplate.tryCreate model.namingTemplateText.value` (step 268): `Error e` sets `kitStatus` to `Not saved — <e.describe>` and writes nothing; a template equal to `model.kit.kitFile.namingTemplate` sets `The naming template is unchanged.` and writes nothing; any other is written by `model.kit.saveKitFile { model.kit.kitFile with namingTemplate = template }` (step 131), whose `Ok kit` makes `model.kit` that context and `kitStatus` `Saved the naming template.`, and whose `Error e` keeps the model and sets `Not saved to the kit — <e.describe>`. The window's own write is not a change offered for reload (step 130), and no setup or experiment is renamed (step 271). (4) `OpticalConstructor.Ui/KitWindowView.fs` (step 188): after the Kit menu's `WrapPanel` (step 188 (2)(b)), a `DockPanel` whose left child is the semi-bold `TextBlock` `Naming template:`, whose right child is the `MaterialsWindowView.verbButton` `Save template` carrying `saveNamingTemplateButton` and sending `SaveNamingTemplate`, present only while the kit's writes are offered (`model.kitWrites`, step 185), and whose fill is a `TextBox` carrying `namingTemplateField` that shows `namingTemplateText` and sends `SetNamingTemplateText` at every change of its text. No other message, field, id or option is added. Tests. `KitWindowModelTests` (steps 184-187), over a folder kit: `Save template writes the typed naming template into the kit file`: `SetNamingTemplateText (ControlCaption \"{source:CPL1=CPL}-({obj1}#{phi1})-{analyzer:CPL2=CPL}\")` and `SaveNamingTemplate` leave that template in `model.kit.kitFile.namingTemplate`, `model.kit.proxy.readKitFile ()` answers a kit file holding it, `kitStatus` is `Saved the naming template.` and `CheckKitChanges KitCheckOnRequest` offers no change. `a naming template that does not parse, or the kit's own, is told and writes nothing`: the text `{sauce}` sets a `kitStatus` starting `Not saved` and holding `the naming template is not valid`, and the standard text sets `The naming template is unchanged.`; the bytes of `.kit-json` are unchanged by both. `a kit opened read-only refuses every write message and writes nothing` (step 185) also sends `SaveNamingTemplate` after a template is typed, with the same assertions. `Reload reads the kit's files in and clears the offer` (step 187) also has the other writer save a kit file whose template is `{obj1}`, and after Reload `namingTemplateText` is `{obj1}`. `KitWindowTests` (step 188): `the kit bar shows the kit's naming template with Save template beside it`: `namingTemplateField` shows the kit's template text, `saveNamingTemplateButton` is present with its left beyond the field's right, and the ids' texts are `NamingTemplateField` and `SaveNamingTemplateButton`; `a read-only window withholds every write control` (step 185) also finds no `saveNamingTemplateButton`. `ScrollExtentTests`' kit-window fact passes unchanged.", "acceptance": "After the template is edited in the kit bar, `SetNamingTemplateText` and `SaveNamingTemplate` MUST set and save the kit's naming template through `KitContext.saveKitFile`, refusing a text that does not parse, an unchanged template and a read-only kit with nothing written, and the kit bar MUST show the template's field and Save template; constructor-unit-tests MUST pass, including `Save template writes the typed naming template into the kit file` and `a naming template that does not parse, or the kit's own, is told and writes nothing` and the changed `a kit opened read-only refuses every write message and writes nothing` and `Reload reads the kit's files in and clears the offer`, the count rising by 2; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, including `the kit bar shows the kit's naming template with Save template beside it` and the changed `a read-only window withholds every write control`; and build, elevation and the fifteen s27 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.KitWindowTests", "OpticalConstructor.Ui.Tests.ScrollExtentTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs", "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui/KitWindowView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitWindowModelTests.Save template writes the typed naming template into the kit file", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "class": "OpticalConstructor.Tests.KitWindowModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-TEMPLATE-EDIT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitWindowModelTests.a naming template that does not parse, or the kit's own, is told and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "class": "OpticalConstructor.Tests.KitWindowModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-TEMPLATE-EDIT"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitWindowModelTests.a kit opened read-only refuses every write message and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitWindowModelTests.Reload reads the kit's files in and clears the offer", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"op": "create", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.KitWindowTests.the kit bar shows the kit's naming template with Save template beside it", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs", "class": "OpticalConstructor.Ui.Tests.KitWindowTests", "discovery_gate": "ui-tests", "obligations": ["S83-TEMPLATE-EDIT"]}, {"op": "change_expectation", "suite": "ui-tests", "id": "OpticalConstructor.Ui.Tests.KitWindowTests.a read-only window withholds every write control", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs", "obligations": ["S83-TEMPLATE-EDIT"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.ConstructorUiIdOfDomain.NamingTemplate.caption", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.namingTemplateField", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"symbol": "OpticalConstructor.Controls.ConstructorUiId.saveNamingTemplateButton", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.namingTemplateText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SetNamingTemplateText", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SaveNamingTemplate", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S83-TEMPLATE-EDIT"]}, {"symbol": "OpticalConstructor.Ui.KitWindowView.kitWindowView", "op": "change_behavior", "obligations": ["S83-TEMPLATE-EDIT"]}], "packages": [], "checks": []}, "section": "S8.3 -- The naming template and the grid generator"}
{"number":274,"anchor":"IMPLEMENT","ac":"AC-S83h","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[273],"actions":["ADD_TEST OpticalConstructor.Tests.SetupGridTests"],"how_to":"The grid generator as pure Domain: options per slot, their product, the combinations unticked, and every setup made at once and named by the template (001 §J 'Grid generator: a set of options per slot → their product, with impossible or unwanted combinations unticked → all setups and experiments created at once'; 001 §P `GenerateSetupGrid`, whose message is step 276 and whose controls are S8.4's). Each doc is one to three lines citing spec 0050 S8.3. (1) `OpticalConstructor.Domain/Kit.fs`: `SetupError` (step 255) gains `SlotItemTwiceErr of reason : string`, one item in two slots (one physical piece is in one place, 001 §I), rendered `the item is in two slots: <reason>`. (2) New `OpticalConstructor.Domain/SetupGrids.fs`: `module SetupGrids` in `namespace OpticalConstructor.Domain`, compiled directly after `NamingTemplates.fs` (step 268): one `<Compile>` line and no comment. Its module doc is one to three lines: the grid generator, every combination of a table's slot options made a setup at once (spec 0050 S8.3). It opens `Kit`, `ItemModels`, `Setups` and `NamingTemplates`. (a) `SlotChoice = { itemOpt : ItemId option; r1 : Angle }`: the slot holds that item, or nothing, turned to `r1`. (b) `SlotOptions = { slot : Library.ElementId; choices : SlotChoice list }`, one axis: a slot of the table and its options in order. (c) `SlotPick = { slot : Library.ElementId; choice : SlotChoice }` and `GridCombination = { picks : SlotPick list }`, one pick per axis in axis order, with `member this.slotsOver (table : SetupSlot list) (items : Item list) (choiceOf : Item -> ItemModelChoice option) : Result<SetupSlot list, SetupError>`: the table's slots in order, each picked slot first turned (its placement's `r1` set to the choice's) and then made `withoutItem` for `None`, or `withItem item choice` (step 258) for `Some id`, the item taken from `items` (else `UnknownSlotItemErr` naming the id) and its choice from `choiceOf` (else `UnknownSlotItemErr` naming the item's label and that its model is not in the library), as `AssignSlot` resolves an item (step 263). A pick of a slot the table lacks answers `UnknownSetupSlotErr`, and one item in two picked slots `SlotItemTwiceErr` naming its label. Every slot is then `recordedWith items` (step 258), as a commit records the table (step 261). (d) `SetupGrid = { axes : SlotOptions list; unticked : GridCombination list }`, with: `member this.combinations : GridCombination list`, the product of the axes' choices, the first axis varying slowest (no axis gives one empty combination); `member this.ticked : GridCombination list`, those not in `unticked`, in order; `member this.untick (combination : GridCombination) : SetupGrid`, which adds it to `unticked` once, and `member this.tick (combination : GridCombination) : SetupGrid`, which removes it; `static member create (axes : SlotOptions list) (table : SetupSlot list) (items : Item list) (choiceOf : Item -> ItemModelChoice option) : SetupGrid`, the grid over `axes` whose `unticked` holds, in order, every combination whose `slotsOver` answers an error, so the impossible ones start unticked (001 §J); and `member this.generate (table : SetupSlot list) (items : Item list) (choiceOf : Item -> ItemModelChoice option) (template : NamingTemplate) (held : Setup list) : Result<Setup list, SetupError>`, one setup per ticked combination, in order: the setup of `held`, or one made earlier in the same run, whose current slots equal the combination's `slotsOver`; else `Setup.create` (step 256) of `template.setupNameAmong slots items taken (SetupName.firstFree taken)` (step 271), `taken` being the names of `held` and of the setups made before it. The first combination whose `slotsOver` fails refuses the whole grid with that error, so nothing half-made is answered. Nothing is written: the host records (step 276). No cache, sort, size limit or other member is added. Tests: new `OpticalConstructor.Tests/SetupGridTests.fs`, `module SetupGridTests` in `namespace OpticalConstructor.Tests`, appended at the end of `OpticalConstructor.Tests.fsproj`'s compile list with no comment, over step 271's fixture as test-local copies: the slots `src`, `lpA`, `sampleA`, `lpB` and `det`, the items `Laser`, `CPL1`, `CPL2`, `QZ` and `LR`, the template `lab` = `tryCreate \"{source:CPL1=CPL,LP1=LP}-({obj1}#{phi1}-{obj2}#{phi2})-{analyzer:CPL2=CPL,LP2=LP}-{note}\"`, and a test-local `choiceOf` answering each item's choice (`SourcePresetChoice` for `Laser`, `LibraryModelChoice` of its model for the others) and `None` for `Ghost`, an item whose model no library holds. `a grid lists the product of its slots' options, the first slot slowest, and leaves out what is unticked`: the axes `lpA` {`CPL1` at 0°, nothing at 0°} and `sampleA` {`QZ` at 0°, `QZ` at 45°, `LR` at 90°} list six combinations in the order (`CPL1`, `QZ` 0°), (`CPL1`, `QZ` 45°), (`CPL1`, `LR` 90°), (nothing, `QZ` 0°), (nothing, `QZ` 45°), (nothing, `LR` 90°); unticking (`CPL1`, `QZ` 45°) leaves the other five ticked in that order, unticking it again changes nothing, and ticking it lists six again. `a grid starts with the combinations it cannot make unticked`: `create` over the axes `lpA` {`CPL1`, `Laser`, `Ghost`, an id no item has} and `sampleA` {`QZ`} unticks the three last combinations, and over `lpA` {`CPL1`} and `lpB` {`CPL1`, `CPL2`} unticks (`CPL1`, `CPL1`). `a grid's setups take the template's names, and a combination a held setup holds is that setup`: over `lpA` {`CPL1`}, `sampleA` {`QZ` at 0°, `QZ` at 45°} and `lpB` {`CPL2`} with `lab`, `generate` with no held setup answers `CPL-(QZ#0)-CPL` and `CPL-(QZ#45)-CPL` at revision 1; with the first held, it answers that held setup itself and the second as before; with a held `CPL-(QZ#45)-CPL` of other slots, the second is `CPL-(QZ#45)-CPL (2)`; and over the same grid with `lpA` no axis and holding nothing, which `lab` cannot name, the setups are `Setup 1` and `Setup 2`. `a ticked combination the grid cannot make refuses the whole grid`: the record `{ axes = …; unticked = [] }` over `lpA` {`CPL1`, `Laser`} and `sampleA` {`QZ`} answers `IncompatibleSlotItemErr` naming `Laser`; one putting `CPL1` in `lpA` and `lpB` answers `SlotItemTwiceErr` naming `CPL1`; and an axis of a slot the table lacks answers `UnknownSetupSlotErr`. `KitTests`' `every setup error renders its condition and its payload` (step 255) also covers `SlotItemTwiceErr`. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the grid generator lands, `SetupGrids.fs` MUST hold `SlotChoice`, `SlotOptions`, `SlotPick`, `GridCombination` and `SetupGrid`, a grid MUST list the product of its options less the unticked ones, start with its impossible combinations unticked, and generate one setup per ticked combination named by the template, a held one reused, or refuse the whole grid; constructor-unit-tests MUST pass, including `a grid lists the product of its slots' options, the first slot slowest, and leaves out what is unticked`, `a grid starts with the combinations it cannot make unticked`, `a grid's setups take the template's names, and a combination a held setup holds is that setup` and `a ticked combination the grid cannot make refuses the whole grid` and the changed `every setup error renders its condition and its payload`, the count rising by 4; and build, elevation and the fifteen s27 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/Kit.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/OpticalConstructor.Domain.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/OpticalConstructor.Tests.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Tests/KitTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.a grid lists the product of its slots' options, the first slot slowest, and leaves out what is unticked","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GRID"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.a grid starts with the combinations it cannot make unticked","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GRID"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.a grid's setups take the template's names, and a combination a held setup holds is that setup","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GRID"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.a ticked combination the grid cannot make refuses the whole grid","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GRID"]},{"op":"change_expectation","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.KitTests.every setup error renders its condition and its payload","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/KitTests.fs","obligations":["S83-GRID"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.Kit.SetupError","op":"change_shape","obligations":["S83-GRID"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.SlotChoice","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S83-GRID"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.SlotOptions","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S83-GRID"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.SlotPick","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S83-GRID"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.GridCombination","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S83-GRID"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.GridCombination.slotsOver","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S83-GRID"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.SetupGrid","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S83-GRID"]}],"packages":[],"checks":[]},"section":"S8.3 -- The naming template and the grid generator"}
{"number": 275, "anchor": "IMPLEMENT", "ac": "AC-S83i", "touches": ["OpticalConstructor.Domain", "OpticalConstructor.Tests"], "depends_on": [274], "how_to": "One experiment of the draft over each of several setups, the experiments half of the grid (001 §J 'all setups and experiments created at once'). In `OpticalConstructor.Domain/Experiments.fs`, after `commit` (`Experiments.fs:commit`), with a doc of one to three lines citing spec 0050 S8.3: `commitOverSetups (references : SetupReference list) (c : ExperimentCollection) : ExperimentCollection`. When the draft can be committed (`ExperimentCollection.canCommit`, `Experiments.fs:canCommit`: an element and a variable are chosen) it appends, for each reference in order, the experiment `commit` (step 261) appends over it from the draft editing nothing: each takes the next id and holds the draft's varied element, capture, range and wavelength, and no data file. The answer's draft is the draft editing nothing, so a later commit appends. An incomplete draft appends nothing, as `commit` does. Its body folds `commit`, so no second experiment builder is written (AGENTS.md 'Reuse, never copy'). No other function or option is added. Tests, in `ExperimentProxyTests`: `committing the draft over setups appends one experiment over each, and an incomplete draft appends none`: over a collection holding `E1` whose draft edits `E1` and varies a polarizer's R1 over 0 … 90°, `commitOverSetups` of the test-local references `A` revision 1 and `B` revision 2 appends `E2` over `A` revision 1 and `E3` over `B` revision 2, each with the draft's variable, range and capture and no data file, leaves `E1` unchanged and the draft editing nothing; over `ExperimentDraft.empty` it answers the collection unchanged.", "acceptance": "After the draft can be committed over several setups, `Experiments.commitOverSetups` MUST append one experiment of a committable draft over each reference in order through `commit`, leave the draft editing nothing and append nothing for an incomplete draft; constructor-unit-tests MUST pass, including `committing the draft over setups appends one experiment over each, and an incomplete draft appends none`, the count rising by 1; and build, elevation and the fifteen s27 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Domain/Experiments.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentProxyTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.ExperimentProxyTests.committing the draft over setups appends one experiment over each, and an incomplete draft appends none", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/ExperimentProxyTests.fs", "class": "OpticalConstructor.Tests.ExperimentProxyTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S83-GRID-EXPERIMENTS"]}], "contracts": [{"symbol": "OpticalConstructor.Domain.Experiments.commitOverSetups", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Domain/Experiments.fs", "obligations": ["S83-GRID-EXPERIMENTS"]}], "packages": [], "checks": []}, "section": "S8.3 -- The naming template and the grid generator"}
{"number":276,"anchor":"IMPLEMENT","ac":"AC-S83j","touches":["OpticalConstructor.Ui","OpticalConstructor.Tests"],"depends_on":[275],"how_to":"`GenerateSetupGrid` as a semantic message: every ticked combination becomes a setup of the kit, with an experiment of the draft over each, at once (001 §J 'all setups and experiments created at once'; 001 §P `GenerateSetupGrid`; the grid's controls, `SetupGridGenerateButton`, are S8.4's). Each doc is one to three lines citing spec 0050 S8.3. (1) `OpticalConstructor.Ui/TableAndElementRotationView.fs`: `TableAndElementRotationMsg` gains `GenerateSetupGrid of SetupGrids.SetupGrid`, with a one-line doc: every ticked combination of the grid over the table, as setups and experiments of the kit. Its arm is refused by the read-only guard of step 185. Otherwise it calls `grid.generate model.elements model.kitItems model.tryItemModelChoice model.kit.kitFile.namingTemplate model.kitSetups` (steps 274, 263): `Error e` sets `kitStatus` to `Not generated — <e.describe>` and writes nothing. `Ok setups`: each setup not in `kitSetups` (by equality) is recorded through `recordSetup` (step 260), in order; then, when the draft has a capture (`model.draftCapture`, as `ExpCommit` reads it), the collection takes it (`chooseMeasurement`) and `commitOverSetups` (step 275) over the setups' references in order, and each experiment it appends is recorded as `ExpCommit` records one (step 261). The first write that fails stops the run: `kitSetups` and the collection hold what was written, and `kitStatus` is `Not saved to the kit — <e.describe>`. On success `kitSetups` holds the new setups in name order and `kitStatus` is `Generated <n> setups (<m> new) and <k> experiments.`. The table, `activeSetupOpt` and the draft's fields are unchanged. (2) `AGENTS.md`, after the gotcha 'The table is the active setup' (step 261), one bullet of at most six lines: **Names come from the kit's naming template** (`NamingTemplates.fs`, spec 0050 S8.3): `{source}` is the polarization source (Prep 1), `{light}` the light source, `{obj<k>}` / `{phi<k>}` the objects and their angles (a dial reading or R1), then `{analyzer}`, `{detector}` and `{note}`; a second or later slot of a role and the note are left out with the text before them, and `{source:CPL1=CPL}` writes an item under another name. A new setup takes the template's name made free (`setupNameAmong`), and one the template cannot name keeps `Setup <n>`; the reference pipeline reads the lab's labels through `NamingTemplate.standard`, and the grid generator is `SetupGrids.fs`. No other message, field or option is added. Tests, in `SetupModelTests`, over step 272's table (`LP1`, the sample, `LPd`) with the first polarizer chosen (`ExpChooseElement`) and a grid made by `SetupGrid.create` over the sample's options `QZ` at 0°, `QZ` at 45° and `QZ2` at 0° with (`QZ2`, 0°) unticked: `GenerateSetupGrid records a setup per ticked combination, named by the kit's template, and an experiment of the draft over each`: the kit holds `LP1-(QZ#0)-LPd.setup-json` and `LP1-(QZ#45)-LPd.setup-json` at revision 1 and `E1` and `E2` referencing them in that order, with the draft's variable; `kitStatus` is `Generated 2 setups (2 new) and 2 experiments.`; and `elements` and `activeSetupOpt` are as they were. `a grid over setups the kit holds writes no setup again, and a grid it cannot make writes nothing`: the same grid again leaves both setup files' bytes unchanged, records `E3` and `E4` over them and sets `Generated 2 setups (0 new) and 2 experiments.`; a grid record whose sample options hold `Laser` and whose `unticked` is empty sets a `kitStatus` starting `Not generated` and naming `Laser`, and no kit file changes. `a grid over a draft that cannot be committed records its setups and no experiment`: after `ExpNew` (no element chosen) the grid writes the two setups and no experiment file and sets `Generated 2 setups (2 new) and 0 experiments.`. `a kit opened read-only generates nothing`: over the folder reopened read-only, the grid sets `kitStatus` to `The kit is open read-only: nothing is saved.` and every file is as it was. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After `GenerateSetupGrid` lands, the message MUST record every ticked combination's setup not yet held, named by the kit's template, and an experiment of a committable draft over each, refuse an impossible grid and a read-only kit with nothing written, and `AGENTS.md` MUST carry the naming-template gotcha; constructor-unit-tests MUST pass, including `GenerateSetupGrid records a setup per ticked combination, named by the kit's template, and an experiment of the draft over each`, `a grid over setups the kit holds writes no setup again, and a grid it cannot make writes nothing`, `a grid over a draft that cannot be committed records its setups and no experiment` and `a kit opened read-only generates nothing`, the count rising by 4; ui-smoke MUST pass; ui-tests MUST pass over the selected classes; and build, elevation and the fifteen s27 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.InverseConstructorTests","OpticalConstructor.Ui.Tests.SetupSaveLoadTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","AGENTS.md"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.GenerateSetupGrid records a setup per ticked combination, named by the kit's template, and an experiment of the draft over each","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GENERATE-SETUP-GRID"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a grid over setups the kit holds writes no setup again, and a grid it cannot make writes nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GENERATE-SETUP-GRID"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a grid over a draft that cannot be committed records its setups and no experiment","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GENERATE-SETUP-GRID"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a kit opened read-only generates nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S83-GENERATE-SETUP-GRID"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.GenerateSetupGrid","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S83-GENERATE-SETUP-GRID"]}],"packages":[],"checks":[]},"section":"S8.3 -- The naming template and the grid generator"}
{"number":277,"anchor":"IMPLEMENT","ac":"AC-S84a","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[276],"how_to":"The pure halves of the slot bar: which kit items a slot's chip lists, which one a typed letter picks, and the angle an object's chip shows (001 §J 'Quick swap: a slot bar above the table shows one chip per slot (… Obj 1: QZ ▾ @ 45° ▾ …); each dropdown lists compatible items only; … keyboard: Tab between chips, letters pick'; the S8.4 brief). Each doc is one to three lines citing spec 0050 S8.4. In `OpticalConstructor.Domain/Setups.fs`, after step 261's members: (1) `PickLetter of char` with `.value`, a letter typed on a chip, and `static member tryCreate (text : string) : PickLetter option`: the first character of the text, upper-cased in the invariant culture, when `Char.IsLetterOrDigit` holds for it, and `None` for an empty text or any other first character. (2) `type SetupSlot with`: (a) `member this.turnAngle : Angle`, the reading of a `DialTurn reading` slot and the placement's R1 otherwise (`PlacementTurn`, or a slot holding nothing): the rule `NamingTemplate.nameReadingOf` applies to an `AnglePlaceholder` (step 271), moved here; that arm in `NamingTemplates.fs` calls it and keeps its condition (Obj k holds an item), so every name it writes is unchanged. (b) `member this.fittingItems (items : Item list) (choiceOf : Item -> ItemModelChoice option) : Item list`: the items of `items`, in their order, whose `choiceOf` answers a choice whose `slotKinds` (step 258) holds the slot's `placement.catalogueKind`; an item `choiceOf` cannot resolve is left out. It is the rule `withItem` checks (step 258), applied before the choice, so a chip lists exactly what `SwapSlot` accepts. (c) `member this.pickedByLetter (letter : PickLetter) (fitting : Item list) : Item option`: among `fitting`, the items whose label's first character, upper-cased in the invariant culture, is the letter; when the slot holds one of them (`content.itemOpt`, step 256), the next of them after it, wrapping to the first; otherwise the first of them; and `None` when none is, or when that pick is the item the slot already holds, so a letter never swaps a slot to its own content. No cache, wildcard arm or other member is added. Tests, in `SetupTests` (steps 256-258, 261), over its slots `src`, `lpA`, `sampleA` and `det` (steps 256, 257) and test-local items made as step 258's facts make them, each `FixedMounting` unless named: `Laser` (`SourcePresetChoice` of `BuiltinCatalogue.source PresetIds.heNe633`), `LP1` and `LP2` (the `PresetIds.polarizerLp` polarizer), `CPL1` (`LibraryModelChoice` of the circular polarizer's built-in item model, `BuiltinCatalogue.itemModel`, step 210), `QZ` (`StackSampleChoice` of `SampleIds.glassPlate1mmId` at version 1), `QZd` (the glass plate, `DialMounted DialNegative`, its `dialZero` known at 10°) and `Ghost`, which the test-local `choiceOf` answers `None` for. `a slot lists the kit's items that fit it, in their order`: over the items `Laser`, `LP1`, `QZ`, `CPL1`, `Ghost` and `LP2`, in that order, `lpA.fittingItems` is `LP1`, `CPL1`, `LP2`, `sampleA`'s is `QZ`, `src`'s `Laser` and `det`'s none. `a typed letter picks the next fitting item whose label starts with it, wrapping, and never the slot's own`: over `lpA`'s fitting `LP1`, `CPL1`, `LP2`: holding `LP1`, `l` picks `LP2` and `c` picks `CPL1`; holding `LP2`, `L` picks `LP1` (wrapping); holding nothing, `l` picks `LP1`; holding `CPL1`, `c` picks nothing (no other label starts with it); `x` picks nothing; and `PickLetter.tryCreate` of `q` and of `qz` is `PickLetter 'Q'`, and of the empty text, ` ` and `-` is `None`. `an object's angle is its dial reading, or its R1`: `sampleA` holding `QZd` put in by `withItem` at R1 30° turns at −20° (its reading, step 258), holding `QZ` at R1 45° at 45°, and holding nothing at R1 15° at 15°, each within 1e-12. `NamingTemplateTests`' facts pass unchanged. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the slot bar's pure halves land, `PickLetter` MUST exist in `Setups.fs`, `SetupSlot.fittingItems` MUST list the items whose model fits the slot, `pickedByLetter` MUST pick the next fitting item whose label starts with the typed letter and never the slot's own, and `turnAngle` MUST be the one angle rule `NamingTemplate.nameReadingOf` calls; constructor-unit-tests MUST pass, including `a slot lists the kit's items that fit it, in their order`, `a typed letter picks the next fitting item whose label starts with it, wrapping, and never the slot's own` and `an object's angle is its dial reading, or its R1`, the count rising by 3; and build, elevation and the sixteen s28 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","Berreman/OpticalConstructor/OpticalConstructor.Domain/NamingTemplates.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupTests.a slot lists the kit's items that fit it, in their order","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupTests.fs","class":"OpticalConstructor.Tests.SetupTests","discovery_gate":"constructor-unit-tests","obligations":["S84-SLOT-PICKS"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupTests.a typed letter picks the next fitting item whose label starts with it, wrapping, and never the slot's own","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupTests.fs","class":"OpticalConstructor.Tests.SetupTests","discovery_gate":"constructor-unit-tests","obligations":["S84-SLOT-PICKS"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupTests.an object's angle is its dial reading, or its R1","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupTests.fs","class":"OpticalConstructor.Tests.SetupTests","discovery_gate":"constructor-unit-tests","obligations":["S84-SLOT-PICKS"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.Setups.PickLetter","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S84-SLOT-PICKS"]},{"symbol":"OpticalConstructor.Domain.Setups.SetupSlot.turnAngle","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S84-SLOT-PICKS"]},{"symbol":"OpticalConstructor.Domain.Setups.SetupSlot.fittingItems","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S84-SLOT-PICKS"]},{"symbol":"OpticalConstructor.Domain.Setups.SetupSlot.pickedByLetter","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/Setups.fs","obligations":["S84-SLOT-PICKS"]}],"packages":[],"checks":[]},"section":"S8.4 -- The slot bar, quick swap and the direct problem"}
{"number": 278, "anchor": "IMPLEMENT", "ac": "AC-S84b", "touches": ["OpticalConstructor.Ui", "OpticalConstructor.Tests"], "depends_on": [277], "how_to": "`RecordExperiment` as a semantic message: a new experiment of the draft over the active setup, however many the setup already has (001 §P `RecordExperiment`; 001 §J 'Direct problem: several experiments over one setup, saved in the kit'; 001 §O 'Slot bar over the table (§J), with \"Record experiment\"'). The slot bar's button that sends it is step 280's. Each doc is one to three lines citing spec 0050 S8.4. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `ExpCommit`'s two halves (steps 152, 261 (8)(b), 272) become two private functions of the update, so no second copy of either is written (AGENTS.md 'Reuse, never copy'): the table recorded as the active setup (the recorded slots, `revisedWith` over `pinFor` when a setup is active or the template's name made free otherwise, `recordSetup` unless the setup is unchanged, then `kitSetups` and `activeSetupOpt`), and the recording of the experiments a commit appended (`recordExperiment`, step 261 (7)(b)). `ExpCommit` and `GenerateSetupGrid` (step 276, which records each appended experiment as `ExpCommit` records one) call them, every text and outcome unchanged. (2) `TableAndElementRotationMsg` gains `RecordExperiment`, with a one-line doc: a new experiment of the draft over the active setup. (3) Its arm is refused by the read-only guard of step 185, which every write message calls. Otherwise a draft that cannot be committed (`ExperimentCollection.canCommit`, `Experiments.fs:canCommit`: no element or no variable chosen) sets `kitStatus` to `Not recorded — choose the element and the variable to vary in the Experiments bay first.` and writes nothing, and with no capture (`model.draftCapture`, `TableAndElementRotationView.fs:1555`: no detector captures the table) `Not recorded — no detector captures this table.` and writes nothing. Else the table is recorded as the active setup through the first function, whose error keeps the model with `ExpCommit`'s `Not saved to the kit — <e.describe>`; then the collection takes the capture (`Experiments.chooseMeasurement`) and `Experiments.commitOverSetups [ setup.reference ]` (step 275), which appends the draft as a new experiment over that one reference whether or not the draft edits one and leaves the draft editing nothing, and the appended experiment is recorded through the second function, whose error keeps the collection with the same text. On success `kitStatus` is `Recorded <the experiment's id> over <setup.reference.describe>.` (`Recorded E2 over 'Bench' revision 1.`). So the direct problem is any number of experiments over one setup, each its own `<id>.experiment-json`, and a table changed since its setup was recorded is recorded first, as a commit records it. `ExpCommit` keeps editing the experiment its draft edits; `RecordExperiment` never edits one. No other message, field or option is added. Tests, in `SetupModelTests` (steps 260-264), over its folder kit: `RecordExperiment appends a new experiment over the active setup each time, so one setup holds several experiments`: with a linear polarizer added, `SetSetupName (ControlCaption \"Bench\")` and `CreateSetup`, the polarizer chosen (`ExpChooseElement`), then `RecordExperiment`, the range's maximum changed (`ExpSetRangeMax`) and `RecordExperiment` again: the folder holds `E1.experiment-json` and `E2.experiment-json`, both referencing `'Bench' revision 1`, `E1` with the first range and `E2` with the changed one; the bytes of `Bench.setup-json` are those `CreateSetup` wrote; `kitStatus` is `Recorded E2 over 'Bench' revision 1.`; and the draft edits nothing. `RecordExperiment over a draft that edits an experiment appends another and leaves the edited one as it was`: after `E1` is recorded, `ExpEdit E1`, the range's maximum changed and `RecordExperiment` append `E2` with the changed range, and the bytes of `E1.experiment-json` are unchanged. `RecordExperiment records the table as ExpCommit does: a first setup for a table that is no setup yet, and the next revision over one an experiment references`: on a table that is no setup yet, with the polarizer chosen, `RecordExperiment` writes `Setup 1.setup-json` and `E1` over `'Setup 1' revision 1` and makes `Setup 1` active; the polarizer turned (`RotSetAxis (R1, BarDegrees 30.0)`, it being selected) and `RecordExperiment` again give `Setup 1` revision 2 with revision 1 in its history and `E2` over revision 2, `E1` still referencing revision 1. `RecordExperiment without a chosen element and variable is told and writes nothing`: after `ExpNew`, with nothing chosen, `RecordExperiment` sets a `kitStatus` starting `Not recorded` and the folder holds no experiment file. `KitWindowModelTests` (steps 185, 262, 273): `a kit opened read-only refuses every write message and writes nothing` also sends `RecordExperiment`, with the same assertions. Every `ExpCommit` and `GenerateSetupGrid` fact passes unchanged.", "acceptance": "After `RecordExperiment` lands, it MUST record the table as `ExpCommit` records it and append a new experiment of the draft over the active setup each time, never editing the draft's own, and refuse a draft that cannot be committed and a read-only kit with nothing written, `ExpCommit` and `GenerateSetupGrid` sharing its two halves unchanged; constructor-unit-tests MUST pass, including `RecordExperiment appends a new experiment over the active setup each time, so one setup holds several experiments`, `RecordExperiment over a draft that edits an experiment appends another and leaves the edited one as it was`, `RecordExperiment records the table as ExpCommit does: a first setup for a table that is no setup yet, and the next revision over one an experiment references` and `RecordExperiment without a chosen element and variable is told and writes nothing` and the changed `a kit opened read-only refuses every write message and writes nothing`, the count rising by 4; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, the count unchanged; and build, elevation and the sixteen s28 invariants MUST pass.", "required_gates": ["build", "elevation", "constructor-unit-tests", "ui-smoke", "ui-tests"], "gate_selection": {"constructor-unit-tests": {"mode": "all_discovered", "suite": "constructor-unit-tests"}, "ui-smoke": {"mode": "all_discovered", "suite": "ui-smoke"}, "ui-tests": {"mode": "selected", "suite": "ui-tests", "values": ["OpticalConstructor.Ui.Tests.ExperimentControlsTests", "OpticalConstructor.Ui.Tests.FsxAcceptanceTests", "OpticalConstructor.Ui.Tests.InverseConstructorTests", "OpticalConstructor.Ui.Tests.ScrollExtentTests", "OpticalConstructor.Ui.Tests.SetupSaveLoadTests", "OpticalConstructor.Ui.Tests.SolverHandoffWindowTests"]}}, "effects": {"edits": ["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs"], "tests": [{"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.RecordExperiment appends a new experiment over the active setup each time, so one setup holds several experiments", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S84-RECORD-EXPERIMENT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.RecordExperiment over a draft that edits an experiment appends another and leaves the edited one as it was", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S84-RECORD-EXPERIMENT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.RecordExperiment records the table as ExpCommit does: a first setup for a table that is no setup yet, and the next revision over one an experiment references", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S84-RECORD-EXPERIMENT"]}, {"op": "create", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.SetupModelTests.RecordExperiment without a chosen element and variable is told and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs", "class": "OpticalConstructor.Tests.SetupModelTests", "discovery_gate": "constructor-unit-tests", "obligations": ["S84-RECORD-EXPERIMENT"]}, {"op": "change_expectation", "suite": "constructor-unit-tests", "id": "OpticalConstructor.Tests.KitWindowModelTests.a kit opened read-only refuses every write message and writes nothing", "path": "Berreman/OpticalConstructor/OpticalConstructor.Tests/KitWindowModelTests.fs", "obligations": ["S84-RECORD-EXPERIMENT"]}], "contracts": [{"symbol": "OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.RecordExperiment", "op": "create", "path": "Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs", "obligations": ["S84-RECORD-EXPERIMENT"]}], "packages": [], "checks": []}, "section": "S8.4 -- The slot bar, quick swap and the direct problem"}
{"number":279,"anchor":"IMPLEMENT","ac":"AC-S84c","touches":["OpticalConstructor.Ui","OpticalConstructor.Tests"],"depends_on":[278],"how_to":"The slot bar's state in the window model: which chip's list is open and what each chip lists (001 §J 'each dropdown lists compatible items only; choosing one is either a new setup or an existing one'; .spec-md §4 'UI': every user step is a semantic message). The bar that shows it is step 280's. Each doc is one to three lines citing spec 0050 S8.4. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `TableAndElementRotationModel` gains `slotChipOpenOpt : Library.ElementId option`, the slot whose chip's list is open, with a one-line doc; `initWith` sets it to `None`. (2) On the model extension holding `tryItemModelChoice` (step 263): `member model.slotChipItems (slot : Setups.SetupSlot) : Item list` is `slot.fittingItems model.kitItems model.tryItemModelChoice` (step 277), what that slot's chip lists. (3) `TableAndElementRotationMsg` gains `ToggleSlotChip of Library.ElementId`, with a one-line doc: open that slot's chip list, or close it when it is the open one. Its arm writes nothing, so a read-only kit takes it: for a slot of `elements` it sets `slotChipOpenOpt` to `Some` the id, or to `None` when that id is the open one; an id the table lacks leaves the model as it is. (4) `SwapSlot`'s arm (steps 264, 272) also sets `slotChipOpenOpt` to `None` on every outcome, so a pick closes the list whether the swap switched, created or was refused. No other message, field or option is added. Tests, in `SetupModelTests` (steps 263, 264), whose kit holds the items `LP1`, `QZ`, `Laser`, `LPd` and `QZ2`: `a slot's chip lists the kit's items that fit it`: with a linear polarizer and a sample added, `slotChipItems` of the polarizer's slot is exactly `LP1` and `LPd`, in the order `kitItems` holds them, of the sample's `QZ` and `QZ2`, of the light source's `Laser` and of the seeded detector's none. `ToggleSlotChip opens one chip's list at a time, and a swap closes it`: `ToggleSlotChip` of the sample sets `slotChipOpenOpt` to it, of the polarizer moves it there, and of the polarizer again closes it; `ToggleSlotChip` of an id the table lacks changes nothing; the toggles change no kit file; and with the sample's list open, `SwapSlot (sample, QZ2)` closes it. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the chip state lands, `model.slotChipItems` MUST list the kit items that fit a slot, `ToggleSlotChip` MUST open one chip's list at a time and close the open one, writing nothing, and `SwapSlot` MUST close the list; constructor-unit-tests MUST pass, including `a slot's chip lists the kit's items that fit it` and `ToggleSlotChip opens one chip's list at a time, and a swap closes it`, the count rising by 2; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, the count unchanged; and build, elevation and the sixteen s28 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.SetupSaveLoadTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.a slot's chip lists the kit's items that fit it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S84-SLOT-CHIP-STATE"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.ToggleSlotChip opens one chip's list at a time, and a swap closes it","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S84-SLOT-CHIP-STATE"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.slotChipOpenOpt","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-SLOT-CHIP-STATE"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.slotChipItems","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-SLOT-CHIP-STATE"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.ToggleSlotChip","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-SLOT-CHIP-STATE"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.SwapSlot","op":"change_behavior","obligations":["S84-SLOT-CHIP-STATE"]}],"packages":[],"checks":[]},"section":"S8.4 -- The slot bar, quick swap and the direct problem"}
{"number":280,"anchor":"IMPLEMENT","ac":"AC-S84d","touches":["OpticalConstructor.Controls","OpticalConstructor.Ui","OpticalConstructor.Ui.Tests"],"depends_on":[279],"actions":["ADD_TEST OpticalConstructor.Ui.Tests.SlotBarTests"],"how_to":"The slot bar above the table, in a file of its own (001 §J 'Quick swap: a slot bar above the table shows one chip per slot (`Source: Laser | Prep: CPL1 ▾ | Obj 1: QZ ▾ @ 45° ▾ | … | Detector: Phone`); each dropdown lists compatible items only; choosing one is either a new setup or an existing one; keyboard: Tab between chips, letters pick'; 001 §O 'Slot bar over the table (§J), with \"Record experiment\"' and 'Automation': `SlotChip_<slot>`; the S8.4 brief; .spec-md §4 'UI'). The bar sits inside the main page directly above the table, so it is compiled before `TableAndElementRotationView.fs` as a projection of its own state and handler records, the shape of the Experiments bay (`ExperimentControls.fs:experimentControlsView`, over the handlers `TableAndElementRotationView.fs:experimentHandlers` builds), and the main view docks it. Each doc is one to three lines citing spec 0050 S8.4. (1) `OpticalConstructor.Controls/UiIds.fs`: a new group after the flow-strip group (step 242), `// --- The slot bar over the table (SlotBarView). ---`, each member with a one-line doc: `slotBar` (`\"SlotBar\"`), `slotChipChoiceList` (`\"SlotChipChoiceList\"`) and `recordExperimentButton` (`\"RecordExperimentButton\"`). (2) `OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs`, each declaration with a one-line doc: `type Setups.SlotRole with member this.uiKey : ConstructorUiKey`, the role's `text` (step 257) without its spaces (`Source`, `Prep1`, `Obj2`, `Analyzer1`, `Detector1`); on the `ConstructorUiId` extension that holds `ConstructorUiIdOfDomain.fs:elementHover`, `static member slotChip (role : Setups.SlotRole) : ConstructorUiId` (`SlotChip_<role.uiKey>`) and `static member slotChipChoice (role : Setups.SlotRole) (item : Kit.ItemId) : ConstructorUiId` (`SlotChipChoice_<role.uiKey>_<the item's GUID>`); `type Kit.ItemLabel with member this.caption : ControlCaption`, the label's text; `type Angle with member this.degreeCaption : ControlCaption`, its degrees as the rotation bar writes them (`RotationControls.fs:51`, `BarDegrees.text`: at most two decimals, invariant culture) followed by `°`; and `type Setups.RoledSlot with member this.chipCaption (items : Kit.Item list) : ControlCaption`: `<role.text>: <the label of the item the slot holds>`, `<role.text>: —` when it holds nothing and `<role.text>: (not in this kit)` when `items` lacks its item, an `ObjectSlotRole` holding an item adding ` @ <slot.turnAngle.degreeCaption>` (step 277), the angle the naming template writes for it (step 271). (3) New `OpticalConstructor.Ui/SlotBarView.fs`, `module OpticalConstructor.Ui.SlotBarView`, compiled directly before `TableAndElementRotationView.fs`: one `<Compile>` line in `OpticalConstructor.Ui.fsproj` and no comment, and a module doc of one to three lines. It declares, each with a one-line doc: `SlotChipState = { roled : Setups.RoledSlot; caption : ControlCaption; fitting : Kit.Item list }`, one chip; `SlotBarState = { chips : SlotChipState list; openOpt : Library.ElementId option; recordAvailability : ControlAvailability }`; and `SlotBarHandlers = { toggleChip : Library.ElementId -> unit; swapSlot : Library.ElementId -> Kit.ItemId -> unit; pickByLetter : Library.ElementId -> Setups.PickLetter -> unit; recordExperiment : unit -> unit }`; and `slotBarView (state : SlotBarState) (handlers : SlotBarHandlers) : IView`, documented in one to three lines. The view is a vertical `StackPanel` carrying `slotBar`, margin 8, 4, holding: (a) a `WrapPanel` (in a vertical block, AGENTS.md) of one chip per `chips` entry, in order, then, when `recordAvailability` is `ControlOffered`, the verb `Record experiment` (`MaterialsWindowView.verbButton`, public since step 107, carrying `recordExperimentButton`, calling `recordExperiment`). A chip is a `Border` carrying `slotChip roled.role`, focusable and a tab stop, in the box look of `MaterialsWindowView.verbButton` (on `positiveBackground` while its list is open), whose child reads `<caption> ▾`; a press focuses it and calls `toggleChip` with its slot; a text typed while it has the focus is read by `PickLetter.tryCreate` (step 277), an answer calling `pickByLetter` with its slot, the event handled. So Tab moves between the chips in light order and a letter picks. (b) While `openOpt` names a chip's slot: a `WrapPanel` carrying `slotChipChoiceList` holding, for each item of that chip's `fitting`, a box carrying `slotChipChoice role item.id` with `item.label.caption`: the item the slot holds an `actionButton` on `positiveBackground` that calls `toggleChip` (closing the list: there is nothing to swap), every other a `verbButton` that calls `swapSlot` with the slot and the item; with no fitting item, the line `No item of this kit fits <role.text>.`. Every id is an AutomationId. (4) `OpticalConstructor.Ui/TableAndElementRotationView.fs`: on the model extension holding `slotChipItems` (step 279), `member model.slotBarState : SlotBarView.SlotBarState`: a chip per `SetupSlot.inLightOrder model.elements` (step 257), in that order, captioned by `chipCaption model.kitItems` and listing `model.slotChipItems slot`; `openOpt` is `slotChipOpenOpt`; and `recordAvailability` is `model.kitWrites` (step 185). A private `slotBarHandlers (model : TableAndElementRotationModel) (dispatch : TableAndElementRotationMsg -> unit) : SlotBarView.SlotBarHandlers` beside `experimentHandlers` dispatches `ToggleSlotChip`, `SwapSlot` and `RecordExperiment`, and resolves `pickByLetter` against the model: the slot of that id in `elements`, its `pickedByLetter letter (model.slotChipItems slot)` and `SwapSlot` of the picked item, no pick dispatching nothing. `mainView`'s table surface (`TableAndElementRotationView.fs:3944`, `tableSurface`) becomes a `DockPanel` whose top is `SlotBarView.slotBarView model.slotBarState (slotBarHandlers model dispatch)` and whose fill is the panel it holds today, so the canvas, its gestures, the element menu overlay and the page's scrolling are unchanged; a full-surface bay shows no table and no bar. The comment above it gains, in no more words than it needs, that the slot bar sits above the table. No other message, field, id or option is added. Tests: new `OpticalConstructor.Ui.Tests/SlotBarTests.fs`, `module SlotBarTests` in `namespace OpticalConstructor.Ui.Tests`, appended at the end of the compile list with no comment, mounting `mainView` in a `HostWindow` as `ScrollExtentTests.fs:constructorWindow` (`:107`) mounts it, headless at 1000 × 900, over `initMain ()` driven through its messages: its scratch kit holds the items `Laser` (the HeNe preset), `LP1` and `LP2` (the linear-polarizer preset, `FixedMounting`), `QZ` and `QZ2` (the glass plates at version 1), added through the Items panel's messages (`OpenAddItemForm`, `ChooseNewItemModel`, `SetNewItemLabel`, `AddItem`, step 239), and a linear polarizer and a sample are added (`AddElement`) so that the light meets them in that order before the seeded detector. Without a trait: `the slot bar UiIds are the stable intent-named ids`: the three fixed ids' texts; `slotChip` of `SourceSlotRole`, `PrepSlotRole (SlotPosition 1)`, `ObjectSlotRole (SlotPosition 2)`, `AnalyzerSlotRole (SlotPosition 1)` and `DetectorSlotRole (SlotPosition 1)` is `SlotChip_Source`, `SlotChip_Prep1`, `SlotChip_Obj2`, `SlotChip_Analyzer1` and `SlotChip_Detector1`; and `slotChipChoice (ObjectSlotRole (SlotPosition 1))` of a test-local item id is `SlotChipChoice_Obj1_<its GUID>`. `the slot bar shows one chip per slot in light order above the table, each naming its item and an object its angle`: with `Laser`, `LP1` and `QZ` assigned to the source, the polarizer and the sample (`AssignSlot`, step 263) and the sample turned to R1 45° (`RotSetAxis (R1, BarDegrees 45.0)`, it being selected), the chips of Source, Prep 1, Obj 1 and Detector 1 are present left to right on one row, reading `Source: Laser ▾`, `Prep 1: LP1 ▾`, `Obj 1: QZ @ 45° ▾` and `Detector 1: — ▾`, and the bar's bottom is above the top of `tableElementCanvas`. `an open chip lists only the kit's items that fit its slot`: after `ToggleSlotChip` of the polarizer, `slotChipChoiceList` holds the boxes `slotChipChoice` of `LP1` and `LP2` and none of `Laser`, `QZ` or `QZ2`; after `ToggleSlotChip` of the detector it holds the line `No item of this kit fits Detector 1.`. `Tab moves between the chips in light order, and a typed letter picks the next fitting item`: over `the slot bar shows one chip per slot in light order above the table, each naming its item and an object its angle`'s model, with the Prep 1 chip focused, one Tab (`KeyPressQwerty` then `KeyReleaseQwerty` of `PhysicalKey.Tab`, as `EmbeddedChartTests.fs:156` presses Enter) leaves the Obj 1 chip focused (the window's `FocusManager`), and a second the Detector 1 chip; with the Obj 1 chip focused, `window.KeyTextInput(\"q\")` (as `FacetedTreeControlsTests.fs:403` types) makes the sample hold `QZ2`; with it focused again, a second `q` makes it hold `QZ`, and `x` changes nothing. With trait `ui-smoke`, pressing boxes at their centre as `LibraryWindowTests.fs:clickOn` (`:69`) does: `pressing a chip and an item swaps the table to a kit setup that holds it`: over `the slot bar shows one chip per slot in light order above the table, each naming its item and an object its angle`'s model, pressing the Obj 1 chip shows `slotChipChoiceList`, and pressing `QZ2`'s box closes it, the chip reading `Obj 1: QZ2 @ 45° ▾` and the scratch kit's `readSetups ()` answering one setup whose sample slot holds `QZ2`. `pressing Record experiment twice records two experiments over the active setup`: with `SetSetupName (ControlCaption \"Bench\")`, `CreateSetup` and the polarizer chosen (`ExpChooseElement`), pressing `recordExperimentButton` twice leaves the scratch kit's `readExperiments ()` answering `E1` and `E2`, both over `'Bench' revision 1`. `KitWindowTests` (steps 185, 262): `a read-only window withholds every write control` also finds no `recordExperimentButton`.","acceptance":"After the slot bar lands, `SlotBarView.slotBarView` MUST show, directly above the table, one focusable chip per slot in light order under `ConstructorUiId.slotChip`, each naming its item and an object its angle, the open chip's list of fitting items under `slotChipChoice` sending `SwapSlot`, Tab moving between the chips and a typed letter picking, and `Record experiment` sending `RecordExperiment`, withheld under a read-only kit; constructor-unit-tests MUST pass; ui-smoke MUST pass, including `pressing a chip and an item swaps the table to a kit setup that holds it` and `pressing Record experiment twice records two experiments over the active setup`, the count rising by 2; ui-tests MUST pass over the selected classes, including `the slot bar UiIds are the stable intent-named ids`, `the slot bar shows one chip per slot in light order above the table, each naming its item and an object its angle`, `an open chip lists only the kit's items that fit its slot` and `Tab moves between the chips in light order, and a typed letter picks the next fitting item` and the changed `a read-only window withholds every write control`, the count rising by 4; and build, elevation and the sixteen s28 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.AppContextTests","OpticalConstructor.Ui.Tests.ElementMenuTests","OpticalConstructor.Ui.Tests.ExperimentControlsTests","OpticalConstructor.Ui.Tests.FsxAcceptanceTests","OpticalConstructor.Ui.Tests.InverseConstructorTests","OpticalConstructor.Ui.Tests.KitWindowTests","OpticalConstructor.Ui.Tests.LayerBandsControlsTests","OpticalConstructor.Ui.Tests.LibraryControlsTests","OpticalConstructor.Ui.Tests.LibraryWindowTests","OpticalConstructor.Ui.Tests.LightSourceEditorTests","OpticalConstructor.Ui.Tests.MainSceneMsgTests","OpticalConstructor.Ui.Tests.MainWorkbenchTests","OpticalConstructor.Ui.Tests.MaterialsWindowTests","OpticalConstructor.Ui.Tests.OutOfBandBadgeTests","OpticalConstructor.Ui.Tests.ScrollExtentTests","OpticalConstructor.Ui.Tests.SlotBarTests","OpticalConstructor.Ui.Tests.SourceAndDetectorMoveTests","OpticalConstructor.Ui.Tests.WorkbenchInfoAndCaptureTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/SlotBarView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/OpticalConstructor.Ui.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OpticalConstructor.Ui.Tests.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs"],"tests":[{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SlotBarTests.the slot bar UiIds are the stable intent-named ids","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","class":"OpticalConstructor.Ui.Tests.SlotBarTests","discovery_gate":"ui-tests","obligations":["S84-SLOT-BAR-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SlotBarTests.the slot bar shows one chip per slot in light order above the table, each naming its item and an object its angle","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","class":"OpticalConstructor.Ui.Tests.SlotBarTests","discovery_gate":"ui-tests","obligations":["S84-SLOT-BAR-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SlotBarTests.an open chip lists only the kit's items that fit its slot","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","class":"OpticalConstructor.Ui.Tests.SlotBarTests","discovery_gate":"ui-tests","obligations":["S84-SLOT-BAR-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SlotBarTests.Tab moves between the chips in light order, and a typed letter picks the next fitting item","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","class":"OpticalConstructor.Ui.Tests.SlotBarTests","discovery_gate":"ui-tests","obligations":["S84-SLOT-BAR-VIEW"]},{"op":"create","suite":"ui-smoke","id":"OpticalConstructor.Ui.Tests.SlotBarTests.pressing a chip and an item swaps the table to a kit setup that holds it","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","class":"OpticalConstructor.Ui.Tests.SlotBarTests","discovery_gate":"ui-smoke","obligations":["S84-SLOT-BAR-VIEW"]},{"op":"create","suite":"ui-smoke","id":"OpticalConstructor.Ui.Tests.SlotBarTests.pressing Record experiment twice records two experiments over the active setup","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","class":"OpticalConstructor.Ui.Tests.SlotBarTests","discovery_gate":"ui-smoke","obligations":["S84-SLOT-BAR-VIEW"]},{"op":"change_expectation","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.KitWindowTests.a read-only window withholds every write control","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/KitWindowTests.fs","obligations":["S84-SLOT-BAR-VIEW"]}],"contracts":[{"symbol":"OpticalConstructor.Controls.ConstructorUiId.slotBar","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.slotChipChoiceList","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Controls.ConstructorUiId.recordExperimentButton","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.ConstructorUiIdOfDomain.SlotRole.uiKey","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.ConstructorUiIdOfDomain.slotChip","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.ConstructorUiIdOfDomain.slotChipChoice","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.ConstructorUiIdOfDomain.ItemLabel.caption","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.ConstructorUiIdOfDomain.Angle.degreeCaption","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.ConstructorUiIdOfDomain.RoledSlot.chipCaption","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.SlotBarView.SlotChipState","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/SlotBarView.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.SlotBarView.SlotBarState","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/SlotBarView.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.SlotBarView.SlotBarHandlers","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/SlotBarView.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.SlotBarView.slotBarView","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/SlotBarView.fs","obligations":["S84-SLOT-BAR-VIEW"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.slotBarState","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-SLOT-BAR-VIEW"]}],"packages":[],"checks":[]},"section":"S8.4 -- The slot bar, quick swap and the direct problem"}
{"number":281,"anchor":"IMPLEMENT","ac":"AC-S84e","touches":["OpticalConstructor.Domain","OpticalConstructor.Tests"],"depends_on":[280],"how_to":"The grid generator's editable options as pure Domain, so the panel that edits them holds no rule of its own (001 §J 'Grid generator: a set of options per slot → their product, with impossible or unwanted combinations unticked → all setups and experiments created at once'; S8.3's grid, step 274, whose controls are S8.4's; AGENTS.md 'State is separable from the UI'). Each doc is one to three lines citing spec 0050 S8.4. In `OpticalConstructor.Domain/SetupGrids.fs`, after `SetupGrid` (step 274): (1) `GridSlotDraft = { slot : Library.ElementId; items : ItemId list; angles : Angle list }`, one slot's options as the panel edits them: the items tried in it and the R1 angles each is tried at. (2) `SetupGridDraft = { slots : GridSlotDraft list; unticked : GridCombination list }`, every edited slot's draft in the order first edited and the combinations the user unticked, with: `static member empty : SetupGridDraft` (no slot, nothing unticked); `member this.slotDraft (slot : Library.ElementId) : GridSlotDraft`, the slot's draft, or one with no item and no angle; `member this.withItemToggled (slot : Library.ElementId) (item : ItemId) : SetupGridDraft`, the item appended to the slot's items, or removed when they hold it; `member this.withGridAngle (slot : Library.ElementId) (angle : Angle) : SetupGridDraft`, the angle appended to the slot's angles when they do not hold it; `member this.withoutGridAngle (slot : Library.ElementId) (angle : Angle) : SetupGridDraft`, the angle removed; `member this.withCombinationToggled (combination : GridCombination) : SetupGridDraft`, the combination removed from `unticked` when it holds it and appended otherwise; and `member this.gridOver (table : SetupSlot list) (items : Item list) (choiceOf : Item -> ItemModelChoice option) : SetupGrid`. A slot draft left with no item and no angle is dropped from `slots`, so an edit undone leaves the draft as it was. `gridOver` takes one axis per slot of `SetupSlot.inLightOrder table` (step 257), in that order, whose draft holds an item: its `choices` are, for each item in order, a `SlotChoice` of `Some item` at each angle in order, or at the slot's `placement.r1` when the draft lists no angle; a draft of a slot the table lacks gives no axis. The grid is `SetupGrid.create` over those axes (step 274), so its impossible combinations start unticked, its `unticked` then extended by the draft's `unticked` combinations that it lists and does not already hold, in the draft's order. Editing a slot's options re-lists the combinations, so an untick lasts while its combination is listed. Nothing is written. No cache, sort or other member is added. Tests, in `SetupGridTests` (step 274), over its fixture (the slots `src`, `lpA`, `sampleA`, `lpB` and `det`, the items `Laser`, `CPL1`, `CPL2`, `QZ` and `LR`, `Ghost` and `choiceOf`): `a grid draft tries each ticked item of a slot at each of its angles, its slots in light order`: a draft that toggles `CPL2` into `lpB` and then `QZ` and `LR` into `sampleA` with the angles 0° and 45° lists, through `gridOver`, the axes `sampleA` {`QZ` 0°, `QZ` 45°, `LR` 0°, `LR` 45°} and then `lpB` {`CPL2` at `lpB`'s R1}, and four combinations, each with `CPL2`. `ticking an item or adding an angle twice changes nothing more, removing undoes it, and a slot with no item is no axis`: toggling `QZ` into `sampleA` twice leaves `SetupGridDraft.empty`; `withGridAngle` of 0° twice lists 0° once and `withoutGridAngle` of it then lists none; a slot with an angle and no item gives no axis; a draft of an id the table lacks gives no axis; and `slotDraft` of a slot never edited holds no item and no angle. `a draft's unticked combinations stay unticked beside the impossible ones while they are listed`: over `sampleA` {`QZ`, `Ghost`} at its R1, the grid starts with `Ghost`'s combination unticked; `withCombinationToggled` of `QZ`'s makes the grid's `unticked` `Ghost`'s then `QZ`'s and its `ticked` empty; toggling it again ticks it; and after `QZ` is toggled out of the slot, the grid's `unticked` holds `Ghost`'s alone. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the grid draft lands, `SetupGrids.fs` MUST hold `GridSlotDraft` and `SetupGridDraft`, whose edits toggle items, angles and unticked combinations and whose `gridOver` MUST make, in light order, one axis per slot holding an item, each item at each angle, through `SetupGrid.create` with the user's unticks kept while listed; constructor-unit-tests MUST pass, including `a grid draft tries each ticked item of a slot at each of its angles, its slots in light order`, `ticking an item or adding an angle twice changes nothing more, removing undoes it, and a slot with no item is no axis` and `a draft's unticked combinations stay unticked beside the impossible ones while they are listed`, the count rising by 3; and build, elevation and the sixteen s28 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.a grid draft tries each ticked item of a slot at each of its angles, its slots in light order","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S84-GRID-DRAFT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.ticking an item or adding an angle twice changes nothing more, removing undoes it, and a slot with no item is no axis","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S84-GRID-DRAFT"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupGridTests.a draft's unticked combinations stay unticked beside the impossible ones while they are listed","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupGridTests.fs","class":"OpticalConstructor.Tests.SetupGridTests","discovery_gate":"constructor-unit-tests","obligations":["S84-GRID-DRAFT"]}],"contracts":[{"symbol":"OpticalConstructor.Domain.SetupGrids.GridSlotDraft","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S84-GRID-DRAFT"]},{"symbol":"OpticalConstructor.Domain.SetupGrids.SetupGridDraft","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Domain/SetupGrids.fs","obligations":["S84-GRID-DRAFT"]}],"packages":[],"checks":[]},"section":"S8.4 -- The slot bar, quick swap and the direct problem"}
{"number":282,"anchor":"IMPLEMENT","ac":"AC-S84f","touches":["OpticalConstructor.Ui","OpticalConstructor.Tests"],"depends_on":[281],"how_to":"The grid generator's edits as semantic messages over the window model (001 §J 'Grid generator'; 001 §P `GenerateSetupGrid`, step 276's message, which the panel sends; .spec-md §4 'UI'). The panel that sends them is step 283's. Each doc is one to three lines citing spec 0050 S8.4. In `OpticalConstructor.Ui/TableAndElementRotationView.fs`: (1) `TableAndElementRotationModel` gains `setupGridOpt : SetupGrids.SetupGridDraft option`, the grid panel's draft while the panel is open, with a one-line doc; `initWith` sets it to `None`. (2) On the model extension holding `slotChipItems` (step 279): `member model.setupGrid : SetupGrids.SetupGrid option`, the open draft's `gridOver model.elements model.kitItems model.tryItemModelChoice` (step 281), `None` while the panel is closed. (3) `TableAndElementRotationMsg` gains, each with a one-line doc: `OpenSetupGrid` (open the grid panel), `CloseSetupGrid` (close it, forgetting its draft), `ToggleSetupGridItem of Library.ElementId * ItemId` (try the item in that slot, or stop trying it), `AddSetupGridAngle of Library.ElementId * RotationControls.BarDegrees` (try that slot's items at this R1 too), `RemoveSetupGridAngle of Library.ElementId * Angle` (stop trying that R1) and `ToggleSetupGridCombination of SetupGrids.GridCombination` (untick a ticked combination, or tick it again). (4) Arms. None writes, so a read-only kit takes them all. `OpenSetupGrid` sets `setupGridOpt` to `Some SetupGridDraft.empty`, keeping a draft already open; `CloseSetupGrid` sets it to `None`. With a draft open, `ToggleSetupGridItem (slot, item)` sets it to `withItemToggled slot item`, `AddSetupGridAngle (slot, d)` to `withGridAngle slot d.wrappedAngle` (`TableAndElementRotationView.fs:815`, the table's angle convention), `RemoveSetupGridAngle (slot, a)` to `withoutGridAngle slot a` and `ToggleSetupGridCombination c` to `withCombinationToggled c`; with none open each leaves the model as it is. An item that does not fit its slot is the grid's to refuse: its combinations start unticked (step 274) and the panel shows why (step 283). `GenerateSetupGrid` (step 276) is unchanged: the panel sends it with `model.setupGrid`, and the draft stays open, so a grid can be edited and generated again. No other message, field or option is added. Tests, in `SetupModelTests` (steps 272, 276), over step 272's table (`LP1` in the first linear polarizer, the sample, `LPd` in the second) and its kit's items: `the grid panel's draft lists the product of the items and angles tried in a slot, and writes nothing`: `OpenSetupGrid` gives a grid with no axis; `ToggleSetupGridItem` of the sample with `QZ` and `QZ2` and `AddSetupGridAngle` of the sample with `BarDegrees 0.0` and `BarDegrees 45.0` list (`QZ`, 0°), (`QZ`, 45°), (`QZ2`, 0°), (`QZ2`, 45°), all ticked; `RemoveSetupGridAngle` of 45° leaves (`QZ`, 0°) and (`QZ2`, 0°); toggling `QZ2` again leaves (`QZ`, 0°); `AddSetupGridAngle` of `BarDegrees -45.0` adds 315°; and no kit file's bytes change. `unticking a combination in the panel leaves it out, and closing the panel forgets the draft`: `ToggleSetupGridCombination` of (`QZ2`, 0°) leaves the other three ticked, and again all four; `CloseSetupGrid` makes `setupGridOpt` and `model.setupGrid` `None`, and `OpenSetupGrid` then opens an empty draft. `the panel's grid generates its ticked setups through GenerateSetupGrid and stays open`: with the first polarizer chosen (`ExpChooseElement`) and a draft of `QZ` and `QZ2` at 0° and 45° with (`QZ2`, 45°) unticked, `GenerateSetupGrid` of `model.setupGrid` leaves the kit holding `LP1-(QZ#0)-LPd.setup-json`, `LP1-(QZ#45)-LPd.setup-json` and `LP1-(QZ2#0)-LPd.setup-json` and `E1` to `E3` over them in that order, `kitStatus` `Generated 3 setups (3 new) and 3 experiments.`, and the draft still open. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the grid messages land, `OpenSetupGrid`, `CloseSetupGrid`, `ToggleSetupGridItem`, `AddSetupGridAngle`, `RemoveSetupGridAngle` and `ToggleSetupGridCombination` MUST edit the open grid draft through its Domain members, writing nothing, and `model.setupGrid` MUST be the draft's grid over the table, which `GenerateSetupGrid` records; constructor-unit-tests MUST pass, including `the grid panel's draft lists the product of the items and angles tried in a slot, and writes nothing`, `unticking a combination in the panel leaves it out, and closing the panel forgets the draft` and `the panel's grid generates its ticked setups through GenerateSetupGrid and stays open`, the count rising by 3; ui-smoke MUST pass; ui-tests MUST pass over the selected classes, the count unchanged; and build, elevation and the sixteen s28 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.InverseConstructorTests","OpticalConstructor.Ui.Tests.SetupSaveLoadTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs"],"tests":[{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.the grid panel's draft lists the product of the items and angles tried in a slot, and writes nothing","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S84-GRID-MESSAGES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.unticking a combination in the panel leaves it out, and closing the panel forgets the draft","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S84-GRID-MESSAGES"]},{"op":"create","suite":"constructor-unit-tests","id":"OpticalConstructor.Tests.SetupModelTests.the panel's grid generates its ticked setups through GenerateSetupGrid and stays open","path":"Berreman/OpticalConstructor/OpticalConstructor.Tests/SetupModelTests.fs","class":"OpticalConstructor.Tests.SetupModelTests","discovery_gate":"constructor-unit-tests","obligations":["S84-GRID-MESSAGES"]}],"contracts":[{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.setupGridOpt","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationModel.setupGrid","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.OpenSetupGrid","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.CloseSetupGrid","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.ToggleSetupGridItem","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.AddSetupGridAngle","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.RemoveSetupGridAngle","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]},{"symbol":"OpticalConstructor.Ui.TableAndElementRotationView.TableAndElementRotationMsg.ToggleSetupGridCombination","op":"create","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","obligations":["S84-GRID-MESSAGES"]}],"packages":[],"checks":[]},"section":"S8.4 -- The slot bar, quick swap and the direct problem"}
{"number":283,"anchor":"IMPLEMENT","ac":"AC-S84g","touches":["OpticalConstructor.Controls","OpticalConstructor.Ui","OpticalConstructor.Ui.Tests"],"depends_on":[282],"actions":["ADD_TEST OpticalConstructor.Ui.Tests.SetupGridPanelTests"],"how_to":"The grid generator's panel, a surface in a file of its own, opened from the slot bar and shown between it and the table (001 §O 'Slot bar over the table (§J), with \"Record experiment\"; the grid generator' and 'Automation': `SetupGridGenerateButton`; 001 §J 'Grid generator'; the S8.4 brief: 'The grid-generator UI (SetupGridGenerateButton) runs over S8.3'; .spec-md §4 'UI', §10.5). Like the slot bar (step 280) it is compiled before `TableAndElementRotationView.fs` as a projection of its own state and handler records. Each doc is one to three lines citing spec 0050 S8.4. (1) `OpticalConstructor.Controls/UiIds.fs`: in the slot-bar group (step 280), `setupGridOpenButton` (`\"SetupGridOpenButton\"`); and a new group after it, `// --- The setup grid generator (SetupGridView). ---`: `setupGridPanel` (`\"SetupGridPanel\"`), `setupGridCombinationList` (`\"SetupGridCombinationList\"`), `setupGridGenerateButton` (`\"SetupGridGenerateButton\"`, 001 §O's id), `setupGridCloseButton` (`\"SetupGridCloseButton\"`) and `static member setupGridCombination (position : ConstructorUiPosition) : ConstructorUiId` (`SetupGridCombination_<n>`, over `UiIds.fs:ConstructorUiPosition`), each with a one-line doc. (2) `OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs`, each with a one-line doc: on the `ConstructorUiId` extension, `static member setupGridItemChoice (role : Setups.SlotRole) (item : Kit.ItemId) : ConstructorUiId` (`SetupGridItem_<role.uiKey>_<the item's GUID>`), `static member setupGridAngleField (role : Setups.SlotRole) : ConstructorUiId` (`SetupGridAngleField_<role.uiKey>`) and `static member setupGridAngle (role : Setups.SlotRole) (angle : Angle) : ConstructorUiId` (`SetupGridAngle_<role.uiKey>_<the angle's degrees as degreeCaption writes them, without the °>`); and `type SetupGrids.GridCombination with member this.caption (table : Setups.SetupSlot list) (items : Kit.Item list) : ControlCaption`: each pick, in order, as `<the role.text of its slot in the table's light order>: <the item's label> @ <r1.degreeCaption>` (`—` for nothing, `(not in this kit)` for an item `items` lacks), joined by `, `, and `The table as it is` for a combination of no pick. (3) New `OpticalConstructor.Ui/SetupGridView.fs`, `module OpticalConstructor.Ui.SetupGridView`, compiled directly after `SlotBarView.fs` and before `TableAndElementRotationView.fs`: one `<Compile>` line and no comment, and a module doc of one to three lines. It declares, each with a one-line doc: `GridCombinationMark` = `CombinationTicked` | `CombinationUnticked` | `CombinationImpossible of reason : ControlCaption`, never stored, so with no wire tag; `GridCombinationState = { combination : SetupGrids.GridCombination; caption : ControlCaption; mark : GridCombinationMark }`; `SetupGridSlotState = { roled : Setups.RoledSlot; fitting : Kit.Item list; draft : SetupGrids.GridSlotDraft }`; `SetupGridState = { grid : SetupGrids.SetupGrid; slots : SetupGridSlotState list; rows : GridCombinationState list; generateAvailability : ControlAvailability }`; and `SetupGridHandlers = { toggleItem : Library.ElementId -> Kit.ItemId -> unit; addAngle : Library.ElementId -> RotationControls.BarDegrees -> unit; removeAngle : Library.ElementId -> Angle -> unit; toggleCombination : SetupGrids.GridCombination -> unit; generateGrid : SetupGrids.SetupGrid -> unit; closeGrid : unit -> unit }`; and `setupGridView (state : SetupGridState) (handlers : SetupGridHandlers) : IView`. The view is a `Border` carrying `setupGridPanel`, margin 8, 0, 8, 4, over a vertical `StackPanel` holding: (a) the semi-bold `Setup grid` and the wrapping line `Choose the items and the R1 angles to try in each slot. Every ticked combination becomes a setup of the kit, with an experiment of the draft over each.`; (b) for each of `slots`, a `DockPanel` whose left is `<role.text>:` and whose fill is a `WrapPanel` holding each `fitting` item as a box carrying `setupGridItemChoice role item.id` with `item.label.caption`, an `actionButton` on `positiveBackground` while the draft holds the item and a `verbButton` otherwise, either calling `toggleItem`; then `R1 (°):` and a `TextBox` carrying `setupGridAngleField role`, width 60, whose text on Enter or losing focus is read by `BarDegrees.tryCreate` (`RotationControls.fs:60`) and, when it reads, passed to `addAngle` and the field cleared, an unreadable text being left as typed and ignored (the rotation bar's field rule, `RotationControls.fs:236`); then each of the draft's angles as a box carrying `setupGridAngle role angle` reading `<angle.degreeCaption> ×` and calling `removeAngle`; (c) `Combinations:` over a vertical `StackPanel` carrying `setupGridCombinationList`, one line per `rows` entry in order carrying `setupGridCombination` of its 1-based position: a ticked one a box reading `☑ <caption>`, an unticked one `☐ <caption>`, either calling `toggleCombination` (the element menu's marks, `TableAndElementRotationView.fs:3733`), and an impossible one a `TextBlock` reading `✗ <caption> — <reason>` in `MaterialsWindowView.messageColor`, which takes no press; (d) one horizontal `StackPanel` of `Generate` (`setupGridGenerateButton`, an `actionButton` on `positiveBackground` calling `generateGrid grid`, present only when `generateAvailability` is `ControlOffered`) and `Close` (`setupGridCloseButton`, on `negativeBackground`, calling `closeGrid`), the action box's right margin being the gap (.spec-md §10.5). Every id is an AutomationId. (4) `OpticalConstructor.Ui/SlotBarView.fs` (step 280): `SlotBarHandlers` gains `openSetupGrid : unit -> unit`, and the chip row ends, after `Record experiment`, with the verb `Setup grid…` (`setupGridOpenButton`) calling it; the grid's edits write nothing, so it is offered under a read-only kit too. (5) `OpticalConstructor.Ui/TableAndElementRotationView.fs`: on the model extension holding `setupGrid` (step 282), `member model.setupGridState : SetupGridView.SetupGridState option`, `None` while `setupGrid` is: its `slots` one per `SetupSlot.inLightOrder model.elements` with `model.slotChipItems slot` and the draft's `slotDraft slot.id`; its `rows` one per `grid.combinations`, captioned by `caption model.elements model.kitItems` and marked `CombinationImpossible` with the `describe` of `combination.slotsOver model.elements model.kitItems model.tryItemModelChoice`'s error (step 274), else `CombinationTicked` when `grid.ticked` holds it and `CombinationUnticked` otherwise; and `generateAvailability` `ControlOffered` when `model.kitWrites` is (step 185), the grid has an axis and `ticked` is not empty, and `ControlWithheld` otherwise. A private `setupGridHandlers (dispatch : TableAndElementRotationMsg -> unit) : SetupGridView.SetupGridHandlers` beside `slotBarHandlers` dispatches `ToggleSetupGridItem`, `AddSetupGridAngle`, `RemoveSetupGridAngle`, `ToggleSetupGridCombination`, `GenerateSetupGrid` (step 276) and `CloseSetupGrid`, and `slotBarHandlers` gains `openSetupGrid` dispatching `OpenSetupGrid`. The table surface's `DockPanel` (step 280) docks, below the slot bar and above the table, `SetupGridView.setupGridView state (setupGridHandlers dispatch)` while `setupGridState` is `Some state`. No other message, field, id or option is added. Tests: new `OpticalConstructor.Ui.Tests/SetupGridPanelTests.fs`, `module SetupGridPanelTests` in `namespace OpticalConstructor.Ui.Tests`, appended at the end of the compile list with no comment, mounting `mainView` as `SlotBarTests` does (step 280), over `initMain ()` whose scratch kit holds `LP1`, `LP2`, `QZ` and `QZ2` added through the Items panel's messages, with a linear polarizer, a sample and a second linear polarizer added so that the light meets them in that order before the seeded detector, `LP1` in the first and `LP2` in the second (`AssignSlot`). Without a trait: `the setup grid UiIds are the stable intent-named ids`: the five fixed ids' texts, `setupGridCombination (ConstructorUiPosition 2)` (`SetupGridCombination_2`), `setupGridItemChoice (ObjectSlotRole (SlotPosition 1))` of a test-local item id (`SetupGridItem_Obj1_<its GUID>`), `setupGridAngleField (AnalyzerSlotRole (SlotPosition 1))` (`SetupGridAngleField_Analyzer1`) and `setupGridAngle (ObjectSlotRole (SlotPosition 1)) (Angle.degree 22.5)` (`SetupGridAngle_Obj1_22.5`). `the grid panel sits between the slot bar and the table, offers each slot's fitting items and angles, and marks each combination ticked, unticked or impossible`: after `OpenSetupGrid`, `setupGridPanel`'s top is below the bar's bottom and its bottom above the canvas's top, with a row for Source, Prep 1, Obj 1, Analyzer 1 and Detector 1, Obj 1's offering `QZ` and `QZ2` and Prep 1's `LP1` and `LP2`; after `ToggleSetupGridItem` of the sample with `QZ` and `QZ2`, `AddSetupGridAngle` of 0° and 45° and `ToggleSetupGridCombination` of (`QZ2`, 45°), `setupGridCombinationList` reads, in order, `☑ Obj 1: QZ @ 0°`, `☑ Obj 1: QZ @ 45°`, `☑ Obj 1: QZ2 @ 0°` and `☐ Obj 1: QZ2 @ 45°`; and with Prep 1 trying `LP1` and `LP2` and Analyzer 1 trying `LP2`, each combination putting `LP2` in both is a line starting `✗ ` and ending `the item is in two slots: ` and the reason naming `LP2` (`SlotItemTwiceErr`, step 274). `Generate and Close share a row, Close to the right, and Generate needs a ticked combination over a slot`: with the panel open and no axis, `setupGridGenerateButton` is absent and `setupGridCloseButton` present; with an item tried, `Generate` and `Close` have equal tops, `Close`'s left beyond `Generate`'s right; and pressing `setupGridCloseButton` removes the panel. `a kit opened read-only offers the grid but no Generate`: with the model's kit replaced, by record update, by the read-only view of its scratch kit (step 131), as `ItemsPanelTests`' read-only fact builds its model (step 241), and the grid open with `QZ` tried in the sample, `setupGridOpenButton` and `setupGridPanel` are present and `setupGridGenerateButton` absent. With trait `ui-smoke`, pressing boxes at their centre as `LibraryWindowTests.fs:clickOn` (`:69`) does: `pressing Setup grid, items, an angle and Generate records the grid's setups in the kit`: pressing `setupGridOpenButton`, Obj 1's `QZ` and `QZ2` boxes, typing `45` into Obj 1's angle field followed by Enter, and pressing `setupGridGenerateButton` leaves the scratch kit's `readSetups ()` holding `LP1-(QZ#45)-LP2` and `LP1-(QZ2#45)-LP2`. `ScrollExtentTests`: `the Main page with the setup grid open leaves everything reachable`: `assertReachable \"MainSetupGrid\"` (`ScrollExtentTests.fs:89`) over `constructorWindow` (`:107`) of `filledExperiments ()` with the grid open (`OpenSetupGrid`) and the R1 angles 0°, 45° and 90° added to the polarizer's options. `SlotBarTests` (step 280): `the slot bar UiIds are the stable intent-named ids` also checks `setupGridOpenButton`. All choice construction and matching in this step MUST use step 216's payloads, including the resolved ItemModelVersion for source, ideal-polarizer and stack choices. Fixtures MUST obtain those versions from step 210's shipped model entries; runtime resolution MUST use the stored version through ItemModelProxy, never manufacture a model or use a preset/sample as the model. Existing parameter values and optical results MUST be preserved.","acceptance":"After the grid panel lands, `SetupGridView.setupGridView` MUST show, between the slot bar and the table, each slot's fitting items and R1 angles, the combinations ticked, unticked or impossible with the reason, and `Generate` beside `Close`, Generate sending `GenerateSetupGrid` and offered only for a ticked combination over a slot under a writable kit, and the slot bar MUST open it with `Setup grid…`; constructor-unit-tests MUST pass; ui-smoke MUST pass, including `pressing Setup grid, items, an angle and Generate records the grid's setups in the kit`, the count rising by 1; ui-tests MUST pass over the selected classes, including `the setup grid UiIds are the stable intent-named ids`, `the grid panel sits between the slot bar and the table, offers each slot's fitting items and angles, and marks each combination ticked, unticked or impossible`, `Generate and Close share a row, Close to the right, and Generate needs a ticked combination over a slot`, `a kit opened read-only offers the grid but no Generate` and `the Main page with the setup grid open leaves everything reachable` and the changed `the slot bar UiIds are the stable intent-named ids`, the count rising by 5; and build, elevation and the sixteen s28 invariants MUST pass.","required_gates":["build","elevation","constructor-unit-tests","ui-smoke","ui-tests"],"gate_selection":{"constructor-unit-tests":{"mode":"all_discovered","suite":"constructor-unit-tests"},"ui-smoke":{"mode":"all_discovered","suite":"ui-smoke"},"ui-tests":{"mode":"selected","suite":"ui-tests","values":["OpticalConstructor.Ui.Tests.AppContextTests","OpticalConstructor.Ui.Tests.ElementMenuTests","OpticalConstructor.Ui.Tests.ExperimentControlsTests","OpticalConstructor.Ui.Tests.FsxAcceptanceTests","OpticalConstructor.Ui.Tests.InverseConstructorTests","OpticalConstructor.Ui.Tests.KitWindowTests","OpticalConstructor.Ui.Tests.LayerBandsControlsTests","OpticalConstructor.Ui.Tests.LibraryControlsTests","OpticalConstructor.Ui.Tests.LibraryWindowTests","OpticalConstructor.Ui.Tests.LightSourceEditorTests","OpticalConstructor.Ui.Tests.MainSceneMsgTests","OpticalConstructor.Ui.Tests.MainWorkbenchTests","OpticalConstructor.Ui.Tests.MaterialsWindowTests","OpticalConstructor.Ui.Tests.OutOfBandBadgeTests","OpticalConstructor.Ui.Tests.ScrollExtentTests","OpticalConstructor.Ui.Tests.SetupGridPanelTests","OpticalConstructor.Ui.Tests.SlotBarTests","OpticalConstructor.Ui.Tests.SourceAndDetectorMoveTests","OpticalConstructor.Ui.Tests.WorkbenchInfoAndCaptureTests"]}},"effects":{"edits":["Berreman/OpticalConstructor/OpticalConstructor.Controls/UiIds.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/ConstructorUiIdOfDomain.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/SetupGridView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/OpticalConstructor.Ui.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Ui/SlotBarView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui/TableAndElementRotationView.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupGridPanelTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/OpticalConstructor.Ui.Tests.fsproj","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SlotBarTests.fs","Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/ScrollExtentTests.fs"],"tests":[{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SetupGridPanelTests.the setup grid UiIds are the stable intent-named ids","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupGridPanelTests.fs","class":"OpticalConstructor.Ui.Tests.SetupGridPanelTests","discovery_gate":"ui-tests","obligations":["S84-GRID-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SetupGridPanelTests.the grid panel sits between the slot bar and the table, offers each slot's fitting items and angles, and marks each combination ticked, unticked or impossible","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupGridPanelTests.fs","class":"OpticalConstructor.Ui.Tests.SetupGridPanelTests","discovery_gate":"ui-tests","obligations":["S84-GRID-VIEW"]},{"op":"create","suite":"ui-tests","id":"OpticalConstructor.Ui.Tests.SetupGridPanelTests.Generate and Close share a row, Close to the right, and Generate needs a ticked combination over a slot","path":"Berreman/OpticalConstructor/OpticalConstructor.Ui.Tests/SetupGridPanelTests.fs","class":"OpticalConstructor.Ui.Tests.SetupGridPanelTests","discovery_gate":"ui-tests","obligations":["S84-G