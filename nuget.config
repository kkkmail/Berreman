<?xml version="1.0" encoding="utf-8"?>
<!--
    Spec 0046 - STL (Softellect.*) packages come from BOTH feeds: the repo-sibling local feed ../Packages
    (C:\GitHub\Packages, which STL's slow-ring build and family pack scripts publish into - the same feed
    STL's own consumers above the slow ring read) AND nuget.org, where the published versions live.

    STL pins Softellect.* to the local feed ALONE (its Softellect.* pattern outranks nuget.org's "*"). Here
    Softellect.* is listed under BOTH sources at the same specificity, so a version that exists only in the
    local feed (a fresh slow ring) and one that exists only on nuget.org both restore. Everything else comes
    from nuget.org. The <clear /> keeps machine-level sources out, so every machine restores the same way.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="../Packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="Softellect.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Softellect.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
