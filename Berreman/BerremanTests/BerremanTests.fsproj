<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="MatrixComparison.fs" />
        <Compile Include="BerremanMatrixTests.fs" />
        <Compile Include="MatrixExpTests.fs" />
        <Compile Include="FourierTransformTests.fs" />
        <Compile Include="IncidentLightTests.fs" />
        <Compile Include="ThinFilmTests.fs" />
        <Compile Include="RotationTests.fs" />
        <Compile Include="FieldFunctionTests.fs" />
        <Compile Include="SolverTests.fs" />
        <Compile Include="MuellerMatrixTests.fs" />
        <Compile Include="AnalysisFunctionsTests.fs" />
        <Compile Include="DispersionFormulaTests.fs" />
        <Compile Include="EpsWithDispValueTests.fs" />
        <Compile Include="RhoWithDispValueTests.fs" />
        <Compile Include="MuWithDispValueTests.fs" />
        <Compile Include="OptimizationTests.fs" />
        <Compile Include="MuellerReconstructionTests.fs" />
        <Compile Include="InverseFitHarness.fs" />
        <Compile Include="MuellerInverseTests.fs" />
        <Compile Include="BiaxialInverseTests.fs" />
        <Compile Include="FeasibleBiaxialInverseTests.fs" />
        <Compile Include="AbsorbingBiaxialInverseTests.fs" />
        <Compile Include="AbsorbingBiaxialNoisyTests.fs" />
        <Compile Include="LangasiteInverseTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="FsCheck" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Softellect.Sys" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpticalProperties\OpticalProperties.fsproj" />
        <ProjectReference Include="..\Analytics\Analytics.fsproj" />
        <!-- Spec 0042 (001): MuellerReconstructionTests.fs names the pure
             OpticalConstructor.Domain.MuellerReconstruction module (Retardance + retarderMueller). An
             EXPLICIT reference to the Domain project (not relying on the transitive Optimization edge). -->
        <ProjectReference Include="..\OpticalConstructor\OpticalConstructor.Domain\OpticalConstructor.Domain.fsproj" />
        <!-- Slice 011 (§G.11 / AC-G9, AC-G3, AC-G6): OptimizationTests.fs drives the
             full DesignParameters→MeritFunction→optimize→AlglibAdapter→OpticalSystemSolver
             path with the real solver, so it needs the OpticalConstructor.Optimization
             layer. This reference is the enabling edit for that file (no UI dependency,
             per R-4). -->
        <ProjectReference Include="..\OpticalConstructor\OpticalConstructor.Optimization\OpticalConstructor.Optimization.fsproj" />
        <ProjectReference Include="..\OpticalConstructor\OpticalConstructor.Storage\OpticalConstructor.Storage.fsproj" />
        <ProjectReference Include="..\BerremanTestSupport\BerremanTestSupport.fsproj" />
    </ItemGroup>

</Project>
