<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <PlatformTarget>x64</PlatformTarget>
        <DefineConstants>DEBUG</DefineConstants>
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <!-- TestApp.fs first: it carries the assembly-level AvaloniaTestApplication
         attribute the headless xUnit runner reflects on. -->
    <ItemGroup>
        <Compile Include="TestApp.fs" />
        <!-- Spec 0026 Part I (slice 003): pure localization logic tests (no headless
             session needed); runs under the `ui-tests` gate (Category!=ui-smoke). -->
        <Compile Include="LocalizationTests.fs" />
        <!-- Spec 0038 Part B.1 (step 002): the tests that pinned the retired Elmish
             shell (ConstructorView/CommandRegistry/Ribbon/GroupDetectorUndo/PanelView/
             ChartPanel/ConstructionEdit/MaterialsPanel/SourcePanel/ResultsPanel/
             FitPanel/Lifecycle/SystemView3D tests) are deleted with it. SmokeTests
             keeps the app-host boot + persisted-theme assertions over the launcher. -->
        <Compile Include="SmokeTests.fs" />
        <!-- Spec 0038 Part B.1 (step 002): the surviving-surface pins that replace the
             deleted shell suites — the launcher contract (structure `ui-tests` +
             click-opens-scene `ui-smoke`), the AppShell theme seam, and the catalogue
             name/code contract the Main scene and renderer share. -->
        <Compile Include="LauncherTests.fs" />
        <!-- Spec 0038 Part C (step 004, UICOMP_XDUO_0007): the TestLauncherWindow
             contract — the seven diagnostic scene buttons that left the product
             launcher for the standalone OpticalConstructor.TestWindows.App
             executable (structure by stable Name + AutomationId `ui-tests`;
             headless render + click-opens-scene + app-host `ui-smoke`). -->
        <Compile Include="TestLauncherTests.fs" />
        <Compile Include="AppShellSeamTests.fs" />
        <Compile Include="CatalogueTests.fs" />
        <!-- Spec 0038 Part B.1 (step 002): pure-MVU coverage of the Main scene update
             arms TableAndElementRotationTests does not pin (palette per kind, Move/
             Render clamps, exact angles + locks, confirm-gated resets and Library
             bind, zoom clamps, pointer threshold, workbench disarm discipline). -->
        <Compile Include="MainSceneMsgTests.fs" />
        <!-- Spec 0027 (002-rotate-table-task): the table-rotation test window — pure MVU
             (rotations, reset, select/unselect; `ui-tests`) plus two headless render proofs
             of the FuncUI view + window host (`ui-smoke`). -->
        <Compile Include="TableRotationTests.fs" />
        <!-- Spec 0027: the optical-element-rotation test window — pure MVU (rotations, R3 lock,
             per-element + all-element zoom, selection) plus real headless pointer-injection. -->
        <Compile Include="ElementRotationTests.fs" />
        <!-- Spec 0027 task 006 #3: the combined table + element rotation test window. -->
        <Compile Include="TableAndElementRotationTests.fs" />
        <!-- Spec 0027 task 009: the shared rotation-controls bar's modifier-driven highlight
             (pure armed-axis map + a headless key-press render proof). -->
        <Compile Include="RotationControlsTests.fs" />
        <!-- Spec 0027 task 014: the shared position-on-the-ray control (pure contract + headless mount). -->
        <Compile Include="RayPositionControlsTests.fs" />
        <!-- Spec 0027 task 010: the element-movement test window (slide along the beam). -->
        <Compile Include="ElementMovementTests.fs" />
        <!-- Spec 0027 task 010: the renderer test window (swappable element renderer). -->
        <Compile Include="RendererTestTests.fs" />
        <!-- Spec 0027 task 018: the shared renderer control (config DU + presets + transparency). -->
        <Compile Include="RendererControlsTests.fs" />
        <!-- Spec 0038 step 030: the shared renderer's value-binding cue — the pure host derivation
             (bindingStateOf) plus headless proofs that an unbound element renders dashed + ghosted, a
             bound one solid, and a not-bindable lens normally, in both the shape and wireframe looks. -->
        <Compile Include="ElementRendererBindingTests.fs" />
        <!-- Spec 0038 step 031: the out-of-band dispersion warning badge — the pure host
             derivation (a wavelength sweep past a bound sample's defined dispersion flags exactly
             that element; a fixed in-band request flags none) plus the headless proof that the
             flagged element renders the badge with its tooltip text (gate `ui-tests`). -->
        <Compile Include="OutOfBandBadgeTests.fs" />
        <!-- Spec 0027 task 010: the snap-to-beam test window. -->
        <Compile Include="SnapToBeamTests.fs" />
        <!-- Spec 0027 task 012: the snap-to-reflected-light test window. -->
        <Compile Include="SnapToReflectedTests.fs" />
        <!-- Spec 0027 (024) Phase 1: the Library bay — pure control contract + host kind-constrained
             flattening + the BindValueId binding + a headless render/click proof. -->
        <Compile Include="LibraryControlsTests.fs" />
        <!-- Spec 0027 (024) Phase 2: the Experiments bay — pure control contract + host candidate
             flattening + the ChooseSweptElement binding + a headless render/click proof. -->
        <Compile Include="ExperimentControlsTests.fs" />
        <!-- Spec 0027 (028): the pop-out chart window's per-target font-size state (pure `ui-tests`). -->
        <Compile Include="ChartFontTests.fs" />
        <!-- Spec 0027 (030): the chart-window style model — selectable elements, axis range / number format,
             legend placement, per-series look, and the polar conversion (pure `ui-tests`). -->
        <Compile Include="ChartStyleTests.fs" />
        <!-- Spec 0027 (026) Part 4: the Details bay — the reusable LayerBandsControls band component
             (pure contract + headless render) + the host detailsState band-builder + the seven-bay ribbon. -->
        <Compile Include="LayerBandsControlsTests.fs" />
        <!-- Spec 0033 (015): the MaterialsControls component (UICOMP_XDUO_0001) — pure contract +
             headless structure proof (every UiIds control exists; simulated clicks dispatch the
             matching stub handlers; a view-only selection removes the Edit verb). -->
        <Compile Include="MaterialsControlsTests.fs" />
        <!-- Spec 0033 (016): the SampleLibraryControls component (UICOMP_XDUO_0002) — pure contract +
             headless structure proof (every UiIds control exists; simulated clicks dispatch the
             matching stub handlers; the row-targeted verbs are inert without a selection). -->
        <Compile Include="SampleLibraryControlsTests.fs" />
        <!-- Spec 0033 (019): the pure n/k dispersion chart builder (Ui since the 0038
             step-003 workbench move) on the 018
             dual-axis spine — headless model tests: n→left / k→right via the paired style seed,
             the requested spectral range in the display unit, dispersive curve vs flat line. -->
        <Compile Include="NkDispersionChartTests.fs" />
        <!-- Spec 0033 (022): the SampleEditorWindow component (UICOMP_XDUO_0003) — pure contract
             tests + headless UiIds-driven proofs (repeat-block expansion to 2*K films,
             select-by-material bulk thickness, Save through SampleProxy add/update, Cancel
             discard, orientation editor only for anisotropic layers, QWOT derivation). -->
        <Compile Include="SampleEditorWindowTests.fs" />
        <!-- Spec 0033 (023): the MaterialEditorWindow component (UICOMP_XDUO_0004) — pure contract
             tests for the Domain MaterialComplexityEditor ladder + headless UiIds-driven proofs
             (biaxial exposes three principal-index fields, activity on uniaxial offers only the
             uniaxial gyration classes, toggle uncheck restores the default losslessly, Save
             round-trips through MaterialProxy with complexity = Some). -->
        <Compile Include="MaterialEditorWindowTests.fs" />
        <!-- Spec 0033 (024): the Main-screen Materials + Library workbench bays — pure host
             projections / confirm-gated verbs over the write seams, plus headless UiIds-driven
             acceptance proofs (search filters rows, Add/Edit open the editor windows,
             referenced-material remove surfaces MaterialStillReferenced with the store
             unchanged, unreferenced removes update the list in the same render pass). -->
        <Compile Include="MainWorkbenchTests.fs" />
        <!-- Spec 0033 (026): the WIRE_UI composition acceptance — headless proofs driving the
             REAL MainConstructorWindow (the finalized composition root with its four in-memory
             proxies and the default editor launchers): every ribbon bay renders one frame, the
             Selector / Materials / Library bays mount over the root-wired stores, Add/Edit open
             both real editor windows, and a referenced-material remove surfaces the typed
             refusal from the root-coupled samples store. -->
        <Compile Include="WireUiCompositionTests.fs" />
        <!-- Spec 0035 (005): the CategoryControls component (UICOMP_XDUO_0005) — pure contract
             (empty state + the stable intent-named UiIds and derived per-row ids) + a headless
             structure proof (every UiIds control exists over a known State, the built-in row's
             Remove is removed not greyed, and a simulated Add click invokes the add handler). -->
        <Compile Include="CategoryControlsTests.fs" />
        <!-- Spec 0035 (006): the CategoryEditorWindow component (UICOMP_XDUO_0006) — pure contract
             + model tests for the MVU wiring over the step-4 CategoryEditor rendered through the
             step-5 CategoryControls, plus headless UiIds-driven acceptance proofs over a stub
             CategoryProxy (Add grows the list, Rename updates a name, a confirm-gated remove of a
             referenced category surfaces CategoryStillReferenced with the list unchanged). -->
        <Compile Include="CategoryEditorWindowTests.fs" />
        <!-- Spec 0035 (007): the generic Controls ribbon hosts ONLY the active bay's content in ONE
             keyed slot (View.withKey) instead of every bay's pane with IsVisible toggles — headless
             proofs that selecting each bay in turn realizes exactly that bay's content and no other
             pane, with no styled-element recycling error over the live FuncUI patch path. -->
        <Compile Include="RibbonPaneTests.fs" />
        <!-- Spec 0035 (016): the shared dual-axis ScottPlot chart (OpticalConstructor.Controls.EmbeddedChart)
             embedded as the Material editor's n/k preview and the Materials-bay View panel (inlineCanvas
             deleted) — headless render proofs that the embedded control carries n (left) / k (right), draws
             n and k for every model kind incl. the four transcendental, and rasterizes one frame; and both
             host sites embed the AvaPlot and render for a dispersive (incl. transcendental) + non-dispersive. -->
        <Compile Include="EmbeddedChartTests.fs" />
        <!-- Spec 0038 Part C (step 006): the app-scope composition context (AppContext) —
             pure contract pins on `create` (settings carried, materials→samples coupling,
             one scope shares / two scopes don't; gate `ui-tests`) plus the slice acceptance
             (gate `ui-smoke`): two REAL Main windows over ONE app scope share the stores —
             a material added through one window's real editor is listed by the other. -->
        <Compile Include="AppContextTests.fs" />
        <!-- Spec 0038 Part C (step 007, SVC_XDUO_0001 — declared): the WindowLauncher
             contract, mock-driven — pure signature pins (modality decision, typed
             forget/factory errors, id-keyed editor keys + EntryFreshness; gate
             `ui-tests`) plus registry behaviour over stub-built windows (second
             open activates, two editor keys create two windows, forget re-creates;
             gate `ui-smoke`). -->
        <Compile Include="WindowLauncherTests.fs" />
        <!-- Spec 0038 Part E (step 012, UICOMP_XDUO_0008): the FacetedTreeControls component —
             pure contract (empty state + the stable UiIds and derived per-item ids; gate
             `ui-tests`) plus headless structure proofs (every declared automation id over a known
             State, chip click → removeConstraint, offered-value click → applyConstraint, gated
             mode shows Show/Search and ZERO tree rows, the filter and manual-range boxes commit
             on Enter/LostFocus only — never per keystroke; gate `ui-smoke`). -->
        <Compile Include="FacetedTreeControlsTests.fs" />
        <!-- Spec 0038 Part E (step 013, UICOMP_XDUO_0009): the Materials window — pure MVU/
             projection/disarm-discipline tests (gate `ui-tests`) plus the headless acceptance
             (gate `ui-smoke`): the ribbon strip button opens ONE window (second click activates),
             applying facet constraints narrows the corpus in the same render pass, the verbs
             operate over the shared app-scoped stores through the real editors, a category
             rename re-labels the category facet, and gating renders zero rows until Show/Search. -->
        <Compile Include="MaterialsWindowTests.fs" />
        <!-- Spec 0038 Part F (step 015, UICOMP_XDUO_0010): the Library window — pure MVU/
             projection tests (the by-kind tree with per-kind counts, the polarizer-category and
             lifted sample facets, the FIRST numeric-facet host: film-thickness buckets + manual
             min–max range, the protected-remove refusal and confirm-gate discipline; gate
             `ui-tests`) plus the headless acceptance (gate `ui-smoke`): the ribbon strip button
             opens ONE window (second click activates), the by-kind tree lists every entry kind
             with counts, the sample verbs operate over the shared app-scoped stores through the
             real Sample editor, and removing a protected entry surfaces the typed refusal and
             changes nothing. -->
        <Compile Include="LibraryWindowTests.fs" />
        <!-- Spec 0038 Part L (step 037): the inverse constructor state (initInverse — unbound sample,
             chart gated on a hint) and the experiment-collection builder (name / save / list / load
             through the ExperimentCollectionProxy; per-experiment data-file attach that loads +
             validates through the ExperimentDataProxy into a typed status), over mock proxies. -->
        <Compile Include="InverseConstructorTests.fs" />
        <!-- Spec 0038 Part L (step 038): the measured-data picker's persistent last-folder plumbing —
             pure tests over the re-typed EnvironmentSettings.lastFolders (Map keyed by picker purpose):
             the next open reads the persisted folder (lastFolder), a confirmed selection records it
             (rememberFolder / applyPick), a cancel changes nothing, and buildDataFilePickerOptions
             builds the base picker options (title / single-select / no start location) with no real
             picker raised (gate `ui-tests`). -->
        <Compile Include="DataFilePickerFolderTests.fs" />
        <!-- Spec 0038 Part L (step 039, UICOMP_XDUO_0011): the SolverHandoffWindow component — the
             inverse flow's terminal summary + basic-validation screen. Pure per-experiment validation
             facts over mock proxies (every non-sample element specified; a data file attached; the
             file reads schema-valid + range-consistent through the ExperimentDataProxy) plus headless
             semantic-tree proofs driving the REAL window by its UiIds (green ready statuses; missing
             file + range mismatch typed messages; no solver math), gate `ui-tests` + `ui-smoke`. -->
        <Compile Include="SolverHandoffWindowTests.fs" />
        <!-- Spec 0038 Part N (step 047, WIRE_UI / AC-W1): the CLOSING composition acceptance — the
             finalized composition root builds the app scope once (five stores + the file-backed
             ExperimentDataProxy + the in-memory ExperimentCollectionProxy + the step-027 SceneProxy)
             and drives the WHOLE root-wired surface headless: a ui-tests pin that every store proxy
             (incl. the scene seam) is composed at the root, and the ui-smoke wiring assertion that
             renders the launcher, both constructor states, both faceted windows in Browse and Select,
             the three editors, and the SolverHandoff — all over ONE app scope — without throwing. Last
             in the list (it consumes the App composition root + every Ui window). -->
        <Compile Include="WireUiFinalCompositionTests.fs" />
        <!-- Spec 0040 Part E (step 013, WIRE_UI): the CLOSING composition acceptance for arc 0040 —
             the headless wiring assertion that drives the WHOLE changed surface over ONE app scope
             composed like `Startup.context`: the Materials + Library windows open from the REAL
             App-root ribbon strip and render the collapsed tree with a visible selection (steps
             002/003); the Material editor composes with a wrapping description + restricted
             gyration/μ tabs (steps 006/007); a Plate Sample editor renders the R/T emission
             checkboxes and sets its substrate through the Materials Select window (steps 010/011),
             and a ThinFilm editor pins R on with no T control — all without throwing. Last in the
             list (it consumes the App composition root + every changed Ui window). -->
        <Compile Include="WireUi0040CompositionTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.302" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Headless Avalonia (spec 0024 §U1.7): the smoke/view tests render frames on
             the Avalonia.Headless platform via HeadlessUnitTestSession. This dependency
             lives ONLY here, never in the pure OpticalConstructor.Tests project. The
             .XUnit helper is intentionally omitted: it binds to xUnit v2, while this
             project stays on xunit.v3 (see TestApp.fs). Versions track Avalonia 11.3.4. -->
        <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpticalConstructor.Ui\OpticalConstructor.Ui.fsproj" />
        <!-- The App reference lets the smoke test boot the real composition root
             (MainWindow) headlessly; the test never runs the Exe entry point. -->
        <ProjectReference Include="..\OpticalConstructor.App\OpticalConstructor.App.fsproj" />
        <!-- Spec 0027 (002-rotate-table-task): the project under test for the
             table-rotation test window. -->
        <ProjectReference Include="..\OpticalConstructor.TestWindows\OpticalConstructor.TestWindows.fsproj" />
        <!-- Spec 0038 Part C (step 004): the standalone diagnostic-launcher
             executable under test (TestLauncherWindow + its App lifetime). -->
        <ProjectReference Include="..\OpticalConstructor.TestWindows.App\OpticalConstructor.TestWindows.App.fsproj" />
    </ItemGroup>

</Project>
