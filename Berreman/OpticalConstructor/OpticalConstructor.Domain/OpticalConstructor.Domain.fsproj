<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <AssemblyName>Softellect.Berreman.OpticalConstructor.Domain</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <PlatformTarget>x64</PlatformTarget>
        <DefineConstants>DEBUG</DefineConstants>
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <!-- Compile order: units spine -> beam tree -> sources -> dispersion -> materials.
         Slice 001 ships these as empty placeholder modules; later slices fill them. -->
    <ItemGroup>
        <Compile Include="Units.fs" />
        <!-- Spec 0038 Part C (step 005): the pure, elevated workbench-settings record —
             the Domain shape of the app-level appsettings.json values. Depends on
             nothing; the App composition root is the only place the raw wire values
             are read (AppSettingsProvider) and elevated into this record. -->
        <Compile Include="WorkbenchSettings.fs" />
        <!-- Spec 0033 (019): the pure spectral-axis helpers (label / canonical-meter range /
             display-unit ticks), REAL-MOVED here from Ui's MaterialPreview so non-Ui chart
             hosts (TestWindows' n/k dispersion chart) share them. Depends only on Units and
             the engine/Analytics references below. -->
        <Compile Include="SpectralAxis.fs" />
        <Compile Include="BeamTree.fs" />
        <Compile Include="Placement.fs" />
        <Compile Include="RayModel.fs" />
        <Compile Include="SourceSpec.fs" />
        <Compile Include="SourceCombination.fs" />
        <Compile Include="Table.fs" />
        <!-- Spec 0027 (002-rotate-table-task): the pure 3-D rotation + orthographic
             projection of the table to the screen (§C.2.4). Avalonia-free single source
             of truth for the table tumble, consumed by the constructor page and the
             standalone rotation test window; compiles after Table (its `TableViewState`)
             and Placement (its `Vector3`). -->
        <Compile Include="TableView.fs" />
        <Compile Include="Project.fs" />
        <!-- Spec 0026 Part G/H (slice 007): element groups + experiment collections.
             Pure domain on top of Placement (member configs are reused ElementPlacement
             values); compiles after Project, no new dependency. -->
        <Compile Include="Groups.fs" />
        <Compile Include="CurvedElements.fs" />
        <Compile Include="DispersionModels.fs" />
        <Compile Include="MaterialLibrary.fs" />
        <!-- Spec 0027 (024): elevated ElementId + the Library (Sample/Source/Detector/Polarizer
             presets), the grouping-tree representations, and the mock LibraryProxy (functional-proxy
             seam). Depends on MaterialLibrary, Placement.CatalogueKind, and the engine
             WaveLength/Thickness. -->
        <Compile Include="ElementId.fs" />
        <!-- Spec 0027 (024) Phase 3/4: the pure MM/SV propagation pipeline — ideal-polarizer Mueller
             matrices (constants), the sample's Mueller matrix from the EXISTING engine, SV propagation,
             the rotating-analyzer intensity curve (the Malus proof), and the ellipsometer Ψ/Δ readout.
             Depends on the engine Fields/Media/Solvers + the Library domain. -->
        <Compile Include="Propagation.fs" />
        <!-- Spec 0033 (021): the pure, Avalonia-free SAMPLE-stack edit model over
             SampleStructure (state + selection, one message DU, typed repeat-count
             errors). Mirrors Ui's StackEditor message discipline at the material-id
             level; depends only on ElementId/MaterialLibrary above. -->
        <Compile Include="SampleStackEditor.fs" />
        <!-- Spec 0038 Part G (step 016): the Browse/Select window-mode domain — the
             kind constraint, the typed selection target (table element | sample-layer
             position), the SelectionContext callbacks, and the LibraryWindowMode DU
             both catalogue windows share. Depends on Placement (CatalogueKind),
             ElementId (Library.ElementId) and SampleStackEditor (LayerPosition). -->
        <Compile Include="WindowMode.fs" />
        <!-- Spec 0033 (023): the pure, Avalonia-free MATERIAL edit model over
             MaterialComplexity (the Part F progressive-unlock ladder): state +
             message DU + Result-returning apply, toComplexity/ofComplexity onto
             the engine's serializable value trees, the constrained gyration-class
             offering, and the restated advisory gain rule. Depends on
             DispersionModels/MaterialLibrary above. -->
        <Compile Include="MaterialComplexityEditor.fs" />
        <!-- Spec 0035 (004): the pure, Avalonia-free CATEGORY edit model over the seeded
             MaterialCategory catalogue — state + message DU (BeginAddCategory / SetCategoryName /
             RemoveCategoryRow) + a Result-returning apply, plus the commit projection into the
             add/rename/remove intents the host dispatches to CategoryProxy. Reuses the step-2
             CategoryError (blank name -> InvalidCategory). Depends only on MaterialLibrary above. -->
        <Compile Include="CategoryEditor.fs" />
        <!-- Spec 0038 Part D (step 009): the generic faceted-navigation engine — pure,
             Avalonia-free, generic over the item type (defs + constraints as values;
             filter / countFor / breadcrumbCounts / buildTree as naive folds; the plain-text
             filter as an ordinary constraint). Depends on nothing; step 010's numeric
             bucket builder and step 011's concrete facet catalogues compile after it. -->
        <Compile Include="Facets.fs" />
        <!-- Spec 0038 Part D (step 010): the 1–2–5 log-ladder numeric bucket builder
             every NumericAttribute branch uses (ladder boundaries over the constrained
             population's min/max, empty buckets dropped, fewest-first merging under
             ThicknessBucketCap, half-open intervals, exact-value collapse, nm/µm
             labels). Depends on Facets (NumericRange/ItemCount/engine), WorkbenchSettings
             (the cap), and Units (unit symbols); step 011's catalogues compile after it. -->
        <Compile Include="FacetBuckets.fs" />
        <!-- Spec 0038 Part D (step 011): the two CONCRETE facet catalogues as data —
             material facets over MaterialEntry (category / anisotropy / dispersion /
             transparency / dispersion model / activity class + handedness / magnetic)
             and library-entry facets over LibraryEntry (kind, the material facets
             lifted to samples as the distinct union over constituents, substrate
             material, has-thin-films, film materials, per-film thickness). Depends on
             Facets/FacetBuckets, MaterialLibrary, ElementId (Library), DispersionModels
             and MaterialComplexityEditor above. -->
        <Compile Include="LibraryFacets.fs" />
        <!-- Spec 0038 Part H (step 020): the entry-lifecycle foundation — VersionNumber,
             the Material/Sample version ids, EntryLifecycle, the cross-store VersionRef,
             the VersionsInUse seam, and the ONE pure version-creation decision rule
             (decideVersioning) the material/sample stores (steps 21/22) share. Pure and
             Avalonia-free; depends only on MaterialLibrary (MaterialId) and ElementId's
             Library (SampleId) above. -->
        <Compile Include="Lifecycle.fs" />
        <!-- Spec 0038 Part I (step 025): the Experiments domain — grown so an `Experiment` carries an
             ordered `ElementDescriptor` setup (kind + placement/orientation summary + versioned
             `VersionRef` binding, sample/source optional, detector included), a `DataFilePath` +
             optional per-experiment attachment, and the `boundVersions` / `versionsInUseSeam` builders
             the stores' `VersionsInUse` is wired over. Moved out of `ElementId.fs` to here because the
             descriptor binding reuses the step-020 `VersionRef` (`Lifecycle.fs`, above); nothing between
             `ElementId.fs` and here references `Experiments`, so the module name is unchanged. -->
        <Compile Include="Experiments.fs" />
        <!-- Spec 0038 Part H (step 021): the versioned in-memory MATERIAL store behind the
             registered MaterialProxy write-seam (STORE_XDUO_0001). The MaterialProxy record
             stays re-typed in place in MaterialLibrary.fs; its createInMemory augmentation
             lives HERE because it applies the shared decideVersioning rule from Lifecycle.fs
             above and its samplesReferencing parameter is Sample-typed (Library, ElementId.fs). -->
        <Compile Include="MaterialStore.fs" />
        <!-- Spec 0038 Part H (step 022): the versioned in-memory SAMPLE store behind the registered
             SampleProxy write-seam (STORE_XDUO_0002). The SampleProxy record stays re-typed in place
             in ElementId.fs; its createInMemory augmentation lives HERE because it applies the shared
             decideVersioning rule from Lifecycle.fs above and takes the VersionsInUse seam. Mirrors
             MaterialStore.fs. -->
        <Compile Include="SampleStore.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.301" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Berreman\Berreman.fsproj" />
        <ProjectReference Include="..\..\Analytics\Analytics.fsproj" />
    </ItemGroup>

</Project>
