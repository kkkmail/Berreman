<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <AssemblyName>Softellect.Berreman.OpticalConstructor.Domain</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <PlatformTarget>x64</PlatformTarget>
        <DefineConstants>DEBUG</DefineConstants>
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <!-- Compile order: units spine -> beam tree -> sources -> dispersion -> materials.
         Slice 001 ships these as empty placeholder modules; later slices fill them. -->
    <ItemGroup>
        <Compile Include="Units.fs" />
        <!-- Spec 0033 (019): the pure spectral-axis helpers (label / canonical-meter range /
             display-unit ticks), REAL-MOVED here from Ui's MaterialPreview so non-Ui chart
             hosts (TestWindows' n/k dispersion chart) share them. Depends only on Units and
             the engine/Analytics references below. -->
        <Compile Include="SpectralAxis.fs" />
        <Compile Include="BeamTree.fs" />
        <Compile Include="Placement.fs" />
        <Compile Include="RayModel.fs" />
        <Compile Include="SourceSpec.fs" />
        <Compile Include="SourceCombination.fs" />
        <Compile Include="Table.fs" />
        <!-- Spec 0027 (002-rotate-table-task): the pure 3-D rotation + orthographic
             projection of the table to the screen (§C.2.4). Avalonia-free single source
             of truth for the table tumble, consumed by the constructor page and the
             standalone rotation test window; compiles after Table (its `TableViewState`)
             and Placement (its `Vector3`). -->
        <Compile Include="TableView.fs" />
        <Compile Include="Project.fs" />
        <!-- Spec 0026 Part G/H (slice 007): element groups + experiment collections.
             Pure domain on top of Placement (member configs are reused ElementPlacement
             values); compiles after Project, no new dependency. -->
        <Compile Include="Groups.fs" />
        <Compile Include="CurvedElements.fs" />
        <Compile Include="DispersionModels.fs" />
        <Compile Include="MaterialLibrary.fs" />
        <!-- Spec 0027 (024): elevated ElementId + the Library (Sample/Source/Detector/Polarizer
             presets), the grouping-tree representations, and the mock LibraryProxy (functional-proxy
             seam). Depends on MaterialLibrary, Placement.CatalogueKind, and the engine
             WaveLength/Thickness. -->
        <Compile Include="ElementId.fs" />
        <!-- Spec 0027 (024) Phase 3/4: the pure MM/SV propagation pipeline — ideal-polarizer Mueller
             matrices (constants), the sample's Mueller matrix from the EXISTING engine, SV propagation,
             the rotating-analyzer intensity curve (the Malus proof), and the ellipsometer Ψ/Δ readout.
             Depends on the engine Fields/Media/Solvers + the Library domain. -->
        <Compile Include="Propagation.fs" />
        <!-- Spec 0033 (021): the pure, Avalonia-free SAMPLE-stack edit model over
             SampleStructure (state + selection, one message DU, typed repeat-count
             errors). Mirrors Ui's StackEditor message discipline at the material-id
             level; depends only on ElementId/MaterialLibrary above. -->
        <Compile Include="SampleStackEditor.fs" />
        <!-- Spec 0033 (023): the pure, Avalonia-free MATERIAL edit model over
             MaterialComplexity (the Part F progressive-unlock ladder): state +
             message DU + Result-returning apply, toComplexity/ofComplexity onto
             the engine's serializable value trees, the constrained gyration-class
             offering, and the restated advisory gain rule. Depends on
             DispersionModels/MaterialLibrary above. -->
        <Compile Include="MaterialComplexityEditor.fs" />
        <!-- Spec 0035 (004): the pure, Avalonia-free CATEGORY edit model over the seeded
             MaterialCategory catalogue — state + message DU (BeginAddCategory / SetCategoryName /
             RemoveCategoryRow) + a Result-returning apply, plus the commit projection into the
             add/rename/remove intents the host dispatches to CategoryProxy. Reuses the step-2
             CategoryError (blank name -> InvalidCategory). Depends only on MaterialLibrary above. -->
        <Compile Include="CategoryEditor.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.301" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Berreman\Berreman.fsproj" />
        <ProjectReference Include="..\..\Analytics\Analytics.fsproj" />
    </ItemGroup>

</Project>
