{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/material-source-snapshot.json",
  "title": "MaterialSourceSnapshot",
  "description": "An online material source's snapshot stamp, .snapshot-json beside the snapshot it describes (spec 0050 S13.1). Only version 1's body is validated so other positive schema versions reach the typed version check before binding.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "source", "sourceVersion"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "source": { "type": "string", "minLength": 1 },
      "sourceVersion": { "type": "string", "minLength": 1 }
    }
  }
}
