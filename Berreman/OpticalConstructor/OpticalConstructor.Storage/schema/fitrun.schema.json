{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/fitrun.json",
  "title": "FitRun",
  "description": "One fit run's <study>@<stamp>.fitrun-json content, written once and never rewritten (spec 0050 S11.3). Only version 1's body is validated so other positive schema versions reach the typed version check before binding; the inner shapes are bound by the serializer.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "name", "study", "stamp", "mode", "stage", "calibrationUse", "engine", "runs", "dataRead", "parameters", "entries", "members", "objectMatrices", "notes"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "name": { "type": "string", "pattern": "\\S" },
      "study": { "type": "string", "pattern": "\\S" },
      "stamp": { "type": "string" },
      "mode": { "type": "integer", "minimum": 1, "maximum": 2 },
      "stage": { "type": "integer", "minimum": 1, "maximum": 3 },
      "calibrationUse": { "type": "integer", "minimum": 1, "maximum": 2 },
      "engine": { "type": "integer", "minimum": 1, "maximum": 2 },
      "runs": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "dataRead": { "type": "array" },
      "parameters": { "type": "array" },
      "entries": { "type": "array" },
      "members": { "type": "array" },
      "objectMatrices": { "type": "array" },
      "notes": { "type": "string" }
    }
  }
}
