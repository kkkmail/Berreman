{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/library-category.json",
  "title": "LibraryCategoryEntry",
  "description": "One material category per file, <name>.category-json (spec 0050 001 §A, §B); its name is the category's name. The schema header is checked for every version, the body only for version 1, so a file of another version reaches the typed version check: there are no up-converters.",
  "type": "object",
  "required": ["schema"],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["kind", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": 6, "description": "The category kind's wire tag." },
        "version": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
      }
    }
  },
  "if": {
    "required": ["schema"],
    "properties": {
      "schema": {
        "required": ["version"],
        "properties": { "version": { "const": 1 } }
      }
    }
  },
  "then": {
    "required": ["schema", "id", "version", "name", "categoryOpt", "descriptionOpt", "payload", "provenance", "contentHash"],
    "additionalProperties": false,
    "properties": {
      "schema": true,
      "id": { "$ref": "https://berreman/schema/library-common.json#/$defs/guid" },
      "version": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" },
      "name": { "type": "string", "minLength": 1 },
      "categoryOpt": { "type": "null" },
      "descriptionOpt": { "type": "null" },
      "payload": {
        "type": "object",
        "required": ["Case", "Fields"],
        "additionalProperties": false,
        "properties": {
          "Case": { "const": "CategoryPayload" },
          "Fields": {
            "type": "array",
            "prefixItems": [
              {
                "enum": ["SelectableOnCreate", "HiddenOnCreate"],
                "description": "Whether the create picker offers the category."
              }
            ],
            "minItems": 1,
            "items": false
          }
        }
      },
      "provenance": { "$ref": "https://berreman/schema/library-common.json#/$defs/provenance" },
      "contentHash": { "$ref": "https://berreman/schema/library-common.json#/$defs/contentHash" }
    }
  }
}
