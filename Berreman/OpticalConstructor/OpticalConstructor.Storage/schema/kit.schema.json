{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/kit.json",
  "title": "KitFile",
  "description": "A kit's metadata, .kit-json (spec 0050 S4.1). Only version 1's body is validated so other positive schema versions reach the typed version check before binding.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "id", "name", "author", "created", "modified", "notes", "sendExclude"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "id": { "$ref": "https://berreman/schema/library-common.json#/$defs/guid" },
      "name": { "type": "string", "pattern": "\\S" },
      "author": { "type": "string" },
      "created": { "type": "string" },
      "modified": { "type": "string" },
      "notes": { "type": "string" },
      "sendExclude": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
