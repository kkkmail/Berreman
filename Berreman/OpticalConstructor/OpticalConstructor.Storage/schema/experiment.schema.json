{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/experiment.json",
  "title": "ExperimentFile",
  "description": "One experiment's .experiment-json content (spec 0050 S4.3). Only version 1's body is validated so other positive schema versions reach the typed version check before binding.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "experiment"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "experiment": {
        "type": "object",
        "required": ["id", "name", "setup", "scan", "role", "sessionOpt", "notes", "dataFileOpt"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" },
          "name": {
            "description": "The stem of the experiment's <name>.experiment-json (spec 0050 S9.1).",
            "type": "string",
            "pattern": "\\S"
          },
          "setup": {
            "description": "The setup revision the experiment was recorded over (spec 0050 S8.2).",
            "type": "object",
            "required": ["name", "revision"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "\\S" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          },
          "scan": {
            "description": "What the run varies, block after block, and a tunable source's set wavelength (spec 0050 S9.1).",
            "type": "object",
            "required": ["blocks", "sourceWaveLengthOpt"],
            "additionalProperties": false,
            "properties": {
              "blocks": { "type": "array" },
              "sourceWaveLengthOpt": true
            }
          },
          "role": {
            "description": "What the run is for, its ExperimentRole tag (spec 0050 S9.1).",
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "sessionOpt": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "\\S" }
            ]
          },
          "notes": { "type": "string" },
          "dataFileOpt": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["path", "contentHash"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "contentHash": { "$ref": "https://berreman/schema/library-common.json#/$defs/contentHash" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
