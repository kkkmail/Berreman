{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/experiment.json",
  "title": "ExperimentFile",
  "description": "One experiment's .experiment-json content (spec 0050 S4.3). Only version 1's body is validated so other positive schema versions reach the typed version check before binding.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "experiment"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "experiment": {
        "type": "object",
        "required": ["id", "setup", "varied", "measurement", "range", "dataFileOpt", "sourceWaveLengthOpt"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" },
          "setup": {
            "type": "array",
            "items": {
              "description": "A descriptor names its assigned physical item, or null when none was assigned; a body without the field is refused (spec 0050 S7.2).",
              "required": ["itemIdOpt"],
              "properties": {
                "itemIdOpt": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "https://berreman/schema/library-common.json#/$defs/guid" }
                  ]
                }
              }
            }
          },
          "varied": true,
          "measurement": true,
          "range": { "type": "object" },
          "dataFileOpt": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["path", "contentHash"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "contentHash": { "$ref": "https://berreman/schema/library-common.json#/$defs/contentHash" }
                }
              }
            ]
          },
          "sourceWaveLengthOpt": true
        }
      }
    }
  }
}
