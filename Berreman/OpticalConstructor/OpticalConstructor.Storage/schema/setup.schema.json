{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/setup.json",
  "title": "SceneFile",
  "description": "One scene's .setup-json content (spec 0050 S4.3). Only version 1's body is validated so other positive schema versions reach the typed version check before binding.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "name", "scene"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "name": { "type": "string", "pattern": "\\S" },
      "scene": {
        "type": "object",
        "required": ["elements", "view", "snap", "pivot"],
        "additionalProperties": false,
        "properties": {
          "elements": { "type": "array" },
          "view": true,
          "snap": true,
          "pivot": true
        }
      }
    }
  }
}
