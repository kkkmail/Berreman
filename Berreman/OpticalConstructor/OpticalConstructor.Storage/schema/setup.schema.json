{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/setup.json",
  "title": "SetupFile",
  "description": "One setup's <name>.setup-json content (spec 0050 S8.2). Only version 1's body is validated so other positive schema versions reach the typed version check before binding; a slot's shape is bound by the serializer.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "setup"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "setup": {
        "type": "object",
        "required": ["name", "revision", "slots", "history"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "\\S" },
          "revision": { "type": "integer", "minimum": 1 },
          "slots": { "type": "array" },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["revision", "slots"],
              "additionalProperties": false,
              "properties": {
                "revision": { "type": "integer", "minimum": 1 },
                "slots": { "type": "array" }
              }
            }
          }
        }
      }
    }
  }
}
