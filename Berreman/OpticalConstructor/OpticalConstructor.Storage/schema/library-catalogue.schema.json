{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berreman/schema/library-catalogue.json",
  "title": "LibraryCatalogueManifest",
  "description": "A catalogue folder's manifest, .catalogue-json (spec 0050 001 §A, §B): the catalogue's identity and one row per entry file. Its schemaVersion is checked for every version, the body only for version 1, so a file of another version reaches the typed version check: there are no up-converters.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" }
  },
  "if": {
    "required": ["schemaVersion"],
    "properties": { "schemaVersion": { "const": 1 } }
  },
  "then": {
    "required": ["schemaVersion", "id", "name", "version", "entries"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": true,
      "id": { "$ref": "https://berreman/schema/library-common.json#/$defs/guid" },
      "name": { "type": "string", "minLength": 1 },
      "version": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["kind", "id", "version", "fileName", "contentHash"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "integer", "minimum": 1, "maximum": 6, "description": "The entry kind's wire tag." },
            "id": { "$ref": "https://berreman/schema/library-common.json#/$defs/guid" },
            "version": { "$ref": "https://berreman/schema/library-common.json#/$defs/positiveVersion" },
            "fileName": { "type": "string", "minLength": 1 },
            "contentHash": { "$ref": "https://berreman/schema/library-common.json#/$defs/contentHash" }
          }
        }
      }
    }
  }
}
