<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <AssemblyName>Softellect.Berreman.OpticalConstructor.Storage</AssemblyName>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Errors.fs" />
        <Compile Include="SchemaValidation.fs" />
        <Compile Include="CanonicalJson.fs" />
        <Compile Include="EntryFileJson.fs" />
        <Compile Include="CatalogueFolderStore.fs" />
        <Compile Include="LibraryDatabaseStore.fs" />
        <Compile Include="MaterialDatabaseStore.fs" />
        <Compile Include="CategoryDatabaseStore.fs" />
        <Compile Include="SampleDatabaseStore.fs" />
        <Compile Include="SourceDatabaseStore.fs" />
        <Compile Include="PresetDatabaseStore.fs" />
        <Compile Include="ItemModelDatabaseStore.fs" />
        <Compile Include="LibraryBackupStore.fs" />
        <Compile Include="CatalogueImportStore.fs" />
        <Compile Include="KitFolderStore.fs" />
        <Compile Include="KitContentFiles.fs" />
        <Compile Include="KitHistoryStore.fs" />
        <Compile Include="KitArchiveStore.fs" />
        <!-- Spec 0026 Part G/H (slice 007): the separate per-user groups + experiment-
             collections store. Reuses CanonicalJson.options + the validate-on-load seam;
             compiles after CanonicalJson (its shared options). -->
        <Compile Include="GroupsLibrary.fs" />
        <Compile Include="Sidecar.fs" />
        <Compile Include="MaterialImport.fs" />
        <Compile Include="SpectralImport.fs" />
        <!-- Persistence II (§I.5-I.8, slice 013): export. -->
        <Compile Include="Export.fs" />
        <!-- Spec 0046: the file-backed experiment-data export proxy (CSV). -->
        <Compile Include="ExperimentExportFile.fs" />
        <Compile Include="Report.fs" />
        <Compile Include="MuellerDataStore.fs" />
        <Compile Include="LabFileImport.fs" />
        <Compile Include="ExperimentDataStore.fs" />
        <Compile Include="Storage.fs" />
    </ItemGroup>

    <!-- The published JSON Schema is a build-copied content item; the relative
         `schema/` path is preserved into the output (and flows to consumers) so
         `SchemaValidation` can load it beside the assembly at runtime (§I.2). -->
    <ItemGroup>
        <Content Include="schema\material-metadata.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- Spec 0026 Part G/H (slice 007): the groups/collections schema, build-copied
             beside the assembly so GroupsLibrary.validate loads it at runtime (G.3.1). -->
        <Content Include="schema\optical-constructor-groups.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-common.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-material.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-sample.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-source.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-polarizer.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-detector.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-category.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-item-model.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\library-catalogue.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\kit.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\kit-history.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\experiment.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\item.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="schema\setup.schema.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Catalogue\Builtin\**" Link="Catalogue\Builtin\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.SystemTextJson" />
        <PackageReference Include="FSharp.Data" />
        <PackageReference Include="JsonSchema.Net" />
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="Softellect.Sys" />
    </ItemGroup>

    <ItemGroup>
        <!-- Math.NET (`Matrix<Complex>`, used by the JSON converter) flows in
             transitively: Storage -> OpticalConstructor.Domain -> Berreman ->
             Numerics.csproj. No direct reference is needed (binding rule 1:
             no new C# project reference invented here). -->
        <ProjectReference Include="..\OpticalConstructor.Domain\OpticalConstructor.Domain.fsproj" />
        <ProjectReference Include="..\OpticalConstructor.Database\OpticalConstructor.Database.csproj" />
    </ItemGroup>

</Project>
