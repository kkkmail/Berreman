<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>x64</Platforms>
        <AssemblyName>Softellect.Berreman.OpticalConstructor.Controls</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <PlatformTarget>x64</PlatformTarget>
        <DefineConstants>DEBUG</DefineConstants>
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <OtherFlags>--warnaserror+:25 --platform:x64</OtherFlags>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>NU5100;NU5110;NU5111;NU1903</NoWarn>
    </PropertyGroup>

    <!-- Spec 0027 (008-task): the shared reusable UI controls (the rotation-controls bar). A thin
         FuncUI control library, generic (no domain types), referenced by both the test windows and
         the main Ui. Public MIT Avalonia + FuncUI + ScottPlot NuGet only. -->
    <ItemGroup>
        <Compile Include="RotationControls.fs" />
        <Compile Include="ElementPaletteControls.fs" />
        <!-- Spec 0027 (014-more-standardization): the shared "position-on-the-ray" bar (§E.4). -->
        <Compile Include="RayPositionControls.fs" />
        <!-- Spec 0027 (018): the renderer "large control" and the main-screen ribbon of "Bays". -->
        <Compile Include="RendererControls.fs" />
        <Compile Include="Ribbon.fs" />
        <!-- Spec 0027 (024): the Library bay — a kind-constrained list/tree of choosable entries
             (Samples / Sources / Detectors / Polarizers); selecting an entry binds the element's
             valueId. Domain-free (rows are host-flattened). -->
        <Compile Include="LibraryControls.fs" />
        <!-- Spec 0027 (026): the reusable layer-stack BAND view (the Details bay) — a vertical stack of
             coloured rectangles sized by thickness, labelled with material + thickness. Domain-free (the
             host flattens a sample's system into bands). -->
        <Compile Include="LayerBandsControls.fs" />
        <!-- Spec 0027 (024) Phase 2: the Experiments bay — choose WHICH present element's R1 sweeps a
             full circle (the rotating-analyzer experiment). Build / edit only (no solve yet).
             Domain-free (candidates are host-flattened). -->
        <Compile Include="ExperimentControls.fs" />
        <!-- Spec 0033 (015): the materials workbench list surface (UICOMP_XDUO_0001) — search box,
             category/dispersion facet selectors, the materials list, and Add / Edit / Remove / View
             verbs. Domain-free (rows and facet options are host-flattened; the host owns the
             MaterialProxy search seam); view-only rows carry no Edit affordance. -->
        <Compile Include="MaterialsControls.fs" />
        <!-- Spec 0033 (016): the samples workbench list surface (UICOMP_XDUO_0002) — search box,
             substrate-kind facet selector, the samples list, Add / Edit / Remove / View verbs, and
             the multilayer entry point. Domain-free (rows and facet options are host-flattened; the
             host owns the SampleProxy search seam). -->
        <Compile Include="SampleLibraryControls.fs" />
        <!-- Spec 0035 (005): the Category-manager list surface (UICOMP_XDUO_0005) — an editable
             category list with an inline name box per row and Add / Rename(save) / Remove verbs, a
             built-in row whose Remove is omitted (removed, not greyed), and an inline block-message
             slot for the store's CategoryStillReferenced / BuiltInNotRemovable refusals. Domain-free
             (rows are host-flattened from the CategoryEditor working set). -->
        <Compile Include="CategoryControls.fs" />
        <!-- Spec 0033 (017): the renderer-neutral chart model and the pop-out ScottPlot chart window,
             REAL-MOVED here from OpticalConstructor.TestWindows so both hosts (TestWindows and Ui)
             share ONE type identity. ExperimentChart.fs (the pure model: ExperimentChart / ChartFont /
             ChartStyle) compiles before ChartWindow.fs (the ScottPlot IO seam that maps it). -->
        <Compile Include="ExperimentChart.fs" />
        <Compile Include="ChartWindow.fs" />
        <!-- Spec 0035 (016): the inline / embeddable form of the shared dual-axis ScottPlot chart (the
             editor's live n/k preview and the Materials-bay View panel embed this AvaPlot host, built
             through ChartPlot's shared rebuild path), replacing the deleted primitive inlineCanvas. -->
        <Compile Include="EmbeddedChart.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.301" />
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.FuncUI" Version="2.0.0-preview1" />
        <!-- Spec 0033 (017): the interactive chart-window host (moved here with ChartWindow.fs) — the
             same version both hosts already used, so one ScottPlot resolves solution-wide. -->
        <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
    </ItemGroup>

</Project>
